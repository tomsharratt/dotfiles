#!/usr/bin/env bash
# pq - a queue of Claude Code plans, waiting to be run as implementer sessions.
#
# The split this exists to make: one long-lived session, in plan mode, does the
# thinking and produces a plan that has already answered every question. `pq` then
# runs those plans - later, unattended, several at a time - as cheap implementer
# sessions that only have to execute. An agent that cannot get stuck is an agent
# that can work overnight.
#
# `pq` owns plans and scheduling. It does not own worktrees: it shells out to `wt`
# for an isolated, provisioned worktree and starts its own agent in the pane that
# comes back. The two tools are separable on purpose - `wt` is complete without
# `pq`, and `pq` reaches it through one narrow seam (`wt new --no-agent --no-focus
# --json`).
#
#   pq add [plan]        add a plan to the queue (no plan, at a terminal: pick one)
#   pq add --urgent      allocate from a reserved range, ahead of every real date
#   pq add --after T     repeatable: don't dispatch until T's PR has merged
#   pq add --split       split a plan into a stack of standalone parts, wired with --after
#   pq add --split-dir D queue an already-split directory, skipping the split step
#   pq after <task>      list a task's blockers and what each is waiting on
#   pq after <task> T... add blockers to a task already in the queue or held
#   pq after <task> --clear   drop them all
#   pq ls                every task, its state, and what it is waiting on
#   pq ls --all           also show archive/ - settled history pq no longer walks
#   pq show <task>       one task's header and plan
#   pq urgent <task>     move it to the very front of the queue
#   pq later <task>      move it to the very back of the queue
#   pq hold <task>       park a task so nothing picks it up
#   pq unhold <task>     put it back in the queue
#   pq rm <task>         drop a task (never touches a worktree or a branch)
#   pq archive <task>    file a done task away by hand (done only)
#   pq tick              free finished slots, then fill them from the queue
#   pq run               tick on an interval until you stop it
#   pq cap [N]           how many may run at once; 0 pauses. Read every tick.
#
# `pq tick` is one idempotent pass, safe to run by hand at any time - including
# alongside a running `pq run`.
#
# The cap counts live AGENTS, not directories in `running/`. An agent does not
# exit when it opens its pull request, so a task reconcile has moved to `done/`
# keeps spending its slot until that agent has actually stopped - see the
# `slots` section below for why the release is a timer rather than an exit.
#
# A task may name blockers: other work that must have merged before it is
# eligible for dispatch. Blocked is derived, not stored - a blocked task sits in
# `queue/` like any other, and fill just skips it, the same way the cap is soft
# arithmetic rather than a drain state. Merge state comes from the forge (`gh`),
# never from git ancestry - a squash-merged branch's tip is not an ancestor of
# the default branch, so `git branch --merged` misses every real merge. See
# `after_state` below for the full predicate.
#
# `pq` also tears its own tasks down, the other end of that same `wt` seam: once
# a done task's PR has genuinely merged into its repo's default branch - checked
# against the forge, never `wt gc --merged`'s looser "state == MERGED" - `pq`
# runs the equivalent of `wt rm` on it, unattended. It never touches a worktree
# it did not create, never merges or closes a pull request, and a task whose PR
# closed without merging is left exactly as `wt rm` would have found it. The one
# thing that holds a teardown off is the agent still going, or `pq` itself
# sitting in the workspace about to be closed - see `reap_task` below.
#
# Once a done task's verdict is terminal - merged and torn down, or every PR
# closed without one - `pq tick` files it away to `archive/`, keeping only the
# newest few behind (`PQ_DONE_KEEP`) so `pq ls` stays a list of what still
# needs a look rather than a growing pile of finished history. See
# `archive_pass` below, and `pq archive` for the manual escape hatch.
#
# LAYOUT ─────────────────────────────────────────────────────────────────────
# A task is a DIRECTORY, and the directory it sits in is its state:
#
#   $PQ_HOME/queue/20260729143022-live-chat-mentions/    waiting to be picked up
#            hold/20260729150431-risky-refactor/         parked by you
#            running/20260729121005-spotify-scope-fix/   dispatched
#            done/20260728091500-live-chat-links/        a PR exists; still spending a slot until its agent stops
#            archive/20260727080000-live-chat-onboarding/  settled history - `pq ls` hides it, tick never walks it
#            splits/live-chat-mentions-20260728-141230-83421/   a plan mid-split, or one left over
#
#   <task>/plan.md     the settings header + Claude's plan, immutable once added
#          after       blockers: one per line, TSV  label <TAB> repo <TAB> branch
#          state.env   KEY=VALUE runtime facts, written as dispatch progresses
#
#   <split>/source.md     the plan being split, copied in
#          repos          the repo inventory the splitter was shown: TSV  label <TAB> path, primary first - what --split-dir checks against
#                         (a split written before this file's field was called `repo` - one bare line, the primary only - and do_split still reads it as a fallback)
#                         (row 1 can instead be a no-primary sentinel - an empty label, a container directory's path - when the plan was split from a directory that is not itself a repo; see repo_candidates_container)
#          graph.tsv      one line per part: filename <TAB> comma-separated filenames that must merge first <TAB> repo label (empty for the primary, REQUIRED when there is none)
#          NN-*.md        the parts themselves, written by the splitter
#          splitter.json  the splitter session's own JSON output - cost, duration, permission denials
#          splitter.err   the splitter session's stderr, read on failure
#          .named.tsv     part <TAB> branch <TAB> slug <TAB> intent, written once naming succeeds
#
# `after` is neither of the other two: `plan.md` is immutable by contract so an
# agent re-reading its own plan never sees it change, and `state.env` is runtime
# facts written as dispatch progresses. Blockers are your intent, edited before
# dispatch, so they get their own file - named for the verb that writes it. An
# absent file means no blockers.
#
# Every transition is a `mv`, which is atomic within one filesystem - so two
# dispatchers racing cannot both claim the same task, and a `mv` that fails means
# somebody else got there first. Splitting the immutable plan from the mutable
# state also means an agent can re-read its own plan at any point and never see it
# change underneath it.
#
# The fourteen-digit prefix is a UTC timestamp and nothing else - the queue is
# add-order, oldest first. It is not an identity: promoting a task (`pq urgent`,
# `pq later`) renames its directory, so every command here takes the SLUG (or
# any unique prefix of it) instead.

set -uo pipefail

PQ_HOME="${PQ_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}/pq}"
PLANS_DIR="${PQ_PLANS_DIR:-$HOME/.claude/plans}"
WT="${PQ_WT:-$HOME/.local/bin/wt}"
STATES="queue hold running done archive"

# Any stamp below this has a year under 1000, so it cannot be a date pq ever
# produced - which is what makes the low range safe to reserve for --urgent.
PQ_STAMP_REAL=10000000000000

PQ_DEFAULT_MODEL="${PQ_DEFAULT_MODEL:-sonnet}"
PQ_DEFAULT_EFFORT="${PQ_DEFAULT_EFFORT:-xhigh}"
PQ_NAMER_MODEL="${PQ_NAMER_MODEL:-haiku}"
PQ_SPLITTER_MODEL="${PQ_SPLITTER_MODEL:-opus}"
PQ_SPLITTER_EFFORT="${PQ_SPLITTER_EFFORT:-xhigh}"
PQ_PICK_LIMIT="${PQ_PICK_LIMIT:-10}"       # plans per page in pick_plan; `n`/`p` walk the rest
# A non-positive limit would break "Enter takes 1" - the table would have
# zero rows, yet Enter still defaults to a row 1 that can't exist - so this
# one, unlike its neighbours, is worth guarding against a bad override. It is
# also the page STRIDE, so a zero would divide by zero working out how many
# pages there are.
[[ "$PQ_PICK_LIMIT" =~ ^[0-9]+$ ]] && [ "$PQ_PICK_LIMIT" -ge 1 ] || PQ_PICK_LIMIT=10
PQ_PICK_PREVIEW="${PQ_PICK_PREVIEW:-12}"   # lines of a plan pick_plan previews
PQ_REPOS_MAX="${PQ_REPOS_MAX:-12}"         # cap on repo_candidates'/repo_candidates_container's scanned inventory
# Same reasoning as PQ_PICK_LIMIT above: a non-numeric override makes the
# `-gt` truncation check below throw and, under `set -uo pipefail` (no -e),
# silently take the false branch - disabling the cap rather than erroring -
# and a non-positive one drives `head -n` with a zero or negative count,
# which BSD and GNU head disagree on.
[[ "$PQ_REPOS_MAX" =~ ^[0-9]+$ ]] && [ "$PQ_REPOS_MAX" -ge 1 ] || PQ_REPOS_MAX=12
PQ_REPOS_DIR="${PQ_REPOS_DIR:-}"           # scan root override; default is the primary's dirname, or a container split's own path
PQ_LABEL_MAX="${PQ_LABEL_MAX:-16}"         # max chars of a blocker label in AGENT's cell, before the +N count
[[ "$PQ_LABEL_MAX" =~ ^[0-9]+$ ]] && [ "$PQ_LABEL_MAX" -ge 1 ] || PQ_LABEL_MAX=16
PQ_DONE_KEEP="${PQ_DONE_KEEP:-3}"           # newest archivable done/ tasks archive_pass leaves behind; 0 is legal
[[ "$PQ_DONE_KEEP" =~ ^[0-9]+$ ]] || PQ_DONE_KEEP=3
# How long a done/ task's agent must have stopped working before its slot is
# released - see the `slots` section. 0 is legal and restores the old
# release-on-PR behaviour; a non-numeric override is a typo, not a request to
# disable the cap, so it falls back to the default rather than to 0.
PQ_WRAPUP_GRACE="${PQ_WRAPUP_GRACE:-300}"
[[ "$PQ_WRAPUP_GRACE" =~ ^[0-9]+$ ]] || PQ_WRAPUP_GRACE=300

# What the session wall looks like on screen, and how hard to knock. These are
# Claude Code UI strings, so they will change - hence up here and overridable
# rather than buried in the logic that uses them.
#
# No braces in these defaults: `${VAR:-...}` ends at the first unescaped `}`, so a
# bounded repetition like {0,24} gets cut in half and the rest leaks out as literal
# text. It fails as a corrupt pattern at match time, not as a syntax error here.
PQ_QUOTA_RE="${PQ_QUOTA_RE:-limit to reset|usage limit reached|out of usage credits|hit your .*limit}"
PQ_PERM_RE="${PQ_PERM_RE:-Do you want to |Yes, and don.t ask again|Allow once}"
PQ_QUOTA_RETRY="${PQ_QUOTA_RETRY:-600}"           # seconds between "continue" attempts
PQ_QUOTA_MAX_TRIES="${PQ_QUOTA_MAX_TRIES:-40}"    # ~7h at that interval, then stop knocking
PQ_TAIL_LINES="${PQ_TAIL_LINES:-30}"

# Paths that a trap has to clean up must be globals: an EXIT trap runs after the
# function has returned, so a `local` it referenced is already out of scope - and
# under `set -u` that turns the cleanup into an "unbound variable" error instead.
PQ_STAGING=""; PQ_LOCK=""

# A tick's one-line verdict. `pq tick` prints it directly; `pq run` collects it
# instead, so it can drop a summary identical to the previous one and leave a log
# of what CHANGED rather than one line per interval all night.
PQ_SUMMARY=""; PQ_RUN=0

summary() { PQ_SUMMARY=$*; [ "$PQ_RUN" = 1 ] || printf 'pq: %s\n' "$*" >&2; }
msg()  { printf 'pq: %s\n' "$*" >&2; }
warn() { printf '\033[38;2;246;193;119mpq: %s\033[0m\n' "$*" >&2; }
die()  { printf '\033[38;2;235;111;146mpq: %s\033[0m\n' "$*" >&2; exit 1; }

for d in $STATES; do mkdir -p "$PQ_HOME/$d"; done

# ── plan header ─────────────────────────────────────────────────────────────
# The header is deliberately flat `key: value`, one per line, no nesting and no
# folded blocks. It is written by this script and read by this script (in bash,
# in a loop, on every tick), so being trivially parseable beats being expressive
# YAML. `intent` is therefore one long line - it is read by `pq show` and pasted
# into a PR body, never wrapped by hand.
hdr() {                                 # plan.md key
  [ -f "$1" ] || return 0
  awk -v k="$2" '
    NR == 1 && $0 == "---" { inh = 1; next }
    inh && $0 == "---"     { exit }
    inh {
      i = index($0, ":")
      if (i && substr($0, 1, i - 1) == k) {
        v = substr($0, i + 1); sub(/^[ \t]+/, "", v); print v; exit
      }
    }' "$1"
}

# Read one key out of a task's runtime state without disturbing our own variables.
# Same shape as wt's state files, so the two tools' state reads the same way.
st() {                                  # task_dir key
  [ -f "$1/state.env" ] || return 0
  ( set -a; . "$1/state.env" 2>/dev/null; set +a; eval "printf '%s' \"\${$2:-}\"" ) 2>/dev/null
}
# Upsert KEY=VALUE, preserving the other keys. Each dispatch step records itself the
# moment it succeeds, which is what lets reconcile tell a half-finished dispatch from
# a finished one after an interrupted tick.
#
# Values must be shell-safe WORDS, because `st` reads this file by sourcing it and
# nothing here quotes anything. That is not a style note: a value containing a
# bracket - `PQ_RESETS=3pm (PDT)`, as the session wall used to store its hint - is a
# syntax error, and bash abandons the whole file at that line, so every key written
# after it silently reads empty. Store the machine form of a fact (an epoch, an id, a
# stamp) and format it on the way out; never store prose.
st_set() {                              # task_dir key value
  local f="$1/state.env"
  { grep -v "^$2=" "$f" 2>/dev/null || true; printf '%s=%s\n' "$2" "$3"; } > "$f.tmp" && mv "$f.tmp" "$f"
}
now() { date -u '+%Y-%m-%dT%H:%M:%SZ'; }
epoch() { date -u '+%s'; }
# One of pq's own ISO stamps back to epoch seconds, or nothing when it cannot be
# parsed. BSD `date` only, like every other date call in this file: `-j` (do not
# set the clock) and `-f` (input format) are not GNU flags, and pq is a darwin
# tool. Prints nothing rather than 0 on a bad stamp, so a caller can tell "no
# stamp" from "the epoch".
epoch_of() {                            # iso8601 -> epoch seconds, or empty
  [ -n "${1:-}" ] || return 0
  date -j -u -f '%Y-%m-%dT%H:%M:%SZ' "$1" '+%s' 2>/dev/null || return 0
}

# ── shielded children ───────────────────────────────────────────────────────
# Run a command in a process group of its own, so a Ctrl-C aimed at pq does not
# take it down as collateral.
#
# A terminal sends SIGINT to the entire FOREGROUND PROCESS GROUP, which by default
# includes every child pq has spawned. So a `wt new` halfway through copying a
# database would die alongside the tick, and a minute of provisioning gets thrown
# away and done again. Job control (`set -m`) puts a background job in its own
# process group, and the signal then reaches only pq: the trap sets the stop flag,
# the work already in flight runs to completion, and the loop exits after it. That
# is what makes "stop after this tick" a real promise rather than a hopeful one.
#
# Everything comes back through files. Command substitution would defeat the whole
# point by putting the child back in our process group, and `wait`'s return value
# cannot be told apart from "interrupted" once signals are in play - so stdout and
# the true exit status are written where they can be read afterwards. stdin is
# /dev/null because a background process group that reads the terminal is stopped
# with SIGTTIN, which would hang the tick.
SHIELDED_OUT=""; SHIELDED_PID=""
shielded() {                            # cmd...
  local outf="$PQ_HOME/.out.$$" rcf="$PQ_HOME/.rc.$$" code
  rm -f "$outf" "$rcf"
  set -m
  ( "$@" > "$outf" < /dev/null; printf '%s' "$?" > "$rcf" ) &
  SHIELDED_PID=$!
  set +m
  # The trap interrupts `wait`, not the child - so wait again until it has gone.
  while kill -0 "$SHIELDED_PID" 2>/dev/null; do wait "$SHIELDED_PID" 2>/dev/null; done
  SHIELDED_PID=""
  SHIELDED_OUT=$(cat "$outf" 2>/dev/null)
  code=$(cat "$rcf" 2>/dev/null)
  rm -f "$outf" "$rcf"
  return "${code:-1}"
}

# ── the cap ─────────────────────────────────────────────────────────────────
# How many tasks may be running at once. It is STATE, not an argument: it lives in
# a file and is re-read at the top of every tick, so `pq cap 1` in the morning and
# `pq cap 4` at bedtime take effect on the next pass of a loop that is already
# running - no restart, no second concept for pausing. `pq cap 0` is the pause.
#
# The cap is soft in both directions. Fill is `while active < cap`, so lowering it
# never kills anything: it simply starts nothing new until enough slots free up on
# their own. There is no drain state to track, because the arithmetic already is one.
#
# The default is deliberately 1 rather than the 3 you will probably settle on. A
# fresh machine, or a state dir that got wiped, should not quietly start dispatching
# three unattended agents because nobody had said otherwise yet.
CAP_FILE="$PQ_HOME/cap"
cap_get() {
  local c
  c=$( { tr -dc '0-9' < "$CAP_FILE"; } 2>/dev/null )
  [ -n "$c" ] || c=${PQ_DEFAULT_CAP:-1}
  printf '%s' "$c"
}
cap_set() { printf '%s\n' "$1" > "$CAP_FILE"; }

cmd_cap() {
  [ $# -eq 0 ] && { printf '%s\n' "$(cap_get)"; return 0; }
  [[ "$1" =~ ^[0-9]+$ ]] || die "usage: pq cap [N]   (0 pauses; nothing running is touched)"
  cap_set "$1"
  # The same arithmetic fill uses, so what this promises and what the next tick
  # does cannot drift - a done task still wrapping up its PR is spending a slot,
  # and saying "room for 1 more" while it does would be the old lie in a new
  # place. slot_state, not slot_held: reporting the cap must not start anybody's
  # wrap-up clock. pidx_load first, or every pane reads as unknowable and every
  # unsettled done task is counted out of caution.
  local active nwrap=0 d
  pidx_load
  for d in "$PQ_HOME/done"/*/; do
    [ -d "$d" ] || continue
    [ -n "$(slot_state "${d%/}")" ] && nwrap=$((nwrap + 1))
  done
  active=$(( $(ls -d "$PQ_HOME/running"/*/ 2>/dev/null | wc -l | tr -d ' ') + nwrap ))
  local also=""
  [ "$nwrap" -gt 0 ] && also=" ($nwrap of them wrapping up a PR)"
  # A wall outranks the arithmetic here as much as it does in fill: room the next
  # tick will not use is not room, and the reason is the whole answer.
  local walled_by walled_at
  IFS=$'\t' read -r walled_by walled_at <<<"$(walled_slot)"
  if [ "$1" = 0 ]; then
    msg "cap 0 - paused. $active still running$also; nothing new will start."
  elif [ -n "$walled_by" ]; then
    msg "cap $1 - $active running$also, but $walled_by is $(walled_note "$walled_at"), so nothing new starts until it is moving again."
  elif [ "$active" -gt "$1" ]; then
    msg "cap $1 - $active already running$also, so nothing new starts until $(( active - $1 + 1 )) of them finish."
  else
    msg "cap $1 - room for $(( $1 - active )) more$also."
  fi
}

# ── task lookup ─────────────────────────────────────────────────────────────
# "queue/20260729143022-live-chat-mentions" -> "live-chat-mentions"
slug_of() { local b; b=$(basename "$1"); printf '%s' "${b#*-}"; }
# Tolerant of a non-numeric (or missing) prefix, yielding 0 rather than letting
# $((10#$b)) throw - what makes a legacy `060-slug` directory, or any foreign
# directory, harmless instead of fatal. Checked with a pattern match first: under
# `set -uo pipefail` (no -e) a bad $(( )) prints to stderr and keeps going rather
# than dying, which would be noise, not 0.
# Also bounded to 14 digits, same reasoning: a longer all-digit prefix (never
# produced by task_name, only by hand-corruption) would otherwise overflow
# bash's 64-bit arithmetic and wrap to an unpredictable value that could get
# adopted as next_stamp's max - "harmless" has to include this input too, not
# just non-numeric ones.
stamp_of() {
  local b; b=$(basename "$1"); b=${b%%-*}
  case "$b" in ""|*[!0-9]*) printf 0; return ;; esac
  [ "${#b}" -gt 14 ] && { printf 0; return; }
  printf '%s' "$((10#$b))"
}

is_urgent() {                           # task_dir -> true if in the urgent range
  [ "$(stamp_of "$1")" -lt "$PQ_STAMP_REAL" ]
}

# The directory basename for a task at a stamp. %014d is a FIXED width, not a
# minimum: it is what makes bash's glob order and numeric order the same order.
# Takes a BARE integer - a zero-padded string here would be read as octal
# (printf '%03d' 020 is 16) or rejected outright.
task_name() {                           # stamp slug
  printf '%014d-%s' "$1" "$2"
}

# The next stamp in one of the two ranges. Monotone by construction: a UTC
# timestamp normally, but never less than one past the highest stamp already in
# that range. That is what makes N adds inside the same second still ascend
# strictly - which is what a --split relies on - and what stops a clock that
# steps backwards from burying a new task under an old one.
next_stamp() {                          # [urgent] -> bare integer
  local urgent=${1:-0} want max=0 s d
  if [ "$urgent" = 1 ]; then want=1; else want=$(date -u +%Y%m%d%H%M%S); fi
  # Spans archive: a stamp must never be reissued, and an archived task is
  # still a task that once claimed this number. See all_tasks.
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    s=$(stamp_of "$d")
    if [ "$urgent" = 1 ]; then [ "$s" -lt "$PQ_STAMP_REAL" ] || continue
    else                       [ "$s" -ge "$PQ_STAMP_REAL" ] || continue; fi
    [ "$s" -gt "$max" ] && max=$s
  done <<<"$(all_tasks all)"
  [ "$want" -gt "$max" ] || want=$(( max + 1 ))
  printf '%s' "$want"
}

# Every task directory, ordered by state then stamp. `done` last: it is history,
# and the top of the list should be what is live. No sort needed within a state,
# PROVIDED every directory there carries the new %014d (task_name) prefix - that
# fixed width is what makes bash's own glob ordering agree with numeric order. A
# lingering legacy or foreign directory of a different width can still disagree
# with it, which is exactly what the one-time migration exists to clear out.
#
# `scope` narrows what "every task directory" means. `live` (the default) is
# what every display and dispatch walker wants - archive/ is settled history,
# not something to show or to search. `all` adds it, always last: even more
# history than `done`, and the one thing a stamp-uniqueness check
# (`slug_taken_in`) or a stamp allocation (`next_stamp`) cannot afford to miss.
all_tasks() {                           # [scope: live|all]
  # An array, not a space-joined string split with `for s in $states`: this
  # function is routinely reached from inside an ancestor's
  # `IFS=$'\t' read ... <<<"$(...)"` (after_check's read of after_state is
  # exactly that shape), and that prefix assignment is in effect for the
  # WHOLE command it prefixes - including the command substitution that
  # builds its herestring, which is a subshell this function then runs in. An
  # unquoted `$states` word-splits on that inherited IFS, and a tab-only IFS
  # has no space in it - `for s in $states` collapses to one bogus iteration
  # and every task vanishes. `"${states[@]}"` never depends on IFS at all.
  local scope=${1:-live} s d states=(running queue hold done)
  [ "$scope" = all ] && states+=(archive)
  for s in "${states[@]}"; do
    for d in "$PQ_HOME/$s"/*/; do
      [ -d "$d" ] || continue
      printf '%s\n' "${d%/}"
    done
  done
}

# Fill's own view of the queue: stamp order, sorted NUMERICALLY rather than
# trusting glob order. Glob order and numeric order agree by construction now
# (task_name's fixed width, see above), but this sort is the guard that keeps
# it that way rather than an assumption resting on every writer doing the right
# thing - test/pq-order.sh is what holds it.
queue_ordered() {
  local d
  for d in "$PQ_HOME/queue"/*/; do
    [ -d "$d" ] || continue
    printf '%s\t%s\n' "$(stamp_of "${d%/}")" "${d%/}"
  done | sort -s -n -k1,1 | cut -f2-
}

# Resolve what the user typed to exactly one task directory. Exact slug match wins
# outright, so a slug that happens to prefix a longer one is still reachable;
# otherwise a unique prefix is enough, and an ambiguous one is an error rather than
# a guess - picking the wrong task here would queue or delete the wrong work.
#
# Live tasks first, archive/ only on a miss - so a prefix that already resolves
# (uniquely or ambiguously) among live tasks reads exactly as it did before
# archive/ existed, and history sharing a prefix never changes that answer.
# Archive is consulted only when live has nothing at all, which is what keeps
# `pq show`/`pq rm` working on an archived slug.
find_task() {                           # needle
  local needle=${1:-} d s scope exact="" hits=()
  [ -n "$needle" ] || die "which task? (pq ls)"
  for scope in live all; do
    exact=""; hits=()
    while IFS= read -r d; do
      [ -n "$d" ] || continue
      s=$(slug_of "$d")
      [ "$s" = "$needle" ] && { exact=$d; break; }
      case "$s" in "$needle"*) hits+=("$d") ;; esac
    done <<<"$(all_tasks "$scope")"
    [ -n "$exact" ] && { printf '%s' "$exact"; return 0; }
    [ "${#hits[@]}" -gt 0 ] && break
  done
  case "${#hits[@]}" in
    0) die "no task matching '$needle' (pq ls)" ;;
    1) printf '%s' "${hits[0]}" ;;
    *) die "'$needle' matches ${#hits[@]} tasks: $(for d in "${hits[@]}"; do printf '%s ' "$(slug_of "$d")"; done)" ;;
  esac
}

state_of() {                            # task_dir  -> queue|hold|running|done
  local p=${1%/*}; basename "$p"
}

# Move a task between states, keeping its stamp prefix. The `mv` is the state
# transition; nothing else records it.
retitle() {                             # task_dir new_state [new_stamp]
  local src=$1 to=$2 stamp=${3:-} name
  name=$(basename "$src")
  [ -n "$stamp" ] && name=$(task_name "$stamp" "$(slug_of "$src")")
  local dst="$PQ_HOME/$to/$name"
  [ "$src" = "$dst" ] && { printf '%s' "$dst"; return 0; }
  [ -e "$dst" ] && die "a task already exists at $to/$name"
  mv "$src" "$dst" || die "could not move $src -> $dst"
  printf '%s' "$dst"
}

# ── after: blockers ─────────────────────────────────────────────────────────
# A blocker is a resolved (label, repo, branch) triple, not a task reference -
# `pq add B --after A` resolves A to its repo and branch at the moment you type
# it. That is what makes the dependency survive `pq rm A`, survive A ageing out
# of `done/`, and survive a slug being reused; it is also what makes a cross-repo
# blocker work for free, and what lets a blocker name a branch that is not in
# `pq` at all.

# The branch a slug reduces to, same rule `cmd_add` uses for its own task names -
# lowercased, non `[a-z0-9-]` squashed to `-`, runs collapsed, edges trimmed.
branch_to_slug() {                      # branch -> a queue-safe slug
  local s=${1##*/}
  tr '[:upper:]' '[:lower:]' <<<"$s" | tr -c 'a-z0-9-' '-' | sed -E 's/-+/-/g; s/^-|-$//g'
}

# The `after` file, one blocker per line, or nothing if the task has none.
after_list() {                          # task_dir
  [ -f "$1/after" ] && cat "$1/after"
}

# Append a blocker if its (repo, branch) is not already present - that pair is
# the real identity, not the label, so re-adding the same branch under a
# different label is a no-op rather than a duplicate.
after_add() {                           # task_dir label repo branch
  local d=$1
  awk -F'\t' -v r="$3" -v b="$4" '$2 == r && $3 == b { f = 1; exit } END { exit !f }' \
    "$d/after" 2>/dev/null && return 0
  printf '%s\t%s\t%s\n' "$2" "$3" "$4" >> "$d/after"
}

# The task directory, in ANY state, whose plan.md names this exact (repo,
# branch) - or nothing. Used for cycle detection and for telling "orphan" (no
# task anywhere owns this branch, so nothing will ever open a PR for it) apart
# from the ordinary "waiting, not started yet" case.
#
# Live first, archive only on a miss - blocker_state reaches this only after
# pr_merged_into has already said no, so the archive scan happens only on that
# rarer path. Without it, a blocker whose owner has since archived would read
# as "no task owns its branch" and fire a false orphan warning.
task_by_branch() {                      # repo branch
  local d scope
  for scope in live all; do
    while IFS= read -r d; do
      [ -n "$d" ] || continue
      [ "$(hdr "$d/plan.md" repo)" = "$1" ] && [ "$(hdr "$d/plan.md" branch)" = "$2" ] \
        && { printf '%s' "$d"; return 0; }
    done <<<"$(all_tasks "$scope")"
  done
  return 1
}

# A value containing '/' is a branch in the OWNER's own repo - the repo of the
# task being given the blocker. Slugs cannot contain '/' (cmd_add strips them),
# so the rule is unambiguous. Otherwise it is a task slug resolved through
# find_task, which is what makes a cross-repo blocker free: the resolved task
# carries its own repo along with it, whatever that repo is.
resolve_after() {                       # owner_repo value -> "label\trepo\tbranch"
  local owner_repo=$1 value=$2 t
  case "$value" in
    */*) printf '%s\t%s\t%s' "$(branch_to_slug "$value")" "$owner_repo" "$value" ;;
    *)
      t=$(find_task "$value") || return 1
      printf '%s\t%s\t%s' "$(slug_of "$t")" "$(hdr "$t/plan.md" repo)" "$(hdr "$t/plan.md" branch)"
      ;;
  esac
}

# DFS from the proposed blocker (repo, branch) back through task_by_branch and
# each task's own `after` file, looking for a path that leads back to
# (owner_repo, owner_branch) - including the trivial self-reference, one step
# in. Two tasks each waiting on the other would stall silently forever, and the
# odds only grow once a big plan is auto-split into a stack of them.
after_cycle() {                         # owner_repo owner_branch repo branch [visited task_dirs...]
  local owner_repo=$1 owner_branch=$2 repo=$3 branch=$4 t r2 b2 v
  [ "$repo" = "$owner_repo" ] && [ "$branch" = "$owner_branch" ] && return 0
  t=$(task_by_branch "$repo" "$branch") || return 1
  shift 4
  for v in "$@"; do [ "$v" = "$t" ] && return 1; done
  while IFS=$'\t' read -r _ r2 b2; do
    [ -n "$r2" ] || continue
    after_cycle "$owner_repo" "$owner_branch" "$r2" "$b2" "$t" "$@" && return 0
  done <<<"$(after_list "$t")"
  return 1
}

# The slugs of every task, in any state, that lists (repo, branch) as a
# blocker. Holding or removing a task silently stalls everything after it, and
# this is what lets `cmd_hold` and `cmd_rm` say so before they do it.
dependents_of() {                       # repo branch
  local d r b
  while IFS= read -r d; do
    [ -n "$d" ] && [ -f "$d/after" ] || continue
    while IFS=$'\t' read -r _ r b; do
      [ "$r" = "$1" ] && [ "$b" = "$2" ] && printf '%s\n' "$(slug_of "$d")"
    done <<<"$(after_list "$d")"
  done <<<"$(all_tasks)"
}

# ── add ─────────────────────────────────────────────────────────────────────
# The newest plan Claude wrote, now or ever edited. Claude Code names these
# itself, from the prompt that started the session, so the filename is never
# a task name - see name_plan.

# epoch<TAB>path, newest first. The sort key is max(mtime, birth time), not
# plain mtime: a plan created days ago and edited this morning must sort
# above one created this morning and left alone, and a file restored by
# `cp -p`, `rsync -a`, or a git checkout carries an old mtime with a new
# birth time. A filesystem with no birth time reports 0 for %B, which the
# max simply ignores. Only top-level *.md - a hand-made subdirectory under
# $PLANS_DIR stays invisible, exactly as `ls -t "$PLANS_DIR"/*.md` always was.
recent_plans() {                        # -> epoch<TAB>path, newest first
  stat -f '%m%t%B%t%N' "$PLANS_DIR"/*.md 2>/dev/null \
    | awk -F'\t' '{ print ($1 > $2 ? $1 : $2) "\t" $3 }' \
    | sort -t$'\t' -k1,1nr -k2,2
}

latest_plan() { recent_plans | head -1 | cut -f2-; }

# Ask a small model for a branch name and a one-line statement of intent, from the
# plan itself. Both are things a human reads later - the branch on a pull request,
# the intent at the top of its description - and neither can be derived from the
# filename, which is auto-generated ("floofy-hugging-dragonfly.md").
#
# Prints "branch<TAB>intent", or nothing if the model could not be reached or gave
# something unusable; the caller then insists on --branch rather than inventing one.
#
# The optional second argument is a comma-separated avoid list: branches already
# spoken for by a sibling part in the same split, appended as one more sentence
# rather than a second prompt - `do_split` retries a collision once with this set,
# before giving up on that part.
#
# The optional third argument is the repo label a multi-repo split part lands
# in - a task's slug is a single global namespace (`slug_taken_in` sweeps every
# state), so an iOS part and an Android part of the same feature would
# otherwise both want the same branch. Appended as one more sentence, exactly
# like the avoid list, and omitted entirely for a single-repo split.
name_plan() {                           # plan_file [avoid: comma-separated branches already taken] [repo_label]
  local raw json avoid=${2:-} label=${3:-} prompt
  prompt='Read this plan and reply with ONLY a JSON object, no code fence, no commentary:
{"branch":"tom/<3-5 dash-separated lowercase words naming the task>","intent":"<2-3 sentences, one line, saying what this sets out to achieve in the author'"'"'s terms - not a description of the diff>"}'
  [ -n "$avoid" ] && prompt="$prompt
The branch must differ from these, which are already taken: $avoid"
  [ -n "$label" ] && prompt="$prompt
This part lands in the $label repository, so make the branch name say which one if the task's own words would not already distinguish it from the same work elsewhere."
  raw=$(claude -p --model "$PQ_NAMER_MODEL" "$prompt" < "$1" 2>/dev/null) || return 0
  # Be forgiving about a fenced or chatty reply: take the first {...} span.
  json=$(sed -n 's/.*\({.*}\).*/\1/p' <<<"$(tr '\n' ' ' <<<"$raw")" | head -1)
  [ -n "$json" ] || return 0
  jq -er '[.branch, .intent] | @tsv' 2>/dev/null <<<"$json"
}

# A branch already spoken for is the one failure that must be caught at add time.
# `wt new` on an existing branch deliberately CHECKS IT OUT rather than failing, so
# two tasks sharing a name would quietly land in the same worktree and fight over
# it. Live tasks and git both get a say; `done` deliberately does not, so a name
# whose branch has since been reclaimed is free to be used again.
#
# Three checks, cheapest first. The last one goes to the network, which is worth a
# round trip to catch a branch pushed from somewhere else - but it is bounded, so an
# add made offline fails fast instead of sitting on a TCP timeout, and a network we
# could not reach reports "not taken". That is the safe direction to be wrong in:
# the worst case is `wt new` later adopting the existing remote branch, which is a
# thing it already knows how to do.
branch_taken() {                        # branch repo
  local branch=$1 repo=$2 d
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    case "$(state_of "$d")" in done) continue ;; esac
    [ "$(hdr "$d/plan.md" branch)" = "$branch" ] && { printf 'queued as %s' "$(slug_of "$d")"; return 0; }
  done <<<"$(all_tasks)"
  git -C "$repo" show-ref --verify --quiet "refs/heads/$branch" && { printf 'a local git branch'; return 0; }
  git -C "$repo" show-ref --verify --quiet "refs/remotes/origin/$branch" && { printf 'a known remote branch'; return 0; }
  GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o ConnectTimeout=5 -o BatchMode=yes}" \
    git -C "$repo" ls-remote --exit-code --heads origin "$branch" >/dev/null 2>&1 \
    && { printf 'a remote branch'; return 0; }
  return 1
}

# Which of $STATES already has a task directory ending in -$slug, or nothing.
# `done` counts here, unlike `branch_taken`'s live-task check above: a slug is
# the whole directory name rather than a branch, so a stale `done/NNN-foo`
# still blocks a fresh `foo` from being created at all. Shared by `cmd_add`'s
# own uniqueness sweep and `split_name_collision`, so the two rules cannot
# silently drift apart.
slug_taken_in() {                       # slug -> the state name, or nothing
  local slug=$1 d2
  for d2 in $STATES; do
    ls -d "$PQ_HOME/$d2"/*-"$slug" >/dev/null 2>&1 && { printf '%s' "$d2"; return 0; }
  done
  return 1
}

# ── picking a plan and its options ──────────────────────────────────────────
# `pq add` with no plan, at a terminal, shows what it is about to queue rather
# than guessing silently - see cmd_add's own gate for exactly when this fires.

# The first line with real content, leading blanks skipped, a leading `#`
# marker stripped whether it is one or several. H1 for every plan Claude Code
# writes today; the first non-blank line is the fallback for anything without
# one.
plan_title() {                          # plan_file -> its title
  awk '
    /^[[:space:]]*$/ { next }
    { sub(/^#+[ \t]*/, ""); print; exit }
  ' "$1"
}

# A string made safe for render_table, which requires plain ASCII: macOS
# awk's length() counts BYTES, not characters, so one multi-byte character
# over-pads its column and skews the whole table. Order matters - squeeze
# \t, \n, \r to spaces FIRST, because a surviving tab or newline does not
# merely skew a column, it splits the row into phantom ones. Then drop
# everything outside \40-\176, collapse runs of spaces, trim, and truncate
# to width with a trailing ".." so a cut title never reads as the whole one.
cell() {                                # text width -> ASCII-safe, truncated
  local text=$1 width=$2 out
  out=$(tr '\t\n\r' '   ' <<<"$text" | tr -cd '\40-\176' | tr -s ' ')
  out=$(sed -e 's/^ *//' -e 's/ *$//' <<<"$out")
  [ "${#out}" -gt "$width" ] && out="${out:0:$(( width - 2 ))}.."
  printf '%s' "$out"
}

# One page of `recent_plans`, as a table numbered ABSOLUTELY: row 11 is the
# eleventh-newest plan whichever page it happens to be shown on. That is what
# keeps `sed -n "${ans}p"` below a direct index into the full list, with no
# per-page arithmetic to get wrong, and what makes a number mean one fixed plan
# rather than "the third one I can currently see".
pick_page() {                           # rows lo hi out_tsv
  local lo=$2 hi=$3 out=$4 n=0 epoch path title
  printf '#\tAGE\tPLAN\tSUMMARY\n' > "$out"
  while IFS=$'\t' read -r epoch path; do
    [ -n "$path" ] || continue
    n=$((n + 1))
    [ "$n" -lt "$lo" ] && continue
    [ "$n" -gt "$hi" ] && break
    title=$(plan_title "$path")
    printf '%s\t%s\t%s\t%s\n' "$n" "$(age_since "$epoch")" \
      "$(cell "$(basename "$path" .md)" 30)" "$(cell "$title" 60)" >> "$out"
  done <<<"$1"
  # A `while read` loop returns whatever its body last ran, and this body can
  # end on a short-circuited test - so a perfectly good page would otherwise
  # report failure. Exit codes carry meaning in this file (see pick_plan's own
  # contract below); say the happy path out loud.
  return 0
}

# Exit codes carry meaning, the way reap_task's already do: 0 chose one (its
# path on stdout), 1 declined/`q`/EOF, 2 nothing in $PLANS_DIR to pick from -
# the caller falls through to the existing "none found" error on that one.
# Everything a human reads goes to stderr: pick_plan is consumed by a command
# substitution, and any leakage on stdout would silently corrupt $plan, the
# `source:` header, and the staged plan.md.
#
# $PLANS_DIR is every plan ever written, so this shows PQ_PICK_LIMIT of them at
# a time - the newest page answers it most days - and `n`/`p` walk back through
# the rest. Paging beats simply raising the limit because the plans you want
# are named by the prompt that started their session
# ("floofy-hugging-dragonfly.md"), so digging back is reading titles, not
# recalling a filename, and a hundred-row table is not a thing you read.
pick_plan() {
  local rows total
  rows=$(recent_plans)
  [ -n "$rows" ] || return 2
  total=$(wc -l <<<"$rows" | tr -d ' ')

  # `lo`, the 1-based index of the page's first row, is the whole of the paging
  # state - the stride cannot change mid-picker, so every other bound is
  # arithmetic on it. It survives a declined preview, which is what returns you
  # to the page you were reading rather than to the top.
  local per=$PQ_PICK_LIMIT lo=1 hi pages
  pages=$(( (total + per - 1) / per ))

  local tbl="$PQ_HOME/.pick.$$.tsv"
  local ans row sel_path total_lines ans2 rule
  rule=$(printf -- '─%.0s' $(seq 1 60))
  while :; do
    hi=$(( lo + per - 1 )); [ "$hi" -gt "$total" ] && hi=$total
    pick_page "$rows" "$lo" "$hi" "$tbl"

    if [ "$pages" -gt 1 ]; then
      msg "$lo-$hi of $total (page $(( (lo - 1) / per + 1 ))/$pages)"
    else
      msg "$total most recent of $total"
    fi
    printf '\n' >&2
    render_table "$tbl" >&2
    printf '\n' >&2
    # One page is the whole list, so there is nowhere to page to - don't offer
    # keys that can only answer "already at the oldest".
    if [ "$pages" -gt 1 ]; then
      printf 'pq: pick a plan [%s-%s, n older, p newer, Enter for %s, q to quit] ' "$lo" "$hi" "$lo" >&2
    else
      printf 'pq: pick a plan [1-%s, Enter for 1, q to quit] ' "$total" >&2
    fi
    read -r ans || { rm -f "$tbl"; return 1; }
    # The top of what you are looking at, which is row 1 on the first page -
    # so a plain `pq add`, Enter, still takes the newest plan.
    [ -z "$ans" ] && ans=$lo
    # `n` here is "next page, older"; `n` at the `use this plan? [y/N]` prompt
    # a few lines down is "no". Two prompts, two vocabularies - each one's own
    # hint says which is in force, and neither key is ever ambiguous within the
    # prompt that reads it.
    case "$ans" in
      q|Q) rm -f "$tbl"; return 1 ;;
      n|N) if [ "$hi" -lt "$total" ]; then lo=$(( lo + per )); else warn "already at the oldest"; fi
           continue ;;
      p|P) if [ "$lo" -gt 1 ]; then lo=$(( lo - per )); else warn "already at the newest"; fi
           continue ;;
    esac
    # Any listed plan, on this page or not: the numbering is absolute, so
    # rejecting a number that names a real plan just because it scrolled off
    # would be a lie about what that number means.
    #
    # Capped at 9 digits so a huge number never reaches the arithmetic tests
    # below: bash's [ -lt ]/[ -gt ] error out (a false "false") on an integer
    # past its native range, which would flip this whole OR-chain to skip the
    # reject instead of triggering it.
    if ! [[ "$ans" =~ ^[0-9]{1,9}$ ]] || [ "$ans" -lt 1 ] || [ "$ans" -gt "$total" ]; then
      warn "not a number from 1 to $total"
      continue
    fi

    row=$(sed -n "${ans}p" <<<"$rows")
    IFS=$'\t' read -r _ sel_path <<<"$row"

    total_lines=$(wc -l < "$sel_path" | tr -d ' ')
    printf '%s\n' "$rule" >&2
    head -n "$PQ_PICK_PREVIEW" "$sel_path" >&2
    printf '%s\n' "$rule" >&2
    [ "$total_lines" -gt "$PQ_PICK_PREVIEW" ] && msg "showing first $PQ_PICK_PREVIEW of $total_lines lines"

    printf 'pq: use this plan? [y/N] ' >&2
    read -r ans2 || { rm -f "$tbl"; return 1; }
    if [[ "$ans2" =~ ^[Yy]$ ]]; then
      rm -f "$tbl"
      printf '%s' "$sel_path"
      return 0
    fi
  done
}

# `after_vals` is cmd_add's own local, reached through bash's dynamic scope
# exactly as do_split reaches `plan`/`repo`/etc (pq's "add" header comment) -
# so, like add_wizard below, this function must NEVER declare `after_vals`
# `local`. A stray `local` here would shadow the caller's variable: every
# answer would appear to work and be silently discarded. Called as a bare
# statement for the same reason - `x=$(pick_after)` forks a subshell and
# throws the mutation away. Writes nothing to stdout; its prompts and table,
# like pick_plan's, go to stderr.
pick_after() {
  local d st slug branch repo n=0 full
  full="$PQ_HOME/.pickafter.$$.tsv"
  : > "$full"
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    st=$(state_of "$d")
    case "$st" in queue|hold|running) ;; *) continue ;; esac
    n=$((n + 1))
    slug=$(slug_of "$d"); branch=$(hdr "$d/plan.md" branch); repo=$(hdr "$d/plan.md" repo)
    printf '%s\t%s\t%s\t%s\t%s\n' "$n" "$st" "$slug" "${repo:--}" "${branch:--}" >> "$full"
  done <<<"$(all_tasks)"
  [ "$n" -gt 0 ] || { rm -f "$full"; return 0; }

  # A PROJECT column only once the candidates actually span more than one
  # repo - same rule and idiom cmd_ls uses. PROJECT is the only column here
  # that needs `cell`: slugs are [a-z0-9-], branches have passed
  # check-ref-format, and state names are literals, so those three are ASCII
  # by construction - a repo path is arbitrary and the one column where the
  # byte-counting skew documented on `cell` would actually land.
  local multi tbl i
  multi=$(cut -f4 "$full" | sort -u | awk 'END { print (NR > 1) }')
  tbl="$PQ_HOME/.pickafterdisp.$$.tsv"
  if [ "$multi" = 1 ]; then
    printf '#\tSTATE\tTASK\tPROJECT\tBRANCH\n' > "$tbl"
    while IFS=$'\t' read -r i st slug repo branch; do
      printf '%s\t%s\t%s\t%s\t%s\n' "$i" "$st" "$slug" "$(cell "$(basename "$repo")" 20)" "$branch" >> "$tbl"
    done < "$full"
  else
    printf '#\tSTATE\tTASK\tBRANCH\n' > "$tbl"
    awk -F'\t' '{ print $1"\t"$2"\t"$3"\t"$5 }' "$full" >> "$tbl"
  fi

  msg "$n tasks this could wait on"
  printf '\n' >&2
  render_table "$tbl" >&2
  printf '\n' >&2
  rm -f "$tbl"

  local ans norm entry bad valid
  while :; do
    printf 'pq: block on which? [1-%s, comma separated, Enter for none] ' "$n" >&2
    read -r ans || { rm -f "$full"; return 0; }
    [ -z "$ans" ] && { rm -f "$full"; return 0; }
    norm=$(tr ',' ' ' <<<"$ans")
    bad=0; valid=""
    # shellcheck disable=SC2086  # word-splitting $norm on whitespace is the point
    for entry in $norm; do
      if [[ "$entry" =~ ^[0-9]{1,9}$ ]] && [ "$entry" -ge 1 ] && [ "$entry" -le "$n" ]; then
        valid="$valid $entry"
      else
        bad=1; break
      fi
    done
    if [ "$bad" = 1 ] || [ -z "${valid// /}" ]; then
      warn "each entry must be a number from 1 to $n"
      continue
    fi
    break
  done

  local seen="" num s
  # shellcheck disable=SC2086  # word-splitting $valid on whitespace is the point
  for num in $valid; do
    s=$(awk -F'\t' -v i="$num" '$1 == i { print $3; exit }' "$full")
    case " $seen " in *" $s "*) continue ;; esac
    seen="$seen $s"
    after_vals="${after_vals}${s}"$'\n'
  done
  rm -f "$full"
}

# The two questions that shape how a task runs, asked right after pick_plan
# actually chose something - see cmd_add's `interactive` gate. `split` and
# `split_dir` are reached the same way `after_vals` is above, through bash's
# dynamic scope - do_split already relies on the identical mechanism (see the
# warning on cmd_add's own locals) - so this function must never declare
# `split`, `split_dir`, or `after_explicit` `local` either.
add_wizard() {
  if [ "$split" != 1 ] && [ -z "$split_dir" ]; then
    local ans
    printf 'pq: split into a stack of parts? [y/N] ' >&2
    read -r ans || ans=n
    [[ "${ans:-}" =~ ^[Yy]$ ]] && split=1
  fi
  [ "$after_explicit" = 1 ] || pick_after
}

cmd_add() {
  local plan="" branch="" model=$PQ_DEFAULT_MODEL effort=$PQ_DEFAULT_EFFORT
  local urgent=0 dev=false hold=0 repo="" repo_explicit=0 as_json=0
  # A string, not an array: an empty bash array expanded under `set -u` is a
  # portability trap (fixed only in bash 4.4+), so every repeatable option in
  # this script accumulates into a newline-joined string instead. See `repos`
  # in cmd_ls for the same idiom.
  local after_vals="" after_explicit=0
  # `repo` stays the FIRST value given, so every existing single-repo path is
  # untouched; `repo_vals` is the full repeatable set, read by do_split to
  # decide whether the scan still contributes (see the asymmetry documented
  # on do_split's own --repo handling).
  local repo_vals=""
  # `intent` moves above the parse loop so `--intent` can set it before the
  # naming step decides whether it still needs to ask Haiku. `split` and
  # `split_dir` MUST stay local here too: `do_split` recurses back into this
  # very function once per part, through bash's ordinary dynamic scope, and it
  # is these two `local`s - shadowing whatever the recursive call passed - that
  # stop that recursion rather than forking every part into its own split.
  # `interactive` is the same idea for add_wizard: it fires the wizard once,
  # never on the recursive calls do_split and split_queue make into cmd_add.
  local intent="" intent_explicit=0 split=0 split_dir="" yes=0 interactive=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --branch)    branch=${2:-}; shift 2 ;;
      --model)     model=${2:-}; shift 2 ;;
      --effort)    effort=${2:-}; shift 2 ;;
      --urgent)    urgent=1; shift ;;
      --repo)      repo_vals="${repo_vals}${2:-}"$'\n'; [ -n "$repo" ] || repo=${2:-}; repo_explicit=1; shift 2 ;;
      --after)     after_vals="${after_vals}${2:-}"$'\n'; after_explicit=1; shift 2 ;;
      --intent)    intent=${2:-}; intent_explicit=1; shift 2 ;;
      --split)     split=1; shift ;;
      --split-dir) split_dir=${2:-}; shift 2 ;;
      -y|--yes)    yes=1; shift ;;
      --dev)       dev=true; shift ;;
      --hold)      hold=1; shift ;;
      --json)      as_json=1; shift ;;
      -h|--help)   die "usage: pq add [plan.md] [--branch B] [--model M] [--effort E] [--urgent] [--repo PATH]... [--after task|branch]... [--intent TEXT] [--split | --split-dir DIR] [-y] [--dev] [--hold] [--json]" ;;
      -*)          die "unknown option '$1'" ;;
      *)           plan=$1; shift ;;
    esac
  done

  [ -n "$branch" ] && { [ "$split" = 1 ] || [ -n "$split_dir" ]; } && \
    die "--split queues N branches of its own - --branch has no meaning with it"
  [ -n "$plan" ] && [ -n "$split_dir" ] && \
    die "--split-dir carries its own source.md - don't also pass a plan file"
  [ "$split" = 1 ] && [ -n "$split_dir" ] && \
    die "--split and --split-dir are mutually exclusive - pick one"

  # A second --repo only means something when parts can land in different
  # repos - a plain add queues one task in one repo, so a repeated --repo
  # there is a mistake worth catching rather than silently taking the first.
  local repo_n=0 rv
  while IFS= read -r rv; do [ -n "$rv" ] || continue; repo_n=$((repo_n + 1)); done <<<"$repo_vals"
  [ "$repo_n" -gt 1 ] && [ "$split" != 1 ] && [ -z "$split_dir" ] && \
    die "--repo is repeatable only with --split or --split-dir - a plain add takes exactly one"

  if [ -n "$split_dir" ]; then
    [ -d "$split_dir" ] || die "no such split directory: $split_dir"
  else
    # The interactive picker fires only when nothing else already answered
    # "which plan": an explicit path still wins (so a plain `pq add plan.md`,
    # and every recursive cmd_add call do_split makes, never reach it), `-y`
    # already means "don't ask me" (and is now the only way to get today's
    # zero-prompt behaviour at a terminal), and no tty is what keeps
    # `a=$(pq add)` working in a script, a cron run, or an agent.
    if [ -z "$plan" ] && [ "$yes" != 1 ] && [ -t 0 ]; then
      local picked
      picked=$(pick_plan)
      case $? in
        0) plan=$picked; interactive=1 ;;
        1) die "no plan chosen" ;;
      esac                              # 2: nothing to pick, fall through
    fi
    [ -n "$plan" ] || plan=$(latest_plan)
    [ -n "$plan" ] || die "no plan given and none found in $PLANS_DIR"
    [ -f "$plan" ] || die "no such plan: $plan"
  fi

  # The repo is wherever you are standing when you add the plan - you planned the
  # work in it. Resolve to the MAIN checkout, so adding from inside a worktree
  # still queues against the repo the new worktree will be forked from.
  #
  # A failure to resolve is NOT fatal here: it only IS fatal for a plain add,
  # which genuinely needs one repo - a --split can still work if cwd is
  # itself a container of several checkouts rather than a repo, which is
  # exactly what do_split's own container-mode scan handles. Whether this is
  # a split may not be decided yet (the wizard below can still turn it into
  # one), so the die is deferred past the split gate rather than dropped.
  [ -n "$repo" ] || repo=$(git -C "$PWD" worktree list --porcelain 2>/dev/null | awk '/^worktree /{print substr($0,10); exit}')

  # The wizard runs only for a plan the picker actually chose, and must run
  # before the split gate below, so $split is decided before do_split would
  # need it.
  [ "$interactive" = 1 ] && add_wizard

  # The --branch/--split guard above ran before the wizard could have set
  # split=1 by answering its own question - re-check the same rule now that
  # the wizard has had its say, or "split into a stack of parts? y" would
  # silently drop an explicit --branch instead of refusing it.
  [ -n "$branch" ] && [ "$split" = 1 ] && \
    die "--split queues N branches of its own - --branch has no meaning with it"

  # Same reasoning, same fix: a repeatable --repo given alongside a plan the
  # picker chose interactively must not be rejected just because the wizard
  # hadn't yet answered "split into a stack of parts?" when the first check
  # ran - $repo_n itself does not change, only $split does.
  [ "$repo_n" -gt 1 ] && [ "$split" != 1 ] && [ -z "$split_dir" ] && \
    die "--repo is repeatable only with --split or --split-dir - a plain add takes exactly one"

  if [ -n "$split_dir" ] || [ "$split" = 1 ]; then
    # cwd not being a repo is do_split's problem now, not ours - it either
    # resolves a container path (see repo_candidates_container) or dies with
    # a more specific message than we could give here.
    [ -n "$repo" ] || repo=$PWD
    do_split
    return $?
  fi

  [ -n "$repo" ] || die "not inside a git repo - run this from the project, or pass --repo"

  msg "plan:   $plan"

  # Reject a name we cannot use BEFORE paying for the model call. When --branch was
  # given we already know the name, so the cheap checks come first and a duplicate
  # add fails in milliseconds instead of after a round trip to Haiku. Without it we
  # have no choice: the name is what we are asking for.
  #
  # Both branches skip the naming call once `--intent` was explicitly given -
  # a part queued from `do_split` supplies both --branch and --intent, and
  # every part in a split paying for Haiku a second time here would double
  # the naming cost for nothing. Gated on `intent_explicit`, not merely on
  # `intent` being non-empty: a part whose own intent from the model came
  # back genuinely empty must not read as "not given yet" and re-ask.
  local named why
  if [ -n "$branch" ]; then
    git check-ref-format "refs/heads/$branch" || die "invalid branch name: '$branch'"
    why=$(branch_taken "$branch" "$repo") && die "branch '$branch' is already $why"
    if [ "$intent_explicit" != 1 ]; then
      named=$(name_plan "$plan"); [ -n "$named" ] && intent=$(cut -f2 <<<"$named")
    fi
  else
    named=$(name_plan "$plan")
    if [ -n "$named" ]; then
      branch=$(cut -f1 <<<"$named")
      [ "$intent_explicit" = 1 ] || intent=$(cut -f2 <<<"$named")
    fi
    [ -n "$branch" ] || die "could not derive a branch name from the plan - pass --branch"
    git check-ref-format "refs/heads/$branch" || die "invalid branch name: '$branch'"
    why=$(branch_taken "$branch" "$repo") && die "branch '$branch' is already $why"
  fi

  local slug; slug=$(branch_to_slug "$branch")
  [ -n "$slug" ] || die "branch '$branch' does not reduce to a usable name"

  # Resolve every --after value to a (label, repo, branch) triple NOW, before
  # anything is written - a bad blocker should fail the whole add, not leave a
  # task queued with only some of what it was told to wait on. Self-reference
  # and cycles are rejected here for the same reason `find_task` resolves the
  # slug side of it: adding is the one place a mistake is cheap to catch.
  local after_lines="" av label arepo abranch resolved
  while IFS= read -r av; do
    [ -n "$av" ] || continue
    resolved=$(resolve_after "$repo" "$av") || die "could not resolve '$av' to a task or branch"
    IFS=$'\t' read -r label arepo abranch <<<"$resolved"
    [ -n "$arepo" ] && [ -n "$abranch" ] || die "could not resolve '$av' to a repo and branch"
    [ "$arepo" = "$repo" ] && [ "$abranch" = "$branch" ] && die "a task cannot block on itself"
    after_cycle "$repo" "$branch" "$arepo" "$abranch" \
      && die "'$av' would create a cycle - $branch already leads back to it"
    # The explicit $'\n' matters: command substitution strips ALL trailing
    # newlines, so without it a single-blocker add would write an `after` file
    # with none - and `while read` silently skips a final line that has no
    # trailing newline, so after_state would read the file as empty and the
    # blocker would never gate anything.
    after_lines="${after_lines}$(printf '%s\t%s\t%s' "$label" "$arepo" "$abranch")"$'\n'
  done <<<"$after_vals"

  local state=queue; [ "$hold" = 1 ] && state=hold
  # Allocated here, immediately before the directory is built - not earlier,
  # alongside the rest of the parse - so a `--split` that pays for a Haiku
  # naming round trip between the two points records a stamp for when the
  # task actually landed, not for when the command started.
  local stamp; stamp=$(next_stamp "$urgent")
  local dir="$PQ_HOME/$state/$(task_name "$stamp" "$slug")"
  [ -e "$dir" ] && die "a task already exists at $state/$(basename "$dir")"
  local taken_in; taken_in=$(slug_taken_in "$slug") && die "a task named '$slug' already exists in $taken_in/"

  # Build the task somewhere the queue cannot see, then move it into place. A task
  # directory with no plan.md would be listed by `pq ls` as a blank row, matched by
  # `find_task`, and - once tick exists - iterated unattended with an empty `repo`,
  # which is a `cd ""` into the wrong place. Assembling out of sight means a failed
  # or interrupted add leaves nothing behind rather than something half-formed.
  PQ_STAGING="$PQ_HOME/.add.$$"
  rm -rf "$PQ_STAGING"; mkdir -p "$PQ_STAGING" || die "could not create $PQ_STAGING"
  trap 'rm -rf "$PQ_STAGING"' EXIT
  # COPY, never move: ~/.claude/plans is Claude Code's directory and it prunes it,
  # so the original is not ours to consume. `source` keeps the trail back.
  {
    printf -- '---\n'
    printf 'repo:     %s\n'   "$repo"
    printf 'branch:   %s\n'   "$branch"
    printf 'model:    %s\n'   "$model"
    printf 'effort:   %s\n'   "$effort"
    printf 'dev:      %s\n'   "$dev"
    printf 'intent:   %s\n'   "${intent:-}"
    printf 'source:   %s\n'   "$plan"
    printf 'added:    %s\n'   "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    printf -- '---\n\n'
    cat "$plan"
  } > "$PQ_STAGING/plan.md" || die "could not write the task's plan.md"
  [ -s "$PQ_STAGING/plan.md" ] || die "wrote an empty plan.md - refusing to queue it"
  # Written to staging, not to $dir afterwards - the same reason plan.md is
  # built here: a task with a plan but no `after` is exactly the kind of
  # half-formed state this staging dance exists to rule out.
  [ -n "$after_lines" ] && printf '%s' "$after_lines" > "$PQ_STAGING/after"
  mv "$PQ_STAGING" "$dir" || die "could not move the new task into $state/"
  trap - EXIT

  msg "branch: $branch"
  [ -n "$intent" ] && msg "intent: $intent"
  msg "added:  $state/$(basename "$dir")  ($model, effort $effort, dev $dev)"

  if [ -n "$after_lines" ]; then
    pr_load_all "$(awk -F'\t' '{print $2"\t"$3}' <<<"$after_lines")"
    local base
    while IFS=$'\t' read -r label arepo abranch; do
      [ -n "$label" ] || continue
      base=$(repo_base "$arepo")
      if [ -n "$base" ] && pr_merged_into "$arepo" "$abranch" "$base"; then
        msg "after $label: already merged into $base - nothing to wait for"
      else
        msg "after $label ($abranch)"
      fi
    done <<<"$after_lines"
    # NOT cleaned up here: --json below still needs this same PR_CACHE/PR_ANS
    # for after_json to report each blocker's state, rather than reading an
    # already-deleted cache and calling everything "unknown" right after this
    # loop just said "already merged" from the live one.
  fi

  # The slug on stdout is the handle chaining needs - it is what makes
  # `b=$(pq add planB.md --after "$a")` possible at all, and pq's own
  # convention is that stdout stays machine-readable while everything a human
  # reads goes to stderr, which is why this is additive rather than a change.
  if [ "$as_json" = 1 ]; then
    jq -nc --arg task "$slug" --arg state "$state" --arg branch "$branch" \
      --arg repo "$repo" --arg model "$model" --arg effort "$effort" --arg dev "$dev" \
      --arg intent "$intent" --arg dir "$dir" --argjson after "$(after_json "$dir")" \
      --arg stamp "$stamp" --argjson urgent "$([ "$urgent" = 1 ] && printf true || printf false)" '
      def str: if . == "" then null else . end;
      { task: $task, stamp: ($stamp|tonumber), urgent: $urgent, state: $state, dir: $dir,
        repo: $repo, branch: $branch, model: $model, effort: $effort,
        dev: ($dev == "true"), intent: ($intent|str), after: $after }'
  else
    printf '%s\n' "$slug"
  fi
  rm -f "$PR_CACHE" "$PR_ANS"
  repo_base_reset
}

# ── the repo inventory ───────────────────────────────────────────────────────
# Discovered, not declared: a plan already names the repositories or directories
# it touches, so the splitter only needs to know what is checked out and can
# work out the rest. Candidates default to the git checkouts sitting alongside
# the primary - siblings under its own parent directory - unless PQ_REPOS_DIR
# names a different scan root.
repo_candidates() {                     # primary_repo -> label<TAB>path, primary first, rest sorted by label
  local primary=$1 root entry label resolved
  root="${PQ_REPOS_DIR:-$(dirname "$primary")}"

  printf '%s\t%s\n' "$(basename "$primary")" "$primary"
  local seen_paths=$'\n'"$primary"$'\n' seen_labels=$'\n'"$(basename "$primary")"$'\n'

  # Each entry resolves to its MAIN checkout via the same `git worktree list
  # --porcelain` idiom cmd_add already uses on the primary (line ~751), so a
  # linked worktree collapses onto its parent instead of counting twice.
  local found=""
  for entry in "$root"/*/; do
    [ -d "$entry" ] || continue
    entry=${entry%/}
    case "$(basename "$entry")" in .*) continue ;; esac
    resolved=$(git -C "$entry" worktree list --porcelain 2>/dev/null \
                 | awk '/^worktree /{print substr($0,10); exit}')
    [ -n "$resolved" ] || continue                     # not a git repo at all
    case "$seen_paths" in *$'\n'"$resolved"$'\n'*) continue ;; esac
    label=$(basename "$resolved")
    case "$seen_labels" in *$'\n'"$label"$'\n'*) continue ;; esac
    seen_paths="$seen_paths$resolved"$'\n'
    seen_labels="$seen_labels$label"$'\n'
    found="$found$label"$'\t'"$resolved"$'\n'
  done
  [ -n "$found" ] || return 0
  # `found` already ends in `$'\n'` from the loop above, and `<<<` appends
  # its OWN trailing newline unconditionally - so the here-string doubles up
  # and `sort` sees one extra, empty final "line", which sorts to the front
  # (empty precedes everything) and would otherwise surface as a phantom
  # candidate. `sed` drops it the same way `cmd_ls`'s `multi` check does.
  found=$(sort -t$'\t' -k1,1 <<<"$found" | sed '/^$/d')

  # A silent truncation here would read as "the splitter considered
  # everything" when it did not - so past PQ_REPOS_MAX, name every repo dropped.
  local total; total=$(( $(grep -c . <<<"$found") + 1 ))
  if [ "$total" -gt "$PQ_REPOS_MAX" ]; then
    local keep=$(( PQ_REPOS_MAX - 1 )) dropped
    dropped=$(tail -n +"$(( keep + 1 ))" <<<"$found" | cut -f1 | tr '\n' ' ')
    found=$(head -n "$keep" <<<"$found")
    warn "found $total candidate repos, more than PQ_REPOS_MAX ($PQ_REPOS_MAX) - dropped: $dropped - pass --repo explicitly to include one of these"
  fi
  printf '%s' "$found"
}

# Same discovery, for a plan added from a directory that is NOT itself a git
# repo - a container holding several checkouts as peers (e.g. `~/projects`).
# There is no primary among them: nothing here is privileged as the default a
# part can land in without the plan saying so. Kept separate from
# repo_candidates rather than folded into one function with a mode flag: the
# two differ in scan root (a container scans itself, not its parent), in
# dedup seeding (no primary to seed against), and in truncation math (no
# primary consuming a slot) - similar shapes, different enough contracts that
# sharing one signature would need more branching than the duplication costs.
repo_candidates_container() {           # dir -> label<TAB>path, sorted by label
  local dir=$1 root entry label resolved
  root="${PQ_REPOS_DIR:-$dir}"

  local seen_paths=$'\n' seen_labels=$'\n'
  local found=""
  for entry in "$root"/*/; do
    [ -d "$entry" ] || continue
    entry=${entry%/}
    case "$(basename "$entry")" in .*) continue ;; esac
    resolved=$(git -C "$entry" worktree list --porcelain 2>/dev/null \
                 | awk '/^worktree /{print substr($0,10); exit}')
    [ -n "$resolved" ] || continue                     # not a git repo at all
    case "$seen_paths" in *$'\n'"$resolved"$'\n'*) continue ;; esac
    label=$(basename "$resolved")
    case "$seen_labels" in *$'\n'"$label"$'\n'*) continue ;; esac
    seen_paths="$seen_paths$resolved"$'\n'
    seen_labels="$seen_labels$label"$'\n'
    found="$found$label"$'\t'"$resolved"$'\n'
  done
  [ -n "$found" ] || return 0
  # Same here-string double-newline trap as repo_candidates above.
  found=$(sort -t$'\t' -k1,1 <<<"$found" | sed '/^$/d')

  local total; total=$(grep -c . <<<"$found")
  if [ "$total" -gt "$PQ_REPOS_MAX" ]; then
    local keep=$PQ_REPOS_MAX dropped
    dropped=$(tail -n +"$(( keep + 1 ))" <<<"$found" | cut -f1 | tr '\n' ' ')
    found=$(head -n "$keep" <<<"$found")
    warn "found $total candidate repos under $dir, more than PQ_REPOS_MAX ($PQ_REPOS_MAX) - dropped: $dropped - pass --repo explicitly to include one of these"
  fi
  printf '%s' "$found"
}

# ── splitting a plan ─────────────────────────────────────────────────────────
# `pq add --split` runs one Opus session that reads a whole-feature plan and
# writes one standalone plan per seam plus a dependency graph, then queues
# every part through the ordinary `cmd_add` path with its blockers wired -
# same header, same `branch_taken` guard, same staging dance, same `after`
# file a hand-typed add would get. The load-bearing constraint: parts wait for
# MERGES, never for branches - no part is ever built on a sibling's branch.
# `--after` handles that on the scheduling side; this section's validation is
# the other half, since it is what keeps the part text honest about it.
#
# `do_split` reads `cmd_add`'s locals through bash's dynamic scope (`plan`,
# `repo`, `repo_explicit`, `repo_vals`, `model`, `effort`, `dev`, `hold`, `urgent`,
# `after_vals`, `as_json`, `yes`, `split_dir`) and is only ever called from
# there - hence no arguments of its own.

# The prompt the splitter session is given, passed as an argv element (unlike
# `dispatch_prompt`, never typed into a pane's shell) so it has no quote
# restriction.
splitter_prompt() {                     # candidates: label<TAB>path, primary first (or an empty-label sentinel row when there is no primary - see do_split)
  local candidates=$1 repo_block example primary_label primary_path repo_sentence field_sentence row1
  row1=$(head -1 <<<"$candidates")
  # `cut`, not `read`: a sentinel row starts with a literal tab (empty
  # label), and bash's `read` treats a tab as "IFS whitespace" even when IFS
  # holds nothing else - it strips that LEADING tab before splitting, so
  # `IFS=$'\t' read` would shift the path into `primary_label` and leave
  # `primary_path` empty. `cut` never trims field boundaries, so it reads an
  # empty first field correctly.
  primary_label=$(cut -f1 <<<"$row1"); primary_path=$(cut -f2 <<<"$row1")
  # `$1 != ""` guards against a phantom trailing record: `candidates` can
  # itself end in `$'\n'` (the explicit multi-repo `--repo` path builds it
  # that way), and `<<<` appends its OWN newline unconditionally on top -
  # doubling up into one empty final "line" that would otherwise print as a
  # bare "- : " bullet in the prompt. It also naturally excludes the
  # no-primary sentinel row itself, which is not a repository to read from.
  repo_block=$(awk -F'\t' '$1 != "" { printf "- %s: %s\n", $1, $2 }' <<<"$candidates")

  if [ -n "$primary_label" ]; then
    repo_sentence="The primary is $primary_label ($primary_path). Use it unless source.md clearly places some of the work in one of the others - never assign a part to a repository the plan does not talk about."
    field_sentence="the label of the repository this part belongs to, EMPTY for the primary"
    example=$(printf '01-tip-fee-config.md\t\n02-tip-fee-ios.md\t01-tip-fee-config.md\tios\n03-tip-fee-android.md\t01-tip-fee-config.md\tandroid')
  else
    repo_sentence="There is no primary here - these repositories are peers, none of them a default. EVERY part must name which one it belongs to; never assign a part to a repository the plan does not talk about."
    field_sentence="the label of the repository this part belongs to - REQUIRED, there is no primary to leave it empty for"
    example=$(printf '01-tip-fee-config.md\t\tconfig\n02-tip-fee-ios.md\t01-tip-fee-config.md\tios\n03-tip-fee-android.md\t01-tip-fee-config.md\tandroid')
  fi

  cat <<EOF
Read ./source.md - it is a plan for a whole feature. These repositories are checked out and readable, but never writable - read whatever you need from any of them to find the real seams in the plan:

$repo_block

$repo_sentence

Write into the current directory ONLY:
- One file per part: NN-short-slug.md, numbered in build order starting at 01, lowercase words separated by dashes.
- graph.tsv: one line per part, tab-separated - filename<TAB>comma-separated filenames of the parts that must have MERGED before this one can start<TAB>$field_sentence. Leave the second field empty for a part that can start now.

Field discipline matters here: a root part (no dependencies) still needs an EMPTY middle field even when it names a repository in the third - a model that writes filename<TAB>label instead is read as a dependency named "label", and the split dies on "unknown dependency" once this session has already been paid for. A worked example, two dependent parts and one without:

$example

How to choose the split:
- Each part is a pull request a human would enjoy reviewing: one coherent change, complete in itself.
- Each part must leave its own repository's default branch working and shippable once merged. No part may need a later part to compile, pass tests, or behave correctly. A feature flag defaulting off is fine; a half-migrated schema is not.
- A part belongs to exactly ONE repository, because a part is one pull request. Work that genuinely spans two repositories is two parts.
- Use as FEW parts as possible while that stays true, WITHIN each repository - two to six per repository is the usual answer, never more than twelve in total. If the plan is already one coherent shippable change, write a single part.
- Declare a dependency only where one really exists: an interface, schema, migration, or helper another part introduces, or two parts that would edit the same code and collide. This holds across repositories too - a client part that needs an endpoint, field, or flag a server part introduces depends on that server part. Parts with no real dependency must have none declared - that is what lets them run in parallel.
- Between the parts, cover ALL of source.md: do not drop scope, do not add scope, do not leave anything to "a follow-up".

How to write each part - it will be executed by an agent that sees ONLY that one file: it has never read source.md and cannot see any other part.
- Never mention another part, its filename, or its number, and never say "the previous plan". Where a part relies on earlier work, state it as a fact about the code it will find - e.g. "the mentions table already has a notified_at column" - never as a reference to another plan or file.
- Every part starts from its own repository's default branch with its declared dependencies already merged. Never tell a part to branch from, rebase onto, or cherry-pick another part's branch.
- Same shape as the plan you read: a Context section, the specific files to change, the existing functions and patterns to reuse, and a verification section. Real paths, confirmed to exist.
- Do not start a part's file with '---' - no YAML front matter.
EOF
}

# The `pq add --split-dir ...` line to hand back whenever a split stops short
# of queueing everything - declined, or a validation failure, or a part that
# failed to queue mid-pass. Carries every one of cmd_add's own locals that
# isn't already the tool's default, so following this line verbatim does not
# silently drop --model/--effort/--dev/--hold/--urgent/--after the way a
# bare `--split-dir DIR --repo REPO` would.
split_resume_hint() {                   # sd
  local hint="pq add --split-dir $1 --repo $repo" av
  [ "$model" = "$PQ_DEFAULT_MODEL" ]   || hint="$hint --model $model"
  [ "$effort" = "$PQ_DEFAULT_EFFORT" ] || hint="$hint --effort $effort"
  [ "$dev" = true ]      && hint="$hint --dev"
  [ "$hold" = 1 ]        && hint="$hint --hold"
  [ "$urgent" = 1 ]      && hint="$hint --urgent"
  while IFS= read -r av; do
    [ -n "$av" ] || continue
    hint="$hint --after $av"
  done <<<"$after_vals"
  printf '%s' "$hint"
}

# total_cost_usd duration_ms -> " (\$0.71, 2m48s)", or "" if neither is known.
fmt_cost() {                            # cost_usd duration_ms
  local cost=${1:-} dur=${2:-} out=""
  [ -n "$cost" ] && out="\$$(printf '%.2f' "$cost" 2>/dev/null || printf '%s' "$cost")"
  if [ -n "$dur" ]; then
    local secs=$(( dur / 1000 ))
    out="${out:+$out, }$(( secs / 60 ))m$(( secs % 60 ))s"
  fi
  [ -n "$out" ] && printf ' (%s)' "$out"
}

# The reason a branch or slug cannot be used for a new part, or nothing -
# `branch_taken` plus `slug_taken_in` (the same $STATES sweep `cmd_add` itself
# runs), plus a sibling already named earlier in THIS split.
#
# `part_repo` is an explicit argument rather than `$repo` off dynamic scope,
# so each part's `branch_taken` check runs against ITS OWN repo - a part
# assigned to a second repo claiming a branch already live in the primary
# must queue, not be refused. `slug_taken_in` stays global on purpose: a slug
# is a whole directory name, not a per-repo concept.
split_name_collision() {                # branch slug named_file part_repo
  local branch=$1 slug=$2 named_file=$3 part_repo=$4 why taken_in collider
  why=$(branch_taken "$branch" "$part_repo") && { printf '%s' "$why"; return; }
  taken_in=$(slug_taken_in "$slug") \
    && { printf "a task named '%s' already exists in %s/" "$slug" "$taken_in"; return; }
  collider=$(awk -F'\t' -v b="$branch" -v s="$slug" '$2 == b || $3 == s { print $1; exit }' \
               "$named_file" 2>/dev/null)
  [ -n "$collider" ] && printf 'the same branch or name as %s, already named earlier in this split' "$collider"
}

# Validate the parts and the graph, before any naming and before anything is
# queued. `awk` throughout, never `while read` - a model-written graph.tsv can
# arrive with no trailing tab and no final newline at all (verified against
# the real CLI), and `while read` silently drops a final line with no newline
# where `awk` reads it correctly - the same regression `after` already has a
# test for (test/pq-after.sh:242).
split_validate() {                      # sd -> dies on any violation
  local sd=$1
  local g="$sd/graph.tsv" n bad part mdfiles gnames extra missing dupes unknown selfdep hit

  [ -s "$g" ] || die "the splitter wrote no graph.tsv (or an empty one) - see $sd/splitter.err"

  n=$(awk -F'\t' '$1 != "" { c++ } END { print c + 0 }' "$g")
  [ "$n" -ge 1 ] && [ "$n" -le 12 ] || \
    die "graph.tsv names $n part(s) - must be 1-12; trim and re-run with: $(split_resume_hint "$sd")"

  bad=$(awk -F'\t' '$1 != "" && $1 !~ /^[0-9][0-9]-[a-z0-9-]+\.md$/ { print $1 }' "$g")
  [ -z "$bad" ] || die "graph.tsv names a badly-formed part filename: $(tr '\n' ' ' <<<"$bad")($sd)"

  while IFS= read -r part; do
    [ -n "$part" ] || continue
    [ -f "$sd/$part" ] || die "graph.tsv names $part, which does not exist in $sd"
    [ -s "$sd/$part" ] || die "$sd/$part is empty"
  done <<<"$(awk -F'\t' '$1 != "" { print $1 }' "$g")"

  # Bidirectionally complete: every *.md but source.md is in the graph exactly
  # once, and the graph names nothing else - a part file the graph forgot is
  # silent scope loss, which is the failure that costs a whole feature.
  #
  # Dupes MUST be checked before the `comm` pair below: `comm` walks two
  # SORTED streams in lockstep, so a name listed twice in graph.tsv but once
  # on disk exhausts mdfiles a line early and comm reports the second copy as
  # "file2-only" - misdiagnosing a duplicate as a missing file.
  mdfiles=$( (cd "$sd" && ls -- *.md 2>/dev/null) | grep -vx 'source.md' | sort)
  gnames=$(awk -F'\t' '$1 != "" { print $1 }' "$g" | sort)
  dupes=$(printf '%s\n' "$gnames" | uniq -d)
  [ -z "$dupes" ] || die "graph.tsv lists these parts more than once: $(tr '\n' ' ' <<<"$dupes") ($sd)"
  extra=$(comm -23 <(printf '%s\n' "$mdfiles") <(printf '%s\n' "$gnames") 2>/dev/null)
  [ -z "$extra" ] || die "these part files exist but graph.tsv never lists them: $(tr '\n' ' ' <<<"$extra") ($sd)"
  missing=$(comm -13 <(printf '%s\n' "$mdfiles") <(printf '%s\n' "$gnames") 2>/dev/null)
  [ -z "$missing" ] || die "graph.tsv names files that don't exist: $(tr '\n' ' ' <<<"$missing") ($sd)"

  unknown=$(awk -F'\t' '
    { names[NR] = $1; depsraw[NR] = $2; if ($1 != "") valid[$1] = 1 }
    END {
      for (i = 1; i <= NR; i++) {
        if (names[i] == "") continue
        d = split(depsraw[i], arr, ",")
        for (j = 1; j <= d; j++) {
          dep = arr[j]; gsub(/^[ \t]+|[ \t]+$/, "", dep)
          if (dep != "" && !(dep in valid)) print names[i] ": " dep
        }
      }
    }' "$g")
  [ -z "$unknown" ] || die "graph.tsv names a dependency that is not itself a listed part - $unknown ($sd)"

  selfdep=$(awk -F'\t' '
    $1 != "" {
      d = split($2, arr, ",")
      for (j = 1; j <= d; j++) {
        dep = arr[j]; gsub(/^[ \t]+|[ \t]+$/, "", dep)
        if (dep == $1) print $1
      }
    }' "$g")
  [ -z "$selfdep" ] || die "graph.tsv has a part depending on itself: $(tr '\n' ' ' <<<"$selfdep") ($sd)"

  # The third field: every non-empty one must be a label repo_candidates (or
  # an explicit --repo set) actually offered the splitter - a model does not
  # get to invent a repository. Classic two-file awk: $sd/repos read first
  # into a lookup, graph.tsv checked against it second.
  # A label is valid only with a non-empty path alongside it - a row like
  # "somelabel<TAB>" (a blank path, from a hand-edited file) must not read as
  # a real repository, or split_levels would resolve it to an empty string
  # and reintroduce the exact empty-middle-field hazard `deps` staying last
  # was written to avoid.
  local badrepo
  badrepo=$(awk -F'\t' '
    NR == FNR { if ($1 != "" && $2 != "") valid[$1] = 1; next }
    $1 != "" && $3 != "" && !($3 in valid) { print $1 ": " $3 }
  ' "$sd/repos" "$g")
  [ -z "$badrepo" ] || die "graph.tsv names a repository label that is not in $sd/repos - $badrepo ($sd)"

  # Row 1 of $sd/repos is either the primary (a real label) or a no-primary
  # sentinel do_split writes for a container split - empty label, the
  # container path alongside it (see do_split). A row with BOTH fields empty
  # is neither - a hand-edited file that lost its first line - and reading it
  # as "no primary" would let every part's empty third field slide by
  # unnoticed instead of dying here, where the mistake is easy to see.
  # `cut`, not `read`: a sentinel row starts with a literal tab (empty
  # label), and `read` strips a LEADING tab as "IFS whitespace" before
  # splitting even when IFS holds nothing else, which would shift the path
  # into row1_label and leave row1_path empty - the opposite of what this
  # check needs. `cut` never trims field boundaries.
  local row1 row1_label row1_path
  row1=$(head -1 "$sd/repos")
  row1_label=$(cut -f1 <<<"$row1"); row1_path=$(cut -f2 <<<"$row1")
  if [ -z "$row1_label" ]; then
    [ -n "$row1_path" ] || die "$sd/repos' first row is blank - it must be either the primary (label<TAB>path) or a no-primary sentinel (<TAB>container-path) ($sd)"
    local noassign
    noassign=$(awk -F'\t' '$1 != "" && $3 == "" { print $1 }' "$g")
    [ -z "$noassign" ] || die "graph.tsv leaves the repository field empty for $(tr '\n' ' ' <<<"$noassign") - there is no primary in this split, so every part must name one ($sd)"
  fi

  # Every path the graph actually USES (not every candidate offered - an
  # unrelated sibling costs nothing precisely because nothing ever checks it)
  # must still exist and be a git repo - $sd/repos is a plain hand-editable
  # TSV, and a part queued against a path that moved or was never a repo
  # would fail unattended, far from where the mistake was made.
  local usedpaths up
  usedpaths=$(awk -F'\t' '
    NR == FNR { path[$1] = $2; if (NR == 1) primary = $2; next }
    $1 != "" { r = ($3 == "" ? primary : path[$3]); if (r != "") seen[r] = 1 }
    END { for (p in seen) print p }
  ' "$sd/repos" "$g")
  while IFS= read -r up; do
    [ -n "$up" ] || continue
    [ -d "$up" ] || die "$sd/repos names $up, which no longer exists ($sd)"
    git -C "$up" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
      || die "$sd/repos names $up, which is not a git repository ($sd)"
  done <<<"$usedpaths"

  while IFS= read -r part; do
    [ -n "$part" ] || continue
    [ "$(head -1 "$sd/$part")" != "---" ] || \
      die "$part starts with '---' - that fence is reserved for cmd_add's own header ($sd)"
    # Anchored to EXACTLY two leading digits so a real repo path like
    # db/migrate/20260728141230-add-columns.md cannot trip it - an
    # implementer only ever sees its own plan.md, so a cross-reference is an
    # instruction it cannot follow, and that anchoring is what makes this
    # safe to be a hard error rather than a warning.
    hit=$(grep -nE '(^|[^0-9])[0-9][0-9]-[a-z0-9-]+\.md' "$sd/$part" 2>/dev/null || true)
    [ -z "$hit" ] || die "$part references another part by filename - an implementer never sees a sibling: $hit"
  done <<<"$(awk -F'\t' '$1 != "" { print $1 }' "$g")"
}

# level<TAB>part<TAB>repo(path)<TAB>label<TAB>deps, sorted by level then part
# name - sorting by level IS a valid topological order, since every part
# outranks each of its dependencies. `tsort` is not usable here: on this
# machine it prints "tsort: cycle in data" and still exits 0, so it cannot
# report a cycle - iterative relaxation gives the wave number and the cycle
# check together.
#
# `label` is graph.tsv's own third field verbatim (or the primary's own
# label when that field is empty) - never recomputed as `basename(repo)`,
# which would show the wrong name the moment `$sd/repos` gives a repo a
# label that differs from its directory's basename (a hand-edited file is a
# first-class input, same as graph.tsv itself).
#
# `deps` stays LAST: it is the only field that can be empty (a root part),
# and every consumer reads a row with `IFS=$'\t' read` - bash treats a tab as
# "IFS whitespace" even when IFS holds nothing else, so a run of TWO adjacent
# tabs (an empty field with non-empty neighbours on both sides) collapses to
# one delimiter and silently shifts every field after it left. `repo` and
# `label` are never empty (they resolve to the primary at worst - or, when
# there is no primary, `split_validate` has already died on any part whose
# third field was empty, so `path[$3]`/`$3` are the only branches a
# no-primary split ever actually takes here), so putting them third and
# fourth and leaving `deps` trailing keeps every row `read`-safe.
#
# NEVER calls `die`: the caller reaches this through `leveled=$(split_levels
# ...)`, which forks a subshell, and an `exit` in there would kill only that
# subshell and let the split limp on none the wiser. A cycle is reported on
# stdout instead, with a non-zero return, for `do_split` - which is not
# subshelled - to `die` on.
split_levels() {                        # sd -> prints level<TAB>part<TAB>repo(path)<TAB>label<TAB>deps, or "CYCLE ..." + return 1
  local sd=$1
  local g="$sd/graph.tsv" n out
  n=$(awk -F'\t' '$1 != "" { c++ } END { print c + 0 }' "$g")
  # Two files, classic NR==FNR split: $sd/repos loads the label -> path map
  # (and the primary, its first row) before graph.tsv's third field is
  # resolved against it - an empty third field becomes the primary.
  out=$(awk -F'\t' -v n="$n" '
    NR == FNR { path[$1] = $2; if (FNR == 1) { primary = $2; primlabel = $1 } next }
    $1 != "" {
      name[NR] = $1; deps[NR] = $2; level[$1] = 1
      repo[$1] = ($3 == "" ? primary : path[$3])
      lbl[$1]  = ($3 == "" ? primlabel : $3)
    }
    END {
      changed = 1
      for (pass = 1; pass <= n && changed; pass++) {
        changed = 0
        for (i = 1; i <= NR; i++) {
          if (name[i] == "") continue
          d = split(deps[i], arr, ",")
          for (j = 1; j <= d; j++) {
            dep = arr[j]; gsub(/^[ \t]+|[ \t]+$/, "", dep)
            if (dep == "") continue
            want = level[dep] + 1
            if (want > level[name[i]]) { level[name[i]] = want; changed = 1 }
          }
        }
      }
      if (changed) {
        cyc = ""
        for (i = 1; i <= NR; i++) if (name[i] != "" && level[name[i]] > n) cyc = cyc " " name[i]
        print "CYCLE" cyc
        exit
      }
      for (i = 1; i <= NR; i++) {
        if (name[i] == "") continue
        # Rebuilt trimmed and re-joined, not the raw field: a splitter that
        # writes "a.md, b.md" (a space after the comma - the prompt only
        # says "comma-separated", never "no spaces") must not leak that
        # space into the printed deps column, since split_queue splits this
        # same field on "," and looks each piece up verbatim.
        d = split(deps[i], arr, ",")
        clean = ""
        for (j = 1; j <= d; j++) {
          dep = arr[j]; gsub(/^[ \t]+|[ \t]+$/, "", dep)
          if (dep == "") continue
          clean = (clean == "" ? dep : clean "," dep)
        }
        printf "%d\t%s\t%s\t%s\t%s\n", level[name[i]], name[i], repo[name[i]], lbl[name[i]], clean
      }
    }' "$sd/repos" "$g")
  case "$out" in
    CYCLE*) printf '%s' "$out"; return 1 ;;
  esac
  sort -k1,1n -k2,2 <<<"$out"
}

# Name every part, in topological (level) order, collecting part<TAB>branch
# <TAB>slug<TAB>intent into $sd/.named.tsv. Serial and slow on purpose - one
# Haiku round trip per part, plus `branch_taken`'s bounded `ls-remote` per
# branch, adds roughly 15-30s for a six-part split. That is the intended
# cost: the `ls-remote` is what catches a branch pushed from another machine,
# and skipping it to save the round trips would only move that failure to
# `wt new` at 2am, where it silently adopts the existing branch instead.
#
# A collision - with git, with a live task, or with a sibling already named
# in this pass - gets one retry with an avoid list; a second is a hard error
# naming both parts, with nothing queued. A part that yields no name at all
# is also a hard error: `cmd_add`'s "pass --branch" advice has no meaning
# inside a split.
split_name_parts() {                    # sd leveled_tsv multi
  local sd=$1 leveled=$2 multi=$3
  local named_file="$sd/.named.tsv"
  : > "$named_file"
  local level part repopath label deps named branch intent slug reason avoid try
  while IFS=$'\t' read -r level part repopath label deps; do
    [ -n "$part" ] || continue
    avoid=""
    for try in 1 2; do
      if [ "$multi" = 1 ]; then
        named=$(name_plan "$sd/$part" "$avoid" "$label")
      else
        named=$(name_plan "$sd/$part" "$avoid")
      fi
      [ -n "$named" ] || die "$part: could not derive a branch name and intent - naming failed"
      IFS=$'\t' read -r branch intent <<<"$named"
      [ -n "$branch" ] || die "$part: could not derive a branch name - naming failed"
      git check-ref-format "refs/heads/$branch" || die "$part: invalid branch name '$branch'"
      slug=$(branch_to_slug "$branch")
      [ -n "$slug" ] || die "$part: branch '$branch' does not reduce to a usable name"

      reason=$(split_name_collision "$branch" "$slug" "$named_file" "$repopath")
      if [ -z "$reason" ]; then
        printf '%s\t%s\t%s\t%s\n' "$part" "$branch" "$slug" "$intent" >> "$named_file"
        break
      fi
      if [ "$try" = 2 ]; then
        die "$part: branch '$branch' collides - $reason - retried once, still colliding; nothing queued"
      fi
      warn "$part: branch '$branch' collides - $reason - retrying with an avoid-list"
      avoid="${avoid:+$avoid,}$branch"
    done
  done <<<"$leveled"
}

# Shown before anything is queued, then "[y/N]" unless `-y`. Built as a TSV
# and passed to the existing `render_table`, so columns pad to their widest
# cell like `pq ls` and `wt ls` - every cell but REPO is ASCII by construction
# (the filename charset check and `check-ref-format`), which `render_table`
# requires, since macOS `awk`'s `length()` counts bytes - REPO alone goes
# through `cell()`.
#
# All of it goes to stderr: `pq add --split`'s stdout contract is the slugs
# (or, with --json, the JSON array), the same as an ordinary `pq add`'s
# stdout is just the slug - a caller piping this for a slug list must never
# see the table.
split_confirm() {                       # sd leveled_tsv named_file cost_str multi -> 0 confirmed, 1 declined
  local sd=$1 leveled=$2 named_file=$3 cost_str=${4:-} multi=${5:-0}
  local tbl="$PQ_HOME/.splitconfirm.$$"
  # A REPO column, but only once the parts actually span more than one -
  # same rule and idiom cmd_ls and pick_after use for their own PROJECT
  # column. It is the only cell here that needs `cell()`: part filenames and
  # branches are ASCII by construction, a repo LABEL might not be.
  if [ "$multi" = 1 ]; then
    printf 'PART\tWAVE\tREPO\tBRANCH\tAFTER\n' > "$tbl"
  else
    printf 'PART\tWAVE\tBRANCH\tAFTER\n' > "$tbl"
  fi
  local level part repopath label deps branch after_disp nparts nwaves ans
  while IFS=$'\t' read -r level part repopath label deps; do
    [ -n "$part" ] || continue
    branch=$(awk -F'\t' -v p="$part" '$1 == p { print $2; exit }' "$named_file")
    after_disp="-"
    [ -n "$deps" ] && after_disp=${deps//,/, }
    if [ "$multi" = 1 ]; then
      printf '%s\t%s\t%s\t%s\t%s\n' "$part" "$level" "$(cell "$label" 20)" "$branch" "$after_disp" >> "$tbl"
    else
      printf '%s\t%s\t%s\t%s\n' "$part" "$level" "$branch" "$after_disp" >> "$tbl"
    fi
  done <<<"$leveled"

  nparts=$(( $(wc -l < "$tbl" | tr -d ' ') - 1 ))
  nwaves=$(awk -F'\t' 'NR > 1 && $2 + 0 > max { max = $2 + 0 } END { print max + 0 }' "$tbl")

  msg "split $(basename "$sd") into $nparts parts, $nwaves waves$cost_str"
  printf '\n' >&2
  render_table "$tbl" >&2
  printf '\n' >&2
  rm -f "$tbl"

  [ "$nwaves" -gt 1 ] && msg "wave 2 runs in parallel once wave 1 has merged"

  [ "$yes" = 1 ] && return 0
  printf 'pq: queue all %s? [y/N] ' "$nparts" >&2
  read -r ans || ans=n
  [[ "${ans:-}" =~ ^[Yy]$ ]]
}

# Pass 2: queue every part through the ordinary `cmd_add`, in topological
# order, each through a command substitution - which isolates `die` to that
# subshell, so one bad part stops the split without unwinding what already
# queued. Sequential by construction, which is what makes `cmd_add`'s shared
# `$PQ_HOME/.add.$$` staging path safe to reuse across the recursive calls:
# `$$` names the top-level process even inside a subshell, and never changes.
#
# `--after` on the split itself applies to ROOT parts only - the ones with no
# dependency inside the split. That is transitively correct: `cmd_after`'s
# existing "waiting on X of its own" branch already surfaces the rest of the
# chain to anyone asking why a downstream part hasn't started.
split_queue() {                         # sd leveled_tsv named_file
  local sd=$1 leveled=$2 named_file=$3
  local slugmap="$PQ_HOME/.splitslugs.$$"; : > "$slugmap"
  local objects="$PQ_HOME/.splitjson.$$"; : > "$objects"
  local devflag=""; [ "$dev" = true ] && devflag=--dev
  local holdflag=""; [ "$hold" = 1 ] && holdflag=--hold
  local urgentflag=""; [ "$urgent" = 1 ] && urgentflag=--urgent
  local n=0 total level part repopath label deps row branch intent afterflags dep depslug task out rc av

  # $leveled already has exactly one line per part - no need to touch
  # graph.tsv again for a count already sitting in an argument this function
  # was handed.
  total=$(wc -l <<<"$leveled" | tr -d ' ')

  while IFS=$'\t' read -r level part repopath label deps; do
    [ -n "$part" ] || continue
    n=$((n + 1))
    row=$(awk -F'\t' -v p="$part" '$1 == p { print; exit }' "$named_file")
    IFS=$'\t' read -r _ branch _ intent <<<"$row"

    # Each part's own dependencies resolve to slugs recorded in EARLIER
    # iterations of this same loop - guaranteed to exist because the leveled
    # order is a valid topological order. A root part (no deps) instead gets
    # the split-level --after values, resolved by the recursive cmd_add call
    # exactly like any other --after.
    afterflags=""
    if [ -n "$deps" ]; then
      while IFS= read -r dep; do
        [ -n "$dep" ] || continue
        depslug=$(awk -F'\t' -v p="$dep" '$1 == p { print $2; exit }' "$slugmap")
        [ -n "$depslug" ] || die "internal error: $part depends on $dep, which was not queued before it ($sd)"
        afterflags="$afterflags--after
$depslug
"
      done <<<"$(tr ',' '\n' <<<"$deps")"
    else
      while IFS= read -r av; do
        [ -n "$av" ] || continue
        afterflags="$afterflags--after
$av
"
      done <<<"$after_vals"
    fi

    # Parts ascend: each recursive `cmd_add` allocates through `next_stamp`,
    # which is strictly greater than everything already queued, so the
    # topological walk order (level-then-part, pq:1364) is preserved by the
    # allocator's contract rather than by arithmetic in this function.
    #
    # This is load-bearing in a way worth spelling out. `next_stamp` is
    # stateless between calls, and this function invokes `cmd_add` inside
    # `$( )`, so every part allocates in its own subshell with nothing carried
    # over in a variable. Monotonicity survives only because the previous
    # part's directory has already been `mv`'d into place by the time the
    # next part scans `all_tasks`. The sequential-by-construction property
    # documented above ("Pass 2", pq:1552) is therefore now load-bearing for
    # ordering as well as for the shared `$PQ_HOME/.add.$$` staging path.

    # shellcheck disable=SC2086  # devflag/holdflag/urgentflag/afterflags are
    # deliberately unquoted - see the identical idiom at pq:1573 for $devflag.
    # Each part's OWN repo, resolved by split_levels - never the shared
    # `$repo`, which is only ever the primary (or, in a no-primary container
    # split, not a repo at all).
    out=$(cmd_add "$sd/$part" --repo "$repopath" --branch "$branch" --intent "$intent" \
            --model "$model" --effort "$effort" $devflag $holdflag \
            $urgentflag $afterflags --json)
    rc=$?
    if [ "$rc" != 0 ]; then
      [ "$n" -gt 1 ] && warn "already queued, untouched: $(cut -f2 "$slugmap" | tr '\n' ' ')"
      # Not a bare blind retry: re-running --split-dir re-names every part
      # from scratch, and a part already queued above could get renamed to a
      # DIFFERENT branch on that pass (branch_taken forces a retry once its
      # own name collides with the live task it just created) - so check
      # `pq ls` before trusting it did not duplicate what already queued.
      die "$part failed to queue ($n of $total) - finish the rest with: $(split_resume_hint "$sd")  (check pq ls first - re-naming could duplicate what's already queued)"
    fi

    task=$(jq -r '.task // empty' <<<"$out")
    [ -n "$task" ] || die "internal error: $part queued but returned no task slug ($sd)"
    printf '%s\t%s\n' "$part" "$task" >> "$slugmap"
    printf '%s\n' "$out" >> "$objects"
    [ "$as_json" = 1 ] || printf '%s\n' "$task"
  done <<<"$leveled"

  [ "$as_json" = 1 ] && jq -s '.' "$objects"
  rm -f "$slugmap" "$objects"
}

do_split() {
  local sd stamp stem cost_str="" candidates

  # How many --repo values THIS invocation gave, regardless of branch -
  # repeatable --repo is the escape hatch, not the normal path (Decisions),
  # so this is the one signal that the user - not merely the scan - is
  # declaring more than one repo is in play.
  local repo_n=0 rv
  while IFS= read -r rv; do [ -n "$rv" ] && repo_n=$((repo_n + 1)); done <<<"$repo_vals"

  if [ -n "$split_dir" ]; then
    sd=$split_dir
    [ -f "$sd/source.md" ] || die "$sd has no source.md - not a split directory"

    if [ -s "$sd/repos" ]; then
      candidates=$(cat "$sd/repos")
    else
      # Pre-multi-repo split directory: a single recorded repo is a
      # single-candidate inventory, so every split written before this
      # change still resumes.
      local legacy; legacy=$(cat "$sd/repo" 2>/dev/null)
      [ -n "$legacy" ] && candidates=$(printf '%s\t%s' "$(basename "$legacy")" "$legacy")
    fi
    [ -n "$candidates" ] || die "$sd has no repo or repos file - not a split directory"

    # `cut`, not `read`: a no-primary sentinel row starts with a literal tab
    # (empty label), and `read` strips a LEADING tab as "IFS whitespace"
    # before splitting even when IFS holds nothing else - it would shift the
    # container path into recorded_label and leave recorded_path empty,
    # misreading a container split as an ordinary one with a real primary.
    local row1 recorded_label recorded_path
    row1=$(head -1 <<<"$candidates")
    recorded_label=$(cut -f1 <<<"$row1"); recorded_path=$(cut -f2 <<<"$row1")
    if [ -n "$recorded_label" ]; then
      # `--repo` passed explicitly is how you say "yes, I mean it" - parts name
      # real files in a specific checkout, so re-running a stale split against
      # the wrong repo would queue parts describing files that do not exist,
      # and nothing downstream would catch it. Auto-resolved from cwd, a
      # mismatch is far more likely an accident: you are standing in the wrong
      # place, not choosing to override. Only the PRIMARY is ever compared
      # against cwd - the rest of a recorded multi-repo set is untouched.
      if [ -n "$recorded_path" ] && [ "$recorded_path" != "$repo" ] && [ "$repo_explicit" != 1 ]; then
        die "$sd was split against $recorded_path, not $repo - cd there, or pass --repo to confirm you mean it"
      fi

      # $sd/repos is authoritative on resume - it is not re-scanned or
      # re-collected from --repo, so a SECOND (or later) --repo here has no
      # effect beyond the first, which only ever overrides the primary.
      [ "$repo_n" -gt 1 ] && \
        warn "resuming ignores every --repo past the first - $sd/repos already fixes the rest of the set"

      local newlabel oldtail; newlabel=$(basename "$repo")
      oldtail=$(tail -n +2 <<<"$candidates")
      case $'\n'"$oldtail" in
        *$'\n'"$newlabel"$'\t'*)
          die "the overriding --repo's label ('$newlabel') collides with an already-recorded repo in $sd/repos - rename one, or edit the file directly" ;;
      esac
      candidates=$(printf '%s\t%s\n' "$newlabel" "$repo"; printf '%s' "$oldtail")
      printf '%s\n' "$candidates" > "$sd/repos"
    else
      # No-primary/container split (row 1 is the empty-label sentinel
      # do_split writes for one): there is no primary slot to compare cwd
      # against or override - $sd/repos is already the complete, fixed set
      # every part's label was validated against, so --repo has no effect
      # here beyond a warning.
      [ "$repo_n" -ge 1 ] && \
        warn "resuming a no-primary split - --repo has no effect here, $sd/repos already fixes the set; edit it directly to change which repositories are in play"
    fi
    msg "resuming split from $sd"
  else
    stem=$(basename "$plan"); stem=${stem%.md}
    stem=$(branch_to_slug "$stem")
    stamp=$(date -u '+%Y%m%d-%H%M%S')
    # $$ as well as the timestamp: the stamp alone is only second-granularity,
    # and two `--split`s of the same plan stem within one second would
    # otherwise collide on the same directory - `mkdir -p` would not even
    # fail, it would just let a second Opus session write into the first
    # one's files mid-flight. $$ is unique per process, so this rules that
    # out the same way the staging path elsewhere in this file does.
    sd="$PQ_HOME/splits/${stem}-${stamp}-$$"
    mkdir -p "$sd" || die "could not create $sd"
    # COPY, never move - same reason cmd_add copies rather than moves out of
    # $PLANS_DIR: it is Claude Code's directory and it prunes it.
    cp "$plan" "$sd/source.md" || die "could not copy the plan into $sd"

    # Repeatable --repo is the escape hatch, not the normal path: a single
    # --repo is how you fix a wrong cwd, and it must not silently turn
    # multi-repo splitting off - the scan still contributes unless TWO OR
    # MORE were given, in which case the set is exactly those.
    if [ "$repo_n" -ge 2 ]; then
      candidates=""
      while IFS= read -r rv; do
        [ -n "$rv" ] || continue
        case $'\n'"$candidates" in *$'\n'"$(basename "$rv")"$'\t'*)
          die "--repo '$rv' and another --repo share the label '$(basename "$rv")' - the splitter cannot tell them apart" ;;
        esac
        candidates="${candidates}$(basename "$rv")"$'\t'"$rv"$'\n'
      done <<<"$repo_vals"
    elif git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      candidates=$(repo_candidates "$repo")
    else
      # $repo is not itself a git repo - a container directory holding
      # several checkouts as peers (cmd_add sets it to $PWD for exactly this
      # case when cwd isn't a repo, or an explicit --repo named the
      # container directly). Scan ITS OWN children rather than a parent's,
      # and record NO primary: row 1 of $sd/repos becomes a sentinel - an
      # empty label alongside the container path - so every consumer
      # downstream (splitter_prompt, split_validate, the resume branch
      # above) can tell a container split apart from an ordinary one with
      # one cheap check: is row 1's label empty?
      [ -d "$repo" ] || die "no such directory: $repo"
      local containerset containerpath
      containerset=$(repo_candidates_container "$repo")
      [ -n "$containerset" ] || \
        die "$repo is not a git repository and has no git repositories under it - pass --repo to name one explicitly"
      # Resolved the same way every child is (git-worktree resolution is a
      # no-op outside a repo, so `cd && pwd -P` is the equivalent for a plain
      # directory) - nothing compares this path against anything today, but
      # $sd/repos is hand-editable, and an unresolved row 1 next to resolved
      # children is exactly the macOS /var-vs-/private/var mismatch waiting
      # for whoever adds that comparison next.
      containerpath=$(cd "$repo" && pwd -P)
      candidates=$(printf '\t%s\n' "$containerpath"; printf '%s' "$containerset")
    fi
    printf '%s\n' "$candidates" > "$sd/repos"
  fi

  # A raw branch is ambiguous once there is no privileged default it could
  # resolve against - it resolves against the OWNER's repo (resolve_after),
  # and for a root part that owner is now the part's own repo, not
  # necessarily a primary.
  #
  # Two DIFFERENT ways to reach that: an EXPLICIT --repo count of 2+
  # (Decisions' escape hatch), or a no-primary container split, where every
  # repo is a peer and a root part could land in ANY of them. Neither is
  # gated on how many candidates the scan happened to turn up: repo_candidates
  # scans the primary's own parent directory by default, which commonly holds
  # several unrelated checkouts, and an unrelated candidate is supposed to
  # cost nothing (Decisions) - it must not turn an ordinary single-repo
  # `--split --after some/branch` into a hard refusal just because a sibling
  # happens to sit next to the primary. `no_primary` is read off the
  # FINALIZED $candidates (row 1's label), after both the resume and fresh
  # branches above have converged on one - the one point where either path's
  # sentinel row is already settled. The narrower, real danger - the
  # splitter actually assigning a root part elsewhere without the user
  # having asked for that - is the confirmation table's job to catch, same
  # as any other repo assignment a human, not validation, has to judge.
  # `cut`, not `read`: same leading-tab trap as everywhere else a sentinel
  # row's label needs checking - `read` would strip it and read the
  # container's PATH as a non-empty "label", hiding a no-primary split from
  # this exact check.
  local no_primary=0 primlbl
  primlbl=$(cut -f1 <<<"$(head -1 <<<"$candidates")")
  [ -n "$primlbl" ] || no_primary=1

  if [ "$repo_n" -ge 2 ] || [ "$no_primary" = 1 ]; then
    local av
    while IFS= read -r av; do
      [ -n "$av" ] || continue
      case "$av" in
        */*) die "--after '$av' is a raw branch - ambiguous across a multi-repo split, since it resolves against a repo this split hasn't assigned yet. Name a task slug instead (it carries its own repo), or queue without it and add the blocker afterwards with: pq after <part> $av" ;;
      esac
    done <<<"$after_vals"
  fi

  if [ -z "$split_dir" ]; then
    local rc is_error cost dur denials
    local statusdir="$PQ_HOME/.splitstatus.$$" lbl lpath
    # A real array, not the newline-joined-string idiom used for repeatable
    # CLI options elsewhere in this file: those values are all guaranteed
    # space-free by construction (branch names, digits, literal flags), but a
    # checkout's path is not, and unquoted word-splitting would cut a path
    # like "My Drive/supercast" in two. `candidates` always has at least one
    # real (non-sentinel) row - the primary, or a container split's first
    # discovered child - so this array is never empty - the bash-3.2
    # "unbound variable on an empty array" trap under `set -u` cannot bite
    # here.
    local add_dir_args=()
    mkdir -p "$statusdir"
    # Snapshotted before and after, for every candidate: `--tools` cannot
    # scope `Write` to one directory, and `--add-dir` grants the repo to
    # every allowed tool, so the prompt's instruction not to write there is
    # not a guarantee - this is the only net there is.
    while IFS=$'\t' read -r lbl lpath; do
      [ -n "$lbl" ] || continue
      git -C "$lpath" status --porcelain 2>/dev/null > "$statusdir/$lbl.before"
      add_dir_args+=(--add-dir "$lpath")
    done <<<"$candidates"

    msg "splitting $(basename "$plan") with $PQ_SPLITTER_MODEL - this takes a few minutes"
    ( cd "$sd" && claude -p --model "$PQ_SPLITTER_MODEL" --effort "$PQ_SPLITTER_EFFORT" \
        "${add_dir_args[@]}" --tools "Read,Grep,Glob,Write" \
        --permission-mode acceptEdits --output-format json "$(splitter_prompt "$candidates")" ) \
      < /dev/null > "$sd/splitter.json" 2> "$sd/splitter.err"
    rc=$?

    while IFS=$'\t' read -r lbl lpath; do
      [ -n "$lbl" ] || continue
      git -C "$lpath" status --porcelain 2>/dev/null > "$statusdir/$lbl.after"
      cmp -s "$statusdir/$lbl.before" "$statusdir/$lbl.after" \
        || warn "the splitter left $lpath dirty - it was only meant to read from it: $(tr '\n' ' ' < "$statusdir/$lbl.after")"
    done <<<"$candidates"
    rm -rf "$statusdir"

    is_error=$(jq -r '.is_error // empty'        "$sd/splitter.json" 2>/dev/null)
    cost=$(jq -r      '.total_cost_usd // empty' "$sd/splitter.json" 2>/dev/null)
    dur=$(jq -r       '.duration_ms // empty'    "$sd/splitter.json" 2>/dev/null)
    denials=$(jq -r   '.permission_denials // empty' "$sd/splitter.json" 2>/dev/null)
    [ -z "$denials" ] || [ "$denials" = "[]" ] || warn "the splitter reached for something denied: $denials"
    if [ "$rc" != 0 ] || [ "$is_error" = "true" ]; then
      die "the splitter session failed - see $sd/splitter.err and $sd/splitter.json"
    fi
    cost_str=$(fmt_cost "$cost" "$dur")
  fi

  split_validate "$sd"
  local leveled
  if ! leveled=$(split_levels "$sd"); then
    die "graph.tsv has a dependency cycle involving:${leveled#CYCLE} ($sd)"
  fi

  # Computed once, here, and threaded through both consumers below - the
  # repo hint only matters once a part could otherwise collide with the same
  # task words used for a sibling in another repo, so a single-repo split's
  # naming call stays byte-identical to today's, and the confirm table's
  # REPO column appears on the same condition.
  local multi; multi=$(cut -f3 <<<"$leveled" | sort -u | awk 'END { print (NR > 1) }')

  split_name_parts "$sd" "$leveled" "$multi"
  local named_file="$sd/.named.tsv"

  if ! split_confirm "$sd" "$leveled" "$named_file" "$cost_str" "$multi"; then
    msg "declined - nothing queued. Edit parts under $sd, then resume with: $(split_resume_hint "$sd")"
    return 0
  fi

  split_queue "$sd" "$leveled" "$named_file"
}

# ── pane state ──────────────────────────────────────────────────────────────
# "Is the agent still there" is three questions, not one, and answering it with
# `herdr agent list` collapses them: that call reports only panes it FOUND an agent
# in, so a missing pane could equally mean the workspace is gone, or that Claude
# exited cleanly and left a shell behind, or that the session is seconds old and its
# SessionStart hook has not reported yet. Deciding "this task is dead" on that is
# how a live task gets written off.
#
# `herdr api snapshot` lists every pane, with `agent` null on the ones holding no
# agent, so a single call separates all three:
#
#   pane absent from the snapshot   -> missing   the workspace itself is gone
#   pane present, agent null        -> noagent   Claude exited; a shell is sitting there
#   pane present, agent named       -> working | idle | blocked | unknown
#
PIDX=""; PIDX_OK=0
pidx_load() {
  local raw
  PIDX=""; PIDX_OK=0
  command -v herdr >/dev/null 2>&1 || return 0
  raw=$(herdr api snapshot 2>/dev/null) || return 0
  jq -e '.result.snapshot.panes' >/dev/null 2>&1 <<<"$raw" || return 0
  PIDX=$(jq -r '.result.snapshot.panes[]? | [.pane_id // "", (.agent // ""), (.agent_status // "")] | @tsv' \
    2>/dev/null <<<"$raw")
  PIDX_OK=1
}
# missing | noagent | working | idle | blocked | unknown. Empty when herdr never
# answered at all, so a stopped server reads as "no idea" rather than "all dead".
pane_state() {                          # pane_id
  [ "${PIDX_OK:-0}" = 1 ] || return 0
  [ -n "${1:-}" ] || { printf 'missing'; return; }
  awk -F'\t' -v p="$1" '
    $1 == p { print ($2 == "" ? "noagent" : ($3 == "" ? "unknown" : $3)); found = 1; exit }
    END { if (!found) print "missing" }' <<<"$PIDX"
}

# ── slots ───────────────────────────────────────────────────────────────────
# What the cap counts. The cap is a promise about how many AGENTS run at once,
# and for a long time it counted directories in `running/` instead - which is
# the same number only while "has a pull request" means "has stopped working".
# It does not. A Claude Code agent that opens a PR keeps going: it answers
# review, fixes CI, pushes again, and it never exits on its own. So reconcile
# would move a task to `done/` the moment its PR appeared, free the slot, and
# start a fourth agent while the third was still typing. Three tasks wrapping
# up in `done/` alongside three fresh ones in `running/` is six live agents at
# a cap of 3 - measured, not hypothetical.
#
# Reconcile is right and stays as it is: a PR in any state does mean the work
# left the queue, and a draft PR is what the stalled-chain verdict is built on
# (`blocker_state`). What was wrong is only the arithmetic, so only the
# arithmetic changes - `done/` tasks keep counting while their agent is still
# there.
#
# The release has to be a TIMER, not an exit. An agent that has genuinely
# finished sits `idle` forever rather than exiting, so counting `idle` with no
# deadline would not overshoot the cap - it would stall the queue permanently,
# which is worse. PQ_WRAPUP_GRACE is that deadline: once the agent has not been
# working for that long, the slot goes. `idle` is the state a finished agent
# actually rests in, so putting a deadline on that one is what rules out the
# stall.
#
# herdr's agent_status is one of exactly five words - idle, working, blocked,
# done, unknown - on top of the two pq derives from the snapshot itself:
#
#   working           holds it, and clears the clock - this is real work
#   blocked           holds it, and clears the clock. Same trade `running/`
#                     already makes: a permission prompt or a quota wall is an
#                     agent that will resume, not one that has finished. It is
#                     the one state besides `working` with no deadline, and
#                     `pq ls` reports a blocked done row as `blocked` rather
#                     than `wrapping up`, counting it into "needs you"
#   idle | done       holds it until the clock passes the grace, then releases.
#                     Both are per-TURN, not per-task: `done` means the agent
#                     finished the turn it was on, and one that opened a PR and
#                     then went back in to fix CI passes through it every time.
#                     Releasing on either the moment it appeared would be the
#                     original bug in a subtler form - a slot handed away in the
#                     pause between two turns of the same task.
#   unknown | other   same treatment, which is also the safe default for a word
#                     herdr adds later: bounded, so nothing can hold a slot for
#                     ever on a status pq has never heard of
#   noagent | missing releases at once - Claude exited, or the workspace is gone
#   "" (herdr silent) holds it, clock untouched. There is no way to tell a live
#                     agent from a finished one, and guessing "finished" is
#                     exactly the over-dispatch this exists to stop. Dispatch
#                     needs herdr too, so nothing is lost by waiting.
#
# On top of herdr's word, pq's own PQ_BLOCKED=quota holds the slot with no
# deadline, exactly as `blocked` does, and for a reason herdr cannot see: the
# first thing check_stall does about a wall is DISMISS it, which stops the
# spinner, so from that moment a walled agent reads `idle` and the grace would
# hand its slot away while it waits for its window. It is then handed back on the
# very tick the block clears - the tick its agent starts working again - which is
# the "six agents at a cap of 3" bug arriving one tick late.
#
# One asymmetry that is deliberate, since two functions otherwise look like they
# disagree: reap_task decides "the agent is still going" from herdr's
# `working`/`blocked` alone, so it will tear down a walled task that this one is
# still holding a slot for. Reap wins, and should - it only ever fires once the
# pull request has MERGED, and a merged PR means there is nothing left for the
# agent to come back to. The slot goes with the teardown.
#
# `running/` is deliberately NOT put through this: it counts unconditionally.
# That preserves the documented trade that a blocked task still holds its slot,
# and it avoids a leak this would otherwise open - a `running/` task whose agent
# went idle without ever opening a PR would stop counting while still sitting in
# `running/`, holding a worktree, with nothing to move it on.

# Does this done/ task still hold a slot? 0 yes, 1 no. Writes PQ_WRAPUP_SINCE,
# so it must not be called from a listing - see slot_state for the read-only
# view `pq ls` uses.
slot_held() {                           # task_dir -> 0 holds, 1 released
  local d=$1 pane status since nowe
  # Terminal - there is no agent left to hold anything. PQ_REAPED means the
  # workspace itself has been closed, so the pane id on file now points at
  # nothing (or, if herdr ever recycles ids, at somebody else's agent).
  [ -n "$(st "$d" PQ_REAPED)" ] && return 1
  [ -n "$(st "$d" PQ_CLOSED)" ] && return 1
  pane=$(st "$d" PQ_PANE)
  [ -n "$pane" ] || return 1
  status=$(pane_state "$pane")
  case "$status" in
    noagent|missing) return 1 ;;
  esac
  # A dismissed wall reads `idle`, so pq's own verdict has to be consulted before
  # the grace is applied to one - see the note above.
  [ "$(st "$d" PQ_BLOCKED)" = quota ] && status=blocked
  case "$status" in
    working|blocked)
      [ -z "$(st "$d" PQ_WRAPUP_SINCE)" ] || st_set "$d" PQ_WRAPUP_SINCE ""
      return 0 ;;
    "")              return 0 ;;
  esac
  # idle | done | unknown, and anything herdr adds later - start the clock on the
  # transition, then compare against it.
  since=$(st "$d" PQ_WRAPUP_SINCE)
  if [ -z "$since" ]; then
    st_set "$d" PQ_WRAPUP_SINCE "$(now)"
    return 0
  fi
  since=$(epoch_of "$since")
  # An unparseable stamp is corruption, not a verdict: rewrite it and hold the
  # slot for one more grace period rather than releasing on a bad read.
  [ -n "$since" ] || { st_set "$d" PQ_WRAPUP_SINCE "$(now)"; return 0; }
  nowe=$(epoch)
  [ $(( nowe - since )) -ge "$PQ_WRAPUP_GRACE" ] && return 1
  return 0
}

# The slot count the cap is compared against, as `running<TAB>wrapping-up`:
# every running/ task, plus every done/ task whose agent has not finished. The
# two halves come back separately because the summary has to name them
# separately - "3 running (cap 3)" while six agents are live is the report that
# hid this bug for as long as it lasted.
#
# One pass, one set of PQ_WRAPUP_SINCE writes: slot_held is idempotent, but the
# clock it starts should be read by everything in a tick, not restarted partway
# through it. Reads state that reconcile and reap have already stamped, so it
# must run after them.
#
# Under `dry` it counts through slot_state instead, so `--dry-run` starts nobody's
# clock - the same promise reap_task keeps by gating each of its write sites
# individually. The two agree on every branch (an unstamped idle agent holds its
# slot either way; it is only the stamping that differs), so the number a
# dry-run reports is the number a real tick would have acted on.
active_slots() {                        # [dry] -> run<TAB>wrap
  local dry=${1:-0} d run=0 wrap=0
  for d in "$PQ_HOME/running"/*/; do
    [ -d "$d" ] && run=$((run + 1))
  done
  for d in "$PQ_HOME/done"/*/; do
    [ -d "$d" ] || continue
    d=${d%/}
    if [ "$dry" = 1 ]; then
      [ -n "$(slot_state "$d")" ] && wrap=$((wrap + 1))
    else
      slot_held "$d" && wrap=$((wrap + 1))
    fi
  done
  printf '%s\t%s' "$run" "$wrap"
}

# The read-only half of slot_held, for `pq ls` and `pq cap`: the same verdict
# with no state written and no clock started. Prints `wrapping up` when the task
# is holding a slot it will eventually give back, and nothing when it is not
# holding one at all - so a caller can tell the two apart by emptiness alone.
#
# It deliberately does NOT start the clock. A listing that stamped
# PQ_WRAPUP_SINCE would reset the grace period every time you ran `pq ls`, and
# an agent could then hold its slot for as long as you kept looking at it.
slot_state() {                          # task_dir -> "wrapping up" | ""
  local d=$1 pane status since
  [ -n "$(st "$d" PQ_REAPED)" ] && return 0
  [ -n "$(st "$d" PQ_CLOSED)" ] && return 0
  pane=$(st "$d" PQ_PANE)
  [ -n "$pane" ] || return 0
  status=$(pane_state "$pane")
  case "$status" in
    noagent|missing) return 0 ;;
  esac
  # Same override as slot_held, for the same reason: a dismissed wall reads `idle`.
  [ "$(st "$d" PQ_BLOCKED)" = quota ] && status=blocked
  case "$status" in
    working|blocked|"") printf 'wrapping up'; return 0 ;;
  esac
  since=$(st "$d" PQ_WRAPUP_SINCE)
  # Not yet stamped: the next tick is what starts the clock, and until then the
  # slot is still held.
  [ -n "$since" ] || { printf 'wrapping up'; return 0; }
  since=$(epoch_of "$since")
  [ -n "$since" ] || { printf 'wrapping up'; return 0; }
  [ $(( $(epoch) - since )) -ge "$PQ_WRAPUP_GRACE" ] || printf 'wrapping up'
  return 0
}

# ── the session wall ────────────────────────────────────────────────────────
# Claude Code turns a 429 into a dialog - "Wait for limit to reset · Resets 3pm" -
# and every option on it only dismisses the dialog. Nothing resumes by itself. So
# an agent that hits the wall at 2am sits there until morning unless something
# knocks on it, and that knock is the only reason this section exists.
#
# Three deliberate choices, each of which the obvious alternative gets wrong.
#
# **Detection is the pane's TEXT, never herdr's status.** Herdr derives status from
# its own regexes over terminal regions, and its top rule (priority 1100,
# `osc_title_working`: a braille spinner in the window title) outranks every
# blocked rule it has. A spinner is exactly what is on screen while the request
# that hit the wall is still in flight. Gating on `blocked` would risk never firing.
#
# **Liveness is the tail's HASH, not a status either.** We act only when the wall's
# text is on screen AND the tail has not changed since the last tick. That matters
# in both directions: a working agent's tail moves every few seconds so this cannot
# interrupt one, and the wall's message stays in the scrollback for a while after
# the session recovers, so the text alone would keep firing long after it should.
#
# **We wait for the time the dialog names, and poll only if we cannot read it.**
# The dialog carries "Resets 8:30pm", and that hint beats any other source of the
# same fact: it comes from the error that walled us, so it already refers to the
# right window. The account has two (five-hour and weekly) and nothing else on hand
# would say which one we are behind.
#
# Its format is fixed by Claude Code's own formatter and worth writing down, because
# two of its habits will bite anyone who assumes otherwise: minutes are omitted when
# they are zero ("8pm", not "8:00pm"), and no date is printed for anything less than
# 24 hours out - so a bare "1am" seen at 11pm means tomorrow. Beyond 24 hours it
# becomes "Jul 28, 8:30pm", and gains a year only when the year differs.
#
# A hint we cannot read is not a failure: PQ_QUOTA_RETRY polling is the fallback,
# and it also takes over after a knock at the named time turns out to be too early.
# Waiting on an unparsed guess is the only outcome worth ruling out, since that
# strands a task silently, where a knock sent early costs one instantly-failing call.
# `pane read`, not `agent read`, and `--format text` is already text - it is not a
# JSON envelope with the terminal inside it. Piping it through jq is how this
# returned the empty string on every tick of every task for as long as the section
# existed, which check_stall reads as "could not see the pane" and returns on. The
# wall was never once detected.
#
# `pane read` is also the only one of the two that answers for a pane whose agent
# binding has lapsed - `agent read` returns an `agent_not_found` error object - and
# answering for exactly that pane is the point of the `noagent` case reconcile goes
# out of its way to include. An error object is still possible (a dead socket, a
# pane id that is gone), so drop one: it is not terminal text, and letting it
# through would have `classify_tail` reading somebody's error message.
pane_tail() {                           # pane_id -> the last lines on screen
  [ -n "${1:-}" ] || return 0
  herdr pane read "$1" --source visible --format text 2>/dev/null \
    | grep -v '^{"error":' | tail -n "$PQ_TAIL_LINES"
}

# "Resets 8:30pm" / "Resets Jul 28, 8pm" -> epoch. Local time throughout, because
# that is what Claude Code printed. Silence means "could not read it" and the caller
# falls back to polling, so every branch here fails closed rather than guessing.
#
# Every format below carries an explicit `%S` against a literal `00`, because BSD
# `date -j -f` fills a field the format does not mention from the CURRENT time - so a
# hint with no seconds in it silently picked up however many seconds past the minute
# it happened to be parsed at. Harmless in the arithmetic, but it made a stored reset
# disagree with the one on screen, and `clock_of` its own inverse only by luck.
parse_reset() {                         # hint text -> epoch seconds
  local s=$1 dpart tpart e nowe
  s=${s%%(*}                                          # drop a trailing " (PDT)"
  s=$(sed 's/^[[:space:]]*//; s/[[:space:]]*$//' <<<"$s")
  [ -n "$s" ] || return 1
  # Split on the LAST comma: the with-year form is "Jan 3, 2027, 9am".
  case "$s" in
    *,*) dpart=$(tr -d ',' <<<"${s%,*}"); tpart=${s##*,} ;;
    *)   dpart=""; tpart=$s ;;
  esac
  tpart=$(tr -d ' ' <<<"$tpart" | tr '[:lower:]' '[:upper:]')
  case "$tpart" in *:*) ;; *) tpart=$(sed 's/\([0-9]\{1,2\}\)\([AP]M\)/\1:00\2/' <<<"$tpart") ;; esac
  case "$tpart" in *AM|*PM) ;; *) return 1 ;; esac
  nowe=$(date '+%s')
  if [ -n "$dpart" ]; then
    dpart=$(sed 's/^[[:space:]]*//; s/[[:space:]]*$//' <<<"$dpart")
    case "$dpart" in
      *[0-9][0-9][0-9][0-9]*) e=$(date -j -f '%b %d %Y %I:%M%p %S' "$dpart $tpart 00" '+%s' 2>/dev/null) ;;
      *) e=$(date -j -f '%b %d %Y %I:%M%p %S' "$dpart $(date '+%Y') $tpart 00" '+%s' 2>/dev/null)
         # No year printed means this year - unless we are reading it across new year.
         [ -n "$e" ] && [ "$e" -lt $(( nowe - 86400 )) ] &&
           e=$(date -j -f '%b %d %Y %I:%M%p %S' "$dpart $(( $(date '+%Y') + 1 )) $tpart 00" '+%s' 2>/dev/null) ;;
    esac
  else
    e=$(date -j -f '%Y-%m-%d %I:%M%p %S' "$(date '+%Y-%m-%d') $tpart 00" '+%s' 2>/dev/null)
    # A bare clock time is the next time the clock reads it, so 1am seen at 11pm
    # is tomorrow. The small grace keeps a reset we have just passed from jumping.
    [ -n "$e" ] && [ "$e" -lt $(( nowe - 300 )) ] && e=$(( e + 86400 ))
  fi
  [ -n "$e" ] || return 1
  printf '%s' "$e"
}

# The hint sits at the end of a line that may well be inside a bordered box, so
# anything trailing that cannot be part of a date is dropped.
#
# Which line it comes off matters, because there are usually two. The wall's own
# line carries one ("You've hit your session limit - resets 3pm (PDT)"), and a
# statusline that reports rate limits carries another ("session 70% (resets
# 10:40pm)") - so a plain `tail -1` takes the statusline's, purely because the
# statusline is drawn below the transcript. That is the wrong one twice over: it
# names the five-hour window even when what walled us was the weekly one, and its
# trailing bracket makes parse_reset fail, silently demoting a reset we could have
# read to blind polling.
#
# So prefer a hint on a line that also looks like the wall, and only fall back to
# any other. The fallback is worth keeping - a statusline hint beats no hint, and
# it is right in the common case - which is why the two shapes it comes in are
# tolerated below: a trailing bracket, and a weekday for a reset that crosses
# midnight. Dropping the weekday loses nothing, since parse_reset already reads a
# bare clock time as the next time the clock reads it.
reset_hint() {                          # pane text -> the time the wall names
  local line
  line=$(grep -iE "$PQ_QUOTA_RE" <<<"$1" | grep -i 'resets ' | tail -1)
  [ -n "$line" ] || line=$(grep -i 'resets ' <<<"$1" | tail -1)
  # The weekday strip is anchored to a whole bare clock time on purpose: a leading
  # three-letter word is a weekday in "Sat 1:00am" and a MONTH in "Jul 28, 8pm",
  # and dropping the month would move the reset by up to a year.
  sed -n 's/.*[Rr]esets \(.*\)$/\1/p' <<<"$line" | tail -1 \
    | sed 's/[^0-9A-Za-z:,() ]*$//
           s/)$//
           s/^[A-Za-z][a-z][a-z] \([0-9]\{1,2\}\(:[0-9][0-9]\)*[APap][Mm]\)$/\1/'
}

# parse_reset's inverse, for the one place a stored reset is shown to a human. What
# is KEPT is the epoch - a hint is prose, and prose does not survive a round trip
# through state.env (see st_set) - so the display form is rebuilt on the way out
# rather than stored alongside it.
#
# Formatted the way Claude Code formats the same fact, since that is what you saw on
# the pane: minutes dropped when they are zero, and a weekday only once the reset is
# not today. ASCII throughout, as every `pq ls` cell must be.
clock_of() {                            # epoch seconds -> "8:30pm" | "Sat 1am"
  [ -n "${1:-}" ] || return 0
  local fmt='+%-I:%M%p'
  [ "$(date -r "$1" '+%M' 2>/dev/null)" = 00 ] && fmt='+%-I%p'
  [ "$(date -r "$1" '+%j' 2>/dev/null)" = "$(date '+%j')" ] || fmt="+%a ${fmt#+}"
  # Only the meridiem is lowercased, and by substitution rather than `tr`, which
  # would take the weekday with it. Same two expressions the statusline uses.
  date -r "$1" "$fmt" 2>/dev/null | sed 's/AM$/am/; s/PM$/pm/'
}

classify_tail() {                       # text -> quota | permission | none
  if   grep -qiE "$PQ_QUOTA_RE" <<<"$1"; then printf 'quota'
  elif grep -qiE "$PQ_PERM_RE"  <<<"$1"; then printf 'permission'
  else                                        printf 'none'; fi
}

# Escape rather than picking an option off the list. There are at least two
# different limit dialogs in the binary and their option sets differ - one of them
# offers "Upgrade to Team plan" - so arrowing to the Nth entry is a bet on which
# dialog turned up. Escape does not care, and since every option merely dismisses,
# it loses nothing.
unstick() {                             # pane_id [text to send after]
  herdr pane send-keys "$1" escape >/dev/null 2>&1 || return 1
  [ -n "${2:-}" ] || return 0
  sleep 1
  herdr pane send-text "$1" "$2" >/dev/null 2>&1 \
    && herdr pane send-keys "$1" enter >/dev/null 2>&1
}

clear_block() {                         # task_dir
  local d=$1 k
  for k in PQ_BLOCKED PQ_QUOTA_SINCE PQ_TRIES PQ_RETRY_AT PQ_GAVEUP PQ_RESETS_AT; do st_set "$d" "$k" ""; done
}

# One task, one tick: record what its pane is waiting on, and knock if it is the
# wall. Everything else is classified and left alone - answering a dialog nobody has
# identified is how an unattended system approves something it shouldn't.
#
# **Once the wall has been seen, the schedule is pq's own.** The banner is not
# transcript text: it is live UI that Claude Code derives from the reset time it is
# waiting for, so it clears ITSELF at the reset - which is the exact moment the knock
# comes due. Cancelling the plan whenever the wall is no longer on screen therefore
# threw it away at the one moment it mattered, and an agent walled at 2am sat there
# until morning with nothing left on file to say it ever had been.
#
# So the text is treated as a signal, not as state. It puts the block on; from then
# on PQ_RETRY_AT decides, and what is on screen decides nothing until the knock is
# due.
#
# What takes the block off is evidence the agent is MOVING again, and "moving" needs
# two things, not one. The tail hash alone is not enough, because a statusline that
# reports rate limits is inside the tail and turns over at the reset - a one-tick
# hash change landing at precisely `due + 60`, indistinguishable from the agent
# picking its work back up, and it would clear the block on an idle agent that never
# resumed. So movement has to be corroborated by herdr calling the pane `working`.
#
# That is not a retreat from "detection is the pane's TEXT, never herdr's status".
# That rule is about DETECTION, where herdr's top rule reads the spinner still in the
# title as `working` while the request that hit the wall is in flight. By the time a
# knock is due the dialog has long been dismissed and nothing is in flight, so
# `working` there means what it says. PIDX is loaded once per tick, so it is free.
check_stall() {                         # task_dir
  local d=$1 slug pane text hash prev kind was tries at nowsec still moved
  pane=$(st "$d" PQ_PANE); [ -n "$pane" ] || return 0
  text=$(pane_tail "$pane"); [ -n "$text" ] || return 0
  slug=$(slug_of "$d"); nowsec=$(epoch)
  hash=$(cksum <<<"$text" | awk '{ print $1 }')
  prev=$(st "$d" PQ_TAIL); st_set "$d" PQ_TAIL "$hash"
  kind=$(classify_tail "$text")
  was=$(st "$d" PQ_BLOCKED)
  # "Has this screen stopped" and "has this screen moved" are not each other's
  # negation: with no hash on file yet, the honest answer to both is no. Folding them
  # into one flag has to pick a side, and each side is wrong somewhere - a first read
  # counted as still detects a wall off a single glimpse, and a first read counted as
  # moved lets one glimpse of a `working` title clear a block that is real.
  still=0; moved=0
  if [ -n "$prev" ]; then
    if [ "$prev" = "$hash" ]; then still=1; else moved=1; fi
  fi

  # A permission prompt is recorded and deliberately never answered. That is the
  # trade for running everything in auto mode, and it is the distinction `pq ls`
  # draws in the morning between waiting on the clock and waiting on you.
  #
  # It also ends a wall, wherever we had got to with one: a session that is asking
  # for something is a session that is running again. Ending it here matters, because
  # the alternative is a knock sending Escape at a prompt - refusing it - and then
  # doing that again every ten minutes.
  if [ "$kind" = permission ]; then
    [ "$was" = quota ] && msg "$slug: moving again after the session limit"
    [ -n "$was" ] && [ "$was" != permission ] && clear_block "$d"
    st_set "$d" PQ_BLOCKED permission
    return 0
  fi

  if [ "$was" != quota ]; then
    if [ "$kind" != quota ]; then
      # Only when there is something to clear: this is the overwhelmingly common
      # branch, and each clear is six rewrites of state.env for no change at all.
      [ -n "$was" ] && clear_block "$d"
      return 0
    fi
    # The wall is on screen, but only a screen that has stopped moving is stuck.
    [ "$still" = 1 ] || return 0
    local hint due plan
    hint=$(reset_hint "$text")
    due=$(parse_reset "$hint") || due=""
    if [ -n "$due" ] && [ "$due" -gt "$nowsec" ]; then
      plan="waiting until $(clock_of "$due")"
      st_set "$d" PQ_RESETS_AT "$due"
      due=$(( due + 60 ))               # a minute past it, so clock skew cannot land early
    else
      due=$(( nowsec + PQ_QUOTA_RETRY ))
      plan="no reset time on screen, so knocking every $(( PQ_QUOTA_RETRY / 60 ))m"
      st_set "$d" PQ_RESETS_AT ""
    fi
    st_set "$d" PQ_BLOCKED quota;  st_set "$d" PQ_QUOTA_SINCE "$(now)"
    st_set "$d" PQ_TRIES 0;        st_set "$d" PQ_RETRY_AT "$due"
    unstick "$pane"
    warn "$slug: hit the session limit - dismissed it, $plan"
    return 0
  fi

  # Already walled. The pane is moving under its own steam, so it is back - let it
  # be, whatever the clock says. Waiting for the reset before believing this would
  # strand the block for hours whenever you rescue an agent yourself in the morning,
  # and a block still on file is a block that freezes the queue (see the freeze in
  # tick_body). A wall that is over is over.
  #
  # Both halves are needed. `moved` alone is the statusline turning over at the
  # reset; `working` alone risks a spinner herdr has not caught up with yet, one tick
  # after the Escape. Together they are only ever true of an agent doing work: while
  # walled and dismissed the pane is both still and idle.
  if [ "$moved" = 1 ] && [ "$(pane_state "$pane")" = working ]; then
    msg "$slug: moving again after the session limit"
    clear_block "$d"
    return 0
  fi

  # Until the knock is due, nothing on screen changes anything - the banner going
  # away is what the reset looks like, not what recovery looks like.
  tries=$(st "$d" PQ_TRIES); tries=${tries:-0}
  at=$(st "$d" PQ_RETRY_AT); at=${at:-0}
  [ "$nowsec" -ge "$at" ] || return 0

  if [ "$tries" -ge "$PQ_QUOTA_MAX_TRIES" ]; then
    [ "$(st "$d" PQ_GAVEUP)" = 1 ] || {
      st_set "$d" PQ_GAVEUP 1
      warn "$slug: still walled after $tries attempts - leaving it for you"
    }
    return 0
  fi

  # Past the named reset and still there means the hint was optimistic, so from here
  # it is the poll interval. PQ_RESETS_AT goes with it - a time already gone is worse
  # than no time at all in `pq ls`.
  tries=$(( tries + 1 ))
  st_set "$d" PQ_TRIES "$tries"; st_set "$d" PQ_RETRY_AT "$(( nowsec + PQ_QUOTA_RETRY ))"
  st_set "$d" PQ_RESETS_AT ""
  unstick "$pane" "Continue with what you were doing."
  msg "$slug: knocking after the session limit (attempt $tries)"
}

# Is anybody behind the wall right now, and when does their window reopen? The first
# one found, as `slug<TAB>epoch` with an empty epoch when no reset could be read;
# nothing at all when nobody is walled. Writes nothing, so a listing may call it.
#
# Fill consults this and starts NOTHING while it answers, because the usage window is
# one account-wide budget rather than a per-agent one. A second agent dispatched
# behind the wall does not get its own allowance: it walls on its first request,
# having spent a minute of `wt new`, a database, a port and a puma-dev entry to get
# there, and it arrives with its own knock cycle to run. Waiting costs nothing by
# comparison - the queue is a queue, and the tick that clears the block is the tick
# that fills again.
#
# It takes a LIVE agent to freeze anything, which is why `noagent` is excluded
# alongside `missing`, and this is the one place where reading the pane properly (see
# pane_tail) makes something newly possible rather than only fixing it. Claude Code
# renders inline rather than on the alternate screen, so a session that exited while
# walled leaves its banner sitting in the visible viewport above a shell prompt -
# and `pane read`, unlike the `agent read` it replaced, returns that quite happily.
# classify_tail would go on reading `quota` off dead scrollback for ever, the knocks
# would land on bash, and a freeze that only asked whether the PANE existed would
# hold the entire queue until somebody looked. check_stall still runs on `noagent`
# panes - a binding that lapsed for a moment is worth knocking through - it just
# does not get to stop everybody else.
walled_slot() {                         # -> slug<TAB>resets_at | ""
  local d
  for d in "$PQ_HOME/running"/*/ "$PQ_HOME/done"/*/; do
    [ -d "$d" ] || continue
    d=${d%/}
    [ "$(st "$d" PQ_BLOCKED)" = quota ] || continue
    case "$(pane_state "$(st "$d" PQ_PANE)")" in noagent|missing) continue ;; esac
    printf '%s\t%s' "$(slug_of "$d")" "$(st "$d" PQ_RESETS_AT)"
    return 0
  done
}

# "walled until 3pm", or just "walled" when the reset could not be read.
walled_note() {                         # resets_at -> text
  local at; at=$(clock_of "${1:-}")
  [ -n "$at" ] && printf 'walled until %s' "$at" || printf 'walled'
}

# One `gh` lookup per dispatched branch, concurrently. Only tasks that have been
# dispatched can have a PR, so this costs nothing while the queue is just a queue.
# statusCheckRollup is deliberately not requested: it is what makes `wt ls` slow,
# and "is there a PR" does not need it.
#
# `--limit` is 5, not 1, and `baseRefName` is a sixth column - both purely for
# the blocker predicate below, which needs to tell "closed, but a later PR
# merged" apart from "closed, and nothing else was ever opened", and needs to
# know WHICH branch a PR landed on. `pr_get` still wins on the first matching
# row, untouched - see the comment there for why a second, later PR is safe to
# have sitting further down the file.
#
# PR_ANS is the answered set: a repo+branch pair present in it means gh
# genuinely answered "zero rows" for that branch, as opposed to gh never having
# been asked (no `gh` installed, offline, no GitHub remote) or having failed.
# Without this distinction "no PR yet" and "gh could not tell us" look
# identical, and a blocker that has simply not started yet would be
# misdiagnosed as an orphan the first time `gh` hiccups.
PR_CACHE="" PR_ANS=""
pr_load() {                             # repo branch...
  local repo=$1 b n=0; shift
  local pids=()
  PR_CACHE="$PQ_HOME/.pr.$$"; : > "$PR_CACHE"
  PR_ANS="$PQ_HOME/.pr.$$.ans"; : > "$PR_ANS"
  command -v gh >/dev/null 2>&1 || return 0
  for b in "$@"; do
    [ -n "$b" ] || continue
    (
      cd "$repo" 2>/dev/null || exit 1
      raw=$(gh pr list --head "$b" --state all --limit 5 \
              --json number,state,isDraft,baseRefName 2>/dev/null) || exit 1
      printf '%s\t%s\n' "$repo" "$b" > "$PR_ANS.$n"
      jq -r --arg b "$b" --arg r "$repo" \
         '.[] | [$r, $b, (.number|tostring), .state,
                 (if .isDraft then "draft" else "" end), .baseRefName] | @tsv' <<<"$raw"
    ) > "$PR_CACHE.$n" &
    pids[$n]=$!; n=$((n + 1))
  done
  [ "$n" -gt 0 ] || return 0
  wait "${pids[@]}" 2>/dev/null
  cat "$PR_CACHE".[0-9]* >> "$PR_CACHE" 2>/dev/null
  cat "$PR_ANS".[0-9]*   >> "$PR_ANS"   2>/dev/null
  rm -f "$PR_CACHE".[0-9]* "$PR_ANS".[0-9]*
}
# Keyed on repo AND branch. The cache is one file spanning every project in the
# queue, and a branch name is only unique within its own repo - `tom/fix-timezone`
# in supercast and in supercast-ios are different branches with the same name. On
# the branch alone, one project's merged PR would retire the other project's task
# and free a slot whose work never shipped.
pr_get() {                              # repo branch
  awk -F'\t' -v r="$1" -v b="$2" \
    '$1 == r && $2 == b { print $3 "\t" $4 "\t" $5; exit }' "${PR_CACHE:-/dev/null}" 2>/dev/null
}

# Every (repo, branch) pair pq needs PR/answered state for THIS pass, plus the
# blockers of every task that has not started (queue + hold) - those branches
# can belong to a repo nothing else in the queue touches, so they would
# otherwise never get looked up at all.
#
# `scope` picks which dispatched branches count: `all` (the default) is
# running + done, which `cmd_ls` needs for its PR column; `tick_body` passes
# `running` instead, since reconcile only ever looks at running tasks - a
# `done` task's own branch would otherwise be a `gh` call repeated every tick,
# forever, for history that already shipped and will never change state again.
# A `done` task that is ALSO a blocker still gets looked up, through its
# dependent's `after` row.
#
# The exception is a done task the reap pass still has a verdict to reach:
# `reap_watching` says so for as long as none of `PQ_MERGED`, `PQ_CLOSED`,
# `PQ_REAPED` is set, which is exactly the window where the answer can still
# change. A merged task stamps `PQ_MERGED` and drops out (only local checks
# remain - no more reason to ask `gh`); a closed one stamps `PQ_CLOSED` and
# drops out; a worktree already gone stamps `PQ_REAPED` and drops out.
pr_targets() {                          # [scope: all|running]
  local scope=${1:-all} d st repo branch
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    st=$(state_of "$d")
    case "$st" in
      running)
        repo=$(hdr "$d/plan.md" repo); branch=$(hdr "$d/plan.md" branch)
        [ -n "$repo" ] && [ -n "$branch" ] && printf '%s\t%s\n' "$repo" "$branch"
        ;;
      done)
        [ "$scope" = all ] || reap_watching "$d" || continue
        repo=$(hdr "$d/plan.md" repo); branch=$(hdr "$d/plan.md" branch)
        [ -n "$repo" ] && [ -n "$branch" ] && printf '%s\t%s\n' "$repo" "$branch"
        ;;
      queue|hold)
        while IFS=$'\t' read -r _ repo branch; do
          [ -n "$repo" ] && [ -n "$branch" ] && printf '%s\t%s\n' "$repo" "$branch"
        done <<<"$(after_list "$d")"
        ;;
    esac
  done <<<"$(all_tasks)"
}

# Group a set of (repo, branch) pairs by repo and run `pr_load` once per repo,
# so each repo's lookups share a single `cd` - then combine into ONE PR_CACHE
# and ONE PR_ANS spanning every repo, set once. Replaces two near-identical
# per-repo loops that used to live in `cmd_ls` and `tick_body`; net less code,
# and the one place both a blocker and a dispatched branch can go missing from.
pr_load_all() {                         # pairs: "repo\tbranch" lines, e.g. $(pr_targets)
  local pairs=$1 r branches
  local cache="$PQ_HOME/.prall.$$" ans="$PQ_HOME/.prall.$$.ans"
  : > "$cache"; : > "$ans"
  if [ -n "$pairs" ]; then
    local repos; repos=$(awk -F'\t' '{ print $1 }' <<<"$pairs" | sed '/^$/d' | sort -u)
    while IFS= read -r r; do
      [ -n "$r" ] || continue
      branches=$(awk -F'\t' -v r="$r" '$1 == r { print $2 }' <<<"$pairs")
      # shellcheck disable=SC2086
      pr_load "$r" $branches
      cat "$PR_CACHE" >> "$cache" 2>/dev/null
      cat "$PR_ANS"   >> "$ans"   2>/dev/null
      rm -f "$PR_CACHE" "$PR_ANS"
    done <<<"$repos"
  fi
  PR_CACHE=$cache
  PR_ANS=$ans
}

# ── after: the predicate ────────────────────────────────────────────────────
# The repo's default branch, bare (e.g. "main", not "origin/main") - memoised in
# a file for the life of one `pq` process, the same way PR_CACHE is. It has to
# be a FILE, not a shell variable: every caller reaches this through command
# substitution (`base=$(repo_base "$repo")`), which forks a subshell, and
# anything that function assigned to a plain variable dies with that subshell -
# which is also why the cache path is derived from $$ directly rather than
# stashed in a variable first: a variable assignment here would be exactly as
# invisible to the caller as the memoised value itself would be.
#
# Mirrors `wt`'s `base_ref`: the remote-tracking symbolic ref first, since that
# is what every worktree already forks from, then `gh` for a repo `wt` has never
# touched, then a plain `show-ref` as the last resort. Unresolvable means we
# cannot evaluate "merged into main" at all, so the caller has to fail closed -
# see after_state's "nobase" detail.
repo_base() {                           # repo -> default branch name (bare), or "" if unresolvable
  local cache="$PQ_HOME/.base.$$" repo=$1 line base b
  [ -f "$cache" ] && line=$(awk -F'\t' -v r="$repo" '$1 == r { print; exit }' "$cache")
  if [ -n "${line:-}" ]; then
    base=${line#*$'\t'}; printf '%s' "$base"; [ -n "$base" ]; return
  fi
  base=$(git -C "$repo" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
  base=${base#origin/}
  if [ -z "$base" ] && command -v gh >/dev/null 2>&1; then
    base=$(cd "$repo" 2>/dev/null && gh repo view --json defaultBranchRef -q '.defaultBranchRef.name' 2>/dev/null)
  fi
  if [ -z "$base" ]; then
    for b in main master; do
      git -C "$repo" show-ref --verify --quiet "refs/remotes/origin/$b" && { base=$b; break; }
    done
  fi
  printf '%s\t%s\n' "$repo" "$base" >> "$cache"
  printf '%s' "$base"
  [ -n "$base" ]
}
# Deletes the memo file directly by its (deterministic) path, rather than
# through a variable that repo_base's own callers never actually see set -
# checking a variable the caller's scope never received would silently skip
# the rm every time, leaking one small file per `pq` invocation forever.
repo_base_reset() { rm -f "$PQ_HOME/.base.$$" 2>/dev/null; }

# Pure: reads only PR_CACHE. 0 when a PR for this branch merged into base.
pr_merged_into() {                      # repo branch base
  awk -F'\t' -v r="$1" -v b="$2" -v base="$3" '
    $1 == r && $2 == b && $4 == "MERGED" && $6 == base { ok = 1; exit }
    END { exit !ok }' "${PR_CACHE:-/dev/null}"
}
# Pure: reads only PR_ANS. 0 when gh definitively answered for this branch,
# even if the answer was zero rows.
pr_answered() {                         # repo branch
  awk -F'\t' -v r="$1" -v b="$2" '
    $1 == r && $2 == b { ok = 1; exit }
    END { exit !ok }' "${PR_ANS:-/dev/null}"
}
# Pure: reads only PR_CACHE. 0 when at least one row is on file at all.
pr_has_row() {                          # repo branch
  awk -F'\t' -v r="$1" -v b="$2" '
    $1 == r && $2 == b { ok = 1; exit }
    END { exit !ok }' "${PR_CACHE:-/dev/null}"
}
# Pure: reads only PR_CACHE. 0 when at least one row exists and every row on
# file for this branch is CLOSED - it can never become met on its own.
pr_all_closed() {                       # repo branch
  awk -F'\t' -v r="$1" -v b="$2" '
    BEGIN { allclosed = 1 }
    $1 == r && $2 == b { n++; if ($4 != "CLOSED") allclosed = 0 }
    END { exit !(n > 0 && allclosed) }' "${PR_CACHE:-/dev/null}"
}
# Pure: reads only PR_CACHE. 0 when at least one row is an open DRAFT.
pr_has_draft() {                        # repo branch
  awk -F'\t' -v r="$1" -v b="$2" '
    $1 == r && $2 == b && $5 == "draft" { ok = 1; exit }
    END { exit !ok }' "${PR_CACHE:-/dev/null}"
}

# blocker_state <repo> <branch> <base> -> met | waiting | stalled | dead | orphan | unknown
#
# Not pure past this line: task_by_branch walks all_tasks() and touches disk,
# which is why the five pr_* predicates above are split out on their own - they
# are the seam a test can exercise without a single real task directory.
#
# One row per outcome in the table this mirrors, in the same order, because
# that is the only way to keep the two in sync by inspection rather than by
# memory:
#   MERGED into the default branch                       -> met
#   no PR yet, a live task owns the branch                -> waiting (normal)
#   an OPEN row, a live task owns the branch               -> waiting (in review)
#   a DRAFT row whose owning task has reached done         -> stalled
#   every row is CLOSED                                    -> dead
#   no PR, and no task in any state owns the branch        -> orphan
#   no row and gh never answered                           -> unknown
blocker_state() {                       # repo branch base
  local repo=$1 branch=$2 base=$3 owner
  pr_merged_into "$repo" "$branch" "$base" && { printf 'met'; return; }
  if pr_has_row "$repo" "$branch"; then
    pr_all_closed "$repo" "$branch" && { printf 'dead'; return; }
    owner=$(task_by_branch "$repo" "$branch")
    if pr_has_draft "$repo" "$branch" && [ -n "$owner" ] && [ "$(state_of "$owner")" = "done" ]; then
      printf 'stalled'; return
    fi
    printf 'waiting'; return
  fi
  if pr_answered "$repo" "$branch"; then
    owner=$(task_by_branch "$repo" "$branch")
    [ -n "$owner" ] && { printf 'waiting'; return; }
    printf 'orphan'; return
  fi
  printf 'unknown'
}

# after_state <task_dir> -> "verdict\tdetail" where verdict is
# met | waiting <label> <n_unmet> | stalled <label> | dead <label>, and detail
# is one of dead|orphan|stalled|nobase:<repo>|"" - the finer-grained reason a
# caller needs for a warning message but that would overload the verdict text
# itself. Both are printed on the SAME line, tab-separated, rather than through
# a side-channel global: every caller reaches this through command
# substitution, which forks a subshell, so a global this function set would
# vanish the moment it returned - the same trap repo_base's cache sidesteps by
# being a file instead of a variable.
#
# Aggregates every blocker: dead/orphan outranks stalled outranks plain
# waiting, because the fix differs and the worse case is the one worth
# surfacing first - a task can be both "waiting on two" and "one of them is
# dead", and dead is the one that will never resolve on its own.
after_state() {                         # task_dir
  local d=$1 label repo branch base bst
  local first_dead="" first_dead_detail="" first_stalled="" first_wait="" n_unmet=0 nobase=""
  if [ ! -f "$d/after" ]; then printf 'met\t'; return; fi
  while IFS=$'\t' read -r label repo branch; do
    [ -n "$label" ] || continue
    base=$(repo_base "$repo")
    if [ -z "$base" ]; then
      nobase=$repo
      n_unmet=$((n_unmet + 1)); [ -n "$first_wait" ] || first_wait=$label
      continue
    fi
    bst=$(blocker_state "$repo" "$branch" "$base")
    case "$bst" in
      met) ;;
      dead|orphan)
        n_unmet=$((n_unmet + 1))
        if [ -z "$first_dead" ]; then first_dead=$label; first_dead_detail=$bst; fi
        ;;
      stalled) n_unmet=$((n_unmet + 1)); [ -n "$first_stalled" ] || first_stalled=$label ;;
      *)       n_unmet=$((n_unmet + 1)); [ -n "$first_wait" ] || first_wait=$label ;;
    esac
  done <<<"$(after_list "$d")"
  if [ -n "$first_dead" ]; then
    printf 'dead %s\t%s' "$first_dead" "$first_dead_detail"
  elif [ -n "$first_stalled" ]; then
    printf 'stalled %s\tstalled' "$first_stalled"
  elif [ "$n_unmet" -gt 0 ]; then
    printf 'waiting %s %d\t%s' "$first_wait" "$n_unmet" "${nobase:+nobase:$nobase}"
  else
    printf 'met\t'
  fi
}

# The tick-time wrapper: after_state plus the once-only warning. dead, orphan
# and stalled all set PQ_AFTER_DEAD via the PQ_GAVEUP idiom (clear_block) -
# warn on the transition into it, stay quiet on every tick after, and clear it
# the moment the blocker recovers, so a reopened PR or a draft marked ready
# re-arms the warning. An unresolvable default branch warns once under its own
# PQ_AFTER_NOBASE key instead, because the fix is different - it names a repo,
# not a blocker.
#
# `pq ls` calls after_state directly and never this: a mere listing must not
# write to state.env or print a warning, the same way `agent_cell` never has.
after_check() {                         # task_dir
  local d=$1 verdict detail slug was wasnb reporepo
  IFS=$'\t' read -r verdict detail <<<"$(after_state "$d")"
  slug=$(slug_of "$d")
  was=$(st "$d" PQ_AFTER_DEAD)
  case "$verdict" in
    dead\ *|stalled\ *)
      if [ "$was" != 1 ]; then
        st_set "$d" PQ_AFTER_DEAD 1
        case "$detail" in
          dead)    warn "$slug: blocker ${verdict#* } is dead - every PR for it is closed; merge one or clear the blocker (pq after $slug --clear)" ;;
          orphan)  warn "$slug: blocker ${verdict#* } is an orphan - no task owns its branch, so nothing will ever open a PR for it" ;;
          stalled) warn "$slug: blocker ${verdict#* } is stalled - its task already reached done with only a draft PR open; go look at it" ;;
        esac
      fi
      ;;
    *) [ -z "$was" ] || st_set "$d" PQ_AFTER_DEAD "" ;;
  esac
  case "$detail" in
    nobase:*)
      reporepo=${detail#nobase:}
      wasnb=$(st "$d" PQ_AFTER_NOBASE)
      [ "$wasnb" = 1 ] || { st_set "$d" PQ_AFTER_NOBASE 1
        warn "$slug: could not resolve the default branch of $reporepo - its blockers stay unmet until it can"; }
      ;;
    *)
      wasnb=$(st "$d" PQ_AFTER_NOBASE)
      [ -z "$wasnb" ] || st_set "$d" PQ_AFTER_NOBASE ""
      ;;
  esac
  printf '%s' "$verdict"
}

# {label, repo, branch, state} for every blocker, for cmd_ls --json and
# cmd_add --json - assumes PR_CACHE/PR_ANS already cover every blocker's
# (repo, branch), same as after_state assumes.
after_json() {                          # task_dir
  local d=$1 label repo branch base st
  [ -f "$d/after" ] || { printf '[]'; return; }
  local tmp="$PQ_HOME/.afterjson.$$"; : > "$tmp"
  while IFS=$'\t' read -r label repo branch; do
    [ -n "$label" ] || continue
    base=$(repo_base "$repo")
    st=$(blocker_state "$repo" "$branch" "${base:-}")
    jq -nc --arg label "$label" --arg repo "$repo" --arg branch "$branch" --arg state "$st" \
      '{label: $label, repo: $repo, branch: $branch, state: $state}' >> "$tmp"
  done <<<"$(after_list "$d")"
  jq -sc '.' "$tmp"
  rm -f "$tmp"
}

# The width every caller here renders against, unless told otherwise. `PQ_WIDTH`
# is the escape hatch - what the tests pin to exercise this deterministically
# without a tty, and what a caller in a Herdr pane or a detached `pq tick` can
# set if the probe below ever resolves to the wrong terminal.
#
# `stty size </dev/tty`, not `tput cols`: every caller here reaches term_width
# through a command substitution, so tput's stdout is a pipe, its ioctl fails,
# and it falls back to terminfo's 80 rather than the real width.
#
# The redirection is wrapped in a group so /dev/tty's own absence is silenced
# too: `stty ... 2>/dev/null` only covers what stty says, and a missing
# controlling terminal is the SHELL complaining about the redirect - "Device not
# configured", once per rendered table, in every detached `pq tick` log.
term_width() {
  local c=${PQ_WIDTH:-}
  [ -n "$c" ] || c=$( { stty size </dev/tty; } 2>/dev/null | cut -d' ' -f2 )
  [ -n "$c" ] || c=$(tput cols 2>/dev/null)
  [[ "$c" =~ ^[0-9]+$ ]] && [ "$c" -ge 40 ] || c=100
  printf '%s' "$c"
}

# Same table renderer as wt: every column but the last padded to its own widest
# cell, so one long branch name does not force a fixed width on everything else -
# THEN shrunk to fit `width` (default term_width), so no row can ever roll over
# to a second line. A table that already fits renders byte-identical to before:
# the shrink loop and the truncation below only ever engage once natural widths
# exceed the target.
#
# Cells must be ASCII. macOS awk's length() counts BYTES, not characters, and no
# locale changes that (verified on awk 20200816) - so a single multi-byte character
# anywhere in a cell silently over-pads that column by the number of extra bytes and
# skews the whole table. Cheap to avoid, fiddly to detect, so: plain ASCII in tables.
render_table() {                        # tsv_file [width]
  local width=${2:-$(term_width)}
  awk -F'\t' -v width="$width" '
    { rows = NR; if (NF > n) n = NF
      for (i = 1; i <= NF; i++) { cell[NR, i] = $i; if (length($i) > w[i]) w[i] = length($i) } }
    END {
      # Row 1 is the floor: no column shrinks below the width of its own
      # header cell, so a header is never truncated.
      for (i = 1; i <= n; i++) floor[i] = length(cell[1, i])

      total = 0
      for (i = 1; i <= n; i++) total += w[i] + (i < n ? 2 : 0)
      # Shrink the widest shrinkable column by one, repeatedly, until the row
      # fits or nothing can give - bounded by the sum of the widths, and it
      # naturally targets whichever column (TASK, AGENT, ...) is widest.
      while (total > width) {
        wi = 0; widest = 0
        for (i = 1; i <= n; i++) if (w[i] > floor[i] && w[i] > widest) { widest = w[i]; wi = i }
        if (wi == 0) break
        w[wi]--; total--
      }

      for (r = 1; r <= rows; r++) {
        line = ""
        for (i = 1; i <= n; i++) {
          v = cell[r, i]
          # Truncate an over-long cell with ".." - matching cells own
          # convention - including the last column, which is unpadded and so
          # can otherwise overflow on its own.
          if (length(v) > w[i]) v = substr(v, 1, w[i] - 2) ".."
          line = line (i == n ? v : sprintf("%-*s  ", w[i], v))
        }
        sub(/[ \t]+$/, "", line)
        # Final backstop, for a terminal narrower than the headers themselves
        # can fit - the shrink loop above cannot go below a header floor.
        if (length(line) > width) line = substr(line, 1, width)
        print line
      }
    }
  ' "$1"
}

# epoch_seconds -> 12m / 3h / 5d. Shared by age_of below and the plan picker,
# which already has an epoch from `stat` and must not go via a formatted
# string: `stat -f '%Sm'` renders in LOCAL time while age_of's caller below
# parses with `date -j -u`, so a round trip through a string would be
# silently off by the UTC offset. The d < 0 clamp is for a future mtime - a
# restored or clock-skewed file - which would otherwise render "-1m".
age_since() {                           # epoch_seconds -> 12m / 3h / 5d
  local now d
  [ -n "${1:-}" ] || { printf -- '-'; return; }
  now=$(date -u '+%s'); d=$(( now - $1 )); [ "$d" -lt 0 ] && d=0
  if   [ "$d" -lt 3600 ]  ; then printf '%dm' $(( d / 60 ))
  elif [ "$d" -lt 86400 ] ; then printf '%dh' $(( d / 3600 ))
  else                           printf '%dd' $(( d / 86400 )); fi
}

age_of() {                              # iso8601
  local then
  then=$(epoch_of "${1:-}")
  [ -n "$then" ] || { printf -- '-'; return; }
  age_since "$then"
}

# What check_stall recorded about a pane, as a cell: `quota 8:30pm`, `walled 2h`,
# `permission`, or nothing at all when the task is not blocked. Shared by the running
# and the done branches below, because check_stall now knocks on both and a wrapping-up
# agent behind the wall has exactly as much to say about it as a running one.
block_cell() {                          # task_dir
  local d=$1 at
  case "$(st "$d" PQ_BLOCKED)" in
    quota)      [ "$(st "$d" PQ_GAVEUP)" = 1 ] && printf 'walled ' || printf 'quota '
                # The time it comes back beats how long it has been gone, when the
                # wall told us one. Both are ASCII, as every cell here must be.
                at=$(clock_of "$(st "$d" PQ_RESETS_AT)")
                printf '%s' "${at:-$(age_of "$(st "$d" PQ_QUOTA_SINCE)")}" ;;
    permission) printf 'permission' ;;
  esac
}

# What an agent is waiting on, in the words that decide what you do about it.
# `pq` records why it classified a blocked agent the way it did, so the morning
# read separates "waiting on the clock" from "waiting on you".
#
# The column is headed AGENT, but the header comment already describes `pq ls`
# as showing "what it is waiting on" - so a task that has not started yet gets
# an answer here too, rather than a tenth column: `after <label>` (`+N` for
# more) when it is only waiting, `dead <label>` or `stalled <label>` when a
# blocker needs you instead. Calls after_state directly, never after_check - a
# mere listing must not write to state.env or print a warning.
agent_cell() {                          # task_dir state
  local d=$1 st=$2 pane status blocked
  case "$st" in
    queue|hold)
      [ -f "$d/after" ] || { printf -- '-'; return; }
      local verdict lbl cnt
      IFS=$'\t' read -r verdict _ <<<"$(after_state "$d")"
      case "$verdict" in
        met)  printf -- '-' ;;
        waiting\ *)
          lbl=${verdict#waiting }; cnt=${lbl##* }; lbl=${lbl% *}
          lbl=$(cell "$lbl" "$PQ_LABEL_MAX")
          if [ "$cnt" -gt 1 ] 2>/dev/null; then printf 'after %s +%d' "$lbl" "$((cnt - 1))"
          else printf 'after %s' "$lbl"; fi
          ;;
        stalled\ *) printf 'stalled %s' "$(cell "${verdict#stalled }" "$PQ_LABEL_MAX")" ;;
        dead\ *)    printf 'dead %s' "$(cell "${verdict#dead }" "$PQ_LABEL_MAX")" ;;
      esac
      return
      ;;
    done)
      # Deliberately silent for a reaped task, or one never held at all - `-`
      # keeps meaning "nothing here wants you". A closed-without-merging task
      # never gets a PQ_REAP_HELD (reap_task returns before ever computing a
      # hold reason for it) but still needs a decision from you, same as a
      # hold does - so it gets its own word rather than reading as settled.
      local reason
      if [ -n "$(st "$d" PQ_CLOSED)" ]; then printf 'closed'; return; fi
      reason=$(st "$d" PQ_REAP_HELD)
      # These two want a decision from you and say nothing about the agent, so
      # they outrank the slot report below. `held agent` does not: it means the
      # very thing `wrapping up` says, and says it without mentioning the slot.
      case "$reason" in
        nobase|here) printf 'held %s' "$reason"; return ;;
      esac
      # A done task whose agent is still going still holds one of the cap's
      # slots (see the `slots` section). Without this the queue not advancing
      # has no visible cause at all - the running/ rows add up to less than the
      # cap and nothing on screen accounts for the difference.
      #
      # `blocked` is called out rather than folded into `wrapping up`, because
      # the two want opposite things from you. A wrapping-up agent wants
      # nothing; a blocked one is sitting on a prompt and holds its slot for as
      # long as it sits there. It reads as `blocked` for the same reason a
      # running row does, and counts into "needs you" through the case cmd_ls
      # already has for that word.
      #
      # What pq read off the pane comes first, exactly as it does for a running
      # row: `quota 8:30pm` says which of the two it is and when it comes back,
      # where herdr's bare `blocked` cannot. A wall here is knocked on now, so
      # this is the row that tells you it is being handled rather than waiting.
      blocked=$(block_cell "$d")
      if [ -n "$blocked" ]; then printf '%s' "$blocked"; return; fi
      if [ "$(pane_state "$(st "$d" PQ_PANE)")" = blocked ]; then printf 'blocked'; return; fi
      if [ -n "$(slot_state "$d")" ]; then printf 'wrapping up'; return; fi
      if [ -n "$reason" ]; then printf 'held %s' "$reason"; else printf -- '-'; fi
      return
      ;;
  esac
  [ "$st" = running ] || { printf -- '-'; return; }
  pane=$(st "$d" PQ_PANE)
  # Claimed but not yet launched: either mid-dispatch right now, or an interrupted
  # tick left it half-done and the next reconcile will finish it.
  [ -n "$(st "$d" PQ_LAUNCHED)" ] || { printf 'starting'; return; }
  status=$(pane_state "$pane")
  case "$status" in
    "")        printf '?';    return ;;       # herdr did not answer
    missing)   printf 'gone'; return ;;       # workspace is gone, so nothing else applies
  esac
  # What pq itself read off the pane outranks whatever herdr makes of it - herdr
  # can call a walled agent `working` off the spinner still in its title, or
  # `noagent` if the binding lapsed, and the wall is the whole reason this column
  # exists at 8am. Same ordering as reconcile, for the same reason.
  blocked=$(block_cell "$d")
  [ -n "$blocked" ] && { printf '%s' "$blocked"; return; }
  case "$status" in
    noagent) printf 'exited';  return ;;      # a shell is sitting where Claude was
    unknown) printf 'unknown'; return ;;
  esac
  printf '%s' "$status"
}

cmd_ls() {
  local as_json=0 all=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) as_json=1; shift ;;
      --all)  all=1; shift ;;
      -h|--help) die "usage: pq ls [--all] [--json]" ;;
      *)      die "unknown option '$1' (usage: pq ls [--all] [--json])" ;;
    esac
  done

  local tasks; tasks=$(all_tasks "$([ "$all" = 1 ] && printf all || printf live)")
  if [ -z "$tasks" ]; then
    [ "$as_json" = 1 ] && echo '[]'
    local narch0; narch0=$(ls -d "$PQ_HOME/archive"/*/ 2>/dev/null | wc -l | tr -d ' ')
    if [ "$narch0" -gt 0 ] && [ "$all" != 1 ]; then
      msg "queue is empty - add one with: pq add ($narch0 archived, --all to see)"
    else
      msg "queue is empty - add one with: pq add"
    fi
    return 0
  fi

  # PR state for every dispatched branch, PLUS every blocker of a task that has
  # not started - a blocker's branch can belong to a repo nothing else in the
  # queue touches, so pq ls would otherwise lie about it being unmet forever.
  # pr_targets itself only ever walks live tasks, regardless of --all: archive
  # is settled history, so a listed archived row never costs a fresh `gh` call.
  local d st repo
  pidx_load
  pr_load_all "$(pr_targets)"

  # PROJECT, MODEL, and EFFORT each show only once the listed tasks actually
  # span more than one value - the first thing you need when they do, and a
  # column of the same word repeated on every row when they don't.
  local multi multi_model multi_effort
  multi=$(while IFS= read -r d; do [ -n "$d" ] && hdr "$d/plan.md" repo; done <<<"$tasks" \
            | sed '/^$/d' | sort -u | awk 'END { print (NR > 1) }')
  multi_model=$(while IFS= read -r d; do [ -n "$d" ] && hdr "$d/plan.md" model; done <<<"$tasks" \
            | sed '/^$/d' | sort -u | awk 'END { print (NR > 1) }')
  multi_effort=$(while IFS= read -r d; do [ -n "$d" ] && hdr "$d/plan.md" effort; done <<<"$tasks" \
            | sed '/^$/d' | sort -u | awk 'END { print (NR > 1) }')

  local tbl="$PQ_HOME/.ls.$$.tsv"
  local slug branch model effort dev intent added pr num prstate draft agent needs=0 blocked dispst
  local holding nwrap=0
  local TAB=$'\t'
  if [ "$as_json" = 1 ]; then
    : > "$tbl"
  else
    local hdrline="TASK"
    [ "$multi" = 1 ] && hdrline="${hdrline}${TAB}PROJECT"
    hdrline="${hdrline}${TAB}STATE"
    [ "$multi_model" = 1 ]  && hdrline="${hdrline}${TAB}MODEL"
    [ "$multi_effort" = 1 ] && hdrline="${hdrline}${TAB}EFFORT"
    hdrline="${hdrline}${TAB}AGENT${TAB}PR${TAB}AGE"
    printf '%s\n' "$hdrline" > "$tbl"
  fi
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    st=$(state_of "$d"); slug=$(slug_of "$d")
    # Urgency is only meaningful for what has not started - "queue!" / "hold!"
    # in the human table, restricted to those two states, since render_table
    # widens the STATE column on its own once one of them shows up.
    dispst=$st
    case "$st" in queue|hold) is_urgent "$d" && dispst="$st!" ;; esac
    branch=$(hdr "$d/plan.md" branch); model=$(hdr "$d/plan.md" model)
    effort=$(hdr "$d/plan.md" effort); dev=$(hdr "$d/plan.md" dev)
    intent=$(hdr "$d/plan.md" intent);  added=$(hdr "$d/plan.md" added)
    repo=$(hdr "$d/plan.md" repo)
    agent=$(agent_cell "$d" "$st")
    case "$agent" in
      permission|gone|exited|blocked|unknown|closed) needs=$((needs + 1)) ;;
      dead\ *|stalled\ *|held\ *)                     needs=$((needs + 1)) ;;
    esac
    # Which rows are spending the cap. `running` unconditionally, the same way
    # active_slots counts it; a done row only while its agent is still there.
    # Deliberately NOT folded into `needs` - a task wrapping up is healthy, it
    # just is not free.
    holding=false
    case "$st" in
      running) holding=true ;;
      done)    [ -n "$(slot_state "$d")" ] && { holding=true; nwrap=$((nwrap + 1)); } ;;
    esac
    num=""; prstate=""; draft=""
    IFS=$'\t' read -r num prstate draft <<<"$(pr_get "$repo" "$branch")"
    case "${prstate:-}" in
      MERGED) pr="#$num merged" ;;
      OPEN)   pr="#$num ${draft:-open}" ;;
      CLOSED) pr="#$num closed" ;;
      *)      pr="-" ;;
    esac
    if [ "$as_json" = 1 ]; then
      case "$(after_state "$d")" in met$'\t'*) blocked=false ;; *) blocked=true ;; esac
      local merged reaped held
      merged=$(st "$d" PQ_MERGED); reaped=$(st "$d" PQ_REAPED); held=$(st "$d" PQ_REAP_HELD)
      jq -nc --arg task "$slug" --arg state "$st" --arg branch "$branch" \
        --arg repo "$repo" --arg model "$model" --arg effort "$effort" --arg dev "$dev" \
        --arg intent "$intent" --arg added "$added" --arg dir "$d" \
        --arg agent "$agent" --arg pr "${num:-}" --arg prstate "${prstate:-}" \
        --arg draft "$draft" --arg stamp "$(stamp_of "$d")" \
        --argjson urgent "$(is_urgent "$d" && printf true || printf false)" \
        --arg merged "$merged" --arg reaped "$reaped" --arg held "$held" \
        --argjson holding_slot "$holding" \
        --argjson after "$(after_json "$d")" --argjson blocked "$blocked" '
        def str: if . == "" then null else . end;
        { task: $task, stamp: ($stamp|tonumber), urgent: $urgent, state: $state, dir: $dir,
          repo: $repo, branch: $branch, model: $model, effort: $effort,
          dev: ($dev == "true"), intent: ($intent|str), added: ($added|str),
          agent: ($agent | if . == "-" then null else . end),
          pr: ($pr|str|if . then tonumber else null end),
          pr_state: ($prstate|str), pr_draft: ($draft == "draft"),
          after: $after, blocked: $blocked, holding_slot: $holding_slot,
          merged: ($merged|str), reaped: ($reaped|str), held: ($held|str) }' >> "$tbl"
    else
      local row="$slug"
      [ "$multi" = 1 ] && row="${row}${TAB}$(cell "$(basename "${repo:--}")" 20)"
      row="${row}${TAB}${dispst}"
      [ "$multi_model" = 1 ]  && row="${row}${TAB}${model:--}"
      [ "$multi_effort" = 1 ] && row="${row}${TAB}${effort:--}"
      row="${row}${TAB}${agent}${TAB}${pr}${TAB}$(age_of "$added")"
      printf '%s\n' "$row" >> "$tbl"
    fi
  done <<<"$tasks"

  if [ "$as_json" = 1 ]; then
    jq -s '.' "$tbl"
  else
    render_table "$tbl"
    local nq nr narch
    nq=$(ls -d "$PQ_HOME/queue"/*/ 2>/dev/null | wc -l | tr -d ' ')
    nr=$(ls -d "$PQ_HOME/running"/*/ 2>/dev/null | wc -l | tr -d ' ')
    narch=$(ls -d "$PQ_HOME/archive"/*/ 2>/dev/null | wc -l | tr -d ' ')
    printf '\n' >&2
    # The wrap-up count only earns its words when there is one, but when there
    # is, it is the line that explains a queue sitting still at a cap that looks
    # unreached - so it names the cap alongside it rather than leaving you to
    # add the two numbers up yourself.
    msg "$nr running$([ "$nwrap" -gt 0 ] && printf ' + %s wrapping up (cap %s)' "$nwrap" "$(cap_get)"), $nq queued\
$([ "$needs" -gt 0 ] && printf ' (%s needs you)' "$needs")\
$([ "$narch" -gt 0 ] && printf ', %s archived%s' "$narch" "$([ "$all" = 1 ] || printf ' (--all to see)')")"
  fi
  rm -f "$tbl" "$PR_CACHE" "$PR_ANS"
  repo_base_reset
}

# ── the small movers ────────────────────────────────────────────────────────
cmd_show() {
  local d st; d=$(find_task "${1:-}") || exit 1
  st=$(state_of "$d")
  case "$st" in queue|hold) is_urgent "$d" && st="$st, urgent" ;; esac
  printf '%s  [%s]\n\n' "$(slug_of "$d")" "$st"
  local k
  for k in repo branch model effort dev intent source added; do
    printf '  %-8s %s\n' "$k" "$(hdr "$d/plan.md" "$k")"
  done
  if [ -f "$d/state.env" ]; then
    printf '\n  runtime\n'
    sed 's/^/    /' "$d/state.env"
  fi
  if [ -f "$d/after" ]; then
    printf '\n  after\n'
    pr_load_all "$(after_list "$d" | awk -F'\t' '{ print $2 "\t" $3 }')"
    local label repo branch base bst
    while IFS=$'\t' read -r label repo branch; do
      [ -n "$label" ] || continue
      base=$(repo_base "$repo")
      bst=$(blocker_state "$repo" "$branch" "${base:-}")
      printf '    %-20s %-8s %s\n' "$label" "$bst" "$branch"
    done <<<"$(after_list "$d")"
    rm -f "$PR_CACHE" "$PR_ANS"
    repo_base_reset
  fi
  printf '\n%s\n\n' "$(printf '─%.0s' $(seq 1 60))"
  # The plan itself, with our header stripped back off. Leading blank lines go too -
  # the header is followed by one, and it would otherwise stack with the gap above.
  # A file with no header at all just prints whole, which is the right fallback.
  awk 'NR == 1 && $0 == "---" { inh = 1; next }
       inh && $0 == "---" { inh = 0; next }
       inh { next }
       !started && $0 ~ /^[[:space:]]*$/ { next }
       { started = 1; print }' "$d/plan.md"
}

# The shared `queue|hold` guard for ordering: `pq urgent` and `pq later` (and
# `pq after`'s mutating forms, which cite this same message shape) only ever
# move what has not started.
order_movable() {                       # task_dir -> dies unless queue|hold
  case "$(state_of "$1")" in
    queue|hold) ;;
    *) die "$(slug_of "$1") is $(state_of "$1") - ordering only moves what has not started" ;;
  esac
}

# `pq urgent` and `pq later` are the whole of re-ordering. The queue is add-order,
# so the only two moves that matter are "do this next" and "not yet" - there is no
# number to slot between two tasks, because there is no number. Both are a
# re-stamp, restricted to what has not started, the same rule blockers follow.
cmd_urgent() {
  local d; d=$(find_task "${1:-}") || exit 1
  order_movable "$d"
  is_urgent "$d" && { msg "$(slug_of "$d") is already urgent"; return 0; }
  # "-> urgent" only, not "next off the queue": next_stamp(1) lands behind
  # whatever else is already urgent, so this promotion can land anywhere
  # within the urgent group, not necessarily at its very front.
  retitle "$d" "$(state_of "$d")" "$(next_stamp 1)" >/dev/null
  msg "$(slug_of "$d") -> urgent"
}

cmd_later() {
  local d; d=$(find_task "${1:-}") || exit 1
  order_movable "$d"
  retitle "$d" "$(state_of "$d")" "$(next_stamp 0)" >/dev/null
  msg "$(slug_of "$d") -> back of the queue"
}

cmd_hold() {
  local d; d=$(find_task "${1:-}") || exit 1
  [ "$(state_of "$d")" = queue ] || die "$(slug_of "$d") is $(state_of "$d"), not queued"
  # Read before the move: holding A silently stalls everything after it, and
  # this is the moment to say so - same reasoning as the cmd_rm warning below.
  local deps; deps=$(dependents_of "$(hdr "$d/plan.md" repo)" "$(hdr "$d/plan.md" branch)" | tr '\n' ' ')
  retitle "$d" hold >/dev/null; msg "held $(slug_of "$d") - nothing will pick it up"
  [ -z "$deps" ] || warn "$(slug_of "$d") is a blocker for: ${deps% } - holding it stalls them too"
}

cmd_unhold() {
  local d; d=$(find_task "${1:-}") || exit 1
  [ "$(state_of "$d")" = hold ] || die "$(slug_of "$d") is $(state_of "$d"), not held"
  retitle "$d" queue >/dev/null; msg "queued $(slug_of "$d")"
}

# `pq after <task>` alone answers "why has this not started": per blocker, both
# the state of the TASK that owns the branch and the state of its PR, since
# either one can be the reason and the fix differs.
#
# `pq after <task> <task|branch>...` adds blockers; `--clear` drops them all.
# Restricted to queue and hold, with order_movable's message shape - blockers
# only gate what has not started.
cmd_after() {
  local d; d=$(find_task "${1:-}") || exit 1; shift

  if [ $# -eq 0 ]; then
    if [ ! -f "$d/after" ]; then
      msg "$(slug_of "$d") has no blockers"
      return 0
    fi
    pr_load_all "$(after_list "$d" | awk -F'\t' '{ print $2 "\t" $3 }')"
    local label repo branch base bst owner ownerst num prstate draft prtxt desc overdict
    while IFS=$'\t' read -r label repo branch; do
      [ -n "$label" ] || continue
      base=$(repo_base "$repo")
      bst=$(blocker_state "$repo" "$branch" "${base:-}")
      owner=$(task_by_branch "$repo" "$branch") || owner=""
      ownerst=${owner:+$(state_of "$owner")}; ownerst=${ownerst:--}
      IFS=$'\t' read -r num prstate draft <<<"$(pr_get "$repo" "$branch")"
      case "${prstate:-}" in
        MERGED) prtxt="#$num merged" ;;
        OPEN)   prtxt="#$num ${draft:-open}" ;;
        CLOSED) prtxt="#$num closed" ;;
        *)      prtxt="no PR yet" ;;
      esac
      case "$bst" in
        met)     desc="merged into ${base:-its default branch} - satisfied" ;;
        waiting)
          case "$ownerst" in
            done|-) desc="waiting on your merge" ;;
            hold)   desc="parked - nothing will pick it up" ;;
            *)
              IFS=$'\t' read -r overdict _ <<<"$(after_state "$owner")"
              case "$overdict" in
                waiting\ *) desc="waiting on ${overdict##* } of its own" ;;
                *)          desc="in progress" ;;
              esac
              ;;
          esac
          ;;
        stalled) desc="stalled - a draft PR, but its task already reached done" ;;
        dead)    desc="dead - every PR for it is closed" ;;
        orphan)  desc="orphan - nothing will ever open a PR for this branch" ;;
        *)       desc="gh has not answered yet" ;;
      esac
      printf '  %-20s %-8s %-12s %s\n' "$label" "$ownerst" "$prtxt" "$desc"
    done <<<"$(after_list "$d")"
    rm -f "$PR_CACHE" "$PR_ANS"
    repo_base_reset
    return 0
  fi

  # Both mutating forms - clearing and adding - are restricted to what has not
  # started, same message shape as order_movable: blockers only gate a task
  # that has not been dispatched yet.
  case "$(state_of "$d")" in
    queue|hold) ;;
    *) die "$(slug_of "$d") is $(state_of "$d") - blockers only gate what has not started" ;;
  esac

  if [ "$1" = --clear ]; then
    rm -f "$d/after"
    msg "cleared blockers on $(slug_of "$d")"
    return 0
  fi

  local owner_repo owner_branch value resolved label repo branch base
  owner_repo=$(hdr "$d/plan.md" repo); owner_branch=$(hdr "$d/plan.md" branch)
  for value in "$@"; do
    resolved=$(resolve_after "$owner_repo" "$value") || die "could not resolve '$value' to a task or branch"
    IFS=$'\t' read -r label repo branch <<<"$resolved"
    [ -n "$repo" ] && [ -n "$branch" ] || die "could not resolve '$value' to a repo and branch"
    [ "$repo" = "$owner_repo" ] && [ "$branch" = "$owner_branch" ] && die "a task cannot block on itself"
    after_cycle "$owner_repo" "$owner_branch" "$repo" "$branch" \
      && die "'$value' would create a cycle - $(slug_of "$d") already leads back to it"
    after_add "$d" "$label" "$repo" "$branch"
    pr_load_all "$(printf '%s\t%s\n' "$repo" "$branch")"
    base=$(repo_base "$repo")
    if [ -n "$base" ] && pr_merged_into "$repo" "$branch" "$base"; then
      msg "$(slug_of "$d") after $label: already merged into $base - nothing to wait for"
    else
      msg "$(slug_of "$d") after $label ($branch)"
    fi
  done
  rm -f "$PR_CACHE" "$PR_ANS"
  repo_base_reset
}

# Drops pq's record and nothing else. A dispatched task has a worktree, a branch
# and possibly a database behind it, and those belong to `wt` - reclaiming them
# here would make `pq rm` far more destructive than its name suggests.
cmd_rm() {
  local d; d=$(find_task "${1:-}") || exit 1
  # Read everything we will want to say BEFORE deleting the directory that holds it.
  local slug st branch repo ans deps reaped
  slug=$(slug_of "$d"); st=$(state_of "$d")
  branch=$(hdr "$d/plan.md" branch); repo=$(hdr "$d/plan.md" repo)
  deps=$(dependents_of "$repo" "$branch" | tr '\n' ' ')
  reaped=$(st "$d" PQ_REAPED)
  printf 'pq: remove task "%s" (%s)? [y/N] ' "$slug" "$st" >&2; read -r ans || ans=n
  [[ "${ans:-}" =~ ^[Yy]$ ]] || { msg "cancelled"; return 0; }
  rm -rf "$d" || die "could not remove $d"
  msg "removed $slug"
  # Removing A is exactly how B gets orphaned - nothing will ever open a PR for
  # a branch pq no longer knows about, so that is the moment to say so.
  [ -z "$deps" ] || warn "$slug was a blocker for: ${deps% } - they now wait on a branch nothing owns"
  case "$st" in
    running|done|archive)
      [ -n "$reaped" ] || warn "its worktree and branch are untouched - remove those with: wt rm $branch" ;;
  esac
}

# The manual escape hatch alongside archive_pass' automatic one - for the two
# legacy reaped-without-verdict stragglers, or anything else pq cannot prove
# either way itself. Restricted to `done`: a queued or running task still
# holds a slot or a worktree, so archiving it would strand one - `pq hold` and
# `pq rm` are the right tools there instead.
cmd_archive() {
  local d; d=$(find_task "${1:-}") || exit 1
  local st; st=$(state_of "$d")
  [ "$st" = done ] || die "$(slug_of "$d") is $st, not done - hold or remove it instead (pq hold / pq rm)"
  local slug name dst moved
  slug=$(slug_of "$d"); name=$(basename "$d")
  dst="$PQ_HOME/archive/$name"
  [ -e "$dst" ] && die "a task already exists at archive/$name"
  moved=$(retitle "$d" archive)
  st_set "$moved" PQ_ARCHIVED "$(now)"
  msg "archived $slug"
}

# ── dispatch ────────────────────────────────────────────────────────────────
# What every implementer is told. Short and fixed: the plan carries the work, this
# carries only the contract - how to finish, and how to fail without stalling.
#
# The two exits matter more than anything else here. pq frees a slot when a pull
# request exists, so an agent that finishes cleanly and simply stops has deadlocked
# the queue: done, idle, and holding its slot until morning. Leaving that to each
# plan to remember would mean one forgetful plan costs a whole night, so it lives
# here where it cannot be forgotten.
#
# It names no review step, and asking for one here is the wrong place to try. This
# prompt may only name capabilities the model can invoke ITSELF, and Claude Code's
# `/code-review` and `/security-review` are reserved for a human typing them
# (`disable-model-invocation`), so every dispatched agent answered the review clause
# that used to be here with a complaint that it could not run it. A review gate is
# still wanted; it needs a mechanism pq drives rather than a sentence in a prompt.
#
# Deliberately free of single quotes - it is wrapped in them below so it survives
# being re-parsed by the pane's shell, and the inline check in dispatch_task
# enforces that before anything is sent.
dispatch_prompt() {                     # plan_path
  printf '%s' "Read $1 and carry it out. \
Commit, push, and open a pull request whose description opens with the intent line \
from the plan header, followed by what you actually did. \
If you get stuck, or the plan turns out not to fit, commit what you have, push, and open \
a DRAFT pull request whose description explains what blocked you, then stop. \
Never wait for input - there is nobody watching."
}

# Start the agent for a task, resuming from wherever a previous tick got to. Each
# step records itself the instant it succeeds, so this is safe to re-enter: an
# interrupted dispatch picks up rather than starting over.
#
# Re-entry deliberately does NOT re-run `wt new` when the pane is still there. It
# would work - wt reopens an existing worktree rather than failing - but it also
# re-runs provisioning, and supercast's provisioning DROPS AND RECREATES the
# database. That is harmless before an agent has touched anything and destructive
# afterwards, so the cheap path is also the safe one.
# A shell function rather than an inline `cd ... && wt`, so `shielded` can run it as
# a single command. Functions are visible in the subshell it backgrounds; a `cd`
# baked into a command substitution would not be. It also stands in for a `--repo`
# flag `wt` doesn't have: `wt` takes its repo from `$PWD`, so both dispatch and
# reap need this same `cd` first.
wt_in() {                               # repo wt-subcommand args...
  local repo=$1; shift
  cd "$repo" || return 1
  "$WT" "$@"
}

dispatch_task() {                       # task_dir  -> 0 launched, 1 failed
  local d=$1 repo branch model effort dev pane wtjson cmdline prompt
  repo=$(hdr "$d/plan.md" repo);     branch=$(hdr "$d/plan.md" branch)
  model=$(hdr "$d/plan.md" model);   effort=$(hdr "$d/plan.md" effort)
  dev=$(hdr "$d/plan.md" dev)
  [ -n "$repo" ] && [ -n "$branch" ] || { warn "$(slug_of "$d"): plan.md has no repo/branch"; return 1; }
  [ -d "$repo" ] || { warn "$(slug_of "$d"): repo $repo is gone"; return 1; }

  pane=$(st "$d" PQ_PANE)
  if [ -z "$pane" ] || [ "$(pane_state "$pane")" = missing ]; then
    local devflag=--no-dev; [ "$dev" = true ] && devflag=""
    # `wt new` on a brand-new branch forks from the local origin/HEAD with no
    # fetch first, so a stale checkout can hand a task whose blocker just
    # merged a base that predates the very commit it waited for - `pq` says "A
    # merged, go" and `wt` forks from an origin/master that does not contain A.
    # Bounded and non-fatal: this runs outside `shielded`, so an unreachable
    # remote must not sit on a TCP timeout and stall the tick with a free slot.
    GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o ConnectTimeout=5 -o BatchMode=yes}" \
      git -C "$repo" fetch --quiet origin 2>/dev/null \
      || warn "$(slug_of "$d"): could not fetch $repo - the worktree may fork from a stale base"
    msg "$(slug_of "$d"): preparing worktree for $branch"
    # Shielded: this is the slow one - a full database copy - and the one worth
    # letting finish when you Ctrl-C. wt's own progress still goes to stderr and
    # straight to the user; only its stdout (the JSON) is captured.
    # shellcheck disable=SC2086
    shielded wt_in "$repo" new --no-agent --no-focus $devflag --json "$branch" \
      || { warn "$(slug_of "$d"): wt new failed"; return 1; }
    wtjson=$SHIELDED_OUT
    pane=$(jq -r '.root_pane_id // empty' <<<"$wtjson" 2>/dev/null)
    [ -n "$pane" ] || { warn "$(slug_of "$d"): wt returned no pane"; return 1; }
    st_set "$d" PQ_WORKTREE "$(jq -r '.path // ""'         <<<"$wtjson")"
    st_set "$d" PQ_WORKSPACE "$(jq -r '.workspace_id // ""' <<<"$wtjson")"
    st_set "$d" PQ_PANE      "$pane"
    st_set "$d" PQ_URL       "$(jq -r '.url // ""'          <<<"$wtjson")"
    st_set "$d" PQ_PORT      "$(jq -r '.port // ""'         <<<"$wtjson")"
  else
    msg "$(slug_of "$d"): worktree already prepared, resuming at the agent"
  fi

  prompt=$(dispatch_prompt "$d/plan.md")
  case "$prompt$d" in
    *"'"*) warn "$(slug_of "$d"): prompt or path contains a quote - refusing to send"; return 1 ;;
  esac
  cmdline=$(printf "claude --model %s --effort %s '%s'" "${model:-$PQ_DEFAULT_MODEL}" "${effort:-$PQ_DEFAULT_EFFORT}" "$prompt")
  herdr pane send-text "$pane" "$cmdline" >/dev/null 2>&1 \
    && herdr pane send-keys "$pane" enter >/dev/null 2>&1 \
    || { warn "$(slug_of "$d"): could not start the agent in $pane"; return 1; }
  st_set "$d" PQ_LAUNCHED "$(now)"
  msg "$(slug_of "$d"): running ${model:-$PQ_DEFAULT_MODEL}/${effort:-$PQ_DEFAULT_EFFORT} in $pane"
  return 0
}

# ── reap ────────────────────────────────────────────────────────────────────
# `pq` frees a slot the moment a pull request exists, in any state, and stops
# caring - everything the task was built on survives: the worktree, its database,
# its port, its redis index, its puma-dev entry, and the Herdr workspace holding
# the agent's pane. Reclaiming all of that used to be a human errand, `wt rm` by
# hand or `wt gc --merged` if you remembered it existed. This is the other end of
# dispatch: once a task's PR has genuinely merged into the repo's default branch,
# and only then, `pq` tears down what it built - the same `wt rm` you would have
# run yourself, driven unattended.
#
# `pq` still never touches a worktree it did not create, never merges or closes a
# pull request, and never force-pushes. A task whose PR never merges (every PR
# closed, or none at all) is left exactly as `wt rm` would have found it - you
# decide what to do with unshipped work.

# The whole pass's precondition. `PIDX_OK` means Herdr answered the snapshot, so
# the agent check below is real rather than a blank. `HERDR_ENV` plus a live
# `HERDR_SOCKET_PATH` (mirroring wt's own `in_herdr`) mean `pq` is itself inside a
# Herdr pane, which `wt rm`'s `need_herdr` requires and which is where `pq run` is
# meant to live anyway. These are not the same condition - the server can be
# answering while `pq` runs from a plain terminal, and that combination would fail
# inside `wt rm` on every tick. A teardown deferred to the morning costs nothing,
# so skip rather than guess.
reap_ok() {
  [ "${PIDX_OK:-0}" = 1 ] || return 1
  [ "${HERDR_ENV:-}" = 1 ] || return 1
  [ -S "${HERDR_SOCKET_PATH:-/nonexistent}" ] || return 1
  return 0
}

# True while a done task still needs a `gh` answer - none of `PQ_MERGED`,
# `PQ_CLOSED`, `PQ_REAPED` is set. This is what keeps `pr_targets running` from
# repeating a `gh` call forever once the verdict is in: a merged-but-held task
# stops watching (the verdict is already known; only local checks remain), a
# closed one stops for good, and a reaped one has nothing left to ask about.
reap_watching() {                       # task_dir
  [ -z "$(st "$1" PQ_MERGED)" ] && [ -z "$(st "$1" PQ_CLOSED)" ] && [ -z "$(st "$1" PQ_REAPED)" ]
}

# Tear one task down, once its PR has genuinely merged - 0 only when a teardown
# actually happened this pass, 2 when `--dry-run` would have done one (nothing
# is stamped either way), 1 for everything else. `tick_body` counts 0 as torn
# down and 2 as would-tear-down, the same split fill keeps between `started`
# and `would`.
#
# `dry` gates every write site individually rather than short-circuiting at the
# top: which of the three `--dry-run` messages applies depends on the hold
# reason, and that has to be computed before it can be printed.
reap_task() {                           # task_dir dry -> 0 torn down, 2 would (dry-run), 1 otherwise
  local d=$1 dry=$2 slug repo branch base wt merged=0 reason="" explanation="" was

  slug=$(slug_of "$d")

  # 1. Already reaped or closed - nothing left to do.
  { [ -n "$(st "$d" PQ_REAPED)" ] || [ -n "$(st "$d" PQ_CLOSED)" ]; } && return 1

  # 2. The worktree is already gone - a hand-run `wt rm`, or `wt gc`, got there
  #    first. Nothing left to invoke `wt` for, but the tick already paid for a
  #    verdict - reap_watching kept this task's branch in pr_targets running,
  #    so the row is already sitting in the cache pr_load_all loaded above.
  #    Resolve it before stamping PQ_REAPED, or a merged/closed task would be
  #    reaped with no verdict at all and never become archivable - exactly the
  #    state the two legacy `010-`/`020-` rows are stuck in today.
  wt=$(st "$d" PQ_WORKTREE)
  if [ -z "$wt" ] || [ ! -d "$wt" ]; then
    repo=$(hdr "$d/plan.md" repo); branch=$(hdr "$d/plan.md" branch)
    local verdict=""
    if [ -n "$repo" ] && [ -n "$branch" ]; then
      base=$(repo_base "$repo")
      if [ -n "$base" ] && pr_merged_into "$repo" "$branch" "$base"; then verdict=merged
      elif pr_all_closed "$repo" "$branch"; then verdict=closed
      fi
    fi
    if [ "$dry" = 1 ]; then
      msg "would stop watching $slug - its worktree is already gone$([ -n "$verdict" ] && printf ' (%s)' "$verdict")"
    else
      case "$verdict" in
        merged) st_set "$d" PQ_MERGED "$(now)" ;;
        closed) st_set "$d" PQ_CLOSED "$(now)" ;;
      esac
      st_set "$d" PQ_REAPED "$(now)"
      msg "$slug: worktree already gone - no longer watching"
    fi
    return 1
  fi

  repo=$(hdr "$d/plan.md" repo); branch=$(hdr "$d/plan.md" branch)
  [ -d "$repo" ] || { warn "$slug: repo $repo is gone - fix that, then the next tick will retry"; return 1; }

  # 3. Resolve the merge verdict once, from the PR cache the tick already paid
  #    for (pr_targets running now covers every watched done task's branch too).
  if [ -n "$(st "$d" PQ_MERGED)" ]; then
    merged=1
  else
    base=$(repo_base "$repo")
    if [ -z "$base" ]; then
      # Resolved first, ahead of the predicates below: with no base
      # pr_merged_into can never match and pr_all_closed will not fire on a
      # MERGED row, so without this the task would poll gh every tick forever.
      reason=nobase
    elif pr_merged_into "$repo" "$branch" "$base"; then
      merged=1
      [ "$dry" = 1 ] || st_set "$d" PQ_MERGED "$(now)"
    elif pr_all_closed "$repo" "$branch"; then
      # Terminal, so the stamp makes this warning once-only by itself.
      if [ "$dry" = 1 ]; then
        msg "would leave $slug alone - every PR closed without merging"
      else
        st_set "$d" PQ_CLOSED "$(now)"
        warn "$slug: every PR for it closed without merging - left alone, worktree untouched"
      fi
      return 1
    else
      return 1                          # still in review - no hold, just not yet
    fi
  fi

  # 4. Two holds, both only once merged (just now, or on an earlier pass).
  if [ "$merged" = 1 ]; then
    # The guard that matters most: closing the Herdr workspace pq is itself
    # running in would kill this pane partway through the teardown. Guarded on
    # HERDR_WORKSPACE_ID being non-empty so two blank strings can never match.
    if [ -n "${HERDR_WORKSPACE_ID:-}" ] && [ "$(st "$d" PQ_WORKSPACE)" = "$HERDR_WORKSPACE_ID" ]; then
      reason=here
    else
      case "$(pane_state "$(st "$d" PQ_PANE)")" in
        working|blocked) reason=agent ;;
      esac
    fi
  fi

  # 5. One place writes PQ_REAP_HELD, for all three reasons - stamp and warn on
  #    the transition into it, clear it the moment the hold recovers.
  case "$reason" in
    agent)  explanation="the agent is still going" ;;
    here)   explanation="pq is running inside this task's own workspace" ;;
    nobase) explanation="could not resolve $repo's default branch" ;;
  esac
  was=$(st "$d" PQ_REAP_HELD)
  if [ "$dry" = 1 ]; then
    if [ -n "$reason" ]; then
      msg "would leave $slug alone - $explanation"
      return 1
    fi
    # 2, not 0: nothing actually happened (dry-run stamps nothing), but this is
    # distinct from "nothing to do" - it is what lets tick_body count a
    # would-be teardown into its summary, the same way fill tracks `would`
    # separately from `started`.
    msg "would tear down $slug ($branch)"
    return 2
  fi
  if [ -n "$reason" ]; then
    [ "$was" = "$reason" ] || { st_set "$d" PQ_REAP_HELD "$reason"
      warn "$slug: merged, but holding - $explanation"; }
    return 1
  fi
  [ -z "$was" ] || st_set "$d" PQ_REAP_HELD ""

  # 6. Tear it down - the same `wt rm` you would have run yourself. Shielded for
  #    the same reason `wt new` is: it drops a database, and a Ctrl-C mid-drop
  #    should not leave that half-done.
  if shielded wt_in "$repo" rm --yes "$branch"; then
    st_set "$d" PQ_REAPED "$(now)"
    msg "$slug: merged - tore down $branch"
    return 0
  fi
  warn "$slug: wt rm failed - run by hand: wt rm -y $branch"
  return 1
}

# ── archive ─────────────────────────────────────────────────────────────────
# `done/` never gets pruned on its own, so every task pq has ever finished
# still shows in it - and, once reap_task has torn a merged task's worktree
# down, still shows in `pq ls` too, for nothing pq or you can still decide.
# `archive_pass` (called from `tick_body`) files that settled history away to
# `archive/`, a fifth state nothing walks on the hot path.

# Terminal history - nothing pq or you can still decide, so it can leave done/.
# Two ways in, both stamped by reap_task:
#   PQ_CLOSED           every PR closed without merging - it will never ship
#   PQ_MERGED+PQ_REAPED it shipped and the worktree is gone
# PQ_REAP_HELD needs no check: reap_task clears it before it can ever stamp
# PQ_REAPED, so a held task cannot satisfy the second rule.
archivable() {                          # task_dir -> 0 when it can leave done/
  [ -n "$(st "$1" PQ_CLOSED)" ] && return 0
  [ -n "$(st "$1" PQ_MERGED)" ] && [ -n "$(st "$1" PQ_REAPED)" ] && return 0
  return 1
}

# Files every archivable done/ task away, except the newest PQ_DONE_KEEP -
# kept behind so `pq ls` still answers "did last night's batch ship?" at a
# glance. Ordered by `stamp_of`, exactly as `queue_ordered` is, NOT by glob
# order - done/ still holds legacy directories whose width disagrees with the
# %014d prefix (see all_tasks' own caveat).
#
# Never reaches retitle's `die`: this runs inside tick_body's lock, so a
# destination collision - a hand-corrupted archive/ sharing this task's name -
# is worth one skipped row, not an aborted tick. next_stamp spanning archive
# (see all_tasks) is what keeps a FRESH task's destination from ever
# colliding; this guard is only for archive/ itself having been tampered with.
#
# Prints the count archived (or that would be, under --dry-run) so tick_body
# can fold it into its one-line summary.
archive_pass() {                        # dry -> count, via stdout; msg/warn as it goes
  local dry=$1 d cands total keep=$PQ_DONE_KEEP n_arch=0
  # Piped straight from the loop, same as queue_ordered - NOT built up in a
  # variable and fed to sort through <<<, which appends its own trailing
  # newline on top of the loop's and sorts that spurious blank line (numeric
  # key 0) to the very front, stealing a slot from head -n below.
  cands=$(
    for d in "$PQ_HOME/done"/*/; do
      [ -d "$d" ] || continue
      d=${d%/}
      archivable "$d" || continue
      printf '%s\t%s\n' "$(stamp_of "$d")" "$d"
    done | sort -s -n -k1,1 | cut -f2-
  )
  [ -n "$cands" ] || { printf 0; return; }

  total=$(grep -c . <<<"$cands")
  local to_archive=$(( total - keep ))
  if [ "$to_archive" -le 0 ]; then printf 0; return; fi

  local slug branch dst why moved
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    slug=$(slug_of "$d")
    dst="$PQ_HOME/archive/$(basename "$d")"
    if [ -e "$dst" ]; then
      warn "$slug: could not archive - archive/$(basename "$d") already exists"
      continue
    fi
    branch=$(hdr "$d/plan.md" branch)
    if [ -n "$(st "$d" PQ_CLOSED)" ]; then
      why="its PR closed without merging; worktree untouched (wt rm ${branch:-?})"
    else
      why="it shipped; worktree already torn down"
    fi
    if [ "$dry" = 1 ]; then
      msg "would archive $slug - $why"
    else
      moved=$(retitle "$d" archive)
      st_set "$moved" PQ_ARCHIVED "$(now)"
      msg "archived $slug - $why"
    fi
    n_arch=$((n_arch + 1))
  done <<<"$(head -n "$to_archive" <<<"$cands")"
  printf '%s' "$n_arch"
}

# ── tick ────────────────────────────────────────────────────────────────────
# One idempotent pass: free what has finished, finish what was interrupted, then
# fill whatever room that left. Reconcile runs BEFORE the cap is counted, so a task
# that shipped during the last interval hands its slot straight to the next one.
# One tick at a time. The per-task `mv` already stops the same plan being claimed
# twice, but two ticks running concurrently would each see the same free slots and
# between them overshoot the cap. mkdir is the atomic primitive; a lock whose owner
# is gone is stale and reclaimed.
#
# Taken and released around each tick rather than held for the life of the process,
# because `pq run` ticks in a loop - a lock released only at exit would make every
# tick after the first find the lock held, by itself, forever.
take_lock() {                           # -> 0 took it, 1 someone else has it
  local owner
  PQ_LOCK="$PQ_HOME/.tick.lock"
  if ! mkdir "$PQ_LOCK" 2>/dev/null; then
    owner=$(cat "$PQ_LOCK/pid" 2>/dev/null)
    if [ -n "$owner" ] && kill -0 "$owner" 2>/dev/null; then PQ_LOCK=""; return 1; fi
    warn "clearing a stale tick lock"
    rm -rf "$PQ_LOCK"; mkdir "$PQ_LOCK" 2>/dev/null || die "could not take the tick lock"
  fi
  printf '%s' "$$" > "$PQ_LOCK/pid"
  # The EXIT trap is the backstop for an abnormal exit; the normal path releases below.
  trap 'rm -rf "$PQ_LOCK"' EXIT
  return 0
}
release_lock() {
  [ -n "${PQ_LOCK:-}" ] && rm -rf "$PQ_LOCK"
  PQ_LOCK=""; trap - EXIT; return 0
}

cmd_tick() {
  local cap="" dry=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --cap)     cap=${2:-}; shift 2 ;;
      --dry-run) dry=1; shift ;;
      -*)        die "unknown option '$1' (usage: pq tick [--cap N] [--dry-run])" ;;
      *)         die "unexpected argument '$1'" ;;
    esac
  done
  # Re-read the cap every tick, so `pq cap 0` takes effect on the next pass of a
  # loop that is already running. An explicit --cap overrides for this tick only and
  # deliberately does not write the file.
  [ -n "$cap" ] || cap=$(cap_get)
  [[ "$cap" =~ ^[0-9]+$ ]] || die "--cap must be a number, got '$cap'"

  # A one-shot tick needs the handler too, not just the loop: dispatch shields its
  # slow child from SIGINT, so without a trap here a Ctrl-C would kill pq and leave
  # that `wt new` running orphaned, with nobody left to record what it produced.
  [ "$PQ_RUN" = 1 ] || trap on_interrupt INT TERM

  if ! take_lock; then
    msg "another tick is running (pid $(cat "$PQ_HOME/.tick.lock/pid" 2>/dev/null)) - nothing to do"
    return 0
  fi
  tick_body "$cap" "$dry"
  local rc=$?
  release_lock
  return $rc
}

tick_body() {                           # cap dry
  local cap=$1 dry=$2
  pidx_load

  # PR state for the whole tick, loaded ONCE: every RUNNING task's branch (for
  # reconcile below), plus every blocker of a task that has not started (for
  # the eligibility check that follows fill). `done` is deliberately excluded -
  # reconcile never looks at it, so a done task's own branch would otherwise be
  # a `gh` call repeated every tick, forever, for history that cannot change
  # state again. One combined cache means a dependency that merged during the
  # last interval is visible to the SAME lookup reconcile just paid for, not a
  # second round trip a tick later.
  pr_load_all "$(pr_targets running)"

  # 1. Reconcile. A pull request - in any state - means the work left the queue, so
  #    the slot is free whether it merged, is in review, or was opened as a draft
  #    because the agent got stuck. Judging what to do about it is yours.
  local d slug branch repo running=()
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    running+=("$d")
  done <<<"$(for x in "$PQ_HOME/running"/*/; do [ -d "$x" ] && printf '%s\n' "${x%/}"; done)"

  if [ "${#running[@]}" -gt 0 ]; then
    for d in "${running[@]}"; do
      slug=$(slug_of "$d"); branch=$(hdr "$d/plan.md" branch)
      local num prstate draft
      IFS=$'\t' read -r num prstate draft <<<"$(pr_get "$(hdr "$d/plan.md" repo)" "$branch")"
      if [ -n "${num:-}" ]; then
        local what="${draft:-$(tr '[:upper:]' '[:lower:]' <<<"${prstate:-}")}"
        if [ "$dry" = 1 ]; then
          msg "would finish $slug (#$num $what)"
        else
          st_set "$d" PQ_PR "$num"; st_set "$d" PQ_FINISHED "$(now)"
          retitle "$d" done >/dev/null
          msg "finished $slug - #$num $what"
        fi
        continue
      fi
      # Claimed but never launched: an interrupted tick. Pick it up where it stopped.
      if [ -z "$(st "$d" PQ_LAUNCHED)" ]; then
        if [ "$dry" = 1 ]; then msg "would resume the interrupted dispatch of $slug"
        else warn "$slug: dispatch was interrupted - resuming"; dispatch_task "$d" || true; fi
        continue
      fi
      # The wall check runs for every state but `missing`, deliberately including
      # `noagent`. Whether herdr currently has an agent bound to the pane is the
      # same kind of dependency the detection itself avoids - a walled session that
      # momentarily reads as `noagent` would otherwise be written off as exited and
      # never knocked on.
      local pstate; pstate=$(pane_state "$(st "$d" PQ_PANE)")
      [ "$dry" = 1 ] || [ "$pstate" = missing ] || check_stall "$d"
      case "$pstate" in
        missing) warn "$slug: its workspace is gone and no PR exists - look at it, then: pq rm $slug" ;;
        noagent) [ "$(st "$d" PQ_BLOCKED)" = quota ] \
                   || warn "$slug: the agent exited without opening a PR - look at the pane, or: pq rm $slug" ;;
      esac
    done
  fi

  # 1.2 The wall, for tasks that have already opened their pull request. An agent
  # does not stop when it opens one - it answers review, fixes CI, pushes again -
  # so `done/` is where an unattended agent spends most of the night, and it can
  # hit the wall there exactly as easily as in `running/`. For a long time nothing
  # knocked on those panes at all, which made the whole section useless for the
  # case it was written for: three agents wrapping up at midnight, all three
  # walled, none of them touched by morning.
  #
  # No new authority comes with this. check_stall only ever answers the wall; a
  # permission prompt in `done/` is recorded and left for you, the same as
  # anywhere else. Reaped and closed tasks are skipped because their pane is gone
  # or their work never shipped, and it runs BEFORE reap and before active_slots
  # so the block it sets is visible to the teardown gate, to the slot arithmetic
  # and to the freeze below, all on the tick that set it.
  if [ "$dry" != 1 ]; then
    for d in "$PQ_HOME/done"/*/; do
      [ -d "$d" ] || continue
      d=${d%/}
      [ -n "$(st "$d" PQ_REAPED)" ] && continue
      [ -n "$(st "$d" PQ_CLOSED)" ] && continue
      [ "$(pane_state "$(st "$d" PQ_PANE)")" = missing ] && continue
      check_stall "$d"
    done
  fi

  # 1.25 Reap - tear down what merged, once the agent has stopped and pq is not
  # itself sitting in the workspace about to be closed. Runs after reconcile, so
  # a task that just moved from running/ to done/ this same tick is torn down on
  # the same pass, using the PR row `pr_targets running` already loaded for it
  # above - and before the blocker pass, though the two are independent (done
  # tasks vs. queue/hold tasks, neither reads the other's cache).
  local n_torn=0 would_torn=0 reap_note= rc
  if reap_ok; then
    for d in "$PQ_HOME/done"/*/; do
      [ -d "$d" ] || continue
      d=${d%/}
      reap_task "$d" "$dry"; rc=$?
      case "$rc" in
        0) n_torn=$((n_torn + 1)) ;;
        2) would_torn=$((would_torn + 1)) ;;
      esac
    done
  else
    # The gate can stay closed for a while - say so once something in done/ is
    # actually waiting on it, rather than every night it merely holds history.
    for d in "$PQ_HOME/done"/*/; do
      [ -d "$d" ] || continue
      d=${d%/}
      if reap_watching "$d" || { [ -n "$(st "$d" PQ_MERGED)" ] && [ -z "$(st "$d" PQ_REAPED)" ]; }; then
        reap_note=", teardown needs a herdr pane"; break
      fi
    done
  fi

  # 1.3 Archive - file settled done/ history away to archive/, right after reap
  # (which stamps the verdict this reads) and before the blocker pass. Needs
  # no herdr gate: archiving never touches a worktree, only a directory mv.
  local n_arch; n_arch=$(archive_pass "$dry")

  # 1.5 Blockers - runs for every task that has not started, queue AND hold,
  # so a chain stalled on a stuck agent's draft is flagged even while parked.
  # This runs AFTER reconcile and BEFORE fill, so a dependency that merged
  # during the interval that just ended unblocks its dependent on the same
  # tick that noticed, and it warms the per-task verdict fill reuses below
  # rather than recomputing it.
  local afterpass="$PQ_HOME/.after.$$"; : > "$afterpass"
  for d in "$PQ_HOME/queue"/*/ "$PQ_HOME/hold"/*/; do
    [ -d "$d" ] || continue
    d=${d%/}
    [ -f "$d/after" ] || continue
    printf '%s\t%s\n' "$d" "$(after_check "$d")" >> "$afterpass"
  done
  local waiting; waiting=$(awk -F'\t' '$2 !~ /^met/ { n++ } END { print n + 0 }' "$afterpass")

  # 2. Fill. A live agent is a slot, wherever its task now sits - every running/
  #    task (a task blocked on a permission prompt still holds one, the
  #    deliberate trade for running everything in auto mode) plus every done/
  #    task still wrapping up its pull request. See the `slots` section for why
  #    the second half is not optional.
  local n_run n_wrap active
  IFS=$'\t' read -r n_run n_wrap <<<"$(active_slots "$dry")"
  active=$(( n_run + n_wrap ))
  local free=$(( cap - active ))

  # ...and a wall stops fill outright, whatever the arithmetic says, because every
  # agent pq runs draws on the same window. See walled_slot.
  local walled_by walled_at
  IFS=$'\t' read -r walled_by walled_at <<<"$(walled_slot)"
  [ -n "$walled_by" ] && free=0

  # Build the queue ONCE, in stamp order, then walk it - skipping whatever
  # is not eligible - rather than re-globbing and taking the first entry every
  # pass, which only worked because a claimed task leaves queue/. --dry-run
  # reports every would-dispatch AND every would-skip with its reason, so a
  # queue that is entirely blocked reads differently from an empty one.
  local started=0 would=0 claimed verdict lbl n
  local ordered; ordered=$(queue_ordered)
  if [ -n "$ordered" ]; then
    while IFS= read -r d; do
      [ -n "$d" ] || continue
      slug=$(slug_of "$d")
      if [ "$free" -le 0 ]; then
        # Name the wall rather than the cap when the wall is what closed it: the two
        # want completely different things from you, and "cap reached" reads as
        # healthy.
        if [ "$dry" = 1 ]; then
          if [ -n "$walled_by" ]; then msg "would skip $slug - $(walled_note "$walled_at")"
          else msg "would skip $slug - cap reached"; fi
        fi
        continue
      fi
      verdict=$(awk -F'\t' -v d="$d" '$1 == d { print $2; exit }' "$afterpass")
      case "${verdict:-met}" in
        met) ;;
        waiting\ *)
          if [ "$dry" = 1 ]; then
            lbl=${verdict#waiting }; n=${lbl##* }; lbl=${lbl% *}
            msg "would skip $slug - waiting on $lbl ($n unmet)"
          fi
          continue ;;
        stalled\ *)
          [ "$dry" = 1 ] && msg "would skip $slug - blocker ${verdict#stalled } is stalled"
          continue ;;
        dead\ *)
          [ "$dry" = 1 ] && msg "would skip $slug - blocker ${verdict#dead } is dead"
          continue ;;
      esac
      if [ "$dry" = 1 ]; then
        msg "would dispatch $slug ($(hdr "$d/plan.md" branch))"
        # A separate counter from $started: --dry-run changes nothing, and a
        # summary that says "N started" when nothing moved is the one line a
        # human actually reads before trusting the rest of it.
        would=$((would + 1)); free=$((free - 1))
        continue
      fi
      # Claim FIRST. `wt new` takes the better part of a minute, and until the task has
      # left queue/ a second tick would happily pick up the very same plan.
      claimed=$(retitle "$d" running) || continue
      st_set "$claimed" PQ_CLAIMED "$(now)"
      dispatch_task "$claimed" || warn "$slug: left in running/ half-dispatched - the next tick will retry it"
      started=$((started + 1)); free=$((free - 1))
    done <<<"$ordered"
  fi

  rm -f "$afterpass" "$PR_CACHE" "$PR_ANS"
  repo_base_reset

  # Only running/ is recounted - fill just moved tasks into it. The wrap-up half
  # is reused rather than recomputed: nothing after fill can change it, and a
  # second active_slots pass would re-walk done/ for the same answer.
  n_run=$(ls -d "$PQ_HOME/running"/*/ 2>/dev/null | wc -l | tr -d ' ')
  local queued; queued=$(ls -d "$PQ_HOME/queue"/*/ 2>/dev/null | wc -l | tr -d ' ')
  # Name the two halves separately. A cap of 3 reading "3 running" while three
  # more agents were still wrapping up in done/ is precisely what made six live
  # agents look like a healthy tick for as long as this bug lasted.
  #
  # The wall gets said out loud for the same reason: `pq run` suppresses a summary
  # identical to the last one, so a frozen queue would otherwise leave a log that
  # goes quiet at 2am and says nothing about why.
  summary "$n_run running$([ "$n_wrap" -gt 0 ] && printf ' + %s wrapping up' "$n_wrap") (cap $cap), $queued queued\
$([ -n "$walled_by" ] && printf ', %s - starting nothing' "$(walled_note "$walled_at")")\
$([ "$started" -gt 0 ] && printf ', %s started' "$started")\
$([ "$would" -gt 0 ] && printf ', %s would start' "$would")\
$([ "$waiting" -gt 0 ] && printf ', %s waiting on a merge' "$waiting")\
$([ "$n_torn" -gt 0 ] && printf ', %s torn down' "$n_torn")\
$([ "$would_torn" -gt 0 ] && printf ', %s would tear down' "$would_torn")$reap_note\
$([ "$n_arch" -gt 0 ] && printf ', %s %s' "$n_arch" "$([ "$dry" = 1 ] && printf 'would archive' || printf 'archived')")"
}

# ── run ─────────────────────────────────────────────────────────────────────
# Tick, sleep, repeat - meant to sit in a Herdr space where it inherits the socket
# and you can watch it. Safe to stop and start whenever: the queue's state lives
# entirely in directories, so this process holds nothing that matters.
#
# Ctrl-C is a graceful stop. During the sleep - the overwhelmingly common case - it
# returns immediately. During a tick the work in flight is shielded from the signal
# (see `shielded`), so it genuinely runs to completion and the loop exits after it.
# A second interrupt means you would rather not wait, and it kills the shielded child
# too - otherwise "force" would leave a `wt new` running with nobody to record what
# it produced. Either way nothing is lost: a task caught mid-dispatch is left with no
# PQ_LAUNCHED, which the next reconcile recognises and resumes.
#
# Two `pq run` loops would not overshoot the cap - the tick lock serialises them -
# they would just tick twice as often. Harmless enough not to be worth a second lock.
PQ_STOP=0
on_interrupt() {
  printf '\n'
  if [ "$PQ_STOP" = 1 ]; then
    if [ -n "$SHIELDED_PID" ]; then
      msg "stopping now - abandoning the work in flight; the next tick will retry it"
      kill -TERM -"$SHIELDED_PID" 2>/dev/null || kill -TERM "$SHIELDED_PID" 2>/dev/null
    else
      msg "stopping now"
    fi
    release_lock; exit 130
  fi
  PQ_STOP=1
  if [ -n "$SHIELDED_PID" ]; then
    msg "finishing the work in flight, then stopping (Ctrl-C again to abandon it)"
  else
    msg "stopping after this tick (Ctrl-C again to stop now)"
  fi
}

# sleep in the background and `wait` on it, so the trap runs the moment a signal
# arrives rather than after the sleep has run its course. A bare `sleep` is only
# interruptible when the signal reaches it too, which is not true of `kill -INT`.
nap() {                                 # seconds
  local pid
  sleep "$1" & pid=$!
  wait "$pid" 2>/dev/null
  kill "$pid" 2>/dev/null
  return 0
}

cmd_run() {
  local interval=120 cap=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --interval) interval=${2:-}; shift 2 ;;
      --cap)      cap=${2:-}; shift 2 ;;
      -*)         die "unknown option '$1' (usage: pq run [--interval SECONDS] [--cap N])" ;;
      *)          die "unexpected argument '$1'" ;;
    esac
  done
  [[ "$interval" =~ ^[0-9]+$ ]] && [ "$interval" -ge 5 ] || die "--interval must be a number of seconds, at least 5"
  # --cap here SETS the cap rather than overriding for one pass, since this is the
  # long-running thing: what you pass at startup should be what `pq cap` reports.
  [ -n "$cap" ] && { [[ "$cap" =~ ^[0-9]+$ ]] || die "--cap must be a number"; cap_set "$cap"; }

  PQ_RUN=1
  trap on_interrupt INT TERM
  msg "running every ${interval}s at cap $(cap_get) - change it any time with 'pq cap N', Ctrl-C to stop"

  local last=""
  while :; do
    # Suppress a summary identical to the last one, so an idle night leaves a log of
    # what changed rather than hundreds of lines saying nothing happened.
    PQ_SUMMARY=""
    cmd_tick || true
    if [ -n "$PQ_SUMMARY" ] && [ "$PQ_SUMMARY" != "$last" ]; then
      printf 'pq: [%s] %s\n' "$(date '+%H:%M')" "$PQ_SUMMARY" >&2
      last=$PQ_SUMMARY
    fi
    [ "$PQ_STOP" = 1 ] && break
    nap "$interval"
    [ "$PQ_STOP" = 1 ] && break
  done
  release_lock
  # The same arithmetic the tick itself used, for the same reason cmd_cap uses
  # it: this is the line you read as you Ctrl-C, and "2 still running" while six
  # agents are live is how the cap came to be trusted when it should not have
  # been. slot_state, not slot_held - the loop is over, and nobody's clock should
  # start on the way out.
  local n_run n_wrap d
  n_run=$(ls -d "$PQ_HOME/running"/*/ 2>/dev/null | wc -l | tr -d ' ')
  n_wrap=0
  for d in "$PQ_HOME/done"/*/; do
    [ -d "$d" ] || continue
    [ -n "$(slot_state "${d%/}")" ] && n_wrap=$((n_wrap + 1))
  done
  msg "stopped - $n_run still running$([ "$n_wrap" -gt 0 ] && printf ' + %s wrapping up' "$n_wrap"), queue untouched"
}

# Wrapped so the script can be sourced without dispatching - `test/pq-after.sh`
# sources this file to reach the predicate directly. An `if` rather than a
# trailing `[ ... ] && main "$@"`: that form makes a sourced script return
# non-zero, which would kill any test running under `set -e`.
main() {
  case "${1:-}" in
    add)        shift; cmd_add "$@" ;;
    after)      shift; cmd_after "$@" ;;
    tick)       shift; cmd_tick "$@" ;;
    run)        shift; cmd_run "$@" ;;
    cap)        shift; cmd_cap "$@" ;;
    ls|list)    shift; cmd_ls "$@" ;;
    show)       shift; cmd_show "$@" ;;
    urgent)     shift; cmd_urgent "$@" ;;
    later)      shift; cmd_later "$@" ;;
    hold)       shift; cmd_hold "$@" ;;
    unhold)     shift; cmd_unhold "$@" ;;
    rm|remove)  shift; cmd_rm "$@" ;;
    archive)    shift; cmd_archive "$@" ;;
    *) die "usage: pq {add [plan] [--urgent] [--after task|branch]... [--split | --split-dir DIR] [-y] [--json] | after <task> [<task|branch>... | --clear] | ls [--all] [--json] | show <task> | tick [--cap N] [--dry-run] | run [--interval S] [--cap N] | cap [N] | urgent <task> | later <task> | hold <task> | unhold <task> | rm <task> | archive <task>}" ;;
  esac
}
if [ "${BASH_SOURCE[0]}" = "$0" ]; then main "$@"; fi
