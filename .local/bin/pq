#!/usr/bin/env bash
# pq - a queue of Claude Code plans, waiting to be run as implementer sessions.
#
# The split this exists to make: one long-lived session, in plan mode, does the
# thinking and produces a plan that has already answered every question. `pq` then
# runs those plans - later, unattended, several at a time - as cheap implementer
# sessions that only have to execute. An agent that cannot get stuck is an agent
# that can work overnight.
#
# `pq` owns plans and scheduling. It does not own worktrees: it shells out to `wt`
# for an isolated, provisioned worktree and starts its own agent in the pane that
# comes back. The two tools are separable on purpose - `wt` is complete without
# `pq`, and `pq` reaches it through one narrow seam (`wt new --no-agent --no-focus
# --json`).
#
#   pq add               pick a plan and add it to the queue
#   pq add --base B      fork from B and open the PR against it, not the default branch
#   pq add --urgent      allocate from a reserved range, ahead of every real date
#   pq add --after T     repeatable: don't dispatch until T's PR has merged
#   pq add --design P    repeatable: a design file the implementer builds to (auto-detected from the plan too)
#   pq add --split       queue a plan that lays out several pull requests as one task each, wired with --after
#   pq add --split-dir D queue an already-split directory, skipping the split step
#   pq evidence [task]   publish a task's screenshots to the pq-evidence branch; prints the markdown to paste
#   pq after <task>      list a task's blockers and what each is waiting on
#   pq after <task> T... add blockers to a task already in the queue
#   pq after <task> --clear   drop them all
#   pq base <task>       what branch it forks from and aims its PR at
#   pq base <task> B     retarget it (queued only - a base can be merged and deleted)
#   pq base <task> --clear   back to the repo's default branch
#   pq ls                every task, its state, and what it is waiting on
#   pq ls --all           also show archive/ - settled history pq no longer walks
#   pq rm <task>         drop a task (never touches a worktree or a branch)
#   pq tick              free finished slots, then fill them from the queue
#   pq run               tick on an interval until you stop it
#   pq cap [N]           how many may run at once; 0 pauses. Read every tick.
#
# `pq tick` is one idempotent pass, safe to run by hand at any time - including
# alongside a running `pq run`.
#
# The cap counts live AGENTS, not directories in `running/`. An agent does not
# exit when it opens its pull request, so a task reconcile has moved to `done/`
# keeps spending its slot until that agent has actually stopped - see the
# `slots` section below for why the release is a timer rather than an exit.
#
# A task may name blockers: other work that must have merged before it is
# eligible for dispatch. Blocked is derived, not stored - a blocked task sits in
# `queue/` like any other, and fill just skips it, the same way the cap is soft
# arithmetic rather than a drain state. Merge state comes from the forge (`gh`),
# never from a BRANCH TIP's git ancestry - a squash-merged branch's tip is not an
# ancestor of anything, so `git branch --merged` misses every real merge. See
# `after_state` below for the full predicate.
#
# What "merged" means is per-task, not per-repo. A task's `base:` header names the
# branch it forks from and opens its pull request against; without one it is the
# repo's default branch, which is what every task had before the header existed.
# A blocker is met when its work is present in the DEPENDENT's base - the question
# a fork point actually asks - so a stack landing on an integration branch is
# gated correctly instead of waiting forever on a trunk it was never aimed at.
# `merged_into` is that predicate, and the one place git ancestry is consulted:
# on the forge's own MERGE COMMIT, which unlike a branch tip is by construction on
# the branch it landed on. The forge still decides whether something merged; git
# only answers where that work now sits.
#
# `pq` also tears its own tasks down, the other end of that same `wt` seam. A done
# task earns a teardown once its pull request has SETTLED, which is either of two
# things:
#
#   merged into THE BASE IT WAS AIMED AT - its own `base:` header, or its repo's
#   default branch when it has none; checked against the forge, never `wt`'s
#   looser "state == MERGED"
#
#   closed without merging, every pull request for the branch - closing one is a
#   decision that the work is finished, so it settles the task exactly as a merge
#   does and reclaims exactly as much
#
# Then `pq` runs the equivalent of `wt rm` on it, unattended. It never touches a
# worktree it did not create, and never merges or closes a pull request itself -
# the decision is always yours, and this only acts on one you already made. The
# one thing that holds a teardown off is the agent still going, or `pq` itself
# sitting in the workspace about to be closed - see `reap_task` below.
#
# "Merged into its base" is deliberately not the same as "merged": a task aimed
# at an integration branch that lands there HAS shipped as far as it was ever
# going to, and one aimed at the trunk that landed somewhere else has not.
#
# Between a pull request opening and you reading it, `pq` does two more things.
# Every implementer is dispatched with a delivery CONTRACT (`contract_write`):
# small logical commits in reading order, screenshots of every screen touched,
# a side-by-side comparison against the design files the task carries
# (`pq add --design`, or detected from the plan's text), and a DRAFT pull request
# with a review guide. Then the REVIEW GATE runs one independent `/code-review`
# against the draft in the background - and a `/security-review` beside it when
# the plan asks for one - and prompts the implementer to resolve what they found
# and mark the pull request ready - see the `review gate` section.
#
# Once a done task has settled AND been torn down - not on the verdict alone,
# which would strand its worktree - `pq tick` files it away to `archive/`, keeping only the
# newest few behind (`PQ_DONE_KEEP`) so `pq ls` stays a list of what still
# needs a look rather than a growing pile of finished history. See
# `archive_pass` below.
#
# LAYOUT ─────────────────────────────────────────────────────────────────────
# A task is a DIRECTORY, and the directory it sits in is its state:
#
#   $PQ_HOME/queue/20260729143022-live-chat-mentions/    waiting to be picked up
#            running/20260729121005-spotify-scope-fix/   dispatched
#            done/20260728091500-live-chat-links/        a PR exists; still spending a slot until its agent stops
#            archive/20260727080000-live-chat-onboarding/  settled history - `pq ls` hides it, tick never walks it
#            splits/live-chat-mentions-20260728-141230-83421/   a plan mid-split, or one left over
#            tasks/20260729121005-spotify-scope-fix        a symlink to wherever the task is NOW - the one path
#                                                          the implementer is ever told, since the real one moves
#
#   <task>/plan.md     the settings header + Claude's plan, immutable once added
#                     (`base:` is optional and absent on most tasks - see `task_base`;
#                      `design:` likewise, a comma-separated list of the files in design/;
#                      `security: yes` likewise, when the plan asks for a security review - see name_plan)
#          after       blockers: one per line, TSV  label <TAB> repo <TAB> branch
#          state.env   KEY=VALUE runtime facts, written as dispatch progresses
#          contract.md how the plan is to be delivered - written once, at dispatch, from
#                      pq's own template (see `contract_write`); the plan carries the work,
#                      this carries the rules for turning it into a reviewable pull request
#          design/     the design files the plan was built from, copied in at add time
#          evidence/   the implementer's screenshots, published by `pq evidence`
#          review.json the review gate's own `claude -p` output, plus review.err and
#          review.rc   its stderr and exit code - see the `review gate` section
#          security.*  the same three for the security reviewer, when the plan asked for one,
#                      and security.md, the report it wrote, which pq posts on the pull request
#
#   <split>/source.md     the plan being split, copied in
#          repos          the repo inventory the splitter was shown: TSV  label <TAB> path, primary first - what --split-dir checks against
#                         (a split written before this file's field was called `repo` - one bare line, the primary only - and do_split still reads it as a fallback)
#                         (row 1 can instead be a no-primary sentinel - an empty label, a container directory's path - when the plan was split from a directory that is not itself a repo; see repo_candidates_container)
#          graph.tsv      one line per part: filename <TAB> comma-separated filenames that must merge first <TAB> repo label (empty for the primary, REQUIRED when there is none)
#          NN-*.md        the parts themselves, written by the splitter
#          splitter.json  the splitter session's own JSON output - cost, duration, permission denials
#          splitter.err   the splitter session's stderr, read on failure
#          .named.tsv     part <TAB> branch <TAB> slug <TAB> intent <TAB> security (yes or empty), written once naming succeeds
#
# `after` is neither of the other two: `plan.md` is immutable by contract so an
# agent re-reading its own plan never sees it change, and `state.env` is runtime
# facts written as dispatch progresses. Blockers are your intent, edited before
# dispatch, so they get their own file - named for the verb that writes it. An
# absent file means no blockers.
#
# Every transition is a `mv`, which is atomic within one filesystem - so two
# dispatchers racing cannot both claim the same task, and a `mv` that fails means
# somebody else got there first. Splitting the immutable plan from the mutable
# state also means an agent can re-read its own plan at any point and never see it
# change underneath it.
#
# The fourteen-digit prefix is a UTC timestamp and nothing else - the queue is
# add-order, oldest first. It is not an identity: a task's directory is renamed
# as it changes state, so every command here takes the SLUG (or any unique
# prefix of it) instead.

set -uo pipefail

PQ_HOME="${PQ_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}/pq}"
PLANS_DIR="${PQ_PLANS_DIR:-$HOME/.claude/plans}"
WT="${PQ_WT:-$HOME/.local/bin/wt}"
STATES="queue running done archive"

# Any stamp below this has a year under 1000, so it cannot be a date pq ever
# produced - which is what makes the low range safe to reserve for --urgent.
PQ_STAMP_REAL=10000000000000

PQ_DEFAULT_MODEL="${PQ_DEFAULT_MODEL:-sonnet}"
PQ_DEFAULT_EFFORT="${PQ_DEFAULT_EFFORT:-xhigh}"
PQ_NAMER_MODEL="${PQ_NAMER_MODEL:-haiku}"
PQ_SPLITTER_MODEL="${PQ_SPLITTER_MODEL:-opus}"
PQ_SPLITTER_EFFORT="${PQ_SPLITTER_EFFORT:-xhigh}"
PQ_PICK_LIMIT="${PQ_PICK_LIMIT:-10}"       # plans per page in pick_plan; `n`/`p` walk the rest
# A non-positive limit would break "Enter takes 1" - the table would have
# zero rows, yet Enter still defaults to a row 1 that can't exist - so this
# one, unlike its neighbours, is worth guarding against a bad override. It is
# also the page STRIDE, so a zero would divide by zero working out how many
# pages there are.
[[ "$PQ_PICK_LIMIT" =~ ^[0-9]+$ ]] && [ "$PQ_PICK_LIMIT" -ge 1 ] || PQ_PICK_LIMIT=10
PQ_PICK_PREVIEW="${PQ_PICK_PREVIEW:-12}"   # lines of a plan pick_plan previews
PQ_REPOS_MAX="${PQ_REPOS_MAX:-12}"         # cap on repo_candidates'/repo_candidates_container's scanned inventory
# Same reasoning as PQ_PICK_LIMIT above: a non-numeric override makes the
# `-gt` truncation check below throw and, under `set -uo pipefail` (no -e),
# silently take the false branch - disabling the cap rather than erroring -
# and a non-positive one drives `head -n` with a zero or negative count,
# which BSD and GNU head disagree on.
[[ "$PQ_REPOS_MAX" =~ ^[0-9]+$ ]] && [ "$PQ_REPOS_MAX" -ge 1 ] || PQ_REPOS_MAX=12
PQ_REPOS_DIR="${PQ_REPOS_DIR:-}"           # scan root override; default is the primary's dirname, or a container split's own path
PQ_LABEL_MAX="${PQ_LABEL_MAX:-16}"         # max chars of a blocker label in AGENT's cell, before the +N count
[[ "$PQ_LABEL_MAX" =~ ^[0-9]+$ ]] && [ "$PQ_LABEL_MAX" -ge 1 ] || PQ_LABEL_MAX=16
PQ_DONE_KEEP="${PQ_DONE_KEEP:-3}"           # newest archivable done/ tasks archive_pass leaves behind; 0 is legal
[[ "$PQ_DONE_KEEP" =~ ^[0-9]+$ ]] || PQ_DONE_KEEP=3
# How long a done/ task's agent must have stopped working before its slot is
# released - see the `slots` section. 0 is legal and restores the old
# release-on-PR behaviour; a non-numeric override is a typo, not a request to
# disable the cap, so it falls back to the default rather than to 0.
PQ_WRAPUP_GRACE="${PQ_WRAPUP_GRACE:-300}"
[[ "$PQ_WRAPUP_GRACE" =~ ^[0-9]+$ ]] || PQ_WRAPUP_GRACE=300

# What the session wall looks like on screen, and how hard to knock. These are
# Claude Code UI strings, so they will change - hence up here and overridable
# rather than buried in the logic that uses them.
#
# No braces in these defaults: `${VAR:-...}` ends at the first unescaped `}`, so a
# bounded repetition like {0,24} gets cut in half and the rest leaks out as literal
# text. It fails as a corrupt pattern at match time, not as a syntax error here.
PQ_QUOTA_RE="${PQ_QUOTA_RE:-limit to reset|usage limit reached|out of usage credits|hit your .*limit}"
PQ_PERM_RE="${PQ_PERM_RE:-Do you want to |Yes, and don.t ask again|Allow once}"
PQ_QUOTA_RETRY="${PQ_QUOTA_RETRY:-600}"           # seconds between "continue" attempts
PQ_QUOTA_MAX_TRIES="${PQ_QUOTA_MAX_TRIES:-40}"    # ~7h at that interval, then stop knocking
PQ_TAIL_LINES="${PQ_TAIL_LINES:-30}"

# The one branch every task's screenshots are published to (`pq evidence`), in
# the task's own repo. Never deleted: a merged pull request's description keeps
# pointing at it.
PQ_EVIDENCE_BRANCH="${PQ_EVIDENCE_BRANCH:-pq-evidence}"

# How long `herdr agent start` may wait for a fresh Claude Code to come up and
# read as ready. A cold start with plugins is slow; herdr itself caps this at
# 300000. Milliseconds, because that is what herdr takes.
PQ_AGENT_START_MS="${PQ_AGENT_START_MS:-60000}"
[[ "$PQ_AGENT_START_MS" =~ ^[0-9]+$ ]] && [ "$PQ_AGENT_START_MS" -ge 1000 ] || PQ_AGENT_START_MS=60000

# The review gate - see the `review gate` section. Every pull request a task opens
# gets one independent `/code-review` run by pq itself, in the background, and the
# implementer is then told to resolve what it posted and mark the draft ready.
# A plan that asks for a security review gets a `/security-review` beside it, run
# on these same knobs - the model, effort, timeout, tries and retry below - since
# it is the same job for a different eye, and a second set would be knobs nobody
# turns. There is no off switch: PQ_REVIEW_MAX_TRIES=0 is the honest degraded
# mode, where no reviewer is ever launched and the implementer is sent straight
# to the self-review fallback.
PQ_REVIEWER_MODEL="${PQ_REVIEWER_MODEL:-opus}"
PQ_REVIEW_EFFORT="${PQ_REVIEW_EFFORT:-xhigh}"
# An hour. Reviews ran 747s, 822s, then 1083s against the 1500 this used to be,
# and a reviewer killed at the ceiling throws the whole review away for the
# self-review fallback - the one outcome the gate exists to avoid.
PQ_REVIEW_TIMEOUT="${PQ_REVIEW_TIMEOUT:-3600}"    # seconds a reviewer may run before it is killed
[[ "$PQ_REVIEW_TIMEOUT" =~ ^[0-9]+$ ]] || PQ_REVIEW_TIMEOUT=3600
PQ_REVIEW_MAX_TRIES="${PQ_REVIEW_MAX_TRIES:-2}"   # launches (a failed probe counts too) before falling back to self-review
[[ "$PQ_REVIEW_MAX_TRIES" =~ ^[0-9]+$ ]] || PQ_REVIEW_MAX_TRIES=2
PQ_REVIEW_RETRY="${PQ_REVIEW_RETRY:-600}"         # seconds between tries
[[ "$PQ_REVIEW_RETRY" =~ ^[0-9]+$ ]] || PQ_REVIEW_RETRY=600
PQ_REVIEW_SPLIT_LINES="${PQ_REVIEW_SPLIT_LINES:-150}"  # a single commit over this many changed lines is asked to be restructured
[[ "$PQ_REVIEW_SPLIT_LINES" =~ ^[0-9]+$ ]] || PQ_REVIEW_SPLIT_LINES=150
# `/code-review --comment` posts through `gh`, and a reviewer refused there runs
# to completion and posts nothing, with the JSON's permission_denials the only
# place that shows. Posting is its whole output, so it is allowed by rule rather
# than left to auto mode's classifier - see review_cmd, which also says why `git`
# is not.
PQ_REVIEW_TOOLS="${PQ_REVIEW_TOOLS:-Bash(gh:*)}"
# A pull request whose title says the agent stopped for a reason is not reviewed:
# telling an agent that gave up to "resolve the findings and mark it ready" is
# the wrong instruction. Brace-free, like the two patterns above, and matched
# case-insensitively.
PQ_STUCK_RE="${PQ_STUCK_RE:-^(\[stuck\]|stuck:)}"

# Paths that a trap has to clean up must be globals: an EXIT trap runs after the
# function has returned, so a `local` it referenced is already out of scope - and
# under `set -u` that turns the cleanup into an "unbound variable" error instead.
PQ_STAGING=""; PQ_LOCK=""

# A tick's one-line verdict. `pq tick` prints it directly; `pq run` collects it
# instead, so it can drop a summary identical to the previous one and leave a log
# of what CHANGED rather than one line per interval all night.
PQ_SUMMARY=""; PQ_RUN=0

summary() { PQ_SUMMARY=$*; [ "$PQ_RUN" = 1 ] || printf 'pq: %s\n' "$*" >&2; }
msg()  { printf 'pq: %s\n' "$*" >&2; }
warn() { printf '\033[38;2;246;193;119mpq: %s\033[0m\n' "$*" >&2; }
die()  { printf '\033[38;2;235;111;146mpq: %s\033[0m\n' "$*" >&2; exit 1; }

# `tasks` is not a state and nothing walks it - see task_link.
for d in $STATES tasks; do mkdir -p "$PQ_HOME/$d"; done

# ── plan header ─────────────────────────────────────────────────────────────
# The header is deliberately flat `key: value`, one per line, no nesting and no
# folded blocks. It is written by this script and read by this script (in bash,
# in a loop, on every tick), so being trivially parseable beats being expressive
# YAML. `intent` is therefore one long line - it is pasted into a PR body,
# never wrapped by hand.
hdr() {                                 # plan.md key
  [ -f "$1" ] || return 0
  awk -v k="$2" '
    NR == 1 && $0 == "---" { inh = 1; next }
    inh && $0 == "---"     { exit }
    inh {
      i = index($0, ":")
      if (i && substr($0, 1, i - 1) == k) {
        v = substr($0, i + 1); sub(/^[ \t]+/, "", v); print v; exit
      }
    }' "$1"
}

# Read one key out of a task's runtime state without disturbing our own variables.
# Same shape as wt's state files, so the two tools' state reads the same way.
st() {                                  # task_dir key
  [ -f "$1/state.env" ] || return 0
  # shellcheck source=/dev/null  # a task's runtime facts, not a script to follow
  ( set -a; . "$1/state.env" 2>/dev/null; set +a; eval "printf '%s' \"\${$2:-}\"" ) 2>/dev/null
}
# Upsert KEY=VALUE, preserving the other keys. Each dispatch step records itself the
# moment it succeeds, which is what lets reconcile tell a half-finished dispatch from
# a finished one after an interrupted tick.
#
# Values must be shell-safe WORDS, because `st` reads this file by sourcing it and
# nothing here quotes anything. That is not a style note: a value containing a
# bracket - `PQ_RESETS=3pm (PDT)`, as the session wall used to store its hint - is a
# syntax error, and bash abandons the whole file at that line, so every key written
# after it silently reads empty. Store the machine form of a fact (an epoch, an id, a
# stamp) and format it on the way out; never store prose.
st_set() {                              # task_dir key value
  local f="$1/state.env"
  { grep -v "^$2=" "$f" 2>/dev/null || true; printf '%s=%s\n' "$2" "$3"; } > "$f.tmp" && mv "$f.tmp" "$f"
}
now() { date -u '+%Y-%m-%dT%H:%M:%SZ'; }
epoch() { date -u '+%s'; }
# One of pq's own ISO stamps back to epoch seconds, or nothing when it cannot be
# parsed. BSD `date` only, like every other date call in this file: `-j` (do not
# set the clock) and `-f` (input format) are not GNU flags, and pq is a darwin
# tool. Prints nothing rather than 0 on a bad stamp, so a caller can tell "no
# stamp" from "the epoch".
epoch_of() {                            # iso8601 -> epoch seconds, or empty
  [ -n "${1:-}" ] || return 0
  date -j -u -f '%Y-%m-%dT%H:%M:%SZ' "$1" '+%s' 2>/dev/null || return 0
}

# ── shielded children ───────────────────────────────────────────────────────
# Run a command in a process group of its own, so a Ctrl-C aimed at pq does not
# take it down as collateral.
#
# A terminal sends SIGINT to the entire FOREGROUND PROCESS GROUP, which by default
# includes every child pq has spawned. So a `wt new` halfway through copying a
# database would die alongside the tick, and a minute of provisioning gets thrown
# away and done again. Job control (`set -m`) puts a background job in its own
# process group, and the signal then reaches only pq: the trap sets the stop flag,
# the work already in flight runs to completion, and the loop exits after it. That
# is what makes "stop after this tick" a real promise rather than a hopeful one.
#
# Everything comes back through files. Command substitution would defeat the whole
# point by putting the child back in our process group, and `wait`'s return value
# cannot be told apart from "interrupted" once signals are in play - so stdout and
# the true exit status are written where they can be read afterwards. stdin is
# /dev/null because a background process group that reads the terminal is stopped
# with SIGTTIN, which would hang the tick.
SHIELDED_OUT=""; SHIELDED_PID=""
shielded() {                            # cmd...
  local outf="$PQ_HOME/.out.$$" rcf="$PQ_HOME/.rc.$$" code
  rm -f "$outf" "$rcf"
  set -m
  ( "$@" > "$outf" < /dev/null; printf '%s' "$?" > "$rcf" ) &
  SHIELDED_PID=$!
  set +m
  # The trap interrupts `wait`, not the child - so wait again until it has gone.
  while kill -0 "$SHIELDED_PID" 2>/dev/null; do wait "$SHIELDED_PID" 2>/dev/null; done
  SHIELDED_PID=""
  SHIELDED_OUT=$(cat "$outf" 2>/dev/null)
  code=$(cat "$rcf" 2>/dev/null)
  rm -f "$outf" "$rcf"
  return "${code:-1}"
}

# ── headless claude ─────────────────────────────────────────────────────────
# Every `claude -p` pq runs - the namer, the splitter, the reviewer - belongs to
# no pane, but it inherits the pane identity of whatever pq was started from.
# Herdr's Claude integration reports each session from a SessionStart hook,
# against HERDR_PANE_ID, so the pane `pq add` or `pq run` was typed into was
# handed the headless session as its own: herdr kept it on that pane with status
# `unknown`, left it out of `herdr agent list` because pq is what runs in the
# foreground there, and still held it a day after the session had exited.
#
# HERDR_PANE_ID is the first thing the hook checks, so without it nothing is
# reported; the tab and workspace ids describe the same pane and go with it.
# HERDR_ENV and HERDR_SOCKET_PATH stay - they say which herdr is running, which
# is still true, and `wt` needs them for the `wt run` and `wt test` the reviewer
# is told to use.
headless_claude() {                     # claude args...
  env -u HERDR_PANE_ID -u HERDR_TAB_ID -u HERDR_WORKSPACE_ID claude "$@"
}

# ── the cap ─────────────────────────────────────────────────────────────────
# How many tasks may be running at once. It is STATE, not an argument: it lives in
# a file and is re-read at the top of every tick, so `pq cap 1` in the morning and
# `pq cap 4` at bedtime take effect on the next pass of a loop that is already
# running - no restart, no second concept for pausing. `pq cap 0` is the pause.
#
# The cap is soft in both directions. Fill is `while active < cap`, so lowering it
# never kills anything: it simply starts nothing new until enough slots free up on
# their own. There is no drain state to track, because the arithmetic already is one.
#
# The default is deliberately 1 rather than the 3 you will probably settle on. A
# fresh machine, or a state dir that got wiped, should not quietly start dispatching
# three unattended agents because nobody had said otherwise yet.
CAP_FILE="$PQ_HOME/cap"
cap_get() {
  local c
  c=$( { tr -dc '0-9' < "$CAP_FILE"; } 2>/dev/null )
  [ -n "$c" ] || c=${PQ_DEFAULT_CAP:-1}
  printf '%s' "$c"
}
cap_set() { printf '%s\n' "$1" > "$CAP_FILE"; }

cmd_cap() {
  [ $# -eq 0 ] && { printf '%s\n' "$(cap_get)"; return 0; }
  [[ "$1" =~ ^[0-9]+$ ]] || die "usage: pq cap [N]   (0 pauses; nothing running is touched)"
  cap_set "$1"
  # The same arithmetic fill uses, so what this promises and what the next tick
  # does cannot drift - a done task still wrapping up its PR is spending a slot,
  # and saying "room for 1 more" while it does would be the old lie in a new
  # place. slot_state, not slot_held: reporting the cap must not start anybody's
  # wrap-up clock. pidx_load first, or every pane reads as unknowable and every
  # unsettled done task is counted out of caution.
  local active nwrap=0 d
  pidx_load
  for d in "$PQ_HOME/done"/*/; do
    [ -d "$d" ] || continue
    [ -n "$(slot_state "${d%/}")" ] && nwrap=$((nwrap + 1))
  done
  active=$(( $(dir_count "$PQ_HOME/running") + nwrap ))
  local also=""
  [ "$nwrap" -gt 0 ] && also=" ($nwrap of them wrapping up a PR)"
  # A wall outranks the arithmetic here as much as it does in fill: room the next
  # tick will not use is not room, and the reason is the whole answer.
  local walled_by walled_at
  IFS=$'\t' read -r walled_by walled_at <<<"$(walled_slot)"
  if [ "$1" = 0 ]; then
    msg "cap 0 - paused. $active still running$also; nothing new will start."
  elif [ -n "$walled_by" ]; then
    msg "cap $1 - $active running$also, but $walled_by is $(walled_note "$walled_at"), so nothing new starts until it is moving again."
  elif [ "$active" -gt "$1" ]; then
    msg "cap $1 - $active already running$also, so nothing new starts until $(( active - $1 + 1 )) of them finish."
  else
    msg "cap $1 - room for $(( $1 - active )) more$also."
  fi
}

# ── task lookup ─────────────────────────────────────────────────────────────
# "queue/20260729143022-live-chat-mentions" -> "live-chat-mentions"
slug_of() { local b; b=$(basename "$1"); printf '%s' "${b#*-}"; }
# Tolerant of a non-numeric (or missing) prefix, yielding 0 rather than letting
# $((10#$b)) throw - what makes a legacy `060-slug` directory, or any foreign
# directory, harmless instead of fatal. Checked with a pattern match first: under
# `set -uo pipefail` (no -e) a bad $(( )) prints to stderr and keeps going rather
# than dying, which would be noise, not 0.
# Also bounded to 14 digits, same reasoning: a longer all-digit prefix (never
# produced by task_name, only by hand-corruption) would otherwise overflow
# bash's 64-bit arithmetic and wrap to an unpredictable value that could get
# adopted as next_stamp's max - "harmless" has to include this input too, not
# just non-numeric ones.
stamp_of() {
  local b; b=$(basename "$1"); b=${b%%-*}
  case "$b" in ""|*[!0-9]*) printf 0; return ;; esac
  [ "${#b}" -gt 14 ] && { printf 0; return; }
  printf '%s' "$((10#$b))"
}

is_urgent() {                           # task_dir -> true if in the urgent range
  [ "$(stamp_of "$1")" -lt "$PQ_STAMP_REAL" ]
}

# The directory basename for a task at a stamp. %014d is a FIXED width, not a
# minimum: it is what makes bash's glob order and numeric order the same order.
# Takes a BARE integer - a zero-padded string here would be read as octal
# (printf '%03d' 020 is 16) or rejected outright.
task_name() {                           # stamp slug
  printf '%014d-%s' "$1" "$2"
}

# The next stamp in one of the two ranges. Monotone by construction: a UTC
# timestamp normally, but never less than one past the highest stamp already in
# that range. That is what makes N adds inside the same second still ascend
# strictly - which is what a --split relies on - and what stops a clock that
# steps backwards from burying a new task under an old one.
next_stamp() {                          # [urgent] -> bare integer
  local urgent=${1:-0} want max=0 s d
  if [ "$urgent" = 1 ]; then want=1; else want=$(date -u +%Y%m%d%H%M%S); fi
  # Spans archive: a stamp must never be reissued, and an archived task is
  # still a task that once claimed this number. See all_tasks.
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    s=$(stamp_of "$d")
    if [ "$urgent" = 1 ]; then [ "$s" -lt "$PQ_STAMP_REAL" ] || continue
    else                       [ "$s" -ge "$PQ_STAMP_REAL" ] || continue; fi
    [ "$s" -gt "$max" ] && max=$s
  done <<<"$(all_tasks all)"
  [ "$want" -gt "$max" ] || want=$(( max + 1 ))
  printf '%s' "$want"
}

# Every task directory, ordered by state then stamp. `done` last: it is history,
# and the top of the list should be what is live. No sort needed within a state,
# PROVIDED every directory there carries the new %014d (task_name) prefix - that
# fixed width is what makes bash's own glob ordering agree with numeric order. A
# lingering legacy or foreign directory of a different width can still disagree
# with it, which is exactly what the one-time migration exists to clear out.
#
# `scope` narrows what "every task directory" means. `live` (the default) is
# what every display and dispatch walker wants - archive/ is settled history,
# not something to show or to search. `all` adds it, always last: even more
# history than `done`, and the one thing a stamp-uniqueness check
# (`slug_taken_in`) or a stamp allocation (`next_stamp`) cannot afford to miss.
all_tasks() {                           # [scope: live|all]
  # An array, not a space-joined string split with `for s in $states`: this
  # function is routinely reached from inside an ancestor's
  # `IFS=$'\t' read ... <<<"$(...)"` (after_check's read of after_state is
  # exactly that shape), and that prefix assignment is in effect for the
  # WHOLE command it prefixes - including the command substitution that
  # builds its herestring, which is a subshell this function then runs in. An
  # unquoted `$states` word-splits on that inherited IFS, and a tab-only IFS
  # has no space in it - `for s in $states` collapses to one bogus iteration
  # and every task vanishes. `"${states[@]}"` never depends on IFS at all.
  local scope=${1:-live} s d states=(running queue "done")
  [ "$scope" = all ] && states+=(archive)
  for s in "${states[@]}"; do
    for d in "$PQ_HOME/$s"/*/; do
      [ -d "$d" ] || continue
      printf '%s\n' "${d%/}"
    done
  done
}

# How many task directories one state holds. A glob rather than `ls | wc -l`:
# the same count, with nothing parsed out of ls.
dir_count() {                           # dir -> n
  local n=0 x
  for x in "$1"/*/; do [ -d "$x" ] && n=$((n + 1)); done
  printf '%s' "$n"
}

# Fill's own view of the queue: stamp order, sorted NUMERICALLY rather than
# trusting glob order. Glob order and numeric order agree by construction now
# (task_name's fixed width, see above), but this sort is the guard that keeps
# it that way rather than an assumption resting on every writer doing the right
# thing - test/pq-order.sh is what holds it.
queue_ordered() {
  local d
  for d in "$PQ_HOME/queue"/*/; do
    [ -d "$d" ] || continue
    printf '%s\t%s\n' "$(stamp_of "${d%/}")" "${d%/}"
  done | sort -s -n -k1,1 | cut -f2-
}

# Resolve what the user typed to exactly one task directory. Exact slug match wins
# outright, so a slug that happens to prefix a longer one is still reachable;
# otherwise a unique prefix is enough, and an ambiguous one is an error rather than
# a guess - picking the wrong task here would queue or delete the wrong work.
#
# Live tasks first, archive/ only on a miss - so a prefix that already resolves
# (uniquely or ambiguously) among live tasks reads exactly as it did before
# archive/ existed, and history sharing a prefix never changes that answer.
# Archive is consulted only when live has nothing at all, which is what keeps
# `pq rm` working on an archived slug.
find_task() {                           # needle
  local needle=${1:-} d s scope exact="" hits=()
  [ -n "$needle" ] || die "which task? (pq ls)"
  for scope in live all; do
    exact=""; hits=()
    while IFS= read -r d; do
      [ -n "$d" ] || continue
      s=$(slug_of "$d")
      [ "$s" = "$needle" ] && { exact=$d; break; }
      case "$s" in "$needle"*) hits+=("$d") ;; esac
    done <<<"$(all_tasks "$scope")"
    [ -n "$exact" ] && { printf '%s' "$exact"; return 0; }
    [ "${#hits[@]}" -gt 0 ] && break
  done
  case "${#hits[@]}" in
    0) die "no task matching '$needle' (pq ls)" ;;
    1) printf '%s' "${hits[0]}" ;;
    *) die "'$needle' matches ${#hits[@]} tasks: $(for d in "${hits[@]}"; do printf '%s ' "$(slug_of "$d")"; done)" ;;
  esac
}

state_of() {                            # task_dir  -> queue|running|done
  local p=${1%/*}; basename "$p"
}

# ── the stable path ─────────────────────────────────────────────────────────
# A task's directory MOVES as its state changes, so any path handed to something
# outside pq - the implementer's prompt, its contract, the directory it saves
# screenshots into - names a directory that stops existing the moment reconcile
# moves the task to done/. Measured on the first task dispatched with a contract:
# the agent's next screenshot went to `mkdir -p running/<task>/evidence/`, and
# pq then read that stray directory as a half-dispatched task with no plan.md,
# tried to resume it every tick, and counted it against the cap.
#
# tasks/<name> is the one path that never moves: a symlink, re-pointed by
# retitle on every transition, and the ONLY path pq ever tells anything outside
# itself. The state directories stay the truth; this is a handle onto them.
# `tasks/` is deliberately not in $STATES, so no walker ever sees it as a state.
task_link() {                           # task_dir
  ln -sfn "$1" "$PQ_HOME/tasks/$(basename "$1")" 2>/dev/null || true
}
task_home() {                           # task_dir -> the stable path to hand out
  printf '%s/tasks/%s' "$PQ_HOME" "$(basename "$1")"
}

# Move a task between states, keeping its stamp prefix. The `mv` is the state
# transition; nothing else records it - except the stable link, which follows.
retitle() {                             # task_dir new_state [new_stamp]
  local src=$1 to=$2 stamp=${3:-} name
  name=$(basename "$src")
  [ -n "$stamp" ] && name=$(task_name "$stamp" "$(slug_of "$src")")
  local dst="$PQ_HOME/$to/$name"
  [ "$src" = "$dst" ] && { printf '%s' "$dst"; return 0; }
  [ -e "$dst" ] && die "a task already exists at $to/$name"
  mv "$src" "$dst" || die "could not move $src -> $dst"
  task_link "$dst"
  printf '%s' "$dst"
}

# ── after: blockers ─────────────────────────────────────────────────────────
# A blocker is a resolved (label, repo, branch) triple, not a task reference -
# `pq add --after A` or `pq after B A` resolves A to its repo and branch at the
# moment you type it. That is what makes the dependency survive `pq rm A`,
# survive A ageing out of `done/`, and survive a slug being reused; it is also
# what makes a cross-repo blocker work for free, and what lets a blocker name a
# branch that is not in `pq` at all.

# The branch a slug reduces to, same rule `cmd_add` uses for its own task names -
# lowercased, non `[a-z0-9-]` squashed to `-`, runs collapsed, edges trimmed.
branch_to_slug() {                      # branch -> a queue-safe slug
  local s=${1##*/}
  tr '[:upper:]' '[:lower:]' <<<"$s" | tr -c 'a-z0-9-' '-' | sed -E 's/-+/-/g; s/^-|-$//g'
}

# The `after` file, one blocker per line, or nothing if the task has none.
after_list() {                          # task_dir
  [ -f "$1/after" ] && cat "$1/after"
}

# Append a blocker if its (repo, branch) is not already present - that pair is
# the real identity, not the label, so re-adding the same branch under a
# different label is a no-op rather than a duplicate.
after_add() {                           # task_dir label repo branch
  local d=$1
  awk -F'\t' -v r="$3" -v b="$4" '$2 == r && $3 == b { f = 1; exit } END { exit !f }' \
    "$d/after" 2>/dev/null && return 0
  printf '%s\t%s\t%s\n' "$2" "$3" "$4" >> "$d/after"
}

# The task directory, in ANY state, whose plan.md names this exact (repo,
# branch) - or nothing. Used for cycle detection and for telling "orphan" (no
# task anywhere owns this branch, so nothing will ever open a PR for it) apart
# from the ordinary "waiting, not started yet" case.
#
# Live first, archive only on a miss - blocker_state reaches this only after
# pr_merged_into has already said no, so the archive scan happens only on that
# rarer path. Without it, a blocker whose owner has since archived would read
# as "no task owns its branch" and fire a false orphan warning.
task_by_branch() {                      # repo branch
  local d scope
  for scope in live all; do
    while IFS= read -r d; do
      [ -n "$d" ] || continue
      [ "$(hdr "$d/plan.md" repo)" = "$1" ] && [ "$(hdr "$d/plan.md" branch)" = "$2" ] \
        && { printf '%s' "$d"; return 0; }
    done <<<"$(all_tasks "$scope")"
  done
  return 1
}

# A value containing '/' is a branch in the OWNER's own repo - the repo of the
# task being given the blocker. Slugs cannot contain '/' (cmd_add strips them),
# so the rule is unambiguous. Otherwise it is a task slug resolved through
# find_task, which is what makes a cross-repo blocker free: the resolved task
# carries its own repo along with it, whatever that repo is.
resolve_after() {                       # owner_repo value -> "label\trepo\tbranch"
  local owner_repo=$1 value=$2 t
  case "$value" in
    */*) printf '%s\t%s\t%s' "$(branch_to_slug "$value")" "$owner_repo" "$value" ;;
    *)
      t=$(find_task "$value") || return 1
      printf '%s\t%s\t%s' "$(slug_of "$t")" "$(hdr "$t/plan.md" repo)" "$(hdr "$t/plan.md" branch)"
      ;;
  esac
}

# DFS from the proposed blocker (repo, branch) back through task_by_branch and
# each task's own `after` file, looking for a path that leads back to
# (owner_repo, owner_branch) - including the trivial self-reference, one step
# in. Two tasks each waiting on the other would stall silently forever, and the
# odds only grow once one plan's pull requests are queued as a set of them.
after_cycle() {                         # owner_repo owner_branch repo branch [visited task_dirs...]
  local owner_repo=$1 owner_branch=$2 repo=$3 branch=$4 t r2 b2 v
  [ "$repo" = "$owner_repo" ] && [ "$branch" = "$owner_branch" ] && return 0
  t=$(task_by_branch "$repo" "$branch") || return 1
  shift 4
  for v in "$@"; do [ "$v" = "$t" ] && return 1; done
  while IFS=$'\t' read -r _ r2 b2; do
    [ -n "$r2" ] || continue
    after_cycle "$owner_repo" "$owner_branch" "$r2" "$b2" "$t" "$@" && return 0
  done <<<"$(after_list "$t")"
  return 1
}

# The slugs of every task, in any state, that lists (repo, branch) as a
# blocker. Holding or removing a task silently stalls everything after it, and
# this is what lets `cmd_rm` say so before it does it.
dependents_of() {                       # repo branch
  local d r b
  while IFS= read -r d; do
    [ -n "$d" ] && [ -f "$d/after" ] || continue
    while IFS=$'\t' read -r _ r b; do
      [ "$r" = "$1" ] && [ "$b" = "$2" ] && printf '%s\n' "$(slug_of "$d")"
    done <<<"$(after_list "$d")"
  done <<<"$(all_tasks)"
}

# ── add ─────────────────────────────────────────────────────────────────────
# The plans Claude wrote, newest first, for the picker. Claude Code names these
# itself, from the prompt that started the session, so the filename is never
# a task name - see name_plan.

# epoch<TAB>path, newest first. The sort key is max(mtime, birth time), not
# plain mtime: a plan created days ago and edited this morning must sort
# above one created this morning and left alone, and a file restored by
# `cp -p`, `rsync -a`, or a git checkout carries an old mtime with a new
# birth time. A filesystem with no birth time reports 0 for %B, which the
# max simply ignores. Only top-level *.md - a hand-made subdirectory under
# $PLANS_DIR stays invisible, exactly as `ls -t "$PLANS_DIR"/*.md` always was.
recent_plans() {                        # -> epoch<TAB>path, newest first
  stat -f '%m%t%B%t%N' "$PLANS_DIR"/*.md 2>/dev/null \
    | awk -F'\t' '{ print ($1 > $2 ? $1 : $2) "\t" $3 }' \
    | sort -t$'\t' -k1,1nr -k2,2
}

# Ask a small model for a branch name and a one-line statement of intent, from the
# plan itself. Both are things a human reads later - the branch on a pull request,
# the intent at the top of its description - and neither can be derived from the
# filename, which is auto-generated ("floofy-hugging-dragonfly.md").
#
# Prints "branch<TAB>intent<TAB>security", or nothing if the model could not be
# reached or gave something unusable; the caller then stops rather than inventing
# one. `security` is `yes` when the plan asks for a security review of its work,
# and empty otherwise - it is what opens the security reviewer's ladder beside the
# code reviewer's (see the `review gate` section). One more field in the same
# reply rather than a call of its own, and checked the same way the outline was:
# ten real plans, four runs each, came back right forty times out of forty -
# including one that calls for it only as a mandatory aside to a CSRF decision,
# two that say it is not warranted, and pq's own plan, which names it only as
# follow-up work.
#
# The optional second argument is a comma-separated avoid list: branches already
# spoken for by a sibling part in the same split, appended as one more sentence
# rather than a second prompt - `do_split` retries a collision once with this set,
# before giving up on that part.
#
# The optional third argument is the repo label a multi-repo split part lands
# in - a task's slug is a single global namespace (`slug_taken_in` sweeps every
# state), so an iOS part and an Android part of the same feature would
# otherwise both want the same branch. Appended as one more sentence, exactly
# like the avoid list, and omitted entirely for a single-repo split.
#
# Line 1 is `branch<TAB>intent<TAB>security`. Every line after it is one entry of the OUTLINE:
# the pull requests the plan itself lays out, in its order, one title per line -
# a single entry for any plan that does not. Read off the plan, never judged
# from its size: a big change is one pull request of small commits (see
# dispatch_prompt), and dividing it further only turns work that could run side
# by side into a waterfall of reviews, each part waiting on the merge before it.
# So only a plan that SAYS it ships as several pull requests - a "PR 1" and a
# "PR 2", or changes in more than one repository, which cannot share one - reads
# as more than one entry. The wording was checked against ten real plans and
# one written to span three repositories, four runs each: the real plan with a
# PR 1, 2 and 3 and the three-repository one always came back as three, and
# the big single-PR plans, including one of three PR plans written to separate
# files, always as one - where the old "would naturally be delivered as" had
# read one of them as five. `cmd_add` shows a multi-entry outline before asking
# whether to queue it as one task per pull request (see add_wizard). Callers
# that only want the name read the first line - `IFS=$'\t' read` on a
# herestring stops there - so the outline costs them nothing and is what keeps
# this one Haiku call per add.
name_plan() {                           # plan_file [avoid: comma-separated branches already taken] [repo_label]
  local raw json avoid=${2:-} label=${3:-} prompt
  prompt='Read this plan and reply with ONLY a JSON object, no code fence, no commentary:
{"branch":"tom/<3-5 dash-separated lowercase words naming the task>","intent":"<2-3 sentences, one line, saying what this sets out to achieve in the author'"'"'s terms - not a description of the diff>","security":<true or false>,"parts":["<a title for the pull request this plan will open - or, only when it lays out several, one title per pull request in the order it gives them>"]}
parts is a single entry unless the plan itself says this work ships as more than one pull request - a "PR 1" and a "PR 2", say - or changes code in more than one repository, which takes a pull request per repository since one cannot span two. Never divide a plan by its own sections, steps, stages, files or layers: a plan that never says they ship separately is one entry however large it is, and so is a plan that is itself one of several pull requests planned elsewhere.
Each entry in parts names the feature or change that pull request would carry - "Add the checklist step collection to Onboarding", "Rebuild the Getting Started page around the new components" - never a list of files.
security is true only when the plan asks for a security review of this change - a /security-review - to be run, including one it calls warranted or mandatory. It is false when the plan says one is not warranted or not needed, when it mentions one only as future or follow-up work, and when it never asks for one.'
  [ -n "$avoid" ] && prompt="$prompt
The branch must differ from these, which are already taken: $avoid"
  [ -n "$label" ] && prompt="$prompt
This part lands in the $label repository, so make the branch name say which one if the task's own words would not already distinguish it from the same work elsewhere."
  raw=$(headless_claude -p --model "$PQ_NAMER_MODEL" "$prompt" < "$1" 2>/dev/null) || return 0
  # Be forgiving about a fenced or chatty reply: take the first {...} span.
  json=$(sed -n 's/.*\({.*}\).*/\1/p' <<<"$(tr '\n' ' ' <<<"$raw")" | head -1)
  [ -n "$json" ] || return 0
  # The branch is always tom/<words>, whatever came back: Haiku drops the
  # prefix it is asked for often enough to matter - 27 of the first 103 tasks
  # went out bare. The prefix is pq's, so it is taken off the reply if there
  # and put back once. Every word the model chose is kept - any other slash
  # becomes a dash rather than cutting the name down, since on a multi-repo
  # split an ios/ or android/ may be the only thing telling two parts apart.
  # A reply with no words at all stays empty, and the caller stops.
  #
  # The security verdict is `yes` or empty, and a yes stands only when the plan's
  # text names a security review at all: Haiku's reading decides between "run
  # /security-review" and "/security-review is not warranted", which no pattern
  # can, but a yes for a plan that never mentions one is a guess, and it would
  # cost an hour of the reviewer model for nothing.
  local mentioned=false
  grep -qiE 'security[- ]review' "$1" 2>/dev/null && mentioned=true
  jq -er --argjson mentioned "$mentioned" \
    '[(.branch // "" | sub("^tom/"; "") | gsub("/"; "-") | if . == "" then "" else "tom/" + . end), .intent,
      (if $mentioned and .security == true then "yes" else "" end)] | @tsv' \
    2>/dev/null <<<"$json" || return 0
  # The outline. A tab or newline inside a title would break the line-oriented
  # contract above, so both are squeezed to spaces, and an empty title is dropped.
  jq -r '.parts[]? | strings' 2>/dev/null <<<"$json" | tr '\t' ' ' | sed '/^[[:space:]]*$/d'
}

# The outline half of name_plan's reply - line 2 onwards - or nothing.
outline_of() {                          # name_plan output -> the part titles, one per line
  tail -n +2 <<<"${1:-}" | sed '/^[[:space:]]*$/d'
}

# A branch already spoken for is the one failure that must be caught at add time.
# `wt new` on an existing branch deliberately CHECKS IT OUT rather than failing, so
# two tasks sharing a name would quietly land in the same worktree and fight over
# it. Live tasks and git both get a say; `done` deliberately does not, so a name
# whose branch has since been reclaimed is free to be used again.
#
# Three checks, cheapest first. The last one goes to the network, which is worth a
# round trip to catch a branch pushed from somewhere else - but it is bounded, so an
# add made offline fails fast instead of sitting on a TCP timeout, and a network we
# could not reach reports "not taken". That is the safe direction to be wrong in:
# the worst case is `wt new` later adopting the existing remote branch, which is a
# thing it already knows how to do.
branch_taken() {                        # branch repo
  local branch=$1 repo=$2 d
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    case "$(state_of "$d")" in done) continue ;; esac
    [ "$(hdr "$d/plan.md" branch)" = "$branch" ] && { printf 'queued as %s' "$(slug_of "$d")"; return 0; }
  done <<<"$(all_tasks)"
  git -C "$repo" show-ref --verify --quiet "refs/heads/$branch" && { printf 'a local git branch'; return 0; }
  git -C "$repo" show-ref --verify --quiet "refs/remotes/origin/$branch" && { printf 'a known remote branch'; return 0; }
  GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o ConnectTimeout=5 -o BatchMode=yes}" \
    git -C "$repo" ls-remote --exit-code --heads origin "$branch" >/dev/null 2>&1 \
    && { printf 'a remote branch'; return 0; }
  return 1
}

# Which of $STATES already has a task directory ending in -$slug, or nothing.
# `done` counts here, unlike `branch_taken`'s live-task check above: a slug is
# the whole directory name rather than a branch, so a stale `done/NNN-foo`
# still blocks a fresh `foo` from being created at all. Shared by `cmd_add`'s
# own uniqueness sweep and `split_name_collision`, so the two rules cannot
# silently drift apart.
slug_taken_in() {                       # slug -> the state name, or nothing
  local slug=$1 d2
  for d2 in $STATES; do
    ls -d "$PQ_HOME/$d2"/*-"$slug" >/dev/null 2>&1 && { printf '%s' "$d2"; return 0; }
  done
  return 1
}

# ── picking a plan and its options ──────────────────────────────────────────
# `pq add` with no plan, at a terminal, shows what it is about to queue rather
# than guessing silently - see cmd_add's own gate for exactly when this fires.

# The first line with real content, leading blanks skipped, a leading `#`
# marker stripped whether it is one or several. H1 for every plan Claude Code
# writes today; the first non-blank line is the fallback for anything without
# one.
plan_title() {                          # plan_file -> its title
  awk '
    /^[[:space:]]*$/ { next }
    { sub(/^#+[ \t]*/, ""); print; exit }
  ' "$1"
}

# A string made safe for render_table, which requires plain ASCII: macOS
# awk's length() counts BYTES, not characters, so one multi-byte character
# over-pads its column and skews the whole table. Order matters - squeeze
# \t, \n, \r to spaces FIRST, because a surviving tab or newline does not
# merely skew a column, it splits the row into phantom ones. Then drop
# everything outside \40-\176, collapse runs of spaces, trim, and truncate
# to width with a trailing ".." so a cut title never reads as the whole one.
cell() {                                # text width -> ASCII-safe, truncated
  local text=$1 width=$2 out
  out=$(tr '\t\n\r' '   ' <<<"$text" | tr -cd '\40-\176' | tr -s ' ')
  out=$(sed -e 's/^ *//' -e 's/ *$//' <<<"$out")
  [ "${#out}" -gt "$width" ] && out="${out:0:$(( width - 2 ))}.."
  printf '%s' "$out"
}

# One page of `recent_plans`, as a table numbered ABSOLUTELY: row 11 is the
# eleventh-newest plan whichever page it happens to be shown on. That is what
# keeps `sed -n "${ans}p"` below a direct index into the full list, with no
# per-page arithmetic to get wrong, and what makes a number mean one fixed plan
# rather than "the third one I can currently see".
pick_page() {                           # rows lo hi out_tsv
  local lo=$2 hi=$3 out=$4 n=0 epoch path title
  printf '#\tAGE\tPLAN\tSUMMARY\n' > "$out"
  while IFS=$'\t' read -r epoch path; do
    [ -n "$path" ] || continue
    n=$((n + 1))
    [ "$n" -lt "$lo" ] && continue
    [ "$n" -gt "$hi" ] && break
    title=$(plan_title "$path")
    printf '%s\t%s\t%s\t%s\n' "$n" "$(age_since "$epoch")" \
      "$(cell "$(basename "$path" .md)" 30)" "$(cell "$title" 60)" >> "$out"
  done <<<"$1"
  # A `while read` loop returns whatever its body last ran, and this body can
  # end on a short-circuited test - so a perfectly good page would otherwise
  # report failure. Exit codes carry meaning in this file (see pick_plan's own
  # contract below); say the happy path out loud.
  return 0
}

# Whether there is someone at a terminal to ask. A function rather than a bare
# `[ -t 0 ]` at the one place pq add asks it, so a test can stand in for the
# terminal and drive the picker and the wizard with scripted answers.
at_terminal() { [ -t 0 ]; }

# Exit codes carry meaning, the way reap_task's already do: 0 chose one (its
# path on stdout), 1 declined/`q`/EOF, 2 nothing in $PLANS_DIR to pick from -
# the caller stops on that one, with nothing to add.
# Everything a human reads goes to stderr: pick_plan is consumed by a command
# substitution, and any leakage on stdout would silently corrupt $plan, the
# `source:` header, and the staged plan.md.
#
# $PLANS_DIR is every plan ever written, so this shows PQ_PICK_LIMIT of them at
# a time - the newest page answers it most days - and `n`/`p` walk back through
# the rest. Paging beats simply raising the limit because the plans you want
# are named by the prompt that started their session
# ("floofy-hugging-dragonfly.md"), so digging back is reading titles, not
# recalling a filename, and a hundred-row table is not a thing you read.
pick_plan() {
  local rows total
  rows=$(recent_plans)
  [ -n "$rows" ] || return 2
  total=$(wc -l <<<"$rows" | tr -d ' ')

  # `lo`, the 1-based index of the page's first row, is the whole of the paging
  # state - the stride cannot change mid-picker, so every other bound is
  # arithmetic on it. It survives a declined preview, which is what returns you
  # to the page you were reading rather than to the top.
  local per=$PQ_PICK_LIMIT lo=1 hi pages
  pages=$(( (total + per - 1) / per ))

  local tbl="$PQ_HOME/.pick.$$.tsv"
  local ans row sel_path total_lines ans2 rule
  rule=$(printf -- '─%.0s' $(seq 1 60))
  while :; do
    hi=$(( lo + per - 1 )); [ "$hi" -gt "$total" ] && hi=$total
    pick_page "$rows" "$lo" "$hi" "$tbl"

    if [ "$pages" -gt 1 ]; then
      msg "$lo-$hi of $total (page $(( (lo - 1) / per + 1 ))/$pages)"
    else
      msg "$total most recent of $total"
    fi
    printf '\n' >&2
    render_table "$tbl" >&2
    printf '\n' >&2
    # One page is the whole list, so there is nowhere to page to - don't offer
    # keys that can only answer "already at the oldest".
    if [ "$pages" -gt 1 ]; then
      printf 'pq: pick a plan [%s-%s, n older, p newer, Enter for %s, q to quit] ' "$lo" "$hi" "$lo" >&2
    else
      printf 'pq: pick a plan [1-%s, Enter for 1, q to quit] ' "$total" >&2
    fi
    read -r ans || { rm -f "$tbl"; return 1; }
    # The top of what you are looking at, which is row 1 on the first page -
    # so a plain `pq add`, Enter, still takes the newest plan.
    [ -z "$ans" ] && ans=$lo
    # `n` here is "next page, older"; `n` at the `use this plan? [y/N]` prompt
    # a few lines down is "no". Two prompts, two vocabularies - each one's own
    # hint says which is in force, and neither key is ever ambiguous within the
    # prompt that reads it.
    case "$ans" in
      q|Q) rm -f "$tbl"; return 1 ;;
      n|N) if [ "$hi" -lt "$total" ]; then lo=$(( lo + per )); else warn "already at the oldest"; fi
           continue ;;
      p|P) if [ "$lo" -gt 1 ]; then lo=$(( lo - per )); else warn "already at the newest"; fi
           continue ;;
    esac
    # Any listed plan, on this page or not: the numbering is absolute, so
    # rejecting a number that names a real plan just because it scrolled off
    # would be a lie about what that number means.
    #
    # Capped at 9 digits so a huge number never reaches the arithmetic tests
    # below: bash's [ -lt ]/[ -gt ] error out (a false "false") on an integer
    # past its native range, which would flip this whole OR-chain to skip the
    # reject instead of triggering it.
    if ! [[ "$ans" =~ ^[0-9]{1,9}$ ]] || [ "$ans" -lt 1 ] || [ "$ans" -gt "$total" ]; then
      warn "not a number from 1 to $total"
      continue
    fi

    row=$(sed -n "${ans}p" <<<"$rows")
    IFS=$'\t' read -r _ sel_path <<<"$row"

    total_lines=$(wc -l < "$sel_path" | tr -d ' ')
    printf '%s\n' "$rule" >&2
    head -n "$PQ_PICK_PREVIEW" "$sel_path" >&2
    printf '%s\n' "$rule" >&2
    [ "$total_lines" -gt "$PQ_PICK_PREVIEW" ] && msg "showing first $PQ_PICK_PREVIEW of $total_lines lines"

    printf 'pq: use this plan? [y/N] ' >&2
    read -r ans2 || { rm -f "$tbl"; return 1; }
    if [[ "$ans2" =~ ^[Yy]$ ]]; then
      rm -f "$tbl"
      printf '%s' "$sel_path"
      return 0
    fi
  done
}

# `after_vals` is cmd_add's own local, reached through bash's dynamic scope
# exactly as do_split reaches `plan`/`repo`/etc (pq's "add" header comment) -
# so, like add_wizard below, this function must NEVER declare `after_vals`
# `local`. A stray `local` here would shadow the caller's variable: every
# answer would appear to work and be silently discarded. Called as a bare
# statement for the same reason - `x=$(pick_after)` forks a subshell and
# throws the mutation away. Writes nothing to stdout; its prompts and table,
# like pick_plan's, go to stderr.
pick_after() {
  local d st slug branch repo n=0 full
  full="$PQ_HOME/.pickafter.$$.tsv"
  : > "$full"
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    st=$(state_of "$d")
    case "$st" in queue|running) ;; *) continue ;; esac
    n=$((n + 1))
    slug=$(slug_of "$d"); branch=$(hdr "$d/plan.md" branch); repo=$(hdr "$d/plan.md" repo)
    printf '%s\t%s\t%s\t%s\t%s\n' "$n" "$st" "$slug" "${repo:--}" "${branch:--}" >> "$full"
  done <<<"$(all_tasks)"
  [ "$n" -gt 0 ] || { rm -f "$full"; return 0; }

  # A PROJECT column only once the candidates actually span more than one
  # repo - same rule and idiom cmd_ls uses. PROJECT is the only column here
  # that needs `cell`: slugs are [a-z0-9-], branches have passed
  # check-ref-format, and state names are literals, so those three are ASCII
  # by construction - a repo path is arbitrary and the one column where the
  # byte-counting skew documented on `cell` would actually land.
  local multi tbl i
  multi=$(cut -f4 "$full" | sort -u | awk 'END { print (NR > 1) }')
  tbl="$PQ_HOME/.pickafterdisp.$$.tsv"
  if [ "$multi" = 1 ]; then
    printf '#\tSTATE\tTASK\tPROJECT\tBRANCH\n' > "$tbl"
    while IFS=$'\t' read -r i st slug repo branch; do
      printf '%s\t%s\t%s\t%s\t%s\n' "$i" "$st" "$slug" "$(cell "$(basename "$repo")" 20)" "$branch" >> "$tbl"
    done < "$full"
  else
    printf '#\tSTATE\tTASK\tBRANCH\n' > "$tbl"
    awk -F'\t' '{ print $1"\t"$2"\t"$3"\t"$5 }' "$full" >> "$tbl"
  fi

  msg "$n tasks this could wait on"
  printf '\n' >&2
  render_table "$tbl" >&2
  printf '\n' >&2
  rm -f "$tbl"

  local ans norm entry bad valid
  while :; do
    printf 'pq: block on which? [1-%s, comma separated, Enter for none] ' "$n" >&2
    read -r ans || { rm -f "$full"; return 0; }
    [ -z "$ans" ] && { rm -f "$full"; return 0; }
    norm=$(tr ',' ' ' <<<"$ans")
    bad=0; valid=""
    # shellcheck disable=SC2086  # word-splitting $norm on whitespace is the point
    for entry in $norm; do
      if [[ "$entry" =~ ^[0-9]{1,9}$ ]] && [ "$entry" -ge 1 ] && [ "$entry" -le "$n" ]; then
        valid="$valid $entry"
      else
        bad=1; break
      fi
    done
    if [ "$bad" = 1 ] || [ -z "${valid// /}" ]; then
      warn "each entry must be a number from 1 to $n"
      continue
    fi
    break
  done

  local seen="" num s
  # shellcheck disable=SC2086  # word-splitting $valid on whitespace is the point
  for num in $valid; do
    s=$(awk -F'\t' -v i="$num" '$1 == i { print $3; exit }' "$full")
    case " $seen " in *" $s "*) continue ;; esac
    seen="$seen $s"
    after_vals="${after_vals}${s}"$'\n'
  done
  rm -f "$full"
}

# ── design files ─────────────────────────────────────────────────────────────
# A plan written from a Claude Design file describes the design in prose, and an
# implementer that only ever sees the prose builds to its memory of a picture it
# never saw - PR #6706 said as much in its own description. So the file travels
# with the task: `--design PATH` attaches one, and every absolute or ~-prefixed
# path to a .dc.html/.html/.png/.jpg/.jpeg/.pdf that the plan's text mentions is
# picked up on its own (AGENTS.md asks the planning session to save the file and
# cite that path). The files are copied into <task>/design/ inside the staging
# dance and named in the `design:` header, so a task lands with its design or not
# at all, and the contract (see contract_write) tells the implementer what to do
# with them.

design_expand() {                       # path as written -> trimmed, ~ expanded
  local p=$1
  p=$(sed 's/^[[:space:]]*//; s/[[:space:]]*$//' <<<"$p")
  # A LITERAL tilde is what is being matched - the shell never expanded it,
  # because it came out of a file, not a command line.
  # shellcheck disable=SC2088
  case "$p" in "~/"*) p="$HOME/${p#"~/"}" ;; esac
  printf '%s' "$p"
}

# Every design-looking path the plan's text mentions and that exists on disk, one
# per line; a mention that does not exist is warned about by name.
#
# Two shapes are tried per line, because Claude Design names its files with
# spaces ("Onboarding Refresh.dc.html"): first each whitespace-free token that
# ends in a design extension, and only if none of those exists on disk, the span
# from the line's last path start to its last design extension - which is exactly
# the `Design file: /Users/.../Onboarding Refresh.dc.html` line the AGENTS.md
# rule asks for. Both shapes want the character before the leading `/` to be one
# that cannot continue a path and not a ':', so `https://claude.ai/design/...` is
# never read as a path. A `.html.erb` never matches either: the token has to END
# in the extension, and the span wants the extension followed by something that
# cannot continue a filename.
design_mentions() {                     # plan_file -> existing paths, one per line
  local plan=$1 lines line tok cand found span found_all=""
  lines=$(grep -E '\.(dc\.html|html|png|jpe?g|pdf)' "$plan" 2>/dev/null)
  [ -n "$lines" ] || return 0
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    found=""; cand=""
    while IFS= read -r tok; do
      [ -n "$tok" ] || continue
      tok=$(sed -E 's/[.,;:)]+$//' <<<"$tok")
      case "$tok" in *.dc.html|*.html|*.png|*.jpg|*.jpeg|*.pdf) ;; *) continue ;; esac
      tok=$(design_expand "$tok")
      cand="$cand$tok"$'\n'
      [ -f "$tok" ] && found="$found$tok"$'\n'
    done <<<"$(grep -oE '(^|[^A-Za-z0-9_./~:-])(~/|/)[^[:space:]`"<>|]+' <<<"$line" | sed -E 's/^[^/~]*//')"
    if [ -z "$found" ]; then
      # A leading space so the "preceded by a non-path character" branch always
      # has a character to match, including for a path that starts the line.
      span=$(sed -nE 's#^.*[^A-Za-z0-9_./~:-]((~/|/)[^`"<>|]*\.(dc\.html|html|png|jpe?g|pdf))([^A-Za-z0-9_.].*)?$#\1#p' <<<" $line")
      if [ -n "$span" ]; then
        span=$(design_expand "$span")
        if [ -f "$span" ]; then found="$span"$'\n'; cand="$span"$'\n'
        elif [ -z "$cand" ]; then cand="$span"$'\n'; fi
      fi
    fi
    if [ -n "$found" ]; then
      found_all="$found_all$found"
    else
      while IFS= read -r tok; do
        [ -n "$tok" ] && warn "the plan mentions a design file that is not on disk: $tok"
      done <<<"$cand"
    fi
  done <<<"$lines"
  # Deduplicated in order of first mention, not sorted: the plan's own order is
  # the meaningful one, and a sort by absolute path would order the set by
  # whichever directory the files happen to live in.
  [ -n "$found_all" ] && printf '%s' "$found_all" | awk '!seen[$0]++'
  return 0
}

# Does the plan read as built from a design at all? This is what decides whether
# an EMPTY design set is worth a question (add_wizard) or a warning (cmd_add).
design_hinted() {                       # plan_file -> 0 when it cites Claude Design
  grep -qE 'claude\.ai/design|\.dc\.html' "$1" 2>/dev/null
}

# The design files a task carries, one basename per line, from its header.
design_list() {                         # task_dir
  local v; v=$(hdr "$1/plan.md" design)
  [ -n "$v" ] || return 0
  # A bash substitution, not sed: BSD sed does not read `\n` in a replacement.
  printf '%s\n' "${v//, /$'\n'}" | sed '/^$/d'
}

# The four questions that shape how a task runs, asked right after pick_plan
# actually chose something - see cmd_add's `interactive` gate. `split`,
# `split_dir`, `outline`, `model` and the `design_*` variables are reached the
# same way `after_vals` is above, through bash's dynamic scope - do_split relies
# on the identical mechanism (see the warning on cmd_add's own locals) - so this
# function must never declare any of them `local`. The `${x:-}` defaults are for
# callers that predate the newer ones (test/pq-add-pick.sh's wrapper declares
# only the original four), which under `set -u` would otherwise abort.
#
# The split question is asked only of a plan whose outline has more than one
# entry - one that lays out several pull requests itself (see name_plan) - and
# lists them first, with Enter meaning yes: one task is one pull request, so
# a plan that means to open three is queued as three. Any other plan is not
# asked at all, however big it is; there is nothing to split it along. The
# outline is shown to you, not fed to the splitter, which reads the plan's
# pull requests off source.md itself and still shows its table for
# confirmation before anything is queued. `--split` is still there for a plan
# that lays out several when Haiku has missed it.
add_wizard() {
  if [ "$split" != 1 ] && [ -z "$split_dir" ]; then
    local ans n=0 t i=0
    [ -n "${outline:-}" ] && n=$(grep -c . <<<"$outline")
    if [ "$n" -gt 1 ]; then
      msg "this plan lays out $n pull requests:"
      while IFS= read -r t; do
        [ -n "$t" ] || continue
        i=$((i + 1)); printf 'pq:   %d. %s\n' "$i" "$t" >&2
      done <<<"$outline"
      printf 'pq: queue one task per pull request? [Y/n] ' >&2
      read -r ans || ans=n
      [[ "${ans:-}" =~ ^[Nn] ]] || split=1
    fi
  fi
  # Which model runs it. The three offered are the ones worth choosing between
  # for a queued task; Enter takes PQ_DEFAULT_MODEL, whatever that is set to, so
  # an env override still decides the default rather than this list. `--model`
  # given explicitly skips the question, like every other *_explicit - and the
  # flag itself deliberately stays unvalidated, since it is passed straight to
  # `claude --model` and any id that tool accepts is a legitimate answer. Only
  # what is TYPED here is held to the three, because a typo at a prompt is a
  # slip rather than a choice. A bare initial is taken too (s, o, f are
  # unambiguous), as is any case - the same forgiveness pick_after shows "1, 3".
  # EOF is Enter: a wizard reached with stdin already spent must not spin.
  if [ "${model_explicit:-0}" != 1 ]; then
    local mans mdef=${model:-$PQ_DEFAULT_MODEL}
    while :; do
      printf 'pq: which model? [sonnet/opus/fable, Enter for %s] ' "$mdef" >&2
      read -r mans || mans=""
      if [ -z "$mans" ]; then model=$mdef; break; fi
      case "$(tr '[:upper:]' '[:lower:]' <<<"$mans")" in
        sonnet|s) model=sonnet; break ;;
        opus|o)   model=opus;   break ;;
        fable|f)  model=fable;  break ;;
        *)        warn "pick one of sonnet, opus or fable - or Enter for $mdef" ;;
      esac
    done
  fi
  # A plan that reads as built from a design, with no design file found or given,
  # is the one input the implementer cannot do without - so it is asked for once,
  # here, where the person who has the file is at the keyboard. Blank goes without,
  # loudly. `--design` given explicitly skips the question, like every *_explicit.
  if [ "${design_hinted:-0}" = 1 ] && [ "${design_explicit:-0}" != 1 ] && [ -z "${design_vals:-}" ]; then
    local dp
    printf 'pq: this plan was built from a design, but no design file was found on disk - path to it? [Enter for none] ' >&2
    read -r dp || dp=""
    dp=$(design_expand "$dp")
    if [ -n "$dp" ]; then
      [ -f "$dp" ] || die "no such design file: $dp"
      design_vals="${design_vals:-}${dp}"$'\n'
    else
      warn "no design file - the implementer will build from the plan's prose alone"
    fi
  fi
  [ "$after_explicit" = 1 ] || pick_after
}

# The plan and the name the task goes by come first, and are never flags.
# `pq add` itself passes all four empty: the plan is picked at the wizard and
# Haiku names it. Only pq's own caller fills them in - split_queue, one part at
# a time, with a part it wrote and a name it already chose - and a branch given
# means the intent and the security verdict were given too, so they are taken
# as they came, even empty. None of it is on the command line: the wizard is the
# way in, and a plan path, --branch or --intent typed there is refused.
#
# The security verdict is `yes` or empty, nothing else: a caller written for the
# three positionals this used to take would hand its first flag over as the
# fourth, and that must fail here rather than quietly shift every flag after it.
cmd_add() {                             # plan branch intent security ("" "" "" "" to pick and name) [flags...]
  [ $# -ge 4 ] || die "internal error: cmd_add takes a plan, a branch, an intent and a security verdict before its flags"
  case "$4" in ""|yes) ;; *) die "internal error: cmd_add's security verdict is yes or empty, not '$4'" ;; esac
  # `model_explicit` is the *_explicit pattern again, and it is needed rather
  # than a `[ "$model" != "$PQ_DEFAULT_MODEL" ]` test: `--model sonnet` and no
  # flag at all leave `model` identical, and only one of the two should still
  # be asked about by add_wizard.
  local plan=$1 branch=$2 intent=$3 security=$4 model=$PQ_DEFAULT_MODEL model_explicit=0 effort=$PQ_DEFAULT_EFFORT
  shift 4
  local urgent=0 repo="" repo_explicit=0
  # `basebr` rather than `base`: the blocker-hint loop at the end of this
  # function already declares a `local base`, and `split_queue` reads THIS one
  # through bash's dynamic scope (as it already does for $urgent), so
  # the two must not share a name.
  local basebr=""
  # A string, not an array: an empty bash array expanded under `set -u` is a
  # portability trap (fixed only in bash 4.4+), so every repeatable option in
  # this script accumulates into a newline-joined string instead. See `repos`
  # in cmd_ls for the same idiom.
  local after_vals="" after_explicit=0
  # `repo` stays the FIRST value given, so every existing single-repo path is
  # untouched; `repo_vals` is the full repeatable set, read by do_split to
  # decide whether the scan still contributes (see the asymmetry documented
  # on do_split's own --repo handling).
  local repo_vals=""
  # `split` and `split_dir` MUST stay local here: `do_split` recurses back into
  # this very function once per part, through bash's ordinary dynamic scope,
  # and it is these two `local`s - shadowing whatever the recursive call
  # passed - that stop that recursion rather than forking every part into its
  # own split.
  # `interactive` is the same idea for add_wizard: it fires the wizard once,
  # never on the recursive calls do_split and split_queue make into cmd_add.
  local split=0 split_dir="" interactive=0
  # The design set: paths, newline-joined like every other repeatable option,
  # gathered from --design, from the plan's own text (design_mentions) and from
  # the wizard, then validated and copied in one place below. `design_explicit`
  # follows the *_explicit pattern: given on the command line, the wizard does
  # not ask. `design_hinted` is whether the plan reads as built from a design at
  # all - what decides whether an empty set earns a question or a warning.
  local design_vals="" design_explicit=0 design_hinted=0
  # Haiku's outline of the plan - the pull requests it lays out itself - read
  # by add_wizard through dynamic scope, so it must be declared here.
  local outline=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --base)      basebr=${2:-}; basebr=${basebr#origin/}; shift 2 ;;
      --model)     model=${2:-}; model_explicit=1; shift 2 ;;
      --effort)    effort=${2:-}; shift 2 ;;
      --urgent)    urgent=1; shift ;;
      --repo)      repo_vals="${repo_vals}${2:-}"$'\n'; [ -n "$repo" ] || repo=${2:-}; repo_explicit=1; shift 2 ;;
      --after)     after_vals="${after_vals}${2:-}"$'\n'; after_explicit=1; shift 2 ;;
      --design)    design_vals="${design_vals}${2:-}"$'\n'; design_explicit=1; shift 2 ;;
      --split)     split=1; shift ;;
      --split-dir) split_dir=${2:-}; shift 2 ;;
      -h|--help)   die "usage: pq add [--base BRANCH] [--model M] [--effort E] [--urgent] [--repo PATH]... [--after task|branch]... [--design PATH]... [--split | --split-dir DIR]" ;;
      -*)          die "unknown option '$1'" ;;
      *)           die "pq add takes no plan path - it asks which plan: '$1'" ;;
    esac
  done

  # An explicit design path that does not exist is a typo worth catching before
  # anything else is paid for - the same reasoning as the branch checks below.
  local dv
  while IFS= read -r dv; do
    [ -n "$dv" ] || continue
    [ -f "$(design_expand "$dv")" ] || die "no such design file: $dv"
  done <<<"$design_vals"

  [ "$split" = 1 ] && [ -n "$split_dir" ] && \
    die "--split and --split-dir are mutually exclusive - pick one"

  # A second --repo only means something when parts can land in different
  # repos - a plain add queues one task in one repo, so a repeated --repo
  # there is a mistake worth catching rather than silently taking the first.
  local repo_n=0 rv
  while IFS= read -r rv; do [ -n "$rv" ] || continue; repo_n=$((repo_n + 1)); done <<<"$repo_vals"
  [ "$repo_n" -gt 1 ] && [ "$split" != 1 ] && [ -z "$split_dir" ] && \
    die "--repo is repeatable only with --split or --split-dir - a plain add takes exactly one"

  if [ -n "$split_dir" ]; then
    [ -d "$split_dir" ] || die "no such split directory: $split_dir"
  else
    # The plan is picked at the wizard, unless pq's own caller handed one in
    # (every recursive cmd_add call split_queue makes, one per part). There
    # is no unattended add: with no terminal to ask at, `pq add` stops.
    if [ -z "$plan" ]; then
      at_terminal || die "pq add asks which plan to add - run it at a terminal"
      local picked
      picked=$(pick_plan)
      case $? in
        0) plan=$picked; interactive=1 ;;
        1) die "no plan chosen" ;;
        *) die "no plans in $PLANS_DIR to add" ;;
      esac
    fi
    [ -f "$plan" ] || die "no such plan: $plan"
  fi

  # The repo is wherever you are standing when you add the plan - you planned the
  # work in it. Resolve to the MAIN checkout, so adding from inside a worktree
  # still queues against the repo the new worktree will be forked from.
  #
  # A failure to resolve is NOT fatal here: it only IS fatal for a plain add,
  # which genuinely needs one repo - a --split can still work if cwd is
  # itself a container of several checkouts rather than a repo, which is
  # exactly what do_split's own container-mode scan handles. Whether this is
  # a split may not be decided yet (the wizard below can still turn it into
  # one), so the die is deferred past the split gate rather than dropped.
  [ -n "$repo" ] || repo=$(git -C "$PWD" worktree list --porcelain 2>/dev/null | awk '/^worktree /{print substr($0,10); exit}')

  # No --base given: inherit the branch the repo is STANDING ON, when that is
  # something other than its default. You plan the work in the branch it belongs
  # to, so the checkout already knows the answer, and asking you to repeat it as
  # `--base` every time is a step that will be forgotten - silently, because a
  # forgotten base queues against the trunk and only shows up at dispatch.
  #
  # Read from $repo, NOT from $PWD, deliberately. $repo is already resolved to the
  # MAIN checkout above so that adding from inside a worktree still queues against
  # the parent - and taking the branch from $PWD would undo that in the worst
  # possible way: planning from inside a task's worktree would silently base the
  # new task on THAT task's in-flight branch, which is stacked pull requests, a
  # much bigger decision than an inferred default should ever make on its own.
  #
  # Three things stop this firing when it should not:
  #   detached HEAD      rev-parse prints "HEAD"; there is no branch to inherit
  #   already the default  nothing to record - see the normalisation below
  #   not on origin      `wt new --base origin/X` cannot fork it and no pull
  #                      request can target it, so it is not a usable base yet
  #
  # It runs BEFORE the split gate so `--split` inherits it too, and it is quiet
  # about repos it cannot read at all (a container directory in a no-primary
  # split), where `rev-parse` simply fails and $cur stays empty.
  local base_note=""
  if [ -z "$basebr" ] && [ -n "$repo" ]; then
    local cur def
    cur=$(git -C "$repo" rev-parse --abbrev-ref HEAD 2>/dev/null)
    def=$(repo_base "$repo")
    if [ -n "$cur" ] && [ "$cur" != HEAD ] && [ -n "$def" ] && [ "$cur" != "$def" ]; then
      if git -C "$repo" rev-parse --verify --quiet "refs/remotes/origin/$cur^{commit}" >/dev/null 2>&1; then
        basebr=$cur
        # Held, not printed here. The inference has to run before the split gate
        # so `--split` inherits it, but that is several lines before `plan:` is
        # announced - and a bare `base:` arriving ahead of the plan it belongs to
        # reads like a different command's output. Emitted next to `branch:`
        # instead, which is the line it pairs with. The split path prints it on
        # its way past, since it returns long before that block.
        base_note="base:   $cur (the branch $(basename "$repo") is on - pass --base $def for the default)"
      else
        warn "$(basename "$repo") is on $cur, which is not on origin - queuing against $def instead; push it, or pass --base"
      fi
    fi
  fi

  # Whether it came from --base or from the checkout, a base that IS the repo
  # default is recorded as no base at all. `task_base` falls through to exactly
  # the same answer, so this keeps plan.md free of a header that changes nothing,
  # keeps "absent means default" true for every task ever queued, and makes
  # `--base master` a clean way to say "ignore the branch I am on".
  if [ -n "$basebr" ] && [ -n "$repo" ]; then
    [ "$basebr" = "$(repo_base "$repo")" ] && basebr=""
  fi

  # The design set, before the wizard: what the plan's text names and exists on
  # disk joins whatever --design gave, and whether the plan reads as built from a
  # design at all is what the wizard's question (or the warning below) turns on.
  # A resumed split reads its source.md, since there is no plan argument then.
  local design_src=$plan
  [ -n "$split_dir" ] && design_src="$split_dir/source.md"
  if [ -f "$design_src" ]; then
    design_hinted "$design_src" && design_hinted=1
    local detected; detected=$(design_mentions "$design_src")
    [ -n "$detected" ] && design_vals="${design_vals}${detected}"$'\n'
  fi

  # Naming, before the wizard rather than after the split gate where it used to
  # sit, so Haiku's outline is in hand when the split question would be asked. One
  # call per add either way: the later call is gone, and the outline rides along
  # in the same reply. Skipped for a part queued by split_queue, which arrives
  # already named - paying Haiku again per part would double the naming cost
  # for nothing - and for a resumed split, which names its parts later.
  local named=""
  if [ -z "$split_dir" ] && [ -z "$branch" ]; then
    local named_all; named_all=$(name_plan "$plan")
    named=$(head -1 <<<"$named_all")
    outline=$(outline_of "$named_all")
  fi

  # The wizard runs only for a plan the picker actually chose, and must run
  # before the split gate below, so $split is decided before do_split would
  # need it.
  [ "$interactive" = 1 ] && add_wizard

  # What the wizard's design question would have caught, for an add that never
  # reached it - a split part, or a resumed split: a design the plan leans on
  # with no file to show for it.
  if [ "$interactive" != 1 ] && [ "$design_hinted" = 1 ] && [ -z "$design_vals" ]; then
    warn "the plan was built from a design, but no design file was found on disk or given - the implementer will build from prose; pass --design PATH"
  fi

  # The design set, resolved: every path exists, no two share a basename (they
  # land in one design/ directory), and the header carries the basenames joined
  # with ", " - which is why a comma in a filename is refused rather than
  # written into a list it would then be read out of wrongly.
  local design_files="" design_names="" design_hdr="" dfile dbase
  while IFS= read -r dfile; do
    [ -n "$dfile" ] || continue
    dfile=$(design_expand "$dfile")
    [ -f "$dfile" ] || die "no such design file: $dfile"
    dbase=$(basename "$dfile")
    case "$dbase" in *,*) die "design filename contains a comma, which the design: header cannot carry: $dbase" ;; esac
    case $'\n'"$design_files" in *$'\n'"$dfile"$'\n'*) continue ;; esac
    case $'\n'"$design_names" in *$'\n'"$dbase"$'\n'*) die "two design files share the name '$dbase' - rename one: $dfile" ;; esac
    design_files="$design_files$dfile"$'\n'
    design_names="$design_names$dbase"$'\n'
    design_hdr="${design_hdr:+$design_hdr, }$dbase"
  done <<<"$design_vals"

  # The --repo check above ran before the wizard could have set split=1 by
  # answering its own question: a repeatable --repo given alongside a plan the
  # picker chose interactively must not be rejected just because the wizard
  # hadn't yet answered "queue one task per pull request?" when the first check
  # ran - $repo_n itself does not change, only $split does.
  [ "$repo_n" -gt 1 ] && [ "$split" != 1 ] && [ -z "$split_dir" ] && \
    die "--repo is repeatable only with --split or --split-dir - a plain add takes exactly one"

  if [ -n "$split_dir" ] || [ "$split" = 1 ]; then
    # cwd not being a repo is do_split's problem now, not ours - it either
    # resolves a container path (see repo_candidates_container) or dies with
    # a more specific message than we could give here.
    [ -n "$repo" ] || repo=$PWD
    [ -n "$base_note" ] && msg "$base_note"
    do_split
    local split_rc=$?
    # Reached only on the split path, which returns before the reset at the end
    # of this function - and the base inference above now calls repo_base, so
    # without this the memo would outlive the process that made it.
    repo_base_reset
    return $split_rc
  fi

  [ -n "$repo" ] || die "not inside a git repo - run this from the project, or pass --repo"

  msg "plan:   $plan"

  # The name. Haiku was asked above, before the wizard, when it was going to be
  # asked at all; here its answer is taken apart. A part arrives named, intent
  # and verdict and all - an empty intent from its own naming call included - so
  # only an unnamed task reads Haiku's reply. Either way the branch is checked
  # before anything is written. `cut`, never `read`: a tab is IFS whitespace, so
  # an empty intent would let the verdict slide into its place.
  local why
  if [ -z "$branch" ] && [ -n "$named" ]; then
    branch=$(cut -f1 <<<"$named")
    intent=$(cut -f2 <<<"$named")
    security=$(cut -f3 <<<"$named")
  fi
  [ -n "$branch" ] || die "could not name the plan - Haiku gave no usable branch; try pq add again"
  git check-ref-format "refs/heads/$branch" || die "invalid branch name: '$branch'"
  why=$(branch_taken "$branch" "$repo") && die "branch '$branch' is already $why"

  # Validated at ADD time, not at dispatch: a typo here would otherwise sit in the
  # queue until 3am and then either fork the wrong branch or refuse to start, and
  # the person who could recognise the typo is at the keyboard right now. The
  # remote-tracking ref first (offline, and what dispatch will actually fork
  # from), then `ls-remote` for a branch this checkout has simply never fetched.
  if [ -n "$basebr" ]; then
    git check-ref-format "refs/heads/$basebr" || die "invalid base branch name: '$basebr'"
    if ! git -C "$repo" rev-parse --verify --quiet "refs/remotes/origin/$basebr^{commit}" >/dev/null; then
      git -C "$repo" ls-remote --exit-code --heads origin "$basebr" >/dev/null 2>&1 \
        || die "no such base branch on origin: '$basebr' (in $repo)"
    fi
    # No "based on its own branch" check here: this block runs after the naming
    # step, and `branch_taken` has already refused any branch that exists - so a
    # base equal to the branch is either caught there or fails the ref check
    # above. A third guard for it would be unreachable.
  fi

  local slug; slug=$(branch_to_slug "$branch")
  [ -n "$slug" ] || die "branch '$branch' does not reduce to a usable name"

  # Resolve every --after value to a (label, repo, branch) triple NOW, before
  # anything is written - a bad blocker should fail the whole add, not leave a
  # task queued with only some of what it was told to wait on. Self-reference
  # and cycles are rejected here for the same reason `find_task` resolves the
  # slug side of it: adding is the one place a mistake is cheap to catch.
  local after_lines="" av label arepo abranch resolved
  while IFS= read -r av; do
    [ -n "$av" ] || continue
    resolved=$(resolve_after "$repo" "$av") || die "could not resolve '$av' to a task or branch"
    IFS=$'\t' read -r label arepo abranch <<<"$resolved"
    [ -n "$arepo" ] && [ -n "$abranch" ] || die "could not resolve '$av' to a repo and branch"
    [ "$arepo" = "$repo" ] && [ "$abranch" = "$branch" ] && die "a task cannot block on itself"
    after_cycle "$repo" "$branch" "$arepo" "$abranch" \
      && die "'$av' would create a cycle - $branch already leads back to it"
    # The explicit $'\n' matters: command substitution strips ALL trailing
    # newlines, so without it a single-blocker add would write an `after` file
    # with none - and `while read` silently skips a final line that has no
    # trailing newline, so after_state would read the file as empty and the
    # blocker would never gate anything.
    after_lines="${after_lines}$(printf '%s\t%s\t%s' "$label" "$arepo" "$abranch")"$'\n'
  done <<<"$after_vals"

  local state=queue
  # Allocated here, immediately before the directory is built - not earlier,
  # alongside the rest of the parse - so a `--split` that pays for a Haiku
  # naming round trip between the two points records a stamp for when the
  # task actually landed, not for when the command started.
  local stamp; stamp=$(next_stamp "$urgent")
  local dir; dir="$PQ_HOME/$state/$(task_name "$stamp" "$slug")"
  [ -e "$dir" ] && die "a task already exists at $state/$(basename "$dir")"
  local taken_in; taken_in=$(slug_taken_in "$slug") && die "a task named '$slug' already exists in $taken_in/"

  # Build the task somewhere the queue cannot see, then move it into place. A task
  # directory with no plan.md would be listed by `pq ls` as a blank row, matched by
  # `find_task`, and - once tick exists - iterated unattended with an empty `repo`,
  # which is a `cd ""` into the wrong place. Assembling out of sight means a failed
  # or interrupted add leaves nothing behind rather than something half-formed.
  PQ_STAGING="$PQ_HOME/.add.$$"
  rm -rf "$PQ_STAGING"; mkdir -p "$PQ_STAGING" || die "could not create $PQ_STAGING"
  trap 'rm -rf "$PQ_STAGING"' EXIT
  # COPY, never move: ~/.claude/plans is Claude Code's directory and it prunes it,
  # so the original is not ours to consume. `source` keeps the trail back.
  {
    printf -- '---\n'
    printf 'repo:     %s\n'   "$repo"
    printf 'branch:   %s\n'   "$branch"
    # Omitted entirely when unset rather than written empty: `task_base` reads
    # this key, and an absent one is what makes it fall through to the repo
    # default - which is the whole compatibility story for every task, and every
    # already-queued plan.md, that predates this option.
    [ -n "$basebr" ] && printf 'base:     %s\n' "$basebr"
    # Same absent-means-none pattern as `base:` - written only when there is
    # a design set, so every task without one keeps the header it always had.
    [ -n "$design_hdr" ] && printf 'design:   %s\n' "$design_hdr"
    # And again: only a plan that asks for a security review carries the key,
    # and it is what reconcile reads to open the security reviewer's ladder.
    [ "$security" = yes ] && printf 'security: yes\n'
    printf 'model:    %s\n'   "$model"
    printf 'effort:   %s\n'   "$effort"
    printf 'intent:   %s\n'   "${intent:-}"
    printf 'source:   %s\n'   "$plan"
    printf 'added:    %s\n'   "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    printf -- '---\n\n'
    cat "$plan"
  } > "$PQ_STAGING/plan.md" || die "could not write the task's plan.md"
  [ -s "$PQ_STAGING/plan.md" ] || die "wrote an empty plan.md - refusing to queue it"
  # Written to staging, not to $dir afterwards - the same reason plan.md is
  # built here: a task with a plan but no `after` is exactly the kind of
  # half-formed state this staging dance exists to rule out.
  [ -n "$after_lines" ] && printf '%s' "$after_lines" > "$PQ_STAGING/after"
  # The design files too, and for the same reason: the header names them, so a
  # task must never land with a `design:` line and an empty design/.
  if [ -n "$design_files" ]; then
    mkdir -p "$PQ_STAGING/design" || die "could not create the task's design/"
    while IFS= read -r dfile; do
      [ -n "$dfile" ] || continue
      cp "$dfile" "$PQ_STAGING/design/" || die "could not copy the design file $dfile"
    done <<<"$design_files"
  fi
  mv "$PQ_STAGING" "$dir" || die "could not move the new task into $state/"
  trap - EXIT
  task_link "$dir"

  msg "branch: $branch"
  [ -n "$base_note" ] && msg "$base_note"
  [ -n "$intent" ] && msg "intent: $intent"
  [ -n "$design_hdr" ] && msg "design: $design_hdr"
  [ "$security" = yes ] && msg "review: code and security - the plan asks for a /security-review"
  msg "added:  $state/$(basename "$dir")  ($model, effort $effort)"

  if [ -n "$after_lines" ]; then
    pr_load_all "$(awk -F'\t' '{print $2"\t"$3}' <<<"$after_lines")"
    local base
    while IFS=$'\t' read -r label arepo abranch; do
      [ -n "$label" ] || continue
      base=$(blocker_base "$dir" "$arepo")
      if [ -n "$base" ] && merged_into "$arepo" "$abranch" "$base"; then
        msg "after $label: already in $base - nothing to wait for"
      else
        msg "after $label ($abranch)"
      fi
    done <<<"$after_lines"
  fi

  # The slug is the one thing on stdout - split_queue reads it back for every
  # part it queues - and everything a human reads goes to stderr.
  printf '%s\n' "$slug"
  rm -f "$PR_CACHE" "$PR_ANS"
  repo_base_reset
}

# ── the repo inventory ───────────────────────────────────────────────────────
# Discovered, not declared: a plan already names the repositories or directories
# it touches, so the splitter only needs to know what is checked out and can
# work out the rest. Candidates default to the git checkouts sitting alongside
# the primary - siblings under its own parent directory - unless PQ_REPOS_DIR
# names a different scan root.
repo_candidates() {                     # primary_repo -> label<TAB>path, primary first, rest sorted by label
  local primary=$1 root entry label resolved
  root="${PQ_REPOS_DIR:-$(dirname "$primary")}"

  printf '%s\t%s\n' "$(basename "$primary")" "$primary"
  local seen_paths=$'\n'"$primary"$'\n' seen_labels
  seen_labels=$'\n'"$(basename "$primary")"$'\n'

  # Each entry resolves to its MAIN checkout via the same `git worktree list
  # --porcelain` idiom cmd_add already uses on the primary (line ~751), so a
  # linked worktree collapses onto its parent instead of counting twice.
  local found=""
  for entry in "$root"/*/; do
    [ -d "$entry" ] || continue
    entry=${entry%/}
    case "$(basename "$entry")" in .*) continue ;; esac
    resolved=$(git -C "$entry" worktree list --porcelain 2>/dev/null \
                 | awk '/^worktree /{print substr($0,10); exit}')
    [ -n "$resolved" ] || continue                     # not a git repo at all
    case "$seen_paths" in *$'\n'"$resolved"$'\n'*) continue ;; esac
    label=$(basename "$resolved")
    case "$seen_labels" in *$'\n'"$label"$'\n'*) continue ;; esac
    seen_paths="$seen_paths$resolved"$'\n'
    seen_labels="$seen_labels$label"$'\n'
    found="$found$label"$'\t'"$resolved"$'\n'
  done
  [ -n "$found" ] || return 0
  # `found` already ends in `$'\n'` from the loop above, and `<<<` appends
  # its OWN trailing newline unconditionally - so the here-string doubles up
  # and `sort` sees one extra, empty final "line", which sorts to the front
  # (empty precedes everything) and would otherwise surface as a phantom
  # candidate. `sed` drops it the same way `cmd_ls`'s `multi` check does.
  found=$(sort -t$'\t' -k1,1 <<<"$found" | sed '/^$/d')

  # A silent truncation here would read as "the splitter considered
  # everything" when it did not - so past PQ_REPOS_MAX, name every repo dropped.
  local total; total=$(( $(grep -c . <<<"$found") + 1 ))
  if [ "$total" -gt "$PQ_REPOS_MAX" ]; then
    local keep=$(( PQ_REPOS_MAX - 1 )) dropped
    dropped=$(tail -n +"$(( keep + 1 ))" <<<"$found" | cut -f1 | tr '\n' ' ')
    found=$(head -n "$keep" <<<"$found")
    warn "found $total candidate repos, more than PQ_REPOS_MAX ($PQ_REPOS_MAX) - dropped: $dropped - pass --repo explicitly to include one of these"
  fi
  printf '%s' "$found"
}

# Same discovery, for a plan added from a directory that is NOT itself a git
# repo - a container holding several checkouts as peers (e.g. `~/projects`).
# There is no primary among them: nothing here is privileged as the default a
# part can land in without the plan saying so. Kept separate from
# repo_candidates rather than folded into one function with a mode flag: the
# two differ in scan root (a container scans itself, not its parent), in
# dedup seeding (no primary to seed against), and in truncation math (no
# primary consuming a slot) - similar shapes, different enough contracts that
# sharing one signature would need more branching than the duplication costs.
repo_candidates_container() {           # dir -> label<TAB>path, sorted by label
  local dir=$1 root entry label resolved
  root="${PQ_REPOS_DIR:-$dir}"

  local seen_paths=$'\n' seen_labels=$'\n'
  local found=""
  for entry in "$root"/*/; do
    [ -d "$entry" ] || continue
    entry=${entry%/}
    case "$(basename "$entry")" in .*) continue ;; esac
    resolved=$(git -C "$entry" worktree list --porcelain 2>/dev/null \
                 | awk '/^worktree /{print substr($0,10); exit}')
    [ -n "$resolved" ] || continue                     # not a git repo at all
    case "$seen_paths" in *$'\n'"$resolved"$'\n'*) continue ;; esac
    label=$(basename "$resolved")
    case "$seen_labels" in *$'\n'"$label"$'\n'*) continue ;; esac
    seen_paths="$seen_paths$resolved"$'\n'
    seen_labels="$seen_labels$label"$'\n'
    found="$found$label"$'\t'"$resolved"$'\n'
  done
  [ -n "$found" ] || return 0
  # Same here-string double-newline trap as repo_candidates above.
  found=$(sort -t$'\t' -k1,1 <<<"$found" | sed '/^$/d')

  local total; total=$(grep -c . <<<"$found")
  if [ "$total" -gt "$PQ_REPOS_MAX" ]; then
    local keep=$PQ_REPOS_MAX dropped
    dropped=$(tail -n +"$(( keep + 1 ))" <<<"$found" | cut -f1 | tr '\n' ' ')
    found=$(head -n "$keep" <<<"$found")
    warn "found $total candidate repos under $dir, more than PQ_REPOS_MAX ($PQ_REPOS_MAX) - dropped: $dropped - pass --repo explicitly to include one of these"
  fi
  printf '%s' "$found"
}

# ── splitting a plan ─────────────────────────────────────────────────────────
# `pq add --split` is for a plan that lays out several pull requests of its own:
# a "PR 1" and a "PR 2", or work in more than one repository. It runs one Opus
# session that reads the plan and writes one standalone plan per pull request
# the plan lays out - never a division the plan does not make itself, since a
# big change is one pull request of small commits, and cutting it further only
# queues its parts behind each other's merges - plus a dependency graph, then
# queues every part through the ordinary `cmd_add` path with its blockers wired -
# same header, same `branch_taken` guard, same staging dance, same `after`
# file a hand-typed add would get. The load-bearing constraint: parts wait for
# MERGES, never for branches - no part is ever built on a sibling's branch.
# `--after` handles that on the scheduling side; this section's validation is
# the other half, since it is what keeps the part text honest about it.
#
# `do_split` reads `cmd_add`'s locals through bash's dynamic scope (`plan`,
# `repo`, `repo_explicit`, `repo_vals`, `model`, `effort`, `urgent`, `after_vals`,
# `split_dir`) and is only ever called from there - hence no arguments of its
# own.

# The prompt the splitter session is given, passed as an argv element (unlike
# `dispatch_prompt`, never typed into a pane's shell) so it has no quote
# restriction.
splitter_prompt() {                     # candidates: label<TAB>path, primary first (or an empty-label sentinel row when there is no primary - see do_split)
  local candidates=$1 repo_block example primary_label primary_path repo_sentence field_sentence row1
  row1=$(head -1 <<<"$candidates")
  # `cut`, not `read`: a sentinel row starts with a literal tab (empty
  # label), and bash's `read` treats a tab as "IFS whitespace" even when IFS
  # holds nothing else - it strips that LEADING tab before splitting, so
  # `IFS=$'\t' read` would shift the path into `primary_label` and leave
  # `primary_path` empty. `cut` never trims field boundaries, so it reads an
  # empty first field correctly.
  primary_label=$(cut -f1 <<<"$row1"); primary_path=$(cut -f2 <<<"$row1")
  # `$1 != ""` guards against a phantom trailing record: `candidates` can
  # itself end in `$'\n'` (the explicit multi-repo `--repo` path builds it
  # that way), and `<<<` appends its OWN newline unconditionally on top -
  # doubling up into one empty final "line" that would otherwise print as a
  # bare "- : " bullet in the prompt. It also naturally excludes the
  # no-primary sentinel row itself, which is not a repository to read from.
  repo_block=$(awk -F'\t' '$1 != "" { printf "- %s: %s\n", $1, $2 }' <<<"$candidates")

  # The design files travel with whichever parts cite them (split_queue matches
  # on the filename), so the splitter is told to cite - read off cmd_add's
  # `design_hdr` through dynamic scope, like everything else in here.
  local design_sentence=""
  [ -n "${design_hdr:-}" ] && design_sentence="
The source plan is built from these design files: $design_hdr. A part that implements any of that visual work must name the design file it is built from, by its exact filename, so the right file travels with that part."

  if [ -n "$primary_label" ]; then
    repo_sentence="The primary is $primary_label ($primary_path). Use it unless source.md clearly places some of the work in one of the others - never assign a part to a repository the plan does not talk about."
    field_sentence="the label of the repository this part belongs to, EMPTY for the primary"
    example=$(printf '01-tip-fee-config.md\t\n02-tip-fee-ios.md\t01-tip-fee-config.md\tios\n03-tip-fee-android.md\t01-tip-fee-config.md\tandroid')
  else
    repo_sentence="There is no primary here - these repositories are peers, none of them a default. EVERY part must name which one it belongs to; never assign a part to a repository the plan does not talk about."
    field_sentence="the label of the repository this part belongs to - REQUIRED, there is no primary to leave it empty for"
    example=$(printf '01-tip-fee-config.md\t\tconfig\n02-tip-fee-ios.md\t01-tip-fee-config.md\tios\n03-tip-fee-android.md\t01-tip-fee-config.md\tandroid')
  fi

  cat <<EOF
Read ./source.md - it is a plan that lays out the pull requests its work ships as. These repositories are checked out and readable, but never writable - read whatever you need from any of them to write each of those pull requests up as a plan of its own:

$repo_block

$repo_sentence

Write into the current directory ONLY:
- One file per part: NN-short-slug.md, numbered in build order starting at 01, lowercase words separated by dashes.
- graph.tsv: one line per part, tab-separated - filename<TAB>comma-separated filenames of the parts that must have MERGED before this one can start<TAB>$field_sentence. Leave the second field empty for a part that can start now.

Field discipline matters here: a root part (no dependencies) still needs an EMPTY middle field even when it names a repository in the third - a model that writes filename<TAB>label instead is read as a dependency named "label", and the split dies on "unknown dependency" once this session has already been paid for. A worked example, two dependent parts and one without:

$example

How to choose the parts - they are the plan's own pull requests, not a division of yours:
- One part per pull request source.md lays out, in its order: a "PR 1" and a "PR 2" are two parts. Never divide one of the plan's pull requests further, however large, and never merge two - a large pull request is reviewed as a series of small commits, and cutting it into more pull requests only makes each piece wait on another's merge.
- A part belongs to exactly ONE repository, because a part is one pull request. One of the plan's pull requests that spans repositories is one part per repository, and so is a plan that works in several repositories without naming its pull requests.
- If source.md does not lay out more than one pull request and all of its work is in one repository, write a single part.
- Each part must leave its own repository's default branch working and shippable once merged. No part may need a later part to compile, pass tests, or behave correctly. A feature flag defaulting off is fine; a half-migrated schema is not. If a pull request the plan lays out cannot stand alone like that, keep the plan's boundaries anyway and note the problem in that part's Context section.
- The order the plan gives its pull requests in is NOT a dependency, and neither is its numbering. Declare a dependency only where one really exists: an interface, schema, migration, or helper another part introduces, or two parts that would edit the same code and collide. This holds across repositories too - a client part that needs an endpoint, field, or flag a server part introduces depends on that server part. Parts with no real dependency must have none declared - that is what lets them run in parallel instead of one after another.
- Between the parts, cover ALL of source.md: do not drop scope, do not add scope, do not leave anything to "a follow-up".

How to write each part - it will be executed by an agent that sees ONLY that one file: it has never read source.md and cannot see any other part.
- Never mention another part, its filename, or its number, and never say "the previous plan". Where a part relies on earlier work, state it as a fact about the code it will find - e.g. "the mentions table already has a notified_at column" - never as a reference to another plan or file.
- Every part starts from its own repository's default branch with its declared dependencies already merged. Never tell a part to branch from, rebase onto, or cherry-pick another part's branch.
- Same shape as the plan you read: a Context section, the specific files to change, the existing functions and patterns to reuse, and a verification section. Real paths, confirmed to exist.
- If source.md asks for a security review (a /security-review) of its work, ask for one in every part whose changes that review is about, with what it should focus on - and in no other part.
- Do not start a part's file with '---' - no YAML front matter.
$design_sentence
EOF
}

# The `pq add --split-dir ...` line to hand back whenever a split stops short
# of queueing everything - declined, or a validation failure, or a part that
# failed to queue mid-pass. Carries every one of cmd_add's own locals that
# isn't already the tool's default, so following this line verbatim does not
# silently drop --model/--effort/--urgent/--after the way a bare
# `--split-dir DIR --repo REPO` would.
split_resume_hint() {                   # sd
  local hint="pq add --split-dir $1 --repo $repo" av df
  [ "$model" = "$PQ_DEFAULT_MODEL" ]   || hint="$hint --model $model"
  [ "$effort" = "$PQ_DEFAULT_EFFORT" ] || hint="$hint --effort $effort"
  [ "$urgent" = 1 ]      && hint="$hint --urgent"
  while IFS= read -r av; do
    [ -n "$av" ] || continue
    hint="$hint --after $av"
  done <<<"$after_vals"
  # %q, because Claude Design names its files with spaces and this line is
  # meant to be pasted into a shell verbatim.
  while IFS= read -r df; do
    [ -n "$df" ] || continue
    hint="$hint --design $(printf '%q' "$df")"
  done <<<"${design_files:-}"
  printf '%s' "$hint"
}

# total_cost_usd duration_ms -> " (\$0.71, 2m48s)", or "" if neither is known.
fmt_cost() {                            # cost_usd duration_ms
  local cost=${1:-} dur=${2:-} out=""
  [ -n "$cost" ] && out="\$$(printf '%.2f' "$cost" 2>/dev/null || printf '%s' "$cost")"
  if [ -n "$dur" ]; then
    local secs=$(( dur / 1000 ))
    out="${out:+$out, }$(( secs / 60 ))m$(( secs % 60 ))s"
  fi
  [ -n "$out" ] && printf ' (%s)' "$out"
}

# The reason a branch or slug cannot be used for a new part, or nothing -
# `branch_taken` plus `slug_taken_in` (the same $STATES sweep `cmd_add` itself
# runs), plus a sibling already named earlier in THIS split.
#
# `part_repo` is an explicit argument rather than `$repo` off dynamic scope,
# so each part's `branch_taken` check runs against ITS OWN repo - a part
# assigned to a second repo claiming a branch already live in the primary
# must queue, not be refused. `slug_taken_in` stays global on purpose: a slug
# is a whole directory name, not a per-repo concept.
split_name_collision() {                # branch slug named_file part_repo
  local branch=$1 slug=$2 named_file=$3 part_repo=$4 why taken_in collider
  why=$(branch_taken "$branch" "$part_repo") && { printf '%s' "$why"; return; }
  taken_in=$(slug_taken_in "$slug") \
    && { printf "a task named '%s' already exists in %s/" "$slug" "$taken_in"; return; }
  collider=$(awk -F'\t' -v b="$branch" -v s="$slug" '$2 == b || $3 == s { print $1; exit }' \
               "$named_file" 2>/dev/null)
  [ -n "$collider" ] && printf 'the same branch or name as %s, already named earlier in this split' "$collider"
}

# Validate the parts and the graph, before any naming and before anything is
# queued. `awk` throughout, never `while read` - a model-written graph.tsv can
# arrive with no trailing tab and no final newline at all (verified against
# the real CLI), and `while read` silently drops a final line with no newline
# where `awk` reads it correctly - the same regression `after` already has a
# test for (test/pq-after.sh:242).
split_validate() {                      # sd -> dies on any violation
  local sd=$1
  local g="$sd/graph.tsv" n bad part mdfiles gnames extra missing dupes unknown selfdep hit

  [ -s "$g" ] || die "the splitter wrote no graph.tsv (or an empty one) - see $sd/splitter.err"

  n=$(awk -F'\t' '$1 != "" { c++ } END { print c + 0 }' "$g")
  [ "$n" -ge 1 ] && [ "$n" -le 12 ] || \
    die "graph.tsv names $n part(s) - must be 1-12; trim and re-run with: $(split_resume_hint "$sd")"

  bad=$(awk -F'\t' '$1 != "" && $1 !~ /^[0-9][0-9]-[a-z0-9-]+\.md$/ { print $1 }' "$g")
  [ -z "$bad" ] || die "graph.tsv names a badly-formed part filename: $(tr '\n' ' ' <<<"$bad")($sd)"

  while IFS= read -r part; do
    [ -n "$part" ] || continue
    [ -f "$sd/$part" ] || die "graph.tsv names $part, which does not exist in $sd"
    [ -s "$sd/$part" ] || die "$sd/$part is empty"
  done <<<"$(awk -F'\t' '$1 != "" { print $1 }' "$g")"

  # Bidirectionally complete: every *.md but source.md is in the graph exactly
  # once, and the graph names nothing else - a part file the graph forgot is
  # silent scope loss, which is the failure that costs a whole feature.
  #
  # Dupes MUST be checked before the `comm` pair below: `comm` walks two
  # SORTED streams in lockstep, so a name listed twice in graph.tsv but once
  # on disk exhausts mdfiles a line early and comm reports the second copy as
  # "file2-only" - misdiagnosing a duplicate as a missing file.
  mdfiles=$( (cd "$sd" && ls -- *.md 2>/dev/null) | grep -vx 'source.md' | sort)
  gnames=$(awk -F'\t' '$1 != "" { print $1 }' "$g" | sort)
  dupes=$(printf '%s\n' "$gnames" | uniq -d)
  [ -z "$dupes" ] || die "graph.tsv lists these parts more than once: $(tr '\n' ' ' <<<"$dupes") ($sd)"
  extra=$(comm -23 <(printf '%s\n' "$mdfiles") <(printf '%s\n' "$gnames") 2>/dev/null)
  [ -z "$extra" ] || die "these part files exist but graph.tsv never lists them: $(tr '\n' ' ' <<<"$extra") ($sd)"
  missing=$(comm -13 <(printf '%s\n' "$mdfiles") <(printf '%s\n' "$gnames") 2>/dev/null)
  [ -z "$missing" ] || die "graph.tsv names files that don't exist: $(tr '\n' ' ' <<<"$missing") ($sd)"

  unknown=$(awk -F'\t' '
    { names[NR] = $1; depsraw[NR] = $2; if ($1 != "") valid[$1] = 1 }
    END {
      for (i = 1; i <= NR; i++) {
        if (names[i] == "") continue
        d = split(depsraw[i], arr, ",")
        for (j = 1; j <= d; j++) {
          dep = arr[j]; gsub(/^[ \t]+|[ \t]+$/, "", dep)
          if (dep != "" && !(dep in valid)) print names[i] ": " dep
        }
      }
    }' "$g")
  [ -z "$unknown" ] || die "graph.tsv names a dependency that is not itself a listed part - $unknown ($sd)"

  selfdep=$(awk -F'\t' '
    $1 != "" {
      d = split($2, arr, ",")
      for (j = 1; j <= d; j++) {
        dep = arr[j]; gsub(/^[ \t]+|[ \t]+$/, "", dep)
        if (dep == $1) print $1
      }
    }' "$g")
  [ -z "$selfdep" ] || die "graph.tsv has a part depending on itself: $(tr '\n' ' ' <<<"$selfdep") ($sd)"

  # The third field: every non-empty one must be a label repo_candidates (or
  # an explicit --repo set) actually offered the splitter - a model does not
  # get to invent a repository. Classic two-file awk: $sd/repos read first
  # into a lookup, graph.tsv checked against it second.
  # A label is valid only with a non-empty path alongside it - a row like
  # "somelabel<TAB>" (a blank path, from a hand-edited file) must not read as
  # a real repository, or split_levels would resolve it to an empty string
  # and reintroduce the exact empty-middle-field hazard `deps` staying last
  # was written to avoid.
  local badrepo
  badrepo=$(awk -F'\t' '
    NR == FNR { if ($1 != "" && $2 != "") valid[$1] = 1; next }
    $1 != "" && $3 != "" && !($3 in valid) { print $1 ": " $3 }
  ' "$sd/repos" "$g")
  [ -z "$badrepo" ] || die "graph.tsv names a repository label that is not in $sd/repos - $badrepo ($sd)"

  # Row 1 of $sd/repos is either the primary (a real label) or a no-primary
  # sentinel do_split writes for a container split - empty label, the
  # container path alongside it (see do_split). A row with BOTH fields empty
  # is neither - a hand-edited file that lost its first line - and reading it
  # as "no primary" would let every part's empty third field slide by
  # unnoticed instead of dying here, where the mistake is easy to see.
  # `cut`, not `read`: a sentinel row starts with a literal tab (empty
  # label), and `read` strips a LEADING tab as "IFS whitespace" before
  # splitting even when IFS holds nothing else, which would shift the path
  # into row1_label and leave row1_path empty - the opposite of what this
  # check needs. `cut` never trims field boundaries.
  local row1 row1_label row1_path
  row1=$(head -1 "$sd/repos")
  row1_label=$(cut -f1 <<<"$row1"); row1_path=$(cut -f2 <<<"$row1")
  if [ -z "$row1_label" ]; then
    [ -n "$row1_path" ] || die "$sd/repos' first row is blank - it must be either the primary (label<TAB>path) or a no-primary sentinel (<TAB>container-path) ($sd)"
    local noassign
    noassign=$(awk -F'\t' '$1 != "" && $3 == "" { print $1 }' "$g")
    [ -z "$noassign" ] || die "graph.tsv leaves the repository field empty for $(tr '\n' ' ' <<<"$noassign") - there is no primary in this split, so every part must name one ($sd)"
  fi

  # Every path the graph actually USES (not every candidate offered - an
  # unrelated sibling costs nothing precisely because nothing ever checks it)
  # must still exist and be a git repo - $sd/repos is a plain hand-editable
  # TSV, and a part queued against a path that moved or was never a repo
  # would fail unattended, far from where the mistake was made.
  local usedpaths up
  usedpaths=$(awk -F'\t' '
    NR == FNR { path[$1] = $2; if (NR == 1) primary = $2; next }
    $1 != "" { r = ($3 == "" ? primary : path[$3]); if (r != "") seen[r] = 1 }
    END { for (p in seen) print p }
  ' "$sd/repos" "$g")
  while IFS= read -r up; do
    [ -n "$up" ] || continue
    [ -d "$up" ] || die "$sd/repos names $up, which no longer exists ($sd)"
    git -C "$up" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
      || die "$sd/repos names $up, which is not a git repository ($sd)"
  done <<<"$usedpaths"

  while IFS= read -r part; do
    [ -n "$part" ] || continue
    [ "$(head -1 "$sd/$part")" != "---" ] || \
      die "$part starts with '---' - that fence is reserved for cmd_add's own header ($sd)"
    # Anchored to EXACTLY two leading digits so a real repo path like
    # db/migrate/20260728141230-add-columns.md cannot trip it - an
    # implementer only ever sees its own plan.md, so a cross-reference is an
    # instruction it cannot follow, and that anchoring is what makes this
    # safe to be a hard error rather than a warning.
    hit=$(grep -nE '(^|[^0-9])[0-9][0-9]-[a-z0-9-]+\.md' "$sd/$part" 2>/dev/null || true)
    [ -z "$hit" ] || die "$part references another part by filename - an implementer never sees a sibling: $hit"
  done <<<"$(awk -F'\t' '$1 != "" { print $1 }' "$g")"
}

# level<TAB>part<TAB>repo(path)<TAB>label<TAB>deps, sorted by level then part
# name - sorting by level IS a valid topological order, since every part
# outranks each of its dependencies. `tsort` is not usable here: on this
# machine it prints "tsort: cycle in data" and still exits 0, so it cannot
# report a cycle - iterative relaxation gives the wave number and the cycle
# check together.
#
# `label` is graph.tsv's own third field verbatim (or the primary's own
# label when that field is empty) - never recomputed as `basename(repo)`,
# which would show the wrong name the moment `$sd/repos` gives a repo a
# label that differs from its directory's basename (a hand-edited file is a
# first-class input, same as graph.tsv itself).
#
# `deps` stays LAST: it is the only field that can be empty (a root part),
# and every consumer reads a row with `IFS=$'\t' read` - bash treats a tab as
# "IFS whitespace" even when IFS holds nothing else, so a run of TWO adjacent
# tabs (an empty field with non-empty neighbours on both sides) collapses to
# one delimiter and silently shifts every field after it left. `repo` and
# `label` are never empty (they resolve to the primary at worst - or, when
# there is no primary, `split_validate` has already died on any part whose
# third field was empty, so `path[$3]`/`$3` are the only branches a
# no-primary split ever actually takes here), so putting them third and
# fourth and leaving `deps` trailing keeps every row `read`-safe.
#
# NEVER calls `die`: the caller reaches this through `leveled=$(split_levels
# ...)`, which forks a subshell, and an `exit` in there would kill only that
# subshell and let the split limp on none the wiser. A cycle is reported on
# stdout instead, with a non-zero return, for `do_split` - which is not
# subshelled - to `die` on.
split_levels() {                        # sd -> prints level<TAB>part<TAB>repo(path)<TAB>label<TAB>deps, or "CYCLE ..." + return 1
  local sd=$1
  local g="$sd/graph.tsv" n out
  n=$(awk -F'\t' '$1 != "" { c++ } END { print c + 0 }' "$g")
  # Two files, classic NR==FNR split: $sd/repos loads the label -> path map
  # (and the primary, its first row) before graph.tsv's third field is
  # resolved against it - an empty third field becomes the primary.
  out=$(awk -F'\t' -v n="$n" '
    NR == FNR { path[$1] = $2; if (FNR == 1) { primary = $2; primlabel = $1 } next }
    $1 != "" {
      name[NR] = $1; deps[NR] = $2; level[$1] = 1
      repo[$1] = ($3 == "" ? primary : path[$3])
      lbl[$1]  = ($3 == "" ? primlabel : $3)
    }
    END {
      changed = 1
      for (pass = 1; pass <= n && changed; pass++) {
        changed = 0
        for (i = 1; i <= NR; i++) {
          if (name[i] == "") continue
          d = split(deps[i], arr, ",")
          for (j = 1; j <= d; j++) {
            dep = arr[j]; gsub(/^[ \t]+|[ \t]+$/, "", dep)
            if (dep == "") continue
            want = level[dep] + 1
            if (want > level[name[i]]) { level[name[i]] = want; changed = 1 }
          }
        }
      }
      if (changed) {
        cyc = ""
        for (i = 1; i <= NR; i++) if (name[i] != "" && level[name[i]] > n) cyc = cyc " " name[i]
        print "CYCLE" cyc
        exit
      }
      for (i = 1; i <= NR; i++) {
        if (name[i] == "") continue
        # Rebuilt trimmed and re-joined, not the raw field: a splitter that
        # writes "a.md, b.md" (a space after the comma - the prompt only
        # says "comma-separated", never "no spaces") must not leak that
        # space into the printed deps column, since split_queue splits this
        # same field on "," and looks each piece up verbatim.
        d = split(deps[i], arr, ",")
        clean = ""
        for (j = 1; j <= d; j++) {
          dep = arr[j]; gsub(/^[ \t]+|[ \t]+$/, "", dep)
          if (dep == "") continue
          clean = (clean == "" ? dep : clean "," dep)
        }
        printf "%d\t%s\t%s\t%s\t%s\n", level[name[i]], name[i], repo[name[i]], lbl[name[i]], clean
      }
    }' "$sd/repos" "$g")
  case "$out" in
    CYCLE*) printf '%s' "$out"; return 1 ;;
  esac
  sort -k1,1n -k2,2 <<<"$out"
}

# Name every part, in topological (level) order, collecting part<TAB>branch
# <TAB>slug<TAB>intent<TAB>security into $sd/.named.tsv. Each part gets its own
# security verdict, off its own text, since a plan that asks for a security
# review of its server work may not want one of the client part that follows -
# which is why splitter_prompt has the ask carried into the parts it is about.
#
# Serial and slow on purpose - one Haiku round trip per part, plus
# `branch_taken`'s bounded `ls-remote` per branch, adds roughly 15-30s for a
# six-part split. That is the intended cost: the `ls-remote` is what catches a
# branch pushed from another machine, and skipping it to save the round trips
# would only move that failure to `wt new` at 2am, where it silently adopts the
# existing branch instead.
#
# A collision - with git, with a live task, or with a sibling already named
# in this pass - gets one retry with an avoid list; a second is a hard error
# naming both parts, with nothing queued. A part that yields no name at all
# is also a hard error, the same as it is for a plain add.
split_name_parts() {                    # sd leveled_tsv multi
  local sd=$1 leveled=$2 multi=$3
  local named_file="$sd/.named.tsv"
  : > "$named_file"
  local level part repopath label deps named branch intent security slug reason avoid try
  while IFS=$'\t' read -r level part repopath label deps; do
    [ -n "$part" ] || continue
    avoid=""
    for try in 1 2; do
      if [ "$multi" = 1 ]; then
        named=$(name_plan "$sd/$part" "$avoid" "$label")
      else
        named=$(name_plan "$sd/$part" "$avoid")
      fi
      [ -n "$named" ] || die "$part: could not derive a branch name and intent - naming failed"
      # `cut`, not `read`: a tab is IFS whitespace, so an empty intent would
      # let the verdict slide into its place - see cmd_add.
      named=$(head -1 <<<"$named")
      branch=$(cut -f1 <<<"$named"); intent=$(cut -f2 <<<"$named"); security=$(cut -f3 <<<"$named")
      [ -n "$branch" ] || die "$part: could not derive a branch name - naming failed"
      git check-ref-format "refs/heads/$branch" || die "$part: invalid branch name '$branch'"
      slug=$(branch_to_slug "$branch")
      [ -n "$slug" ] || die "$part: branch '$branch' does not reduce to a usable name"

      reason=$(split_name_collision "$branch" "$slug" "$named_file" "$repopath")
      if [ -z "$reason" ]; then
        printf '%s\t%s\t%s\t%s\t%s\n' "$part" "$branch" "$slug" "$intent" "$security" >> "$named_file"
        break
      fi
      if [ "$try" = 2 ]; then
        die "$part: branch '$branch' collides - $reason - retried once, still colliding; nothing queued"
      fi
      warn "$part: branch '$branch' collides - $reason - retrying with an avoid-list"
      avoid="${avoid:+$avoid,}$branch"
    done
  done <<<"$leveled"
}

# Shown before anything is queued, then "[y/N]". Built as a TSV
# and passed to the existing `render_table`, so columns pad to their widest
# cell like `pq ls` and `wt ls` - every cell but REPO is ASCII by construction
# (the filename charset check and `check-ref-format`), which `render_table`
# requires, since macOS `awk`'s `length()` counts bytes - REPO alone goes
# through `cell()`.
#
# All of it goes to stderr: `pq add --split`'s stdout is the slugs it
# queued, the same as an ordinary `pq add`'s stdout is just the slug.
split_confirm() {                       # sd leveled_tsv named_file cost_str multi -> 0 confirmed, 1 declined
  local sd=$1 leveled=$2 named_file=$3 cost_str=${4:-} multi=${5:-0}
  local tbl="$PQ_HOME/.splitconfirm.$$"
  # A REPO column, but only once the parts actually span more than one -
  # same rule and idiom cmd_ls and pick_after use for their own PROJECT
  # column. It is the only cell here that needs `cell()`: part filenames and
  # branches are ASCII by construction, a repo LABEL might not be.
  if [ "$multi" = 1 ]; then
    printf 'PART\tWAVE\tREPO\tBRANCH\tAFTER\n' > "$tbl"
  else
    printf 'PART\tWAVE\tBRANCH\tAFTER\n' > "$tbl"
  fi
  local level part repopath label deps branch after_disp nparts nwaves ans
  while IFS=$'\t' read -r level part repopath label deps; do
    [ -n "$part" ] || continue
    branch=$(awk -F'\t' -v p="$part" '$1 == p { print $2; exit }' "$named_file")
    after_disp="-"
    [ -n "$deps" ] && after_disp=${deps//,/, }
    if [ "$multi" = 1 ]; then
      printf '%s\t%s\t%s\t%s\t%s\n' "$part" "$level" "$(cell "$label" 20)" "$branch" "$after_disp" >> "$tbl"
    else
      printf '%s\t%s\t%s\t%s\n' "$part" "$level" "$branch" "$after_disp" >> "$tbl"
    fi
  done <<<"$leveled"

  nparts=$(( $(wc -l < "$tbl" | tr -d ' ') - 1 ))
  nwaves=$(awk -F'\t' 'NR > 1 && $2 + 0 > max { max = $2 + 0 } END { print max + 0 }' "$tbl")

  msg "split $(basename "$sd") into $nparts parts, $nwaves waves$cost_str"
  printf '\n' >&2
  render_table "$tbl" >&2
  printf '\n' >&2
  rm -f "$tbl"

  [ "$nwaves" -gt 1 ] && msg "wave 2 runs in parallel once wave 1 has merged"

  printf 'pq: queue all %s? [y/N] ' "$nparts" >&2
  read -r ans || ans=n
  [[ "${ans:-}" =~ ^[Yy]$ ]]
}

# Pass 2: queue every part through the ordinary `cmd_add`, in topological
# order, each through a command substitution - which isolates `die` to that
# subshell, so one bad part stops the split without unwinding what already
# queued. Sequential by construction, which is what makes `cmd_add`'s shared
# `$PQ_HOME/.add.$$` staging path safe to reuse across the recursive calls:
# `$$` names the top-level process even inside a subshell, and never changes.
#
# `--after` on the split itself applies to ROOT parts only - the ones with no
# dependency inside the split. That is transitively correct: `cmd_after`'s
# existing "waiting on X of its own" branch already surfaces the rest of the
# chain to anyone asking why a downstream part hasn't started.
split_queue() {                         # sd leveled_tsv named_file
  local sd=$1 leveled=$2 named_file=$3
  local slugmap="$PQ_HOME/.splitslugs.$$"; : > "$slugmap"
  local urgentflag=""; [ "$urgent" = 1 ] && urgentflag=--urgent
  # A stack is the case `--base` exists for, so a `--base` that reached `--split`
  # and then applied to none of the parts it queued would be the one shape
  # guaranteed to be wrong. Read through dynamic scope from cmd_add, same as the
  # three flags above - but applied PER PART, below, not to all of them: a branch
  # name is only meaningful inside one repository, so a multi-repo split must not
  # inherit the primary's integration branch into a sibling that has no such
  # branch (it would fail that part's own base validation, mid-split, after
  # earlier parts had already queued).
  local n_based=0 baseflag=""
  local n=0 total level part repopath label deps row branch intent security afterflags dep depslug task out rc av

  # $leveled already has exactly one line per part - no need to touch
  # graph.tsv again for a count already sitting in an argument this function
  # was handed.
  total=$(wc -l <<<"$leveled" | tr -d ' ')

  # A design file follows every part that names it (splitter_prompt asked for
  # exactly that). One that NO part names goes to every part, with a warning,
  # rather than to none: the splitter was told to cite, so silence is far more
  # likely a miss than a plan whose visual work vanished in the split. Read from
  # cmd_add's `design_files` through dynamic scope, like `after_vals` above.
  local uncited="" df dbase
  while IFS= read -r df; do
    [ -n "$df" ] || continue
    dbase=$(basename "$df")
    if ! grep -qF -- "$dbase" "$sd"/[0-9][0-9]-*.md 2>/dev/null; then
      uncited="$uncited$df"$'\n'
      warn "no part names the design file $dbase - attaching it to every part"
    fi
  done <<<"${design_files:-}"

  while IFS=$'\t' read -r level part repopath label deps; do
    [ -n "$part" ] || continue
    n=$((n + 1))
    row=$(awk -F'\t' -v p="$part" '$1 == p { print; exit }' "$named_file")
    # `cut` for the same reason as split_name_parts, and forgiving of a row with
    # no fifth field, which reads as no security review.
    branch=$(cut -f2 <<<"$row"); intent=$(cut -f4 <<<"$row"); security=$(cut -f5 <<<"$row")

    # An array, unlike the flag strings below: a design path can contain
    # spaces, and unquoted word-splitting would cut it in two. Expanded with
    # the `${a[@]+"${a[@]}"}` idiom so an empty set is safe under bash 3.2's
    # `set -u`.
    local design_args=()
    while IFS= read -r df; do
      [ -n "$df" ] || continue
      dbase=$(basename "$df")
      if grep -qF -- "$dbase" "$sd/$part" 2>/dev/null; then
        design_args+=(--design "$df")
      else
        case $'\n'"$uncited" in *$'\n'"$df"$'\n'*) design_args+=(--design "$df") ;; esac
      fi
    done <<<"${design_files:-}"

    # Each part's own dependencies resolve to slugs recorded in EARLIER
    # iterations of this same loop - guaranteed to exist because the leveled
    # order is a valid topological order. A root part (no deps) instead gets
    # the split-level --after values, resolved by the recursive cmd_add call
    # exactly like any other --after.
    afterflags=""
    if [ -n "$deps" ]; then
      while IFS= read -r dep; do
        [ -n "$dep" ] || continue
        depslug=$(awk -F'\t' -v p="$dep" '$1 == p { print $2; exit }' "$slugmap")
        [ -n "$depslug" ] || die "internal error: $part depends on $dep, which was not queued before it ($sd)"
        afterflags="$afterflags--after
$depslug
"
      done <<<"$(tr ',' '\n' <<<"$deps")"
    else
      while IFS= read -r av; do
        [ -n "$av" ] || continue
        afterflags="$afterflags--after
$av
"
      done <<<"$after_vals"
    fi

    # Parts ascend: each recursive `cmd_add` allocates through `next_stamp`,
    # which is strictly greater than everything already queued, so the
    # topological walk order (level-then-part, pq:1364) is preserved by the
    # allocator's contract rather than by arithmetic in this function.
    #
    # This is load-bearing in a way worth spelling out. `next_stamp` is
    # stateless between calls, and this function invokes `cmd_add` inside
    # `$( )`, so every part allocates in its own subshell with nothing carried
    # over in a variable. Monotonicity survives only because the previous
    # part's directory has already been `mv`'d into place by the time the
    # next part scans `all_tasks`. The sequential-by-construction property
    # documented above ("Pass 2", pq:1552) is therefore now load-bearing for
    # ordering as well as for the shared `$PQ_HOME/.add.$$` staging path.

    baseflag=""
    if [ -n "${basebr:-}" ]; then
      if [ "$repopath" = "$repo" ]; then
        baseflag="--base
$basebr
"
        n_based=$((n_based + 1))
      else
        warn "$part is in $(basename "$repopath"), not the base's repo - queued off its own default branch"
      fi
    fi

    # shellcheck disable=SC2086  # urgentflag/afterflags are deliberately
    # unquoted - an empty one has to vanish rather than become an empty arg.
    # Each part's OWN repo, resolved by split_levels - never the shared
    # `$repo`, which is only ever the primary (or, in a no-primary container
    # split, not a repo at all).
    out=$(cmd_add "$sd/$part" "$branch" "$intent" "$security" --repo "$repopath" \
            --model "$model" --effort "$effort" \
            $urgentflag $baseflag $afterflags ${design_args[@]+"${design_args[@]}"})
    rc=$?
    if [ "$rc" != 0 ]; then
      [ "$n" -gt 1 ] && warn "already queued, untouched: $(cut -f2 "$slugmap" | tr '\n' ' ')"
      # Not a bare blind retry: re-running --split-dir re-names every part
      # from scratch, and a part already queued above could get renamed to a
      # DIFFERENT branch on that pass (branch_taken forces a retry once its
      # own name collides with the live task it just created) - so check
      # `pq ls` before trusting it did not duplicate what already queued.
      die "$part failed to queue ($n of $total) - finish the rest with: $(split_resume_hint "$sd")  (check pq ls first - re-naming could duplicate what's already queued)"
    fi

    # cmd_add's stdout is the slug and nothing else; anything more is a
    # message that went to the wrong stream, and a slug read out of it would be
    # wrong - `after` for every later part is wired from this map.
    task=$out
    { [ -n "$task" ] && [ "$(wc -l <<<"$task" | tr -d ' ')" = 1 ]; } \
      || die "internal error: $part queued but did not return exactly one task slug ($sd): $out"
    printf '%s\t%s\n' "$part" "$task" >> "$slugmap"
    printf '%s\n' "$task"
  done <<<"$leveled"

  # A --base that reached here and matched nothing is worth saying out loud
  # rather than leaving to be discovered at 3am by a fork from the wrong trunk.
  [ -n "${basebr:-}" ] && [ "$n_based" = 0 ] && \
    warn "--base $basebr applied to no part - none of them are in $repo"

  rm -f "$slugmap"
}

do_split() {
  local sd stamp stem cost_str="" candidates

  # How many --repo values THIS invocation gave, regardless of branch -
  # repeatable --repo is the escape hatch, not the normal path (Decisions),
  # so this is the one signal that the user - not merely the scan - is
  # declaring more than one repo is in play.
  local repo_n=0 rv
  while IFS= read -r rv; do [ -n "$rv" ] && repo_n=$((repo_n + 1)); done <<<"$repo_vals"

  if [ -n "$split_dir" ]; then
    sd=$split_dir
    [ -f "$sd/source.md" ] || die "$sd has no source.md - not a split directory"

    if [ -s "$sd/repos" ]; then
      candidates=$(cat "$sd/repos")
    else
      # Pre-multi-repo split directory: a single recorded repo is a
      # single-candidate inventory, so every split written before this
      # change still resumes.
      local legacy; legacy=$(cat "$sd/repo" 2>/dev/null)
      [ -n "$legacy" ] && candidates=$(printf '%s\t%s' "$(basename "$legacy")" "$legacy")
    fi
    [ -n "$candidates" ] || die "$sd has no repo or repos file - not a split directory"

    # `cut`, not `read`: a no-primary sentinel row starts with a literal tab
    # (empty label), and `read` strips a LEADING tab as "IFS whitespace"
    # before splitting even when IFS holds nothing else - it would shift the
    # container path into recorded_label and leave recorded_path empty,
    # misreading a container split as an ordinary one with a real primary.
    local row1 recorded_label recorded_path
    row1=$(head -1 <<<"$candidates")
    recorded_label=$(cut -f1 <<<"$row1"); recorded_path=$(cut -f2 <<<"$row1")
    if [ -n "$recorded_label" ]; then
      # `--repo` passed explicitly is how you say "yes, I mean it" - parts name
      # real files in a specific checkout, so re-running a stale split against
      # the wrong repo would queue parts describing files that do not exist,
      # and nothing downstream would catch it. Auto-resolved from cwd, a
      # mismatch is far more likely an accident: you are standing in the wrong
      # place, not choosing to override. Only the PRIMARY is ever compared
      # against cwd - the rest of a recorded multi-repo set is untouched.
      if [ -n "$recorded_path" ] && [ "$recorded_path" != "$repo" ] && [ "$repo_explicit" != 1 ]; then
        die "$sd was split against $recorded_path, not $repo - cd there, or pass --repo to confirm you mean it"
      fi

      # $sd/repos is authoritative on resume - it is not re-scanned or
      # re-collected from --repo, so a SECOND (or later) --repo here has no
      # effect beyond the first, which only ever overrides the primary.
      [ "$repo_n" -gt 1 ] && \
        warn "resuming ignores every --repo past the first - $sd/repos already fixes the rest of the set"

      local newlabel oldtail; newlabel=$(basename "$repo")
      oldtail=$(tail -n +2 <<<"$candidates")
      case $'\n'"$oldtail" in
        *$'\n'"$newlabel"$'\t'*)
          die "the overriding --repo's label ('$newlabel') collides with an already-recorded repo in $sd/repos - rename one, or edit the file directly" ;;
      esac
      candidates=$(printf '%s\t%s\n' "$newlabel" "$repo"; printf '%s' "$oldtail")
      printf '%s\n' "$candidates" > "$sd/repos"
    else
      # No-primary/container split (row 1 is the empty-label sentinel
      # do_split writes for one): there is no primary slot to compare cwd
      # against or override - $sd/repos is already the complete, fixed set
      # every part's label was validated against, so --repo has no effect
      # here beyond a warning.
      [ "$repo_n" -ge 1 ] && \
        warn "resuming a no-primary split - --repo has no effect here, $sd/repos already fixes the set; edit it directly to change which repositories are in play"
    fi
    msg "resuming split from $sd"
  else
    stem=$(basename "$plan"); stem=${stem%.md}
    stem=$(branch_to_slug "$stem")
    stamp=$(date -u '+%Y%m%d-%H%M%S')
    # $$ as well as the timestamp: the stamp alone is only second-granularity,
    # and two `--split`s of the same plan stem within one second would
    # otherwise collide on the same directory - `mkdir -p` would not even
    # fail, it would just let a second Opus session write into the first
    # one's files mid-flight. $$ is unique per process, so this rules that
    # out the same way the staging path elsewhere in this file does.
    sd="$PQ_HOME/splits/${stem}-${stamp}-$$"
    mkdir -p "$sd" || die "could not create $sd"
    # COPY, never move - same reason cmd_add copies rather than moves out of
    # $PLANS_DIR: it is Claude Code's directory and it prunes it.
    cp "$plan" "$sd/source.md" || die "could not copy the plan into $sd"

    # Repeatable --repo is the escape hatch, not the normal path: a single
    # --repo is how you fix a wrong cwd, and it must not silently turn
    # multi-repo splitting off - the scan still contributes unless TWO OR
    # MORE were given, in which case the set is exactly those.
    if [ "$repo_n" -ge 2 ]; then
      candidates=""
      while IFS= read -r rv; do
        [ -n "$rv" ] || continue
        case $'\n'"$candidates" in *$'\n'"$(basename "$rv")"$'\t'*)
          die "--repo '$rv' and another --repo share the label '$(basename "$rv")' - the splitter cannot tell them apart" ;;
        esac
        candidates="${candidates}$(basename "$rv")"$'\t'"$rv"$'\n'
      done <<<"$repo_vals"
    elif git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      candidates=$(repo_candidates "$repo")
    else
      # $repo is not itself a git repo - a container directory holding
      # several checkouts as peers (cmd_add sets it to $PWD for exactly this
      # case when cwd isn't a repo, or an explicit --repo named the
      # container directly). Scan ITS OWN children rather than a parent's,
      # and record NO primary: row 1 of $sd/repos becomes a sentinel - an
      # empty label alongside the container path - so every consumer
      # downstream (splitter_prompt, split_validate, the resume branch
      # above) can tell a container split apart from an ordinary one with
      # one cheap check: is row 1's label empty?
      [ -d "$repo" ] || die "no such directory: $repo"
      local containerset containerpath
      containerset=$(repo_candidates_container "$repo")
      [ -n "$containerset" ] || \
        die "$repo is not a git repository and has no git repositories under it - pass --repo to name one explicitly"
      # Resolved the same way every child is (git-worktree resolution is a
      # no-op outside a repo, so `cd && pwd -P` is the equivalent for a plain
      # directory) - nothing compares this path against anything today, but
      # $sd/repos is hand-editable, and an unresolved row 1 next to resolved
      # children is exactly the macOS /var-vs-/private/var mismatch waiting
      # for whoever adds that comparison next.
      containerpath=$(cd "$repo" && pwd -P)
      candidates=$(printf '\t%s\n' "$containerpath"; printf '%s' "$containerset")
    fi
    printf '%s\n' "$candidates" > "$sd/repos"
  fi

  # A raw branch is ambiguous once there is no privileged default it could
  # resolve against - it resolves against the OWNER's repo (resolve_after),
  # and for a root part that owner is now the part's own repo, not
  # necessarily a primary.
  #
  # Two DIFFERENT ways to reach that: an EXPLICIT --repo count of 2+
  # (Decisions' escape hatch), or a no-primary container split, where every
  # repo is a peer and a root part could land in ANY of them. Neither is
  # gated on how many candidates the scan happened to turn up: repo_candidates
  # scans the primary's own parent directory by default, which commonly holds
  # several unrelated checkouts, and an unrelated candidate is supposed to
  # cost nothing (Decisions) - it must not turn an ordinary single-repo
  # `--split --after some/branch` into a hard refusal just because a sibling
  # happens to sit next to the primary. `no_primary` is read off the
  # FINALIZED $candidates (row 1's label), after both the resume and fresh
  # branches above have converged on one - the one point where either path's
  # sentinel row is already settled. The narrower, real danger - the
  # splitter actually assigning a root part elsewhere without the user
  # having asked for that - is the confirmation table's job to catch, same
  # as any other repo assignment a human, not validation, has to judge.
  # `cut`, not `read`: same leading-tab trap as everywhere else a sentinel
  # row's label needs checking - `read` would strip it and read the
  # container's PATH as a non-empty "label", hiding a no-primary split from
  # this exact check.
  local no_primary=0 primlbl
  primlbl=$(cut -f1 <<<"$(head -1 <<<"$candidates")")
  [ -n "$primlbl" ] || no_primary=1

  if [ "$repo_n" -ge 2 ] || [ "$no_primary" = 1 ]; then
    local av
    while IFS= read -r av; do
      [ -n "$av" ] || continue
      case "$av" in
        */*) die "--after '$av' is a raw branch - ambiguous across a multi-repo split, since it resolves against a repo this split hasn't assigned yet. Name a task slug instead (it carries its own repo), or queue without it and add the blocker afterwards with: pq after <part> $av" ;;
      esac
    done <<<"$after_vals"
  fi

  if [ -z "$split_dir" ]; then
    local rc is_error cost dur denials
    local statusdir="$PQ_HOME/.splitstatus.$$" lbl lpath
    # A real array, not the newline-joined-string idiom used for repeatable
    # CLI options elsewhere in this file: those values are all guaranteed
    # space-free by construction (branch names, digits, literal flags), but a
    # checkout's path is not, and unquoted word-splitting would cut a path
    # like "My Drive/supercast" in two. `candidates` always has at least one
    # real (non-sentinel) row - the primary, or a container split's first
    # discovered child - so this array is never empty - the bash-3.2
    # "unbound variable on an empty array" trap under `set -u` cannot bite
    # here.
    local add_dir_args=()
    mkdir -p "$statusdir"
    # Snapshotted before and after, for every candidate: `--tools` cannot
    # scope `Write` to one directory, and `--add-dir` grants the repo to
    # every allowed tool, so the prompt's instruction not to write there is
    # not a guarantee - this is the only net there is.
    while IFS=$'\t' read -r lbl lpath; do
      [ -n "$lbl" ] || continue
      git -C "$lpath" status --porcelain 2>/dev/null > "$statusdir/$lbl.before"
      add_dir_args+=(--add-dir "$lpath")
    done <<<"$candidates"

    msg "splitting $(basename "$plan") with $PQ_SPLITTER_MODEL - this takes a few minutes"
    ( cd "$sd" && headless_claude -p --model "$PQ_SPLITTER_MODEL" --effort "$PQ_SPLITTER_EFFORT" \
        "${add_dir_args[@]}" --tools "Read,Grep,Glob,Write" \
        --permission-mode acceptEdits --output-format json "$(splitter_prompt "$candidates")" ) \
      < /dev/null > "$sd/splitter.json" 2> "$sd/splitter.err"
    rc=$?

    while IFS=$'\t' read -r lbl lpath; do
      [ -n "$lbl" ] || continue
      git -C "$lpath" status --porcelain 2>/dev/null > "$statusdir/$lbl.after"
      cmp -s "$statusdir/$lbl.before" "$statusdir/$lbl.after" \
        || warn "the splitter left $lpath dirty - it was only meant to read from it: $(tr '\n' ' ' < "$statusdir/$lbl.after")"
    done <<<"$candidates"
    rm -rf "$statusdir"

    is_error=$(jq -r '.is_error // empty'        "$sd/splitter.json" 2>/dev/null)
    cost=$(jq -r      '.total_cost_usd // empty' "$sd/splitter.json" 2>/dev/null)
    dur=$(jq -r       '.duration_ms // empty'    "$sd/splitter.json" 2>/dev/null)
    denials=$(jq -r   '.permission_denials // empty' "$sd/splitter.json" 2>/dev/null)
    [ -z "$denials" ] || [ "$denials" = "[]" ] || warn "the splitter reached for something denied: $denials"
    if [ "$rc" != 0 ] || [ "$is_error" = "true" ]; then
      die "the splitter session failed - see $sd/splitter.err and $sd/splitter.json"
    fi
    cost_str=$(fmt_cost "$cost" "$dur")
  fi

  split_validate "$sd"
  local leveled
  if ! leveled=$(split_levels "$sd"); then
    die "graph.tsv has a dependency cycle involving:${leveled#CYCLE} ($sd)"
  fi

  # Computed once, here, and threaded through both consumers below - the
  # repo hint only matters once a part could otherwise collide with the same
  # task words used for a sibling in another repo, so a single-repo split's
  # naming call stays byte-identical to today's, and the confirm table's
  # REPO column appears on the same condition.
  local multi; multi=$(cut -f3 <<<"$leveled" | sort -u | awk 'END { print (NR > 1) }')

  split_name_parts "$sd" "$leveled" "$multi"
  local named_file="$sd/.named.tsv"

  if ! split_confirm "$sd" "$leveled" "$named_file" "$cost_str" "$multi"; then
    msg "declined - nothing queued. Edit parts under $sd, then resume with: $(split_resume_hint "$sd")"
    return 0
  fi

  split_queue "$sd" "$leveled" "$named_file"
}

# ── pane state ──────────────────────────────────────────────────────────────
# "Is the agent still there" is three questions, not one, and answering it with
# `herdr agent list` collapses them: that call reports only panes it FOUND an agent
# in, so a missing pane could equally mean the workspace is gone, or that Claude
# exited cleanly and left a shell behind, or that the session is seconds old and its
# SessionStart hook has not reported yet. Deciding "this task is dead" on that is
# how a live task gets written off.
#
# `herdr api snapshot` lists every pane, with `agent` null on the ones holding no
# agent, so a single call separates all three:
#
#   pane absent from the snapshot   -> missing   the workspace itself is gone
#   pane present, agent null        -> noagent   Claude exited; a shell is sitting there
#   pane present, agent named       -> working | idle | blocked | unknown
#
PIDX=""; PIDX_OK=0
pidx_load() {
  local raw
  PIDX=""; PIDX_OK=0
  command -v herdr >/dev/null 2>&1 || return 0
  raw=$(herdr api snapshot 2>/dev/null) || return 0
  jq -e '.result.snapshot.panes' >/dev/null 2>&1 <<<"$raw" || return 0
  PIDX=$(jq -r '.result.snapshot.panes[]? | [.pane_id // "", (.agent // ""), (.agent_status // "")] | @tsv' \
    2>/dev/null <<<"$raw")
  PIDX_OK=1
}
# missing | noagent | working | idle | blocked | unknown. Empty when herdr never
# answered at all, so a stopped server reads as "no idea" rather than "all dead".
pane_state() {                          # pane_id
  [ "${PIDX_OK:-0}" = 1 ] || return 0
  [ -n "${1:-}" ] || { printf 'missing'; return; }
  awk -F'\t' -v p="$1" '
    $1 == p { print ($2 == "" ? "noagent" : ($3 == "" ? "unknown" : $3)); found = 1; exit }
    END { if (!found) print "missing" }' <<<"$PIDX"
}

# ── slots ───────────────────────────────────────────────────────────────────
# What the cap counts. The cap is a promise about how many AGENTS run at once,
# and for a long time it counted directories in `running/` instead - which is
# the same number only while "has a pull request" means "has stopped working".
# It does not. A Claude Code agent that opens a PR keeps going: it answers
# review, fixes CI, pushes again, and it never exits on its own. So reconcile
# would move a task to `done/` the moment its PR appeared, free the slot, and
# start a fourth agent while the third was still typing. Three tasks wrapping
# up in `done/` alongside three fresh ones in `running/` is six live agents at
# a cap of 3 - measured, not hypothetical.
#
# Reconcile is right and stays as it is: a PR in any state does mean the work
# left the queue, and a draft PR is what the stalled-chain verdict is built on
# (`blocker_state`). What was wrong is only the arithmetic, so only the
# arithmetic changes - `done/` tasks keep counting while their agent is still
# there.
#
# The release has to be a TIMER, not an exit. An agent that has genuinely
# finished sits `idle` forever rather than exiting, so counting `idle` with no
# deadline would not overshoot the cap - it would stall the queue permanently,
# which is worse. PQ_WRAPUP_GRACE is that deadline: once the agent has not been
# working for that long, the slot goes. `idle` is the state a finished agent
# actually rests in, so putting a deadline on that one is what rules out the
# stall.
#
# herdr's agent_status is one of exactly five words - idle, working, blocked,
# done, unknown - on top of the two pq derives from the snapshot itself:
#
#   working           holds it, and clears the clock - this is real work
#   blocked           holds it, and clears the clock. Same trade `running/`
#                     already makes: a permission prompt or a quota wall is an
#                     agent that will resume, not one that has finished. It is
#                     the one state besides `working` with no deadline, and
#                     `pq ls` reports a blocked done row as `blocked` rather
#                     than `wrapping up`, counting it into "needs you"
#   idle | done       holds it until the clock passes the grace, then releases.
#                     Both are per-TURN, not per-task: `done` means the agent
#                     finished the turn it was on, and one that opened a PR and
#                     then went back in to fix CI passes through it every time.
#                     Releasing on either the moment it appeared would be the
#                     original bug in a subtler form - a slot handed away in the
#                     pause between two turns of the same task.
#   unknown | other   same treatment, which is also the safe default for a word
#                     herdr adds later: bounded, so nothing can hold a slot for
#                     ever on a status pq has never heard of
#   noagent | missing releases at once - Claude exited, or the workspace is gone
#   "" (herdr silent) holds it, clock untouched. There is no way to tell a live
#                     agent from a finished one, and guessing "finished" is
#                     exactly the over-dispatch this exists to stop. Dispatch
#                     needs herdr too, so nothing is lost by waiting.
#
# On top of herdr's word, pq's own PQ_BLOCKED=quota holds the slot with no
# deadline, exactly as `blocked` does, and for a reason herdr cannot see: the
# first thing check_stall does about a wall is DISMISS it, which stops the
# spinner, so from that moment a walled agent reads `idle` and the grace would
# hand its slot away while it waits for its window. It is then handed back on the
# very tick the block clears - the tick its agent starts working again - which is
# the "six agents at a cap of 3" bug arriving one tick late.
#
# One asymmetry that is deliberate, since two functions otherwise look like they
# disagree: reap_task decides "the agent is still going" from herdr's
# `working`/`blocked` alone, so it will tear down a walled task that this one is
# still holding a slot for. Reap wins, and should - it only fires once the pull
# request has settled, and one that merged or was closed leaves the agent nothing
# to come back to either way. The slot goes with the teardown.
#
# `running/` is deliberately NOT put through this: it counts unconditionally.
# That preserves the documented trade that a blocked task still holds its slot,
# and it avoids a leak this would otherwise open - a `running/` task whose agent
# went idle without ever opening a PR would stop counting while still sitting in
# `running/`, holding a worktree, with nothing to move it on.

# Does this done/ task still hold a slot? 0 yes, 1 no. Writes PQ_WRAPUP_SINCE,
# so it must not be called from a listing - see slot_state for the read-only
# view `pq ls` uses.
slot_held() {                           # task_dir -> 0 holds, 1 released
  local d=$1 pane status since nowe
  # Terminal - there is no agent left to hold anything. PQ_REAPED means the
  # workspace itself has been closed, so the pane id on file now points at
  # nothing (or, if herdr ever recycles ids, at somebody else's agent).
  #
  # PQ_REAPED alone, and deliberately not PQ_CLOSED: a closed pull request now
  # earns a teardown, and that teardown waits for the agent to stop. Releasing
  # the slot on the verdict instead would hand it to the next task while this
  # one's agent is still running - the over-dispatch this whole section exists to
  # stop. PQ_CLOSED belonged here only while it meant "pq will never touch this".
  [ -n "$(st "$d" PQ_REAPED)" ] && return 1
  pane=$(st "$d" PQ_PANE)
  [ -n "$pane" ] || return 1
  status=$(pane_state "$pane")
  case "$status" in
    noagent|missing) return 1 ;;
  esac
  # A dismissed wall reads `idle`, so pq's own verdict has to be consulted before
  # the grace is applied to one - see the note above.
  [ "$(st "$d" PQ_BLOCKED)" = quota ] && status=blocked
  # So does a review in flight against this task's pull request, for the same
  # shape of reason: the implementer is idle because it is WAITING - for the
  # reviewer, then for the follow-up - and releasing the slot would start a fresh
  # agent beside one about to be told to fix things. Deadline-free here, bounded
  # by the gate's own bounds (see the `review gate` section); `prompted` is not
  # in the set, so once the agent owns its PR again the ordinary grace applies.
  review_inflight "$d" && status=blocked
  case "$status" in
    working|blocked)
      [ -z "$(st "$d" PQ_WRAPUP_SINCE)" ] || st_set "$d" PQ_WRAPUP_SINCE ""
      return 0 ;;
    "")              return 0 ;;
  esac
  # idle | done | unknown, and anything herdr adds later - start the clock on the
  # transition, then compare against it.
  since=$(st "$d" PQ_WRAPUP_SINCE)
  if [ -z "$since" ]; then
    st_set "$d" PQ_WRAPUP_SINCE "$(now)"
    return 0
  fi
  since=$(epoch_of "$since")
  # An unparseable stamp is corruption, not a verdict: rewrite it and hold the
  # slot for one more grace period rather than releasing on a bad read.
  [ -n "$since" ] || { st_set "$d" PQ_WRAPUP_SINCE "$(now)"; return 0; }
  nowe=$(epoch)
  [ $(( nowe - since )) -ge "$PQ_WRAPUP_GRACE" ] && return 1
  return 0
}

# The slot count the cap is compared against, as `running<TAB>wrapping-up`:
# every running/ task, plus every done/ task whose agent has not finished. The
# two halves come back separately because the summary has to name them
# separately - "3 running (cap 3)" while six agents are live is the report that
# hid this bug for as long as it lasted.
#
# One pass, one set of PQ_WRAPUP_SINCE writes: slot_held is idempotent, but the
# clock it starts should be read by everything in a tick, not restarted partway
# through it. Reads state that reconcile and reap have already stamped, so it
# must run after them.
#
# Under `dry` it counts through slot_state instead, so `--dry-run` starts nobody's
# clock - the same promise reap_task keeps by gating each of its write sites
# individually. The two agree on every branch (an unstamped idle agent holds its
# slot either way; it is only the stamping that differs), so the number a
# dry-run reports is the number a real tick would have acted on.
active_slots() {                        # [dry] -> run<TAB>wrap
  local dry=${1:-0} d run=0 wrap=0
  for d in "$PQ_HOME/running"/*/; do
    [ -d "$d" ] || continue
    # Not a task without its plan - see the reconcile loop's phantom check.
    [ -f "${d%/}/plan.md" ] || continue
    run=$((run + 1))
  done
  for d in "$PQ_HOME/done"/*/; do
    [ -d "$d" ] || continue
    d=${d%/}
    if [ "$dry" = 1 ]; then
      [ -n "$(slot_state "$d")" ] && wrap=$((wrap + 1))
    else
      slot_held "$d" && wrap=$((wrap + 1))
    fi
  done
  printf '%s\t%s' "$run" "$wrap"
}

# The read-only half of slot_held, for `pq ls` and `pq cap`: the same verdict
# with no state written and no clock started. Prints `wrapping up` when the task
# is holding a slot it will eventually give back, and nothing when it is not
# holding one at all - so a caller can tell the two apart by emptiness alone.
#
# It deliberately does NOT start the clock. A listing that stamped
# PQ_WRAPUP_SINCE would reset the grace period every time you ran `pq ls`, and
# an agent could then hold its slot for as long as you kept looking at it.
slot_state() {                          # task_dir -> "wrapping up" | ""
  local d=$1 pane status since
  [ -n "$(st "$d" PQ_REAPED)" ] && return 0
  pane=$(st "$d" PQ_PANE)
  [ -n "$pane" ] || return 0
  status=$(pane_state "$pane")
  case "$status" in
    noagent|missing) return 0 ;;
  esac
  # Same overrides as slot_held, for the same reasons: a dismissed wall reads
  # `idle`, and so does an agent waiting on the review gate.
  [ "$(st "$d" PQ_BLOCKED)" = quota ] && status=blocked
  review_inflight "$d" && status=blocked
  case "$status" in
    working|blocked|"") printf 'wrapping up'; return 0 ;;
  esac
  since=$(st "$d" PQ_WRAPUP_SINCE)
  # Not yet stamped: the next tick is what starts the clock, and until then the
  # slot is still held.
  [ -n "$since" ] || { printf 'wrapping up'; return 0; }
  since=$(epoch_of "$since")
  [ -n "$since" ] || { printf 'wrapping up'; return 0; }
  [ $(( $(epoch) - since )) -ge "$PQ_WRAPUP_GRACE" ] || printf 'wrapping up'
  return 0
}

# ── the session wall ────────────────────────────────────────────────────────
# Claude Code turns a 429 into a dialog - "Wait for limit to reset · Resets 3pm" -
# and every option on it only dismisses the dialog. Nothing resumes by itself. So
# an agent that hits the wall at 2am sits there until morning unless something
# knocks on it, and that knock is the only reason this section exists.
#
# Three deliberate choices, each of which the obvious alternative gets wrong.
#
# **Detection is the pane's TEXT, never herdr's status.** Herdr derives status from
# its own regexes over terminal regions, and its top rule (priority 1100,
# `osc_title_working`: a braille spinner in the window title) outranks every
# blocked rule it has. A spinner is exactly what is on screen while the request
# that hit the wall is still in flight. Gating on `blocked` would risk never firing.
#
# **Liveness is the tail's HASH, not a status either.** We act only when the wall's
# text is on screen AND the tail has not changed since the last tick. That matters
# in both directions: a working agent's tail moves every few seconds so this cannot
# interrupt one, and the wall's message stays in the scrollback for a while after
# the session recovers, so the text alone would keep firing long after it should.
#
# **We wait for the time the dialog names, and poll only if we cannot read it.**
# The dialog carries "Resets 8:30pm", and that hint beats any other source of the
# same fact: it comes from the error that walled us, so it already refers to the
# right window. The account has two (five-hour and weekly) and nothing else on hand
# would say which one we are behind.
#
# Its format is fixed by Claude Code's own formatter and worth writing down, because
# two of its habits will bite anyone who assumes otherwise: minutes are omitted when
# they are zero ("8pm", not "8:00pm"), and no date is printed for anything less than
# 24 hours out - so a bare "1am" seen at 11pm means tomorrow. Beyond 24 hours it
# becomes "Jul 28, 8:30pm", and gains a year only when the year differs.
#
# A hint we cannot read is not a failure: PQ_QUOTA_RETRY polling is the fallback,
# and it also takes over after a knock at the named time turns out to be too early.
# Waiting on an unparsed guess is the only outcome worth ruling out, since that
# strands a task silently, where a knock sent early costs one instantly-failing call.
# `pane read`, not `agent read`, and `--format text` is already text - it is not a
# JSON envelope with the terminal inside it. Piping it through jq is how this
# returned the empty string on every tick of every task for as long as the section
# existed, which check_stall reads as "could not see the pane" and returns on. The
# wall was never once detected.
#
# `pane read` is also the only one of the two that answers for a pane whose agent
# binding has lapsed - `agent read` returns an `agent_not_found` error object - and
# answering for exactly that pane is the point of the `noagent` case reconcile goes
# out of its way to include. An error object is still possible (a dead socket, a
# pane id that is gone), so drop one: it is not terminal text, and letting it
# through would have `classify_tail` reading somebody's error message.
pane_tail() {                           # pane_id -> the last lines on screen
  [ -n "${1:-}" ] || return 0
  herdr pane read "$1" --source visible --format text 2>/dev/null \
    | grep -v '^{"error":' | tail -n "$PQ_TAIL_LINES"
}

# "Resets 8:30pm" / "Resets Jul 28, 8pm" -> epoch. Local time throughout, because
# that is what Claude Code printed. Silence means "could not read it" and the caller
# falls back to polling, so every branch here fails closed rather than guessing.
#
# Every format below carries an explicit `%S` against a literal `00`, because BSD
# `date -j -f` fills a field the format does not mention from the CURRENT time - so a
# hint with no seconds in it silently picked up however many seconds past the minute
# it happened to be parsed at. Harmless in the arithmetic, but it made a stored reset
# disagree with the one on screen, and `clock_of` its own inverse only by luck.
parse_reset() {                         # hint text -> epoch seconds
  local s=$1 dpart tpart e nowe
  s=${s%%(*}                                          # drop a trailing " (PDT)"
  s=$(sed 's/^[[:space:]]*//; s/[[:space:]]*$//' <<<"$s")
  [ -n "$s" ] || return 1
  # Split on the LAST comma: the with-year form is "Jan 3, 2027, 9am".
  case "$s" in
    *,*) dpart=$(tr -d ',' <<<"${s%,*}"); tpart=${s##*,} ;;
    *)   dpart=""; tpart=$s ;;
  esac
  tpart=$(tr -d ' ' <<<"$tpart" | tr '[:lower:]' '[:upper:]')
  # shellcheck disable=SC2001  # a backreference, which no parameter expansion does
  case "$tpart" in *:*) ;; *) tpart=$(sed 's/\([0-9]\{1,2\}\)\([AP]M\)/\1:00\2/' <<<"$tpart") ;; esac
  case "$tpart" in *AM|*PM) ;; *) return 1 ;; esac
  nowe=$(date '+%s')
  if [ -n "$dpart" ]; then
    dpart=$(sed 's/^[[:space:]]*//; s/[[:space:]]*$//' <<<"$dpart")
    case "$dpart" in
      *[0-9][0-9][0-9][0-9]*) e=$(date -j -f '%b %d %Y %I:%M%p %S' "$dpart $tpart 00" '+%s' 2>/dev/null) ;;
      *) e=$(date -j -f '%b %d %Y %I:%M%p %S' "$dpart $(date '+%Y') $tpart 00" '+%s' 2>/dev/null)
         # No year printed means this year - unless we are reading it across new year.
         [ -n "$e" ] && [ "$e" -lt $(( nowe - 86400 )) ] &&
           e=$(date -j -f '%b %d %Y %I:%M%p %S' "$dpart $(( $(date '+%Y') + 1 )) $tpart 00" '+%s' 2>/dev/null) ;;
    esac
  else
    e=$(date -j -f '%Y-%m-%d %I:%M%p %S' "$(date '+%Y-%m-%d') $tpart 00" '+%s' 2>/dev/null)
    # A bare clock time is the next time the clock reads it, so 1am seen at 11pm
    # is tomorrow. The small grace keeps a reset we have just passed from jumping.
    [ -n "$e" ] && [ "$e" -lt $(( nowe - 300 )) ] && e=$(( e + 86400 ))
  fi
  [ -n "$e" ] || return 1
  printf '%s' "$e"
}

# The pane WRAPS, and the wall line that turns up most nights is long enough to
# need it: what walls a task is usually a background agent, and its failure is
# reported into the transcript with the whole API error inside it, under a bullet
# that indents the lot ("Agent "..." failed: Agent terminated early due to an API
# error: You've hit your session limit - resets 4:20pm (America/Toronto)").
#
# Claude Code breaks on word boundaries, and almost every break point is harmless:
# the hint lands whole on one row or the other, and parse_reset stops at the first
# bracket, so a break inside "(America/Toronto)" costs nothing. Exactly one hurts,
# and it is the one that happens - a break straight after "resets", which leaves
# the time on a row that no longer looks like the wall and a wall row with nothing
# after "resets" at all. Herdr trims the row, so not even the trailing space
# survives to mark it as a hint that was cut off. Both greps below then come up
# empty on a pane that is showing the reset time in plain sight.
#
# Rejoining those two rows before looking at anything is the whole fix, and the
# continuation's indent goes with the join so the hint comes out clean.
unwrap_resets() {                       # pane text -> the same, wrapped hints whole
  awk '
    held != "" { cont = $0; sub(/^[[:space:]]+/, "", cont)
                 print held " " cont; held = ""; next }
    /[Rr]esets[[:space:]]*$/ { held = $0; next }
                             { print }
    END { if (held != "") print held }
  ' <<<"$1"
}

# The hint sits at the end of a line that may well be inside a bordered box, so
# anything trailing that cannot be part of a date is dropped.
#
# Which line it comes off matters, because there are usually two. The wall's own
# line carries one ("You've hit your session limit - resets 3pm (PDT)"), and a
# statusline that reports rate limits carries another ("session 70% (resets
# 10:40pm)") - so a plain `tail -1` takes the statusline's, purely because the
# statusline is drawn below the transcript. That is the wrong one twice over: it
# names the five-hour window even when what walled us was the weekly one, and its
# trailing bracket makes parse_reset fail, silently demoting a reset we could have
# read to blind polling.
#
# So prefer a hint on a line that also looks like the wall, and only fall back to
# any other. The fallback is worth keeping - a statusline hint beats no hint, and
# it is right in the common case - which is why the two shapes it comes in are
# tolerated below: a trailing bracket, and a weekday for a reset that crosses
# midnight. Dropping the weekday loses nothing, since parse_reset already reads a
# bare clock time as the next time the clock reads it.
#
# Preference, though, is not the same as one shot at it. Picking the last line of
# the better group and giving up if nothing came of it lets a single unreadable
# line hide a perfectly good one lower down - a dangling "...resets" at the very
# bottom of the visible area, with no next row to be joined to, is enough to do it.
# So the groups are a queue in priority order, newest line of each first, and the
# answer is the first hint that parse_reset will actually take.
reset_hint() {                          # pane text -> the time the wall names
  local text cand hint
  text=$(unwrap_resets "$1")
  while IFS= read -r cand; do
    # The weekday strip is anchored to a whole bare clock time on purpose: a
    # leading three-letter word is a weekday in "Sat 1:00am" and a MONTH in
    # "Jul 28, 8pm", and dropping the month would move the reset by up to a year.
    # A timezone may follow the clock time and is kept for parse_reset to trim:
    # a wall whose reset falls after midnight reads "resets Thu 12:10am
    # (America/Toronto)", and with the strip anchored to the clock time alone
    # that line never parsed - pq fell back to whatever the statusline named.
    hint=$(sed -n 's/.*[Rr]esets \(.*\)$/\1/p' <<<"$cand" \
      | sed 's/[^0-9A-Za-z:,() ]*$//
             s/)$//
             s/^[A-Za-z][a-z][a-z] \([0-9]\{1,2\}\(:[0-9][0-9]\)*[APap][Mm]\)\( (.*\)*$/\1\3/')
    [ -n "$hint" ] || continue
    parse_reset "$hint" >/dev/null 2>&1 || continue
    printf '%s' "$hint"; return 0
  done <<<"$( { grep -iE "$PQ_QUOTA_RE" <<<"$text" | grep -i 'resets ' | tail -r
                grep -i 'resets ' <<<"$text" | tail -r; } )"
}

# parse_reset's inverse, for the one place a stored reset is shown to a human. What
# is KEPT is the epoch - a hint is prose, and prose does not survive a round trip
# through state.env (see st_set) - so the display form is rebuilt on the way out
# rather than stored alongside it.
#
# Formatted the way Claude Code formats the same fact, since that is what you saw on
# the pane: minutes dropped when they are zero, and a weekday only once the reset is
# not today. ASCII throughout, as every `pq ls` cell must be.
clock_of() {                            # epoch seconds -> "8:30pm" | "Sat 1am"
  [ -n "${1:-}" ] || return 0
  local fmt='+%-I:%M%p'
  [ "$(date -r "$1" '+%M' 2>/dev/null)" = 00 ] && fmt='+%-I%p'
  [ "$(date -r "$1" '+%j' 2>/dev/null)" = "$(date '+%j')" ] || fmt="+%a ${fmt#+}"
  # Only the meridiem is lowercased, and by substitution rather than `tr`, which
  # would take the weekday with it. Same two expressions the statusline uses.
  date -r "$1" "$fmt" 2>/dev/null | sed 's/AM$/am/; s/PM$/pm/'
}

classify_tail() {                       # text -> quota | permission | none
  if   grep -qiE "$PQ_QUOTA_RE" <<<"$1"; then printf 'quota'
  elif grep -qiE "$PQ_PERM_RE"  <<<"$1"; then printf 'permission'
  else                                        printf 'none'; fi
}

# Escape rather than picking an option off the list. There are at least two
# different limit dialogs in the binary and their option sets differ - one of them
# offers "Upgrade to Team plan" - so arrowing to the Nth entry is a bet on which
# dialog turned up. Escape does not care, and since every option merely dismisses,
# it loses nothing.
unstick() {                             # pane_id [text to send after]
  herdr pane send-keys "$1" escape >/dev/null 2>&1 || return 1
  [ -n "${2:-}" ] || return 0
  sleep 1
  herdr pane send-text "$1" "$2" >/dev/null 2>&1 \
    && herdr pane send-keys "$1" enter >/dev/null 2>&1
}

clear_block() {                         # task_dir
  local d=$1 k
  for k in PQ_BLOCKED PQ_QUOTA_SINCE PQ_TRIES PQ_RETRY_AT PQ_GAVEUP PQ_RESETS_AT; do st_set "$d" "$k" ""; done
}

# One task, one tick: record what its pane is waiting on, and knock if it is the
# wall. Everything else is classified and left alone - answering a dialog nobody has
# identified is how an unattended system approves something it shouldn't.
#
# **Once the wall has been seen, the schedule is pq's own.** The banner is not
# transcript text: it is live UI that Claude Code derives from the reset time it is
# waiting for, so it clears ITSELF at the reset - which is the exact moment the knock
# comes due. Cancelling the plan whenever the wall is no longer on screen therefore
# threw it away at the one moment it mattered, and an agent walled at 2am sat there
# until morning with nothing left on file to say it ever had been.
#
# So the text is treated as a signal, not as state. It puts the block on; from then
# on PQ_RETRY_AT decides, and what is on screen decides nothing until the knock is
# due.
#
# What takes the block off is evidence the agent is MOVING again, and "moving" needs
# two things, not one. The tail hash alone is not enough, because a statusline that
# reports rate limits is inside the tail and turns over at the reset - a one-tick
# hash change landing at precisely `due + 60`, indistinguishable from the agent
# picking its work back up, and it would clear the block on an idle agent that never
# resumed. So movement has to be corroborated by herdr calling the pane `working`.
#
# That is not a retreat from "detection is the pane's TEXT, never herdr's status".
# That rule is about DETECTION, where herdr's top rule reads the spinner still in the
# title as `working` while the request that hit the wall is in flight. By the time a
# knock is due the dialog has long been dismissed and nothing is in flight, so
# `working` there means what it says. PIDX is loaded once per tick, so it is free.
check_stall() {                         # task_dir
  local d=$1 slug pane text hash prev kind was tries at nowsec still moved
  pane=$(st "$d" PQ_PANE); [ -n "$pane" ] || return 0
  text=$(pane_tail "$pane"); [ -n "$text" ] || return 0
  slug=$(slug_of "$d"); nowsec=$(epoch)
  hash=$(cksum <<<"$text" | awk '{ print $1 }')
  prev=$(st "$d" PQ_TAIL); st_set "$d" PQ_TAIL "$hash"
  kind=$(classify_tail "$text")
  was=$(st "$d" PQ_BLOCKED)
  # "Has this screen stopped" and "has this screen moved" are not each other's
  # negation: with no hash on file yet, the honest answer to both is no. Folding them
  # into one flag has to pick a side, and each side is wrong somewhere - a first read
  # counted as still detects a wall off a single glimpse, and a first read counted as
  # moved lets one glimpse of a `working` title clear a block that is real.
  still=0; moved=0
  if [ -n "$prev" ]; then
    if [ "$prev" = "$hash" ]; then still=1; else moved=1; fi
  fi

  # A permission prompt is recorded and deliberately never answered. That is the
  # trade for running everything in auto mode, and it is the distinction `pq ls`
  # draws in the morning between waiting on the clock and waiting on you.
  #
  # It also ends a wall, wherever we had got to with one: a session that is asking
  # for something is a session that is running again. Ending it here matters, because
  # the alternative is a knock sending Escape at a prompt - refusing it - and then
  # doing that again every ten minutes.
  if [ "$kind" = permission ]; then
    [ "$was" = quota ] && msg "$slug: moving again after the session limit"
    [ -n "$was" ] && [ "$was" != permission ] && clear_block "$d"
    st_set "$d" PQ_BLOCKED permission
    return 0
  fi

  if [ "$was" != quota ]; then
    if [ "$kind" != quota ]; then
      # Only when there is something to clear: this is the overwhelmingly common
      # branch, and each clear is six rewrites of state.env for no change at all.
      [ -n "$was" ] && clear_block "$d"
      return 0
    fi
    # The wall is on screen, but only a screen that has stopped moving is stuck.
    [ "$still" = 1 ] || return 0
    local hint due plan
    hint=$(reset_hint "$text")
    due=$(parse_reset "$hint") || due=""
    if [ -n "$due" ] && [ "$due" -gt "$nowsec" ]; then
      plan="waiting until $(clock_of "$due")"
      st_set "$d" PQ_RESETS_AT "$due"
      due=$(( due + 60 ))               # a minute past it, so clock skew cannot land early
    else
      due=$(( nowsec + PQ_QUOTA_RETRY ))
      plan="no reset time on screen, so knocking every $(( PQ_QUOTA_RETRY / 60 ))m"
      st_set "$d" PQ_RESETS_AT ""
    fi
    st_set "$d" PQ_BLOCKED quota;  st_set "$d" PQ_QUOTA_SINCE "$(now)"
    st_set "$d" PQ_TRIES 0;        st_set "$d" PQ_RETRY_AT "$due"
    unstick "$pane"
    warn "$slug: hit the session limit - dismissed it, $plan"
    return 0
  fi

  # Already walled. The pane is moving under its own steam, so it is back - let it
  # be, whatever the clock says. Waiting for the reset before believing this would
  # strand the block for hours whenever you rescue an agent yourself in the morning,
  # and a block still on file is a block that freezes the queue (see the freeze in
  # tick_body). A wall that is over is over.
  #
  # Both halves are needed. `moved` alone is the statusline turning over at the
  # reset; `working` alone risks a spinner herdr has not caught up with yet, one tick
  # after the Escape. Together they are only ever true of an agent doing work: while
  # walled and dismissed the pane is both still and idle.
  if [ "$moved" = 1 ] && [ "$(pane_state "$pane")" = working ]; then
    msg "$slug: moving again after the session limit"
    clear_block "$d"
    return 0
  fi

  tries=$(st "$d" PQ_TRIES); tries=${tries:-0}
  at=$(st "$d" PQ_RETRY_AT); at=${at:-0}

  # Until the knock is due, nothing on screen changes anything - the banner going
  # away is what the reset looks like, not what recovery looks like - with one
  # exception, which is a reset time that was not there to be read at detection.
  #
  # It often is not. What walls a task is usually a BACKGROUND agent's request, and
  # its failure reaches the transcript seconds before the session's own next
  # request fails and puts the same time in the statusline - so the tick that
  # catches the wall can be one that honestly has nothing to read, on a pane that
  # is showing the time plainly by the time you look at it. Reading once and
  # settling for polling all night is the worst of both, because the reset was
  # there.
  #
  # Two guards, and both are load-bearing. The knock must not be due yet, so this
  # only ever refines a plan still in force rather than overruling one that has run
  # its course. And nothing may have been knocked on yet, because a knock DEMOTES
  # us to polling on purpose - it means the named time came and went with the wall
  # still up - while the line that named it stays in the scrollback for ever.
  # Re-reading that line afterwards would not even give back a stale time:
  # parse_reset reads a bare clock time as the next time the clock comes round to
  # it, so `resets 4:20pm` read at 4:30 is TOMORROW, and a ten-minute cycle would
  # become a day-long one. Before any knock neither applies - nothing has been
  # demoted, and what is on screen is minutes old.
  if [ "$nowsec" -lt "$at" ]; then
    [ "$tries" = 0 ] && [ -z "$(st "$d" PQ_RESETS_AT)" ] || return 0
    local late
    late=$(parse_reset "$(reset_hint "$text")") || return 0
    [ "$late" -gt "$nowsec" ] || return 0
    # Later than now is not enough on its own, because there is a second way into
    # this branch: detection DID read a hint, and rejected it for being already
    # past. That line then stays on screen, and parse_reset reads a bare clock time
    # as the next time the clock comes round to it - so `resets 4:20pm`, rejected
    # at 4:21, reads as TOMORROW's 4:20pm by 4:26 and walks straight through a
    # "later than now" test. The bound is what pq is prepared to keep knocking for
    # anyway: past PQ_QUOTA_MAX_TRIES it gives up, so a longer wait buys nothing,
    # and a hint that has rolled over sits a clear day out - far outside it.
    [ $(( late - nowsec )) -le $(( PQ_QUOTA_MAX_TRIES * PQ_QUOTA_RETRY )) ] || return 0
    st_set "$d" PQ_RESETS_AT "$late"
    st_set "$d" PQ_RETRY_AT "$(( late + 60 ))"   # a minute past, so skew cannot land early
    msg "$slug: the pane named its reset after all - waiting until $(clock_of "$late")"
    return 0
  fi

  if [ "$tries" -ge "$PQ_QUOTA_MAX_TRIES" ]; then
    [ "$(st "$d" PQ_GAVEUP)" = 1 ] || {
      st_set "$d" PQ_GAVEUP 1
      warn "$slug: still walled after $tries attempts - leaving it for you"
    }
    return 0
  fi

  # Past the named reset and still there means the hint was optimistic, so from here
  # it is the poll interval. PQ_RESETS_AT goes with it - a time already gone is worse
  # than no time at all in `pq ls`.
  tries=$(( tries + 1 ))
  st_set "$d" PQ_TRIES "$tries"; st_set "$d" PQ_RETRY_AT "$(( nowsec + PQ_QUOTA_RETRY ))"
  st_set "$d" PQ_RESETS_AT ""
  unstick "$pane" "Continue with what you were doing."
  msg "$slug: knocking after the session limit (attempt $tries)"
}

# Is anybody behind the wall right now, and when does their window reopen? The first
# one found, as `slug<TAB>epoch` with an empty epoch when no reset could be read;
# nothing at all when nobody is walled. Writes nothing, so a listing may call it.
#
# Fill consults this and starts NOTHING while it answers, because the usage window is
# one account-wide budget rather than a per-agent one. A second agent dispatched
# behind the wall does not get its own allowance: it walls on its first request,
# having spent a minute of `wt new`, a database, a port and a puma-dev entry to get
# there, and it arrives with its own knock cycle to run. Waiting costs nothing by
# comparison - the queue is a queue, and the tick that clears the block is the tick
# that fills again.
#
# It takes a LIVE agent to freeze anything, which is why `noagent` is excluded
# alongside `missing`, and this is the one place where reading the pane properly (see
# pane_tail) makes something newly possible rather than only fixing it. Claude Code
# renders inline rather than on the alternate screen, so a session that exited while
# walled leaves its banner sitting in the visible viewport above a shell prompt -
# and `pane read`, unlike the `agent read` it replaced, returns that quite happily.
# classify_tail would go on reading `quota` off dead scrollback for ever, the knocks
# would land on bash, and a freeze that only asked whether the PANE existed would
# hold the entire queue until somebody looked. check_stall still runs on `noagent`
# panes - a binding that lapsed for a moment is worth knocking through - it just
# does not get to stop everybody else.
# A task pq has GIVEN UP on stops freezing anything, which is the only bound on how
# long a freeze can last, and it is worth one. Detection is a regex over a terminal,
# so it can be wrong: any pane showing the words - a diff of this very file, a plan
# that quotes the wall, `pq ls` output about somebody else - is a candidate, and one
# that goes idle rather than resuming can never satisfy `moved && working`. Before the
# freeze existed that cost one task's status cell. With it, and without this, it costs
# every night after it: forty knocks is under seven hours, and nothing past that ever
# clears the block on its own.
#
# Releasing it costs one worktree in the case where the wall was real all along - the
# agent dispatched behind it walls on its first request, is detected, and the freeze
# comes back. That is the right way round: a misread pane should cost a worktree, not
# a night.
walled_slot() {                         # -> slug<TAB>resets_at | ""
  local d
  for d in "$PQ_HOME/running"/*/ "$PQ_HOME/done"/*/; do
    [ -d "$d" ] || continue
    d=${d%/}
    [ "$(st "$d" PQ_BLOCKED)" = quota ] || continue
    [ "$(st "$d" PQ_GAVEUP)" = 1 ] && continue
    case "$(pane_state "$(st "$d" PQ_PANE)")" in noagent|missing) continue ;; esac
    printf '%s\t%s' "$(slug_of "$d")" "$(st "$d" PQ_RESETS_AT)"
    return 0
  done
}

# "walled until 3pm", or just "walled" when the reset could not be read.
walled_note() {                         # resets_at -> text
  local at; at=$(clock_of "${1:-}")
  [ -n "$at" ] && printf 'walled until %s' "$at" || printf 'walled'
}

# One `gh` lookup per dispatched branch, concurrently. Only tasks that have been
# dispatched can have a PR, so this costs nothing while the queue is just a queue.
# statusCheckRollup is deliberately not requested: it is what makes `wt ls` slow,
# and "is there a PR" does not need it.
#
# `mergeCommit` is a seventh column, read only by `merged_into` below: it is what
# lets pq ask "is this work IN my base" rather than only "was my base its merge
# target", which is the difference between a stack that moves and one that
# freezes the first time a part lands somewhere other than the trunk.
#
# `--limit` is 5, not 1, and `baseRefName` is a sixth column - both purely for
# the blocker predicate below, which needs to tell "closed, but a later PR
# merged" apart from "closed, and nothing else was ever opened", and needs to
# know WHICH branch a PR landed on. `pr_get` still wins on the first matching
# row, untouched - see the comment there for why a second, later PR is safe to
# have sitting further down the file.
#
# PR_ANS is the answered set: a repo+branch pair present in it means gh
# genuinely answered "zero rows" for that branch, as opposed to gh never having
# been asked (no `gh` installed, offline, no GitHub remote) or having failed.
# Without this distinction "no PR yet" and "gh could not tell us" look
# identical, and a blocker that has simply not started yet would be
# misdiagnosed as an orphan the first time `gh` hiccups.
PR_CACHE="" PR_ANS=""
pr_load() {                             # repo branch...
  local repo=$1 b n=0; shift
  local pids=()
  PR_CACHE="$PQ_HOME/.pr.$$"; : > "$PR_CACHE"
  PR_ANS="$PQ_HOME/.pr.$$.ans"; : > "$PR_ANS"
  command -v gh >/dev/null 2>&1 || return 0
  for b in "$@"; do
    [ -n "$b" ] || continue
    (
      cd "$repo" 2>/dev/null || exit 1
      raw=$(gh pr list --head "$b" --state all --limit 5 \
              --json number,state,isDraft,baseRefName,mergeCommit 2>/dev/null) || exit 1
      printf '%s\t%s\n' "$repo" "$b" > "$PR_ANS.$n"
      jq -r --arg b "$b" --arg r "$repo" \
         '.[] | [$r, $b, (.number|tostring), .state,
                 (if .isDraft then "draft" else "" end), .baseRefName,
                 (.mergeCommit.oid // "")] | @tsv' <<<"$raw"
    ) > "$PR_CACHE.$n" &
    pids[n]=$!; n=$((n + 1))
  done
  [ "$n" -gt 0 ] || return 0
  wait "${pids[@]}" 2>/dev/null
  cat "$PR_CACHE".[0-9]* >> "$PR_CACHE" 2>/dev/null
  cat "$PR_ANS".[0-9]*   >> "$PR_ANS"   2>/dev/null
  rm -f "$PR_CACHE".[0-9]* "$PR_ANS".[0-9]*
}
# Keyed on repo AND branch. The cache is one file spanning every project in the
# queue, and a branch name is only unique within its own repo - `tom/fix-timezone`
# in supercast and in supercast-ios are different branches with the same name. On
# the branch alone, one project's merged PR would retire the other project's task
# and free a slot whose work never shipped.
pr_get() {                              # repo branch
  awk -F'\t' -v r="$1" -v b="$2" \
    '$1 == r && $2 == b { print $3 "\t" $4 "\t" $5; exit }' "${PR_CACHE:-/dev/null}" 2>/dev/null
}

# Every (repo, branch) pair pq needs PR/answered state for THIS pass, plus the
# blockers of every task that has not started - those branches can belong to a
# repo nothing else in the queue touches, so they would otherwise never get
# looked up at all.
#
# `scope` picks which dispatched branches count: `all` (the default) is
# running + done, which `cmd_ls` needs for its PR column; `tick_body` passes
# `running` instead, since reconcile only ever looks at running tasks - a
# `done` task's own branch would otherwise be a `gh` call repeated every tick,
# forever, for history that already shipped and will never change state again.
# A `done` task that is ALSO a blocker still gets looked up, through its
# dependent's `after` row.
#
# The exception is a done task the reap pass still has a verdict to reach:
# `reap_watching` says so for as long as none of `PQ_MERGED`, `PQ_CLOSED`,
# `PQ_REAPED` is set, which is exactly the window where the answer can still
# change. A merged task stamps `PQ_MERGED` and drops out (only local checks
# remain - no more reason to ask `gh`); a closed one stamps `PQ_CLOSED` and
# drops out; a worktree already gone stamps `PQ_REAPED` and drops out.
pr_targets() {                          # [scope: all|running]
  local scope=${1:-all} d st repo branch
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    st=$(state_of "$d")
    case "$st" in
      running)
        repo=$(hdr "$d/plan.md" repo); branch=$(hdr "$d/plan.md" branch)
        [ -n "$repo" ] && [ -n "$branch" ] && printf '%s\t%s\n' "$repo" "$branch"
        ;;
      done)
        [ "$scope" = all ] || reap_watching "$d" || continue
        repo=$(hdr "$d/plan.md" repo); branch=$(hdr "$d/plan.md" branch)
        [ -n "$repo" ] && [ -n "$branch" ] && printf '%s\t%s\n' "$repo" "$branch"
        ;;
      queue)
        while IFS=$'\t' read -r _ repo branch; do
          [ -n "$repo" ] && [ -n "$branch" ] && printf '%s\t%s\n' "$repo" "$branch"
        done <<<"$(after_list "$d")"
        ;;
    esac
  done <<<"$(all_tasks)"
}

# Group a set of (repo, branch) pairs by repo and run `pr_load` once per repo,
# so each repo's lookups share a single `cd` - then combine into ONE PR_CACHE
# and ONE PR_ANS spanning every repo, set once. Replaces two near-identical
# per-repo loops that used to live in `cmd_ls` and `tick_body`; net less code,
# and the one place both a blocker and a dispatched branch can go missing from.
pr_load_all() {                         # pairs: "repo\tbranch" lines, e.g. $(pr_targets)
  local pairs=$1 r branches
  local cache="$PQ_HOME/.prall.$$" ans="$PQ_HOME/.prall.$$.ans"
  : > "$cache"; : > "$ans"
  if [ -n "$pairs" ]; then
    local repos; repos=$(awk -F'\t' '{ print $1 }' <<<"$pairs" | sed '/^$/d' | sort -u)
    while IFS= read -r r; do
      [ -n "$r" ] || continue
      branches=$(awk -F'\t' -v r="$r" '$1 == r { print $2 }' <<<"$pairs")
      # shellcheck disable=SC2086
      pr_load "$r" $branches
      cat "$PR_CACHE" >> "$cache" 2>/dev/null
      cat "$PR_ANS"   >> "$ans"   2>/dev/null
      rm -f "$PR_CACHE" "$PR_ANS"
    done <<<"$repos"
  fi
  PR_CACHE=$cache
  PR_ANS=$ans
}

# ── after: the predicate ────────────────────────────────────────────────────
# The repo's default branch, bare (e.g. "main", not "origin/main") - memoised in
# a file for the life of one `pq` process, the same way PR_CACHE is. It has to
# be a FILE, not a shell variable: every caller reaches this through command
# substitution (`base=$(repo_base "$repo")`), which forks a subshell, and
# anything that function assigned to a plain variable dies with that subshell -
# which is also why the cache path is derived from $$ directly rather than
# stashed in a variable first: a variable assignment here would be exactly as
# invisible to the caller as the memoised value itself would be.
#
# Mirrors `wt`'s `base_ref`: the remote-tracking symbolic ref first, since that
# is what every worktree already forks from, then `gh` for a repo `wt` has never
# touched, then a plain `show-ref` as the last resort. Unresolvable means we
# cannot evaluate "merged into main" at all, so the caller has to fail closed -
# see after_state's "nobase" detail.
repo_base() {                           # repo -> default branch name (bare), or "" if unresolvable
  local cache="$PQ_HOME/.base.$$" repo=$1 line base b
  [ -f "$cache" ] && line=$(awk -F'\t' -v r="$repo" '$1 == r { print; exit }' "$cache")
  if [ -n "${line:-}" ]; then
    base=${line#*$'\t'}; printf '%s' "$base"; [ -n "$base" ]; return
  fi
  base=$(git -C "$repo" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
  base=${base#origin/}
  if [ -z "$base" ] && command -v gh >/dev/null 2>&1; then
    base=$(cd "$repo" 2>/dev/null && gh repo view --json defaultBranchRef -q '.defaultBranchRef.name' 2>/dev/null)
  fi
  if [ -z "$base" ]; then
    for b in main master; do
      # 2>/dev/null, unlike its two siblings above which already had it: a repo
      # PATH that no longer exists makes git complain "cannot change to ..." on
      # stderr, once per probe, straight into every detached `pq tick` log - the
      # same shape of noise `term_width` had to silence for the same reason.
      git -C "$repo" show-ref --verify --quiet "refs/remotes/origin/$b" 2>/dev/null \
        && { base=$b; break; }
    done
  fi
  printf '%s\t%s\n' "$repo" "$base" >> "$cache"
  printf '%s' "$base"
  [ -n "$base" ]
}
# Deletes the memo files directly by their (deterministic) paths, rather than
# through a variable that repo_base's own callers never actually see set -
# checking a variable the caller's scope never received would silently skip
# the rm every time, leaking one small file per `pq` invocation forever.
# base_fetch's own memo goes with it: same lifetime, same reasoning.
repo_base_reset() { rm -f "$PQ_HOME/.base.$$" "$PQ_HOME/.basefetch.$$" 2>/dev/null; }

# The branch this task forks from and aims its pull request at: its own `base:`
# header when it has one, otherwise its repo's default branch. Everything pq used
# to ask `repo_base` directly now asks this instead, and a task with no `base:`
# gets byte-for-byte the old answer - which is what keeps a single-trunk repo's
# behaviour completely unchanged.
#
# Empty means unresolvable, and every caller has to fail closed on that, exactly
# as they already do for repo_base - see after_state's "nobase" detail.
task_base() {                           # task_dir -> base branch name, or "" when unresolvable
  local d=$1 b
  b=$(hdr "$d/plan.md" base)
  [ -n "$b" ] && { printf '%s' "$b"; return 0; }
  repo_base "$(hdr "$d/plan.md" repo)"
}

# Which base ONE blocker of $d is judged against. The whole point of the change:
# a blocker is met when its work is in the branch the dependent will fork from,
# not when it reached some repo-wide trunk the dependent may not even be aiming
# at.
#
# Cross-repo blockers are the exception, and they have to be. `--split` can wire
# a part in supercast behind a part in supercast-ios, and "will my base contain
# it" is meaningless across two repositories that share no history - so those
# keep being judged against their OWN repo's default branch, which is the only
# trunk they have in common with anything.
blocker_base() {                        # task_dir blocker_repo -> the base to judge it against
  local d=$1 brepo=$2
  if [ "$brepo" = "$(hdr "$d/plan.md" repo)" ]; then task_base "$d"; else repo_base "$brepo"; fi
}

# Pure: reads only PR_CACHE. 0 when a PR for this branch merged into base.
pr_merged_into() {                      # repo branch base
  awk -F'\t' -v r="$1" -v b="$2" -v base="$3" '
    $1 == r && $2 == b && $4 == "MERGED" && $6 == base { ok = 1; exit }
    END { exit !ok }' "${PR_CACHE:-/dev/null}"
}
# Pure: reads only PR_ANS. 0 when gh definitively answered for this branch,
# even if the answer was zero rows.
pr_answered() {                         # repo branch
  awk -F'\t' -v r="$1" -v b="$2" '
    $1 == r && $2 == b { ok = 1; exit }
    END { exit !ok }' "${PR_ANS:-/dev/null}"
}
# Pure: reads only PR_CACHE. 0 when at least one row is on file at all.
pr_has_row() {                          # repo branch
  awk -F'\t' -v r="$1" -v b="$2" '
    $1 == r && $2 == b { ok = 1; exit }
    END { exit !ok }' "${PR_CACHE:-/dev/null}"
}
# Pure: reads only PR_CACHE. 0 when at least one row exists and every row on
# file for this branch is CLOSED - it can never become met on its own.
pr_all_closed() {                       # repo branch
  awk -F'\t' -v r="$1" -v b="$2" '
    BEGIN { allclosed = 1 }
    $1 == r && $2 == b { n++; if ($4 != "CLOSED") allclosed = 0 }
    END { exit !(n > 0 && allclosed) }' "${PR_CACHE:-/dev/null}"
}
# Pure: reads only PR_CACHE. 0 when at least one row is an open DRAFT.
pr_has_draft() {                        # repo branch
  awk -F'\t' -v r="$1" -v b="$2" '
    $1 == r && $2 == b && $5 == "draft" { ok = 1; exit }
    END { exit !ok }' "${PR_CACHE:-/dev/null}"
}
# Pure: reads only PR_CACHE. The merge commit of the first MERGED row, or empty.
pr_merge_oid() {                        # repo branch
  awk -F'\t' -v r="$1" -v b="$2" \
    '$1 == r && $2 == b && $4 == "MERGED" && $7 != "" { print $7; exit }' \
    "${PR_CACHE:-/dev/null}" 2>/dev/null
}
# Pure: reads only PR_CACHE. Where the first row for this branch was aimed.
pr_base() {                             # repo branch
  awk -F'\t' -v r="$1" -v b="$2" \
    '$1 == r && $2 == b { print $6; exit }' "${PR_CACHE:-/dev/null}" 2>/dev/null
}

# Refresh one base's remote-tracking ref, at most once per (repo, base) per `pq`
# process - memoised in a file for the same reason repo_base's cache is one, and
# guarded by the same $$-derived path. Best-effort and bounded: it returns 0
# whether or not the fetch worked, because `merged_into` fails closed on a stale
# ref all by itself and a missing remote must never sit on a TCP timeout with a
# free slot going unused.
#
# Off unless PQ_FETCH_BASES says otherwise, which only `tick_body` sets. The
# read-only commands (`pq ls`, `show`, `after`) answer from whatever refs are
# already on disk: a listing must not reach the network, and it is the tick that
# has to converge. Without a fetch SOMEWHERE the ancestry arm below could never
# come true on its own - dispatch's own fetch does not run for a task that is
# still blocked, so the blocker pass would wait forever on a ref nothing updates.
PQ_FETCH_BASES=0
base_fetch() {                          # repo base
  [ "${PQ_FETCH_BASES:-0}" = 1 ] || return 0
  local repo=$1 base=$2 cache="$PQ_HOME/.basefetch.$$" key
  key="$repo"$'\t'"$base"
  [ -f "$cache" ] && grep -qxF "$key" "$cache" 2>/dev/null && return 0
  printf '%s\n' "$key" >> "$cache"
  GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o ConnectTimeout=5 -o BatchMode=yes}" \
    git -C "$repo" fetch --quiet origin "+refs/heads/$base:refs/remotes/origin/$base" \
    >/dev/null 2>&1 || true
  return 0
}

# 0 when this branch's work is PRESENT IN $base - the question every caller here
# actually has, and not the same question as "was $base its merge target".
#
# Two arms, cheapest first:
#
#   1. A MERGED row whose baseRefName IS $base. Pure, cache-only, no git at all,
#      and the only arm a repo with a single integration target ever reaches -
#      so the common path costs exactly what it did before this existed.
#   2. That row's MERGE COMMIT is an ancestor of $base. This is what carries a
#      stack whose lower parts landed on the trunk BEFORE the integration branch
#      was cut: part 3 merged to master, part 4 is based on `live-events`, and
#      master's own commit is sitting in `live-events` history. Exact matching
#      calls that unmet and freezes the queue; containment gets it right.
#
# Testing whether $base CONTAINS the repo default instead would be cheaper and is
# wrong: an integration branch is cut once and then diverges, so origin/master
# stops being an ancestor of it within a day (measured: master 3 ahead,
# live-events 1 ahead) while the merge commit is still plainly in both.
#
# This does not reopen the "never git ancestry" rule at the top of this file. That
# rule is about a branch TIP, and it is right - a squash-merged branch's tip is
# an ancestor of nothing. A merge commit is the opposite: squash, rebase and merge
# commits are all, by construction, ON the branch they landed on, and `gh` hands
# us the oid. The forge still decides WHETHER something merged; git is asked only
# WHERE that work now sits, which is a question about fork points that no forge
# can answer.
#
# Fails closed at every step - no oid, no fetch, an object we do not have, a ref
# that does not exist locally - all read "not yet" and get retried next tick.
merged_into() {                         # repo branch base
  local repo=$1 branch=$2 base=$3 oid
  [ -n "$base" ] || return 1
  pr_merged_into "$repo" "$branch" "$base" && return 0
  oid=$(pr_merge_oid "$repo" "$branch")
  [ -n "$oid" ] || return 1
  base_fetch "$repo" "$base"
  git -C "$repo" merge-base --is-ancestor "$oid" "refs/remotes/origin/$base" 2>/dev/null
}

# blocker_state <repo> <branch> <base> -> met | waiting | stalled | dead | orphan | unknown
#
# Not pure past this line: task_by_branch walks all_tasks() and touches disk,
# which is why the five pr_* predicates above are split out on their own - they
# are the seam a test can exercise without a single real task directory.
#
# One row per outcome in the table this mirrors, in the same order, because
# that is the only way to keep the two in sync by inspection rather than by
# memory:
#   MERGED, and that work is present in $base              -> met
#   no PR yet, a live task owns the branch                -> waiting (normal)
#   an OPEN row, a live task owns the branch               -> waiting (in review)
#   a DRAFT row whose owning task has reached done AND
#     whose review gate is over (or never applied)         -> stalled
#   every row is CLOSED                                    -> dead
#   no PR, and no task in any state owns the branch        -> orphan
#   no row and gh never answered                           -> unknown
#
# A draft during the review gate is the gate WORKING - every pull request now
# opens as one and stays one until the implementer has answered the review - so
# it is only a stalled chain once the gate is settled and the draft is still
# there. `review_settled` is true for an unset key, which keeps every task from
# before the gate reading byte-for-byte as it did.
blocker_state() {                       # repo branch base
  local repo=$1 branch=$2 base=$3 owner
  merged_into "$repo" "$branch" "$base" && { printf 'met'; return; }
  if pr_has_row "$repo" "$branch"; then
    pr_all_closed "$repo" "$branch" && { printf 'dead'; return; }
    owner=$(task_by_branch "$repo" "$branch")
    if pr_has_draft "$repo" "$branch" && [ -n "$owner" ] && [ "$(state_of "$owner")" = "done" ] \
       && review_settled "$owner"; then
      printf 'stalled'; return
    fi
    printf 'waiting'; return
  fi
  if pr_answered "$repo" "$branch"; then
    owner=$(task_by_branch "$repo" "$branch")
    [ -n "$owner" ] && { printf 'waiting'; return; }
    printf 'orphan'; return
  fi
  printf 'unknown'
}

# after_state <task_dir> -> "verdict\tdetail" where verdict is
# met | waiting <label> <n_unmet> | stalled <label> | dead <label>, and detail
# is one of dead|orphan|stalled|nobase:<repo>|"" - the finer-grained reason a
# caller needs for a warning message but that would overload the verdict text
# itself. Both are printed on the SAME line, tab-separated, rather than through
# a side-channel global: every caller reaches this through command
# substitution, which forks a subshell, so a global this function set would
# vanish the moment it returned - the same trap repo_base's cache sidesteps by
# being a file instead of a variable.
#
# Aggregates every blocker: dead/orphan outranks stalled outranks plain
# waiting, because the fix differs and the worse case is the one worth
# surfacing first - a task can be both "waiting on two" and "one of them is
# dead", and dead is the one that will never resolve on its own.
after_state() {                         # task_dir
  local d=$1 label repo branch base bst
  local first_dead="" first_dead_detail="" first_stalled="" first_wait="" n_unmet=0 nobase=""
  if [ ! -f "$d/after" ]; then printf 'met\t'; return; fi
  while IFS=$'\t' read -r label repo branch; do
    [ -n "$label" ] || continue
    base=$(blocker_base "$d" "$repo")
    if [ -z "$base" ]; then
      nobase=$repo
      n_unmet=$((n_unmet + 1)); [ -n "$first_wait" ] || first_wait=$label
      continue
    fi
    bst=$(blocker_state "$repo" "$branch" "$base")
    case "$bst" in
      met) ;;
      dead|orphan)
        n_unmet=$((n_unmet + 1))
        if [ -z "$first_dead" ]; then first_dead=$label; first_dead_detail=$bst; fi
        ;;
      stalled) n_unmet=$((n_unmet + 1)); [ -n "$first_stalled" ] || first_stalled=$label ;;
      *)       n_unmet=$((n_unmet + 1)); [ -n "$first_wait" ] || first_wait=$label ;;
    esac
  done <<<"$(after_list "$d")"
  if [ -n "$first_dead" ]; then
    printf 'dead %s\t%s' "$first_dead" "$first_dead_detail"
  elif [ -n "$first_stalled" ]; then
    printf 'stalled %s\tstalled' "$first_stalled"
  elif [ "$n_unmet" -gt 0 ]; then
    printf 'waiting %s %d\t%s' "$first_wait" "$n_unmet" "${nobase:+nobase:$nobase}"
  else
    printf 'met\t'
  fi
}

# The tick-time wrapper: after_state plus the once-only warning. dead, orphan
# and stalled all set PQ_AFTER_DEAD via the PQ_GAVEUP idiom (clear_block) -
# warn on the transition into it, stay quiet on every tick after, and clear it
# the moment the blocker recovers, so a reopened PR or a draft marked ready
# re-arms the warning. An unresolvable default branch warns once under its own
# PQ_AFTER_NOBASE key instead, because the fix is different - it names a repo,
# not a blocker.
#
# `pq ls` calls after_state directly and never this: a mere listing must not
# write to state.env or print a warning, the same way `agent_cell` never has.
after_check() {                         # task_dir
  local d=$1 verdict detail slug was wasnb reporepo
  IFS=$'\t' read -r verdict detail <<<"$(after_state "$d")"
  slug=$(slug_of "$d")
  was=$(st "$d" PQ_AFTER_DEAD)
  case "$verdict" in
    dead\ *|stalled\ *)
      if [ "$was" != 1 ]; then
        st_set "$d" PQ_AFTER_DEAD 1
        case "$detail" in
          dead)    warn "$slug: blocker ${verdict#* } is dead - every PR for it is closed; merge one or clear the blocker (pq after $slug --clear)" ;;
          orphan)  warn "$slug: blocker ${verdict#* } is an orphan - no task owns its branch, so nothing will ever open a PR for it" ;;
          stalled) warn "$slug: blocker ${verdict#* } is stalled - its task already reached done with only a draft PR open; go look at it" ;;
        esac
      fi
      ;;
    *) [ -z "$was" ] || st_set "$d" PQ_AFTER_DEAD "" ;;
  esac
  case "$detail" in
    nobase:*)
      reporepo=${detail#nobase:}
      wasnb=$(st "$d" PQ_AFTER_NOBASE)
      [ "$wasnb" = 1 ] || { st_set "$d" PQ_AFTER_NOBASE 1
        warn "$slug: could not resolve the default branch of $reporepo - its blockers stay unmet until it can"; }
      ;;
    *)
      wasnb=$(st "$d" PQ_AFTER_NOBASE)
      [ -z "$wasnb" ] || st_set "$d" PQ_AFTER_NOBASE ""
      ;;
  esac
  printf '%s' "$verdict"
}

# The base half of the same gate, and the reason it exists at all: fill CLAIMS a
# task into `running/` before dispatch is attempted, so a dispatch that refuses
# leaves it there with no PR and no PQ_LAUNCHED. `active_slots` counts `running/`
# unconditionally, and the next reconcile reads it as an interrupted dispatch and
# retries - forever, holding one of three slots all night for a task that cannot
# start. Refusing from `queue/` instead costs nothing and reports itself.
#
# This is not a rare case. It is the NORMAL end of the workflow `base:` exists
# for: you merge the integration branch into the trunk and delete it, and every
# task still queued behind it now names a branch that is gone.
#
# Only a DECLARED base is checked. A task without one forks wherever `wt` would
# have sent it anyway, and there is nothing here that could be missing.
#
# The local remote-tracking ref is the whole test, deliberately: it is exactly
# what `dispatch_task` will fork from, so agreeing with it is the point. A
# deleted remote branch whose stale ref nobody pruned therefore still reads as
# present - and that case does NOT burn a slot (the fork succeeds), it surfaces
# as the agent's own `gh pr create --base` failing into a draft PR, which is a
# visible `done/` row rather than a silent stall.
#
# Warns once on the transition and clears on recovery, the same PQ_GAVEUP idiom
# after_check uses, so a base that comes back re-arms the warning.
base_check() {                          # task_dir -> "basegone <branch>" | ""
  local d=$1 b repo was
  b=$(hdr "$d/plan.md" base)
  [ -n "$b" ] || return 0
  repo=$(hdr "$d/plan.md" repo)
  was=$(st "$d" PQ_BASE_GONE)
  if git -C "$repo" rev-parse --verify --quiet "refs/remotes/origin/$b^{commit}" >/dev/null 2>&1; then
    [ -z "$was" ] || st_set "$d" PQ_BASE_GONE ""
    return 0
  fi
  [ "$was" = 1 ] || { st_set "$d" PQ_BASE_GONE 1
    warn "$(slug_of "$d"): base origin/$b is gone - merged and deleted? retarget it (pq base $(slug_of "$d") <branch>) or drop it (pq base $(slug_of "$d") --clear)"; }
  printf 'basegone %s' "$b"
}

# {label, repo, branch, state} for every blocker, for cmd_ls --json - assumes
# PR_CACHE/PR_ANS already cover every blocker's (repo, branch), same as
# after_state assumes.
after_json() {                          # task_dir
  local d=$1 label repo branch base st
  [ -f "$d/after" ] || { printf '[]'; return; }
  local tmp="$PQ_HOME/.afterjson.$$"; : > "$tmp"
  while IFS=$'\t' read -r label repo branch; do
    [ -n "$label" ] || continue
    base=$(blocker_base "$d" "$repo")
    st=$(blocker_state "$repo" "$branch" "${base:-}")
    jq -nc --arg label "$label" --arg repo "$repo" --arg branch "$branch" --arg state "$st" \
      '{label: $label, repo: $repo, branch: $branch, state: $state}' >> "$tmp"
  done <<<"$(after_list "$d")"
  jq -sc '.' "$tmp"
  rm -f "$tmp"
}

# The width every caller here renders against, unless told otherwise. `PQ_WIDTH`
# is the escape hatch - what the tests pin to exercise this deterministically
# without a tty, and what a caller in a Herdr pane or a detached `pq tick` can
# set if the probe below ever resolves to the wrong terminal.
#
# `stty size </dev/tty`, not `tput cols`: every caller here reaches term_width
# through a command substitution, so tput's stdout is a pipe, its ioctl fails,
# and it falls back to terminfo's 80 rather than the real width.
#
# The redirection is wrapped in a group so /dev/tty's own absence is silenced
# too: `stty ... 2>/dev/null` only covers what stty says, and a missing
# controlling terminal is the SHELL complaining about the redirect - "Device not
# configured", once per rendered table, in every detached `pq tick` log.
term_width() {
  local c=${PQ_WIDTH:-}
  [ -n "$c" ] || c=$( { stty size </dev/tty; } 2>/dev/null | cut -d' ' -f2 )
  [ -n "$c" ] || c=$(tput cols 2>/dev/null)
  [[ "$c" =~ ^[0-9]+$ ]] && [ "$c" -ge 40 ] || c=100
  printf '%s' "$c"
}

# Same table renderer as wt: every column but the last padded to its own widest
# cell, so one long branch name does not force a fixed width on everything else -
# THEN shrunk to fit `width` (default term_width), so no row can ever roll over
# to a second line. A table that already fits renders byte-identical to before:
# the shrink loop and the truncation below only ever engage once natural widths
# exceed the target.
#
# Cells must be ASCII. macOS awk's length() counts BYTES, not characters, and no
# locale changes that (verified on awk 20200816) - so a single multi-byte character
# anywhere in a cell silently over-pads that column by the number of extra bytes and
# skews the whole table. Cheap to avoid, fiddly to detect, so: plain ASCII in tables.
render_table() {                        # tsv_file [width]
  local width=${2:-$(term_width)}
  awk -F'\t' -v width="$width" '
    { rows = NR; if (NF > n) n = NF
      for (i = 1; i <= NF; i++) { cell[NR, i] = $i; if (length($i) > w[i]) w[i] = length($i) } }
    END {
      # Row 1 is the floor: no column shrinks below the width of its own
      # header cell, so a header is never truncated.
      for (i = 1; i <= n; i++) floor[i] = length(cell[1, i])

      total = 0
      for (i = 1; i <= n; i++) total += w[i] + (i < n ? 2 : 0)
      # Shrink the widest shrinkable column by one, repeatedly, until the row
      # fits or nothing can give - bounded by the sum of the widths, and it
      # naturally targets whichever column (TASK, AGENT, ...) is widest.
      while (total > width) {
        wi = 0; widest = 0
        for (i = 1; i <= n; i++) if (w[i] > floor[i] && w[i] > widest) { widest = w[i]; wi = i }
        if (wi == 0) break
        w[wi]--; total--
      }

      for (r = 1; r <= rows; r++) {
        line = ""
        for (i = 1; i <= n; i++) {
          v = cell[r, i]
          # Truncate an over-long cell with ".." - matching cells own
          # convention - including the last column, which is unpadded and so
          # can otherwise overflow on its own.
          if (length(v) > w[i]) v = substr(v, 1, w[i] - 2) ".."
          line = line (i == n ? v : sprintf("%-*s  ", w[i], v))
        }
        sub(/[ \t]+$/, "", line)
        # Final backstop, for a terminal narrower than the headers themselves
        # can fit - the shrink loop above cannot go below a header floor.
        if (length(line) > width) line = substr(line, 1, width)
        print line
      }
    }
  ' "$1"
}

# epoch_seconds -> 12m / 3h / 5d. Shared by age_of below and the plan picker,
# which already has an epoch from `stat` and must not go via a formatted
# string: `stat -f '%Sm'` renders in LOCAL time while age_of's caller below
# parses with `date -j -u`, so a round trip through a string would be
# silently off by the UTC offset. The d < 0 clamp is for a future mtime - a
# restored or clock-skewed file - which would otherwise render "-1m".
age_since() {                           # epoch_seconds -> 12m / 3h / 5d
  local now d
  [ -n "${1:-}" ] || { printf -- '-'; return; }
  now=$(date -u '+%s'); d=$(( now - $1 )); [ "$d" -lt 0 ] && d=0
  if   [ "$d" -lt 3600 ]  ; then printf '%dm' $(( d / 60 ))
  elif [ "$d" -lt 86400 ] ; then printf '%dh' $(( d / 3600 ))
  else                           printf '%dd' $(( d / 86400 )); fi
}

age_of() {                              # iso8601
  local at
  at=$(epoch_of "${1:-}")
  [ -n "$at" ] || { printf -- '-'; return; }
  age_since "$at"
}

# What check_stall recorded about a pane, as a cell: `quota 8:30pm`, `walled 2h`,
# `permission`, or nothing at all when the task is not blocked. Shared by the running
# and the done branches below, because check_stall now knocks on both and a wrapping-up
# agent behind the wall has exactly as much to say about it as a running one.
block_cell() {                          # task_dir
  local d=$1 at
  case "$(st "$d" PQ_BLOCKED)" in
    quota)      [ "$(st "$d" PQ_GAVEUP)" = 1 ] && printf 'walled ' || printf 'quota '
                # The time it comes back beats how long it has been gone, when the
                # wall told us one. Both are ASCII, as every cell here must be.
                at=$(clock_of "$(st "$d" PQ_RESETS_AT)")
                printf '%s' "${at:-$(age_of "$(st "$d" PQ_QUOTA_SINCE)")}" ;;
    permission) printf 'permission' ;;
  esac
}

# What an agent is waiting on, in the words that decide what you do about it.
# `pq` records why it classified a blocked agent the way it did, so the morning
# read separates "waiting on the clock" from "waiting on you".
#
# The column is headed AGENT, but the header comment already describes `pq ls`
# as showing "what it is waiting on" - so a task that has not started yet gets
# an answer here too, rather than a tenth column: `after <label>` (`+N` for
# more) when it is only waiting, `dead <label>` or `stalled <label>` when a
# blocker needs you instead. Calls after_state directly, never after_check - a
# mere listing must not write to state.env or print a warning.
agent_cell() {                          # task_dir state
  local d=$1 st=$2 pane status blocked
  case "$st" in
    queue)
      # A base that has gone missing outranks any blocker verdict: the task cannot
      # start either way, and this is the one that needs YOU rather than time.
      # Read from the stamp, never probed here - `base_check` in the tick is the
      # writer, exactly as `block_cell` reads PQ_BLOCKED rather than inspecting a
      # pane. A listing must not touch git or write to state.env.
      #
      # Without this a task whose base was merged and deleted would show `-` and
      # count as healthy, which is precisely the silent stall the rest of this
      # column exists to prevent.
      [ "$(st "$d" PQ_BASE_GONE)" = 1 ] && { printf 'base gone'; return; }
      [ -f "$d/after" ] || { printf -- '-'; return; }
      local verdict lbl cnt
      IFS=$'\t' read -r verdict _ <<<"$(after_state "$d")"
      case "$verdict" in
        met)  printf -- '-' ;;
        waiting\ *)
          lbl=${verdict#waiting }; cnt=${lbl##* }; lbl=${lbl% *}
          lbl=$(cell "$lbl" "$PQ_LABEL_MAX")
          if [ "$cnt" -gt 1 ] 2>/dev/null; then printf 'after %s +%d' "$lbl" "$((cnt - 1))"
          else printf 'after %s' "$lbl"; fi
          ;;
        stalled\ *) printf 'stalled %s' "$(cell "${verdict#stalled }" "$PQ_LABEL_MAX")" ;;
        dead\ *)    printf 'dead %s' "$(cell "${verdict#dead }" "$PQ_LABEL_MAX")" ;;
      esac
      return
      ;;
    done)
      # Deliberately silent for a reaped task, or one never held at all - `-`
      # keeps meaning "nothing here wants you". A closed-without-merging task
      # used to get its own `closed` word here, because pq left its worktree
      # alone and only you could decide what became of it. It is torn down
      # automatically now, so it settles exactly as a merged one does and wants
      # nothing - and the PR column reads `#N closed` either way, which is where
      # that fact belongs.
      local reason
      reason=$(st "$d" PQ_REAP_HELD)
      # These two want a decision from you and say nothing about the agent, so
      # they outrank the slot report below. `held agent` does not: it means the
      # very thing `wrapping up` says, and says it without mentioning the slot.
      case "$reason" in
        nobase|here) printf 'held %s' "$reason"; return ;;
      esac
      # A done task whose agent is still going still holds one of the cap's
      # slots (see the `slots` section). Without this the queue not advancing
      # has no visible cause at all - the running/ rows add up to less than the
      # cap and nothing on screen accounts for the difference.
      #
      # `blocked` is called out rather than folded into `wrapping up`, because
      # the two want opposite things from you. A wrapping-up agent wants
      # nothing; a blocked one is sitting on a prompt and holds its slot for as
      # long as it sits there. It reads as `blocked` for the same reason a
      # running row does, and counts into "needs you" through the case cmd_ls
      # already has for that word.
      #
      # What pq read off the pane comes first, exactly as it does for a running
      # row: `quota 8:30pm` says which of the two it is and when it comes back,
      # where herdr's bare `blocked` cannot. A wall here is knocked on now, so
      # this is the row that tells you it is being handled rather than waiting.
      blocked=$(block_cell "$d")
      if [ -n "$blocked" ]; then printf '%s' "$blocked"; return; fi
      if [ "$(pane_state "$(st "$d" PQ_PANE)")" = blocked ]; then printf 'blocked'; return; fi
      # The review gate, ahead of the slot report: `review due`, `reviewing 7m`,
      # `security review 3m`, `reviewed`, `review failed`, `resolving`, `review lapsed` all say more
      # than `wrapping up` about WHY the slot is held, and `review lapsed` is a
      # decision for you. Block words keep precedence above, since a blocked
      # agent wants an answer whatever the gate is doing.
      local rv; rv=$(review_cell "$d")
      if [ -n "$rv" ]; then printf '%s' "$rv"; return; fi
      if [ -n "$(slot_state "$d")" ]; then printf 'wrapping up'; return; fi
      if [ -n "$reason" ]; then printf 'held %s' "$reason"; else printf -- '-'; fi
      return
      ;;
  esac
  [ "$st" = running ] || { printf -- '-'; return; }
  pane=$(st "$d" PQ_PANE)
  # Claimed but not yet launched: either mid-dispatch right now, or an interrupted
  # tick left it half-done and the next reconcile will finish it.
  [ -n "$(st "$d" PQ_LAUNCHED)" ] || { printf 'starting'; return; }
  status=$(pane_state "$pane")
  case "$status" in
    "")        printf '?';    return ;;       # herdr did not answer
    missing)   printf 'gone'; return ;;       # workspace is gone, so nothing else applies
  esac
  # What pq itself read off the pane outranks whatever herdr makes of it - herdr
  # can call a walled agent `working` off the spinner still in its title, or
  # `noagent` if the binding lapsed, and the wall is the whole reason this column
  # exists at 8am. Same ordering as reconcile, for the same reason.
  blocked=$(block_cell "$d")
  [ -n "$blocked" ] && { printf '%s' "$blocked"; return; }
  case "$status" in
    noagent) printf 'exited';  return ;;      # a shell is sitting where Claude was
    unknown) printf 'unknown'; return ;;
  esac
  printf '%s' "$status"
}

cmd_ls() {
  local as_json=0 all=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) as_json=1; shift ;;
      --all)  all=1; shift ;;
      -h|--help) die "usage: pq ls [--all] [--json]" ;;
      *)      die "unknown option '$1' (usage: pq ls [--all] [--json])" ;;
    esac
  done

  local tasks; tasks=$(all_tasks "$([ "$all" = 1 ] && printf all || printf live)")
  if [ -z "$tasks" ]; then
    [ "$as_json" = 1 ] && echo '[]'
    local narch0; narch0=$(dir_count "$PQ_HOME/archive")
    if [ "$narch0" -gt 0 ] && [ "$all" != 1 ]; then
      msg "queue is empty - add one with: pq add ($narch0 archived, --all to see)"
    else
      msg "queue is empty - add one with: pq add"
    fi
    return 0
  fi

  # PR state for every dispatched branch, PLUS every blocker of a task that has
  # not started - a blocker's branch can belong to a repo nothing else in the
  # queue touches, so pq ls would otherwise lie about it being unmet forever.
  # pr_targets itself only ever walks live tasks, regardless of --all: archive
  # is settled history, so a listed archived row never costs a fresh `gh` call.
  local d st repo
  pidx_load
  pr_load_all "$(pr_targets)"

  # PROJECT, MODEL, and EFFORT each show only once the listed tasks actually
  # span more than one value - the first thing you need when they do, and a
  # column of the same word repeated on every row when they don't.
  local multi multi_model multi_effort
  multi=$(while IFS= read -r d; do [ -n "$d" ] && hdr "$d/plan.md" repo; done <<<"$tasks" \
            | sed '/^$/d' | sort -u | awk 'END { print (NR > 1) }')
  multi_model=$(while IFS= read -r d; do [ -n "$d" ] && hdr "$d/plan.md" model; done <<<"$tasks" \
            | sed '/^$/d' | sort -u | awk 'END { print (NR > 1) }')
  multi_effort=$(while IFS= read -r d; do [ -n "$d" ] && hdr "$d/plan.md" effort; done <<<"$tasks" \
            | sed '/^$/d' | sort -u | awk 'END { print (NR > 1) }')

  local tbl="$PQ_HOME/.ls.$$.tsv"
  local slug branch model effort intent added pr num prstate draft agent needs=0 blocked dispst
  local holding nwrap=0
  local TAB=$'\t'
  if [ "$as_json" = 1 ]; then
    : > "$tbl"
  else
    local hdrline="TASK"
    [ "$multi" = 1 ] && hdrline="${hdrline}${TAB}PROJECT"
    hdrline="${hdrline}${TAB}STATE"
    [ "$multi_model" = 1 ]  && hdrline="${hdrline}${TAB}MODEL"
    [ "$multi_effort" = 1 ] && hdrline="${hdrline}${TAB}EFFORT"
    hdrline="${hdrline}${TAB}AGENT${TAB}PR${TAB}AGE"
    printf '%s\n' "$hdrline" > "$tbl"
  fi
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    st=$(state_of "$d"); slug=$(slug_of "$d")
    # Urgency is only meaningful for what has not started - "queue!" in the
    # human table, since render_table widens the STATE column on its own the
    # moment one shows up.
    dispst=$st
    case "$st" in queue) is_urgent "$d" && dispst="$st!" ;; esac
    branch=$(hdr "$d/plan.md" branch); model=$(hdr "$d/plan.md" model)
    effort=$(hdr "$d/plan.md" effort)
    intent=$(hdr "$d/plan.md" intent);  added=$(hdr "$d/plan.md" added)
    repo=$(hdr "$d/plan.md" repo)
    agent=$(agent_cell "$d" "$st")
    case "$agent" in
      permission|gone|exited|blocked|unknown) needs=$((needs + 1)) ;;
      dead\ *|stalled\ *|held\ *|base\ *)             needs=$((needs + 1)) ;;
      review\ lapsed)                                 needs=$((needs + 1)) ;;
    esac
    # Which rows are spending the cap. `running` unconditionally, the same way
    # active_slots counts it; a done row only while its agent is still there.
    # Deliberately NOT folded into `needs` - a task wrapping up is healthy, it
    # just is not free.
    holding=false
    case "$st" in
      running) holding=true ;;
      done)    [ -n "$(slot_state "$d")" ] && { holding=true; nwrap=$((nwrap + 1)); } ;;
    esac
    num=""; prstate=""; draft=""
    IFS=$'\t' read -r num prstate draft <<<"$(pr_get "$repo" "$branch")"
    local tbase; tbase=$(task_base "$d")
    case "${prstate:-}" in
      # A merged PR that is NOT in this task's base is the one row that used to
      # read as finished while the queue quietly disagreed with it - `#6460
      # merged` on screen, `waiting` in the predicate, and nothing anywhere
      # reconciling the two. Say where it went instead.
      MERGED) pr="#$num merged"
              merged_into "$repo" "$branch" "$tbase" \
                || pr="#$num merged->$(pr_base "$repo" "$branch")" ;;
      OPEN)   pr="#$num ${draft:-open}" ;;
      CLOSED) pr="#$num closed" ;;
      *)      pr="-" ;;
    esac
    if [ "$as_json" = 1 ]; then
      case "$(after_state "$d")" in met$'\t'*) blocked=false ;; *) blocked=true ;; esac
      local merged closed reaped held
      merged=$(st "$d" PQ_MERGED); closed=$(st "$d" PQ_CLOSED)
      reaped=$(st "$d" PQ_REAPED); held=$(st "$d" PQ_REAP_HELD)
      jq -nc --arg task "$slug" --arg state "$st" --arg branch "$branch" \
        --arg repo "$repo" --arg model "$model" --arg effort "$effort" \
        --arg intent "$intent" --arg added "$added" --arg dir "$d" \
        --arg base "$tbase" \
        --arg agent "$agent" --arg pr "${num:-}" --arg prstate "${prstate:-}" \
        --arg draft "$draft" --arg stamp "$(stamp_of "$d")" \
        --argjson urgent "$(is_urgent "$d" && printf true || printf false)" \
        --arg merged "$merged" --arg closed "$closed" \
        --arg reaped "$reaped" --arg held "$held" \
        --arg review "$(st "$d" PQ_REVIEW)" --arg review_result "$(st "$d" PQ_REVIEW_RESULT)" \
        --arg security "$(st "$d" PQ_SECURITY)" --arg security_result "$(st "$d" PQ_SECURITY_RESULT)" \
        --arg design "$(hdr "$d/plan.md" design)" \
        --argjson holding_slot "$holding" \
        --argjson after "$(after_json "$d")" --argjson blocked "$blocked" '
        def str: if . == "" then null else . end;
        { task: $task, stamp: ($stamp|tonumber), urgent: $urgent, state: $state, dir: $dir,
          repo: $repo, branch: $branch, base: ($base|str), model: $model, effort: $effort,
          intent: ($intent|str), added: ($added|str),
          agent: ($agent | if . == "-" then null else . end),
          pr: ($pr|str|if . then tonumber else null end),
          pr_state: ($prstate|str), pr_draft: ($draft == "draft"),
          after: $after, blocked: $blocked, holding_slot: $holding_slot,
          merged: ($merged|str), closed: ($closed|str),
          reaped: ($reaped|str), held: ($held|str),
          review: ($review|str), review_result: ($review_result|str),
          security: ($security|str), security_result: ($security_result|str),
          design: (if $design == "" then [] else ($design | split(", ")) end) }' >> "$tbl"
    else
      local row="$slug"
      [ "$multi" = 1 ] && row="${row}${TAB}$(cell "$(basename "${repo:--}")" 20)"
      row="${row}${TAB}${dispst}"
      [ "$multi_model" = 1 ]  && row="${row}${TAB}${model:--}"
      [ "$multi_effort" = 1 ] && row="${row}${TAB}${effort:--}"
      row="${row}${TAB}${agent}${TAB}${pr}${TAB}$(age_of "$added")"
      printf '%s\n' "$row" >> "$tbl"
    fi
  done <<<"$tasks"

  if [ "$as_json" = 1 ]; then
    jq -s '.' "$tbl"
  else
    render_table "$tbl"
    local nq nr narch
    nq=$(dir_count "$PQ_HOME/queue")
    nr=$(dir_count "$PQ_HOME/running")
    narch=$(dir_count "$PQ_HOME/archive")
    printf '\n' >&2
    # The wrap-up count only earns its words when there is one, but when there
    # is, it is the line that explains a queue sitting still at a cap that looks
    # unreached - so it names the cap alongside it rather than leaving you to
    # add the two numbers up yourself.
    msg "$nr running$([ "$nwrap" -gt 0 ] && printf ' + %s wrapping up (cap %s)' "$nwrap" "$(cap_get)"), $nq queued\
$([ "$needs" -gt 0 ] && printf ' (%s needs you)' "$needs")\
$([ "$narch" -gt 0 ] && printf ', %s archived%s' "$narch" "$([ "$all" = 1 ] || printf ' (--all to see)')")"
  fi
  rm -f "$tbl" "$PR_CACHE" "$PR_ANS"
  repo_base_reset
}

# ── the small commands ──────────────────────────────────────────────────────
# `pq after <task>` alone answers "why has this not started": per blocker, both
# the state of the TASK that owns the branch and the state of its PR, since
# either one can be the reason and the fix differs.
#
# `pq after <task> <task|branch>...` adds blockers; `--clear` drops them all.
# Restricted to what has not been dispatched - blockers only gate what has not
# started. `cmd_base` carries the same restriction, worded the same way.
cmd_after() {
  local d; d=$(find_task "${1:-}") || exit 1; shift

  if [ $# -eq 0 ]; then
    if [ ! -f "$d/after" ]; then
      msg "$(slug_of "$d") has no blockers"
      return 0
    fi
    pr_load_all "$(after_list "$d" | awk -F'\t' '{ print $2 "\t" $3 }')"
    local label repo branch base bst owner ownerst num prstate draft prtxt desc overdict
    while IFS=$'\t' read -r label repo branch; do
      [ -n "$label" ] || continue
      base=$(blocker_base "$d" "$repo")
      bst=$(blocker_state "$repo" "$branch" "${base:-}")
      owner=$(task_by_branch "$repo" "$branch") || owner=""
      ownerst=${owner:+$(state_of "$owner")}; ownerst=${ownerst:--}
      IFS=$'\t' read -r num prstate draft <<<"$(pr_get "$repo" "$branch")"
      case "${prstate:-}" in
        MERGED) prtxt="#$num merged" ;;
        OPEN)   prtxt="#$num ${draft:-open}" ;;
        CLOSED) prtxt="#$num closed" ;;
        *)      prtxt="no PR yet" ;;
      esac
      case "$bst" in
        met)     desc="present in ${base:-its default branch} - satisfied" ;;
        waiting)
          case "$ownerst" in
            done|-) desc="waiting on your merge" ;;
            *)
              IFS=$'\t' read -r overdict _ <<<"$(after_state "$owner")"
              case "$overdict" in
                waiting\ *) desc="waiting on ${overdict##* } of its own" ;;
                *)          desc="in progress" ;;
              esac
              ;;
          esac
          ;;
        stalled) desc="stalled - a draft PR, but its task already reached done" ;;
        dead)    desc="dead - every PR for it is closed" ;;
        orphan)  desc="orphan - nothing will ever open a PR for this branch" ;;
        *)       desc="gh has not answered yet" ;;
      esac
      printf '  %-20s %-8s %-12s %s\n' "$label" "$ownerst" "$prtxt" "$desc"
    done <<<"$(after_list "$d")"
    rm -f "$PR_CACHE" "$PR_ANS"
    repo_base_reset
    return 0
  fi

  # Both mutating forms - clearing and adding - are restricted to what has not
  # started: blockers only gate a task that has not been dispatched yet. Same
  # message shape as cmd_base's own guard below.
  case "$(state_of "$d")" in
    queue) ;;
    *) die "$(slug_of "$d") is $(state_of "$d") - blockers only gate what has not started" ;;
  esac

  if [ "$1" = --clear ]; then
    rm -f "$d/after"
    msg "cleared blockers on $(slug_of "$d")"
    return 0
  fi

  local owner_repo owner_branch value resolved label repo branch base
  owner_repo=$(hdr "$d/plan.md" repo); owner_branch=$(hdr "$d/plan.md" branch)
  for value in "$@"; do
    resolved=$(resolve_after "$owner_repo" "$value") || die "could not resolve '$value' to a task or branch"
    IFS=$'\t' read -r label repo branch <<<"$resolved"
    [ -n "$repo" ] && [ -n "$branch" ] || die "could not resolve '$value' to a repo and branch"
    [ "$repo" = "$owner_repo" ] && [ "$branch" = "$owner_branch" ] && die "a task cannot block on itself"
    after_cycle "$owner_repo" "$owner_branch" "$repo" "$branch" \
      && die "'$value' would create a cycle - $(slug_of "$d") already leads back to it"
    after_add "$d" "$label" "$repo" "$branch"
    pr_load_all "$(printf '%s\t%s\n' "$repo" "$branch")"
    base=$(blocker_base "$d" "$repo")
    if [ -n "$base" ] && merged_into "$repo" "$branch" "$base"; then
      msg "$(slug_of "$d") after $label: already in $base - nothing to wait for"
    else
      msg "$(slug_of "$d") after $label ($branch)"
    fi
  done
  rm -f "$PR_CACHE" "$PR_ANS"
  repo_base_reset
}

# Read or change a queued task's base. `base:` lives in plan.md alongside
# model/effort because it is a SETTING, not runtime state - but that makes it
# the one setting with a reason to change after the fact, since the branch it
# names can be merged and deleted while the task is still waiting.
#
# Restricted to what has not been dispatched, for the same reason cmd_after's
# mutating forms are: plan.md's immutability contract is about an agent never
# seeing its own plan change underneath it, and a task that has not been
# dispatched has no agent to protect.
cmd_base() {
  local d; d=$(find_task "${1:-}") || exit 1; shift

  if [ $# -eq 0 ]; then
    local declared; declared=$(hdr "$d/plan.md" base)
    msg "$(slug_of "$d") base: $(task_base "$d")$([ -n "$declared" ] || printf ' (its repo default)')"
    repo_base_reset
    return 0
  fi

  case "$(state_of "$d")" in
    queue) ;;
    *) die "$(slug_of "$d") is $(state_of "$d") - the base only gates what has not started" ;;
  esac

  local repo newbase=$1
  repo=$(hdr "$d/plan.md" repo)
  if [ "$newbase" = --clear ]; then
    newbase=""
  else
    # Same validation as `pq add --base`, for the same reason: the person who can
    # recognise a typo is at the keyboard now, not at 3am.
    newbase=${newbase#origin/}
    git check-ref-format "refs/heads/$newbase" || die "invalid base branch name: '$newbase'"
    if ! git -C "$repo" rev-parse --verify --quiet "refs/remotes/origin/$newbase^{commit}" >/dev/null 2>&1; then
      git -C "$repo" ls-remote --exit-code --heads origin "$newbase" >/dev/null 2>&1 \
        || die "no such base branch on origin: '$newbase' (in $repo)"
    fi
  fi

  # Rewrites ONLY inside the header block. A plan body is prose and code, and a
  # line in it beginning `base:` is entirely possible - a blind sed would rewrite
  # the agent's instructions. Same header-block bookkeeping as `hdr` itself.
  local tmp="$d/.plan.$$"
  awk -v nb="$newbase" '
    NR == 1 && $0 == "---"      { inh = 1; print; next }
    inh && $0 == "---"          { inh = 0; print; next }
    inh && $0 ~ /^base:[ \t]/   { next }
    inh && $0 ~ /^branch:/      { print; if (nb != "") printf "base:     %s\n", nb; next }
                                { print }
  ' "$d/plan.md" > "$tmp" || { rm -f "$tmp"; die "could not rewrite $(slug_of "$d")'\''s plan.md"; }
  [ -s "$tmp" ] || { rm -f "$tmp"; die "refusing to write an empty plan.md"; }
  mv "$tmp" "$d/plan.md" || { rm -f "$tmp"; die "could not replace $(slug_of "$d")'\''s plan.md"; }

  # Cleared so a retarget that is ALSO wrong warns again rather than staying
  # silent behind the previous block.
  st_set "$d" PQ_BASE_GONE ""

  if [ -n "$newbase" ]; then
    msg "$(slug_of "$d") base: $newbase"
  else
    msg "$(slug_of "$d") base cleared - it will fork from $(task_base "$d")"
  fi
  repo_base_reset
}

# Drops pq's record and nothing else. A dispatched task has a worktree, a branch
# and possibly a database behind it, and those belong to `wt` - reclaiming them
# here would make `pq rm` far more destructive than its name suggests.
cmd_rm() {
  local d; d=$(find_task "${1:-}") || exit 1
  # Read everything we will want to say BEFORE deleting the directory that holds it.
  local slug st branch repo ans deps reaped
  slug=$(slug_of "$d"); st=$(state_of "$d")
  branch=$(hdr "$d/plan.md" branch); repo=$(hdr "$d/plan.md" repo)
  deps=$(dependents_of "$repo" "$branch" | tr '\n' ' ')
  reaped=$(st "$d" PQ_REAPED)
  printf 'pq: remove task "%s" (%s)? [y/N] ' "$slug" "$st" >&2; read -r ans || ans=n
  [[ "${ans:-}" =~ ^[Yy]$ ]] || { msg "cancelled"; return 0; }
  # A reviewer still running would go on writing into a directory that is about
  # to vanish, and then post comments on a pull request pq has forgotten - and
  # the security reviewer can still be running once the gate is at `posted`.
  review_kill "$d"
  rm -rf "$d" || die "could not remove $d"
  rm -f "$PQ_HOME/tasks/$(basename "$d")"
  msg "removed $slug"
  # Removing A is exactly how B gets orphaned - nothing will ever open a PR for
  # a branch pq no longer knows about, so that is the moment to say so.
  [ -z "$deps" ] || warn "$slug was a blocker for: ${deps% } - they now wait on a branch nothing owns"
  case "$st" in
    running|done|archive)
      [ -n "$reaped" ] || warn "its worktree and branch are untouched - remove those with: wt rm $branch" ;;
  esac
}

# ── evidence ─────────────────────────────────────────────────────────────────
# Screenshots are what let a pull request be judged without checking it out, and
# a description can only show an image that has a URL. `pq evidence` gives a
# task's screenshots one: it publishes <task>/evidence/ to a single branch,
# `pq-evidence` (PQ_EVIDENCE_BRANCH), in the task's own repo, under <slug>/, and
# prints the markdown image lines to paste into the description. The contract
# (contract_write) has the implementer run it just before opening the PR.
#
# One branch for every task rather than one per task, so nothing accumulates in
# the branch list - and never deleted, because a merged pull request's
# description keeps pointing at it. A per-task branch reaped with the worktree
# would break the images in every merged PR, which is why `reap_task` and
# `wt rm` never touch this one. Pushing it runs no CI on supercast (the workflow
# filters `push` to master), and GitHub's `raw` URLs on a private repo resolve
# for anyone who can see the repo.
#
# All plumbing, in the task's worktree, against a TEMPORARY index: nothing is
# checked out, the worktree's own index and tree are never touched, and the
# implementer's uncommitted work is not in the way. A non-fast-forward rejection
# - two tasks publishing at once - refetches and rebuilds, three times at most.
# Re-running replaces the slug's files rather than appending, so a second pass
# after a fix is idempotent.

# The task `pq evidence` is about: by slug (any unique prefix), or, with no
# argument, the task whose worktree the caller is standing in - which is how the
# implementer runs it from its own pane.
evidence_task() {                       # [needle] -> task_dir
  local needle=${1:-} d wt
  if [ -n "$needle" ]; then find_task "$needle"; return; fi
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    wt=$(st "$d" PQ_WORKTREE); [ -n "$wt" ] || continue
    case "$PWD/" in "$wt"/*) printf '%s' "$d"; return 0 ;; esac
  done <<<"$(all_tasks)"
  die "not inside a task's worktree - name the task: pq evidence <task>"
}

cmd_evidence() {
  local d; d=$(evidence_task "${1:-}") || exit 1
  local slug repo wt src f files="" n=0
  slug=$(slug_of "$d"); repo=$(hdr "$d/plan.md" repo)
  wt=$(st "$d" PQ_WORKTREE); [ -n "$wt" ] && [ -d "$wt" ] || wt=$repo
  [ -n "$wt" ] && [ -d "$wt" ] || die "$slug: neither its worktree nor its repo exists"
  src="$d/evidence"
  for f in "$src"/*.png "$src"/*.jpg "$src"/*.jpeg "$src"/*.gif "$src"/*.webp; do
    [ -f "$f" ] || continue
    files="$files$f"$'\n'; n=$((n + 1))
  done
  [ "$n" -gt 0 ] || die "$slug: nothing to publish - save screenshots into $src first"

  # Resolved before anything is pushed: the image lines need it, and a push with
  # no lines to show for it would leave the caller with no way to use it.
  local owner_repo
  owner_repo=$(cd "$wt" && gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null)
  [ -n "$owner_repo" ] || die "$slug: could not read the GitHub repository name (gh repo view) - the image urls need it"

  local branch=$PQ_EVIDENCE_BRANCH idx="$d/.evidence.index.$$" parent tree commit blob try ok=0 pargs
  local ssh="${GIT_SSH_COMMAND:-ssh -o ConnectTimeout=5 -o BatchMode=yes}"
  trap 'rm -f "$idx"' EXIT
  for try in 1 2 3; do
    rm -f "$idx"
    # The branch may not exist yet, so a failed fetch is fine here; an unreachable
    # remote is caught by the push below instead.
    GIT_SSH_COMMAND=$ssh git -C "$wt" fetch --quiet origin "+refs/heads/$branch:refs/remotes/origin/$branch" 2>/dev/null || true
    parent=$(git -C "$wt" rev-parse --verify --quiet "refs/remotes/origin/$branch" 2>/dev/null) || parent=""
    pargs=()
    if [ -n "$parent" ]; then
      GIT_INDEX_FILE=$idx git -C "$wt" read-tree "$parent" || die "could not read $branch into a temporary index"
      # Replace, not append: whatever this slug published before goes first.
      GIT_INDEX_FILE=$idx git -C "$wt" ls-files -z --full-name -- "$slug/" 2>/dev/null \
        | GIT_INDEX_FILE=$idx git -C "$wt" update-index -z --force-remove --stdin 2>/dev/null || true
      pargs=(-p "$parent")
    else
      GIT_INDEX_FILE=$idx git -C "$wt" read-tree --empty || die "could not create a temporary index"
    fi
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      blob=$(git -C "$wt" hash-object -w "$f") || die "could not store $f"
      GIT_INDEX_FILE=$idx git -C "$wt" update-index --add --cacheinfo "100644,$blob,$slug/$(basename "$f")" \
        || die "could not add $f to the index"
    done <<<"$files"
    tree=$(GIT_INDEX_FILE=$idx git -C "$wt" write-tree) || die "could not write the evidence tree"
    commit=$(git -C "$wt" commit-tree "$tree" ${pargs[@]+"${pargs[@]}"} -m "evidence: $slug") || die "could not write the evidence commit"
    # No --force, deliberately: a rejected push means somebody else published
    # since the fetch above, and the right answer is to rebuild on top of them.
    if GIT_SSH_COMMAND=$ssh git -C "$wt" push --quiet origin "$commit:refs/heads/$branch" 2>/dev/null; then
      ok=1; break
    fi
    [ "$try" -lt 3 ] && msg "$slug: push of $branch was rejected (another task published first?) - rebuilding"
  done
  rm -f "$idx"; trap - EXIT
  [ "$ok" = 1 ] || die "$slug: could not push $branch after 3 attempts - is origin reachable?"
  msg "$slug: published $n file(s) to $branch/$slug/ (${commit:0:7})"

  # stdout is the markdown, and only the markdown - the implementer pastes it.
  local b
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    b=$(basename "$f")
    printf '![%s](https://github.com/%s/raw/%s/%s/%s)\n' "$b" "$owner_repo" "$branch" "$slug" "${b// /%20}"
  done <<<"$files"
}

# ── dispatch ────────────────────────────────────────────────────────────────
# What every implementer is told. Short and fixed: the plan carries the work, the
# task's contract.md (contract_write, below) carries how to deliver it, and this
# carries only the pointer to both - plus the one rule that cannot wait to be read
# out of a file, which is that nobody is watching.
#
# The delivery rules used to live here, in one long sentence, and outgrew a
# prompt: commit shape, the draft, the screenshots, the design comparison, what to
# do when stuck. They are a document now, written per task at DISPATCH rather than
# at add - so an improvement to the contract reaches every task still queued, while
# a running agent never sees its own contract change underneath it.
#
# It still names no review step, for the reason recorded when the clause came out:
# this prompt may only name capabilities the model can invoke ITSELF, and Claude
# Code's `/code-review` is reserved for a human typing it (disable-model-invocation),
# so every agent asked for one answered that it could not. The review gate exists
# now and is pq's own - see the `review gate` section: pq runs the reviewer in the
# background once the agent has opened its draft, and prompts the agent afterwards,
# so nothing here needs to ask.
#
# Quote-free by convention now rather than by rule. This used to be wrapped in single
# quotes and typed into the pane's shell, which is why a quote anywhere in it was
# refused; it goes to `herdr agent prompt` as one argv element that no shell ever
# re-parses, so nothing would break. The convention stays because the review
# follow-up (review_prompt) shares it, and one rule is easier to keep than two.
dispatch_prompt() {                     # task_dir [base]
  # The base clause is only added when there IS one to add - a task aimed at the
  # repo default gets the prompt it always got, and `gh pr create` picks the right
  # target by itself. When the base is something else, saying so is not optional:
  # `gh pr create` defaults to the DEFAULT branch, so the PR would open against a
  # trunk that is missing everything this branch forked from, and its diff would
  # swallow the whole integration branch.
  local base_clause=""
  [ -n "${2:-}" ] && base_clause="This branch was forked from $2, not from the repository default branch, \
so open your pull request against $2 - pass --base $2 to gh pr create. \
Do not rebase onto the default branch. "
  printf '%s' "Read $1/plan.md and carry it out. \
$1/contract.md is how to deliver it: read it before you start and follow it to the letter. \
${base_clause}\
Never wait for input - there is nobody watching."
}

# ── the delivery contract ────────────────────────────────────────────────────
# Everything pq asks of an implementer beyond the plan, as a file in the task
# directory. Two things about a pq pull request cost the most time to review: it
# arrives as one blob - a thousand lines in one commit, with a body that summarises
# rather than guides - and visual work drifts from the design it was planned
# against, because the implementer never saw the design. The contract answers
# both: small logical commits in reading order with a review guide, screenshots
# of every screen touched, and a side-by-side comparison against the design files
# the task carries. Then a DRAFT pull request, held for the review gate.
#
# Parameterised by the task, so the paths in it are absolute and the dev url is
# the worktree's own. The repo's conventions (its CLAUDE.md, PR format, test
# commands) still apply on top - it says so. One sentence per line, as Tom's
# markdown rule asks, and written once: dispatch_task only calls this when no
# contract.md exists, so a re-entered dispatch never rewrites a running agent's.
contract_write() {                      # task_dir
  local d=$1 repo branch base intent design security url wt slug tmp home
  repo=$(hdr "$d/plan.md" repo);   branch=$(hdr "$d/plan.md" branch)
  base=$(hdr "$d/plan.md" base);   intent=$(hdr "$d/plan.md" intent)
  design=$(hdr "$d/plan.md" design); security=$(hdr "$d/plan.md" security)
  url=$(st "$d" PQ_URL); wt=$(st "$d" PQ_WORKTREE); slug=$(slug_of "$d")
  # Every path the agent is given is the STABLE one (task_home): the real
  # directory moves to done/ the moment the pull request is reconciled, while
  # the agent is still saving screenshots into it.
  home=$(task_home "$d")
  tmp="$d/.contract.$$"
  {
    cat <<EOF
# How to deliver this task

This is pq's delivery contract for the task \`$slug\`: branch \`$branch\` in \`$repo\`.
The plan is in \`$home/plan.md\`; this file is how it becomes a pull request somebody can review.
The repository's own conventions still apply - its CLAUDE.md, its pull request format, its test and lint commands.
These rules sit on top of them.

Intent, from the plan header: ${intent:-(none recorded)}

## Working

Work only in this worktree: \`${wt:-$repo}\`.
Commit as you go.
One coherent, self-contained step per commit, in the order a reader should meet them - foundations before what is built on them - with a message that says what changed and why.
A mechanical change (a rename, a move, generated output) is its own commit, and its message says so.
A non-mechanical commit over about 300 changed lines gets split into smaller ones.
Never one squashed commit at the end: the commits are how the pull request will be read.
History may be rewritten (\`git push --force-with-lease\`) only while the pull request is still a draft.
EOF
    [ -n "$base" ] && cat <<EOF
This branch was forked from \`$base\`, not from the default branch.
Open the pull request against it (\`gh pr create --base $base\`) and never rebase onto the default branch.
EOF
    cat <<EOF

## Verifying, before the pull request

Run the repository's tests and lint, per its conventions.
EOF
    if [ -n "$url" ]; then
      cat <<EOF
The app is served at $url from the \`dev\` tab in this workspace.
If nothing answers there, look at that tab and restart the server with \`wt dev ${wt:-$repo}\`.
Log in with the project's development credentials: the ones its seed data (\`db/seeds.rb\`) or its docs name, and \`wt open ${wt:-$repo}\` opens the login page the project's profile points at, with the seed admin pre-filled.
Before changing any screen the plan names, capture it as it is today.
Walk every user-facing path the change touches, in the browser.
\`chrome-devtools-axi\` is on PATH: \`chrome-devtools-axi open <url>\`, \`chrome-devtools-axi resize <width> <height>\`, \`chrome-devtools-axi screenshot <file>\`.
Export \`CHROME_DEVTOOLS_AXI_CHROME_ARGS=--ignore-certificate-errors\` first, so the \`.test\` domain's certificate does not stop it.
Be picky: anything that looks off gets fixed, even when the plan did not name it.
Save screenshots into \`$home/evidence/\`, named \`NN-<screen>-before.png\` and \`NN-<screen>-after.png\`, at 1440px wide and, for any responsive surface, at 390px too.
EOF
    else
      cat <<EOF
This repository has no dev server profile, so there is no url to open; verify through its tests and whatever the plan names.
If the change is visible anywhere - a CLI's output, a rendered file - capture it before and after into \`$home/evidence/\` as \`NN-<what>-before.png\` and \`NN-<what>-after.png\`.
EOF
    fi
    [ -n "$design" ] && cat <<EOF

## Design fidelity

The plan was built from these design files, which are in \`$home/design/\`: $design.
The plan names the artboards that matter.
Open each file with \`chrome-devtools-axi open file://$home/design/<file>\`, screenshot the target artboard at its native width, and build to it.
Then screenshot your implementation at the same width and in the same state, and compare the two side by side: layout, spacing, sizes, colour, type, radius, icons, copy, and every state the artboard shows (hover, empty, error, blocked).
Fix every difference and compare again, until nothing differs or a difference is deliberate - an existing component convention, accessibility, responsiveness - and recorded in the pull request.
Save the pairs into \`$home/evidence/\` as \`NN-<screen>-design.png\` and \`NN-<screen>-impl.png\`.
EOF
    cat <<EOF

## The pull request

Run \`pq evidence $slug\`.
It publishes everything in \`$home/evidence/\` and prints one markdown image line per file, to paste into the description.
Open the pull request as a draft (\`gh pr create --draft\`), following the repository's pull request conventions, with the intent line above as the first paragraph of the description.
Add two sections to it:

- \`## Review guide\`: the commits in reading order, one line each on what to look at; where the risk is; what is purely mechanical.
- \`## Visual evidence\`: the before/after pairs${design:+ and the design/impl pairs} with a one-line caption each${design:+, then a \`## Design fidelity\` table - element, design, implemented, note - followed by the deliberate deviations}.

Leave it a draft.
pq runs an independent review of every pull request and will tell you when to resolve its findings and mark the pull request ready.
EOF
    # A plan that asks for a security review says "run /security-review" in so
    # many words, and an implementer following it to the letter would try to -
    # so the one that runs it is named here, as the code review is above.
    [ "$security" = yes ] && cat <<EOF
The plan asks for a security review, and pq runs that too: an independent \`/security-review\` of the pull request, whose report comes to you with the code review's findings.
Do not run one yourself.
EOF
    cat <<EOF
If you get stuck, or the plan turns out not to fit the code: commit what you have, push, open a draft pull request whose title begins with \`STUCK:\` and whose description explains what blocked you, then stop.
Never wait for input - there is nobody watching.
EOF
  } > "$tmp" || { rm -f "$tmp"; return 1; }
  mv "$tmp" "$d/contract.md"
}

# ── the herdr agent API ──────────────────────────────────────────────────────
# Starting and prompting the implementer goes through `herdr agent start` and
# `herdr agent prompt`, never by typing into the pane. Typing was blind: it typed
# `claude ...` whether or not a shell was there to receive it, and the first sign
# of trouble was a task that never opened a pull request. The agent API validates
# instead - `start` returns once the expected agent is detected and ready, and
# `prompt` refuses a target sitting on a dialog (`agent_blocked`) before sending
# anything - and a prompt passed as argv is never re-parsed by a shell.
#
# herdr answers on stdout with JSON and exits 0 EITHER WAY: an error is an
# `{"error":{"code":...}}` body, not a non-zero status. So every call here reads
# the body, and treats no body at all as a failure too.
herdr_err() {                           # json -> the error code, or nothing on success
  jq -r '.error.code // empty' 2>/dev/null <<<"${1:-}"
}

# A live agent's name must match [a-z][a-z0-9_-]{0,31} and be unique among live
# agents. A slug is [a-z0-9-], may start with a digit, and may run long - so it
# is shaped rather than used raw, and the optional suffix is for the retry when
# herdr says the plain name is taken.
agent_name() {                          # slug [suffix]
  local n=$1
  n=$(tr -cd 'a-z0-9_-' <<<"$n")
  case "$n" in [a-z]*) ;; *) n="t-$n" ;; esac
  n=${n:0:24}
  [ -n "${2:-}" ] && n="$n-$2"
  printf '%s' "$n"
}

agent_start() {                         # task_dir pane model effort -> 0 an agent is up in the pane
  local d=$1 pane=$2 model=$3 effort=$4 slug name code rc try
  slug=$(slug_of "$d")
  for try in 1 2; do
    if [ "$try" = 1 ]; then name=$(agent_name "$slug"); else name=$(agent_name "$slug" "$(date -u +%H%M%S)"); fi
    # Shielded like `wt new`: a Ctrl-C mid-start would otherwise leave a Claude
    # half-launched with nobody to record it.
    shielded herdr agent start "$name" --kind claude --pane "$pane" --timeout "$PQ_AGENT_START_MS" \
      -- --model "$model" --effort "$effort"
    rc=$?
    code=$(herdr_err "$SHIELDED_OUT")
    if [ -z "$code" ] && { [ "$rc" != 0 ] || [ -z "$SHIELDED_OUT" ]; }; then code="herdr exited $rc with no answer"; fi
    case "$code" in
      "") return 0 ;;
      # Up, but on a dialog before it was ready - a trust prompt, a wall. The
      # agent IS there, which is all this step promises; whether it can be
      # talked to yet is the prompt's question, this tick or the next.
      agent_not_ready) warn "$slug: the agent started but is not ready for input yet"; return 0 ;;
      *name*|*taken*|*exists*|*conflict*|*duplicate*) [ "$try" = 1 ] && continue ;;
    esac
    warn "$slug: herdr could not start the agent in $pane - $code"
    return 1
  done
  return 1
}

# Prints the error code when there is one. 0 sent, 2 the agent is blocked on a
# dialog (the prompt was not sent, and will go on the first tick after it is
# answered), 1 anything else.
agent_prompt() {                        # pane text
  local out rc code
  out=$(herdr agent prompt "$1" "$2" 2>/dev/null); rc=$?
  code=$(herdr_err "$out")
  if [ -z "$code" ] && { [ "$rc" != 0 ] || [ -z "$out" ]; }; then code="herdr exited $rc with no answer"; fi
  [ -z "$code" ] && return 0
  printf '%s' "$code"
  [ "$code" = agent_blocked ] && return 2
  return 1
}

# Start the agent for a task, resuming from wherever a previous tick got to. Each
# step records itself the instant it succeeds, so this is safe to re-enter: an
# interrupted dispatch picks up rather than starting over.
#
# Re-entry deliberately does NOT re-run `wt new` when the pane is still there. It
# would work - wt reopens an existing worktree rather than failing - but it also
# re-runs provisioning, and supercast's provisioning DROPS AND RECREATES the
# database. That is harmless before an agent has touched anything and destructive
# afterwards, so the cheap path is also the safe one.
# A shell function rather than an inline `cd ... && wt`, so `shielded` can run it as
# a single command. Functions are visible in the subshell it backgrounds; a `cd`
# baked into a command substitution would not be. It also stands in for a `--repo`
# flag `wt` doesn't have: `wt` takes its repo from `$PWD`, so both dispatch and
# reap need this same `cd` first.
wt_in() {                               # repo wt-subcommand args...
  local repo=$1; shift
  cd "$repo" || return 1
  "$WT" "$@"
}

dispatch_task() {                       # task_dir  -> 0 launched, 1 failed
  local d=$1 repo branch model effort pane wtjson prompt
  repo=$(hdr "$d/plan.md" repo);     branch=$(hdr "$d/plan.md" branch)
  model=$(hdr "$d/plan.md" model);   effort=$(hdr "$d/plan.md" effort)
  # The DECLARED base only. `task_base` would fall back to the repo default,
  # which is precisely what `wt new` already does on its own - so passing that
  # back to it would be a no-op dressed up as a decision, and it is what keeps
  # every single-trunk dispatch byte-identical to what it was before.
  local basebr; basebr=$(hdr "$d/plan.md" base)
  [ -n "$repo" ] && [ -n "$branch" ] || { warn "$(slug_of "$d"): plan.md has no repo/branch"; return 1; }
  [ -d "$repo" ] || { warn "$(slug_of "$d"): repo $repo is gone"; return 1; }

  # The stable link exists for any task that came through retitle; this makes it
  # so for one that did not (a task made before the link existed, a hand-moved
  # directory), since the prompt below hands it out.
  task_link "$d"

  pane=$(st "$d" PQ_PANE)
  local fresh=0
  if [ -z "$pane" ] || [ "$(pane_state "$pane")" = missing ]; then
    # With the dev server, always. It used to be `--no-dev` - a foreman stack
    # per task behind agents that never opened a browser was the wrong price for
    # an overnight batch - but batches no longer run overnight, most changes are
    # visual, and the contract has the implementer verify every screen it
    # touches in the browser and screenshot it. An agent with no running app to
    # look at cannot do that. `wt open`'s own autostart stays for a server that
    # has died by the time you come to look.
    # `wt new` on a brand-new branch forks from the local origin/HEAD with no
    # fetch first, so a stale checkout can hand a task whose blocker just
    # merged a base that predates the very commit it waited for - `pq` says "A
    # merged, go" and `wt` forks from an origin/master that does not contain A.
    # Bounded and non-fatal: this runs outside `shielded`, so an unreachable
    # remote must not sit on a TCP timeout and stall the tick with a free slot.
    GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o ConnectTimeout=5 -o BatchMode=yes}" \
      git -C "$repo" fetch --quiet origin 2>/dev/null \
      || warn "$(slug_of "$d"): could not fetch $repo - the worktree may fork from a stale base"
    # A declared base is checked HERE rather than trusted, because the failure is
    # silent and expensive: `wt new` falls back to origin/HEAD for a base it
    # cannot resolve, so a typo'd or deleted branch would quietly hand the agent
    # a worktree forked from the trunk - the exact wrong-fork-point bug this
    # header exists to prevent, only harder to see because everything "worked".
    local baseflag=""
    if [ -n "$basebr" ]; then
      if git -C "$repo" rev-parse --verify --quiet "refs/remotes/origin/$basebr^{commit}" >/dev/null; then
        baseflag="--base origin/$basebr"
        msg "$(slug_of "$d"): forking from origin/$basebr"
      else
        warn "$(slug_of "$d"): base origin/$basebr does not exist - refusing to fork from the wrong branch"
        return 1
      fi
    fi
    msg "$(slug_of "$d"): preparing worktree for $branch"
    # Shielded: this is the slow one - a full database copy - and the one worth
    # letting finish when you Ctrl-C. wt's own progress still goes to stderr and
    # straight to the user; only its stdout (the JSON) is captured.
    # shellcheck disable=SC2086
    shielded wt_in "$repo" new --no-agent --no-focus $baseflag --json "$branch" \
      || { warn "$(slug_of "$d"): wt new failed"; return 1; }
    wtjson=$SHIELDED_OUT
    pane=$(jq -r '.root_pane_id // empty' <<<"$wtjson" 2>/dev/null)
    [ -n "$pane" ] || { warn "$(slug_of "$d"): wt returned no pane"; return 1; }
    st_set "$d" PQ_WORKTREE "$(jq -r '.path // ""'         <<<"$wtjson")"
    st_set "$d" PQ_WORKSPACE "$(jq -r '.workspace_id // ""' <<<"$wtjson")"
    st_set "$d" PQ_PANE      "$pane"
    st_set "$d" PQ_DEV_PANE  "$(jq -r '.dev_pane_id // ""'  <<<"$wtjson")"
    st_set "$d" PQ_URL       "$(jq -r '.url // ""'          <<<"$wtjson")"
    st_set "$d" PQ_PORT      "$(jq -r '.port // ""'         <<<"$wtjson")"
    fresh=1
  else
    msg "$(slug_of "$d"): worktree already prepared, resuming at the agent"
  fi

  # The contract, once, before the agent starts - the prompt points at it, so it
  # has to be there first. Never rewritten: a re-entered dispatch finds the file
  # and leaves it, so a running agent's contract is as immutable as its plan.
  if [ ! -f "$d/contract.md" ]; then
    contract_write "$d" || { warn "$(slug_of "$d"): could not write contract.md"; return 1; }
  fi

  # Start the agent, unless one is already there. `PQ_STARTED` is the record;
  # an agent herdr already reports in the pane is the same fact reached the hard
  # way (a start that succeeded but was interrupted before it was recorded), and
  # is not started over. A pane pq created THIS call is empty by construction,
  # and is not in a snapshot taken before it existed anyway.
  if [ -z "$(st "$d" PQ_STARTED)" ]; then
    local pst=""
    [ "$fresh" = 1 ] || pst=$(pane_state "$pane")
    case "$pst" in
      noagent|missing|"")
        agent_start "$d" "$pane" "${model:-$PQ_DEFAULT_MODEL}" "${effort:-$PQ_DEFAULT_EFFORT}" || return 1 ;;
      *) msg "$(slug_of "$d"): an agent is already in $pane - not starting another" ;;
    esac
    st_set "$d" PQ_STARTED "$(now)"
  fi

  # The prompt, as one argv element. A refusal leaves PQ_LAUNCHED empty, which is
  # what the resume path in tick_body already retries - so an agent that came up
  # blocked on a dialog gets its prompt on the first tick after the dialog goes.
  prompt=$(dispatch_prompt "$(task_home "$d")" "$basebr")
  local code rc
  code=$(agent_prompt "$pane" "$prompt"); rc=$?
  if [ "$rc" != 0 ]; then
    warn "$(slug_of "$d"): could not deliver the prompt to $pane ($code) - the next tick will retry"
    return 1
  fi
  st_set "$d" PQ_LAUNCHED "$(now)"
  msg "$(slug_of "$d"): running ${model:-$PQ_DEFAULT_MODEL}/${effort:-$PQ_DEFAULT_EFFORT} in $pane"
  return 0
}

# ── review gate ─────────────────────────────────────────────────────────────
# Every pull request a task opens gets one independent review before the
# implementer may call it ready - run BY pq, not asked of the agent. The agent
# cannot run `/code-review` itself (the skill is reserved for a human typing it,
# see dispatch_prompt), and its contract has it open the pull request as a DRAFT
# and wait. This section is what happens next: once the agent has gone quiet,
# pq runs `claude -p "/code-review N --comment"` in the background, in the
# worktree, which posts inline review comments on the pull request; when that
# finishes, pq prompts the implementer to resolve every comment and mark the
# draft ready. Nobody reviews the review. The point is that a second pair of
# eyes has been over the diff, and that the first pair had to answer them,
# before Tom reads either.
#
# A state machine on PQ_REVIEW, one step per tick per task, so a tick never
# blocks on it:
#
#   (unset)   a task from before the gate existed - never touched
#   pending   reconcile stamped it: a PR exists and no reviewer has run. Waits
#             for the agent to stop working, probes the PR once (title, draft,
#             size), then launches - or skips a STUCK: title outright
#   running   the reviewer is a background process group of its own; its exit
#             code lands in review.rc and is collected on a later tick. Bounded
#             by PQ_REVIEW_TIMEOUT, then killed
#   posted    the reviewer finished. PQ_REVIEW_RESULT says how - `ok`, or
#             `failed` / `timeout` / `denied`, for which the follow-up asks for a
#             self-review instead. Waits for the agent to be promptable, then
#             delivers
#   prompted  the follow-up is with the implementer. Ends when the PR stops
#             being a draft
#   ready     it did - the gate is over
#   lapsed    nobody is going to mark it ready: the agent is gone, or sat idle
#             past the grace with the draft still open. Warned once; it wants you
#   skipped   never applied - the PR settled first, or was opened STUCK
#
# "In flight" is pending|running|posted, and a task in flight holds its slot with
# no clock (see slot_held): the implementer is idle because it is WAITING, and
# handing its slot away would start a fresh agent beside one about to be told to
# fix things. `prompted` is not in flight - the agent owns its PR again and the
# ordinary wrap-up grace applies. The hold is bounded by the gate's own bounds:
# MAX_TRIES x (TIMEOUT + RETRY) at the very worst, about two hours twenty, then
# the fallback prompt. A security reviewer runs to the same bound beside it, but
# can only start once the gate's probe has passed, so probes that fail first add
# up to MAX_TRIES x RETRY on top - two hours forty at the very worst.
# `PQ_WRAPUP_GRACE=0` therefore no longer means release-on-PR for a gated task;
# it means release once the gate is through.
#
# "Settled" is everything else, an unset key included, so a task from before the
# gate reads exactly as it did - `blocker_state`'s stalled verdict rests on it.
#
# Failure is loud, once, and falls back rather than blocking: a reviewer that
# errors is retried on a backoff and then given up on, and the implementer is
# told to review its own diff instead - the pull request still gets marked ready,
# and `pq ls` says the review was not independent. A permission denial on the
# posting path is never retried (it cannot succeed until PQ_REVIEW_TOOLS changes)
# but is reported the same way, loudly, on the first task it happens to.
#
# The reviewer is launched, not `shielded`: shielded waits, and a tick must never
# block for up to an hour. Everything needed to collect it is on disk - review.rc
# for the exit code, review.json for the output - so a `pq run` stopped with
# Ctrl-C leaves the reviewer alone and a later tick, from any pq process, finishes
# the job. Liveness is the PROCESS GROUP, not the pid: the pid on file is the
# group leader, and a recycled pid is almost never a group leader too, so a
# stranger is neither counted alive nor killed.
#
# THE SECURITY REVIEWER. A plan can ask for a security review too - plans say
# "run /security-review" in so many words, and say what it should focus on - and
# name_plan reads that into a `security: yes` header at add time. Such a task gets
# a second reviewer beside the first: `claude -p "/security-review"`, in the same
# worktree, on the same knobs and the same read-only rules. The implementer could
# no more run it than /code-review, and its contract tells it not to try. The
# skill takes no target and posts nothing - it reviews `git diff origin/HEAD...`
# of wherever it runs and replies with a markdown report - so pq delivers: the
# report is saved as security.md, posted on the pull request as one comment to be
# read beside the inline ones, and pointed at in the implementer's follow-up.
#
# Its own ladder, on PQ_SECURITY, with the code reviewer's keys and files
# (PQ_REVIEW_*, review.*) left exactly as they were, so a task mid-review when
# this arrived reads as it did:
#
#   (unset)   not asked for - every task from before, and most since
#   pending   reconcile stamped it beside the gate. Launches once the gate is
#             `running` or `posted` - the gate's probe has passed, so the pull
#             request is neither STUCK nor settled, and it is not probed again -
#             on the same readiness as the code reviewer, so both go out on the
#             same tick; retried on the same backoff
#   running   a background process group, collected from security.rc
#   done      finished. PQ_SECURITY_RESULT is `ok`, or `failed` / `timeout`, for
#             which the follow-up asks for a security self-review instead, and
#             PQ_SECURITY_POSTED says whether the report reached the PR
#   skipped   stopped with the gate - the PR was STUCK or settled
#
# The two meet at one point: the gate's `posted` step sends nothing while the
# security reviewer is pending or running, so the implementer is told once,
# about both, and the slot stays held until then. So a pending|running
# PQ_SECURITY only ever sits beside a gate that is in flight, and every way the
# gate ends early ends it too - except an agent that has gone, where a security
# review under way is let finish first: its report lands on the pull request,
# and resolving it is yours then.

review_inflight() {                     # task_dir -> 0 while the gate holds the slot
  case "$(st "$1" PQ_REVIEW)" in pending|running|posted) return 0 ;; esac
  return 1
}
review_settled() {                      # task_dir -> 0 when the gate is over, or never applied
  case "$(st "$1" PQ_REVIEW)" in ""|ready|lapsed|skipped) return 0 ;; esac
  return 1
}
review_alive() {                        # pid (a process group id)
  [ -n "${1:-}" ] || return 1
  pgrep -g "$1" >/dev/null 2>&1
}

# The git verbs no reviewer may run: the ones that discard the implementer's
# uncommitted work or write over its branch. Shared by review_cmd and
# security_cmd - see the deny rules below for why each is there.
REVIEWER_GIT_DENY=("Bash(git checkout:*)" "Bash(git switch:*)" "Bash(git restore:*)" "Bash(git reset:*)"
                   "Bash(git stash:*)" "Bash(git clean:*)" "Bash(git commit:*)" "Bash(git push:*)")

# The reviewer itself, one swappable function. `-p` with the skill typed as the
# user's own prompt: the model may not invoke /code-review, but the user may,
# and in `-p` the prompt IS the user - verified against a real pull request,
# which came back with eleven inline comments.
#
# PQ_REVIEW_EFFORT is passed twice, as the session's `--effort` and as the
# skill's own level argument. ARGUMENT ORDER IS LOAD-BEARING for the second one:
# the skill takes the level as the FIRST non-flag token and everything after it
# as the target, so `/code-review <level> --comment <pr>` and never the other
# way round. Its usage string says as much - `[low|medium|high|xhigh|max]
# [--fix] [--comment] [<pr#>|<branch>|<path>]` - and the parser behind it takes
# the first token, tries to read it as a level, and on failure treats the WHOLE
# remainder as the target and silently falls back to `codeReviewLastEffort` in
# ~/.claude.json, the level last typed at an interactive prompt.
#
# This used to send the pull request first, which lost both halves: the level
# was ignored, and the target became the string "42 xhigh" rather than "42".
# That is what "Reusing xhigh effort (the level you typed last)" at the top of
# every early transcript was saying, and it read as harmless because the level
# last typed on this machine happened to be xhigh too.
#
# `--comment`, `--fix`, `--post` and `--no-post` are stripped from anywhere in
# the string before the level is read, so only the level and the target are
# order-sensitive.
#
# It asks for `xhigh`, which is what the implementer and the splitter already
# run at (PQ_DEFAULT_EFFORT, PQ_SPLITTER_EFFORT). The reviewer reads a diff it
# did not write, against a plan and a design it has to go and find, and is the
# only pass before Tom - it is the last place to economise.
#
# The reviewer is read-only apart from what it posts, and that is enforced by
# deny rules, not by the permission mode, because no mode means it. acceptEdits,
# which this ran under first, is the one that PRE-APPROVES edits: measured in
# `-p` with the old allowlist, it edited a file, created one and threw an edit
# away with `git checkout --`, and was denied nothing. Deny rules win over allow
# rules and over the classifier in every mode, so:
#
#   Edit(/$HOME/**)   no Edit, Write or NotebookEdit anywhere under the home
#                     directory - the worktree, the task directory, every other
#                     repo (`//` is how a rule spells an absolute path). The
#                     payload the skill stages before posting goes to a new file
#                     in a `mktemp -d` directory instead; review_brief says so,
#                     or the reviewer would learn it by being refused, and
#                     review_collect would warn about that on every review. A
#                     directory, not `mktemp` itself: Write refuses to fill a
#                     file that exists and has not been read, which is what
#                     `mktemp` hands back
#   gh pr ready|merge|close
#                     the implementer marks the draft ready once it has answered
#                     the review, and a reviewer doing it would end the gate with
#                     nothing resolved. Best-effort, as prefix rules are: `gh api`
#                     reaches the same endpoints
#   git checkout|switch|restore|reset|stash|clean|commit|push
#                     the worktree is the implementer's, uncommitted work and
#                     all, and these are the verbs that discard it or write over
#                     its branch. Best-effort the same way (`git -C . checkout`
#                     slips past a prefix); what they miss is auto's to judge
#
# Everything else is `--permission-mode auto`, the mode the implementer already
# runs in - it gets it from `defaultMode` in settings.json; this passes it
# explicitly because the reviewer used to override it. A reviewer explores with
# Bash, and under acceptEdits in `-p` there is nobody to approve a command off
# the allowlist. The first review of a real feature was refused seven read-only
# commands, and sent its two most serious findings out unverified because the
# gem source that would have settled them was out of reach. A longer allowlist
# does not fix that: replayed under acceptEdits with gh, git, wt, bundle, find,
# tail, ls, grep, sed, head and cat all allowed, all seven were refused again -
# for a `$(...)`, a `$PATH` expansion, an env-var prefix and paths outside the
# working directories, none of which an allow rule reaches. Under auto all seven
# ran. Not bypassPermissions: the reviewer runs unattended, with `gh` write
# access, reading text another agent wrote, and auto still stops what it was
# never asked to do.
#
# `--allowedTools` is `gh` alone (PQ_REVIEW_TOOLS): posting is the reviewer's
# whole output, so a rule allows it rather than the classifier's judgement.
# `git` used to be there too, and a blanket `git` rule is exactly what let
# `git checkout --` through unjudged; under auto the reads need no rule.
#
# `--append-system-prompt` carries what the skill's prompt cannot - everything
# after the level is the target - see review_brief.
#
# `--add-dir` opens the task's own directory (through its stable path) to the
# reviewer: the plan, the contract, the design files and the evidence. The first
# real review reached for the design file to check the change against it and was
# refused, because the task directory is outside the worktree it runs in - and a
# reviewer that can see what the change was built to is a better reviewer.
review_cmd() {                          # pr task_home
  headless_claude -p --model "$PQ_REVIEWER_MODEL" --effort "$PQ_REVIEW_EFFORT" \
    --permission-mode auto --allowedTools "$PQ_REVIEW_TOOLS" \
    --disallowedTools "Edit(/$HOME/**)" "Bash(gh pr ready:*)" "Bash(gh pr merge:*)" "Bash(gh pr close:*)" \
      "${REVIEWER_GIT_DENY[@]}" \
    --append-system-prompt "$(review_brief "$1")" \
    --add-dir "$2" \
    --output-format json "/code-review $PQ_REVIEW_EFFORT --comment $1"
}

# What the reviewer is told beside the skill: what it may touch, where its
# scratch goes, and how to run anything in the worktree. One line, and
# quote-free by the same convention as dispatch_prompt. The `wt` clause is there
# because the reviewer inherits `pq run`'s environment, not the worktree's: a
# bare `bundle exec rspec` from it lands on the machine's shared test database,
# which is where the cross-branch deadlocks in the README came from, while
# `wt run` and `wt test` find this worktree's own from the directory they run in.
review_brief() {                        # pr
  printf '%s' "You are reviewing pull request #$1 from inside the worktree of the agent that wrote it, which is still working there. Your only output is the review you post on the pull request. Change nothing else: no file edits, no commits, no checkouts, no pushes, and do not mark the pull request ready, merge it or close it - its author does that once it has answered your review. Write the review payload, and any other scratch file, as a new file inside a directory made with \`mktemp -d\`, never inside the worktree. This worktree has its own databases, ports and environment: run project commands through \`wt run <cmd>\`, and anything that runs in the test environment, such as specs, through \`wt test <cmd>\` - only the specs a finding needs. A bare \`bundle exec\` or \`bin/rails\` uses the shared databases of the whole machine instead."
}

# The security reviewer, one swappable function like review_cmd and read-only
# by the same deny rules - with `gh` denied outright rather than in part, since
# posting is pq's job here (see security_post). No --allowedTools: auto mode
# judges the reads, and the skill's own frontmatter allows the `git diff`, `git
# log` and `git show` it opens with. The skill takes no level and no target, so
# `--effort` is the only way PQ_REVIEW_EFFORT reaches it, and the brief the only
# way the pull request's base does.
#
# Run against scratch repositories before it shipped, exactly as below. A change
# with a SQL injection and two cross-tenant reads came back with all three, at
# confidence 9 and 10, in 167s for $1.12; a clean one came back with none; and
# one forked from an integration branch that carried a command injection of its
# own was shown the whole integration branch by the skill, went by the brief's
# `git diff origin/<base>...HEAD` instead, and left the base's injection out of
# scope. None was denied anything, and none touched its worktree.
security_cmd() {                        # pr task_home base
  headless_claude -p --model "$PQ_REVIEWER_MODEL" --effort "$PQ_REVIEW_EFFORT" \
    --permission-mode auto \
    --disallowedTools "Edit(/$HOME/**)" "Bash(gh:*)" "${REVIEWER_GIT_DENY[@]}" \
    --append-system-prompt "$(security_brief "$1" "$2" "$3")" \
    --add-dir "$2" \
    --output-format json "/security-review"
}

# What the security reviewer is told beside the skill. The base is named because
# the skill diffs against origin/HEAD - the repository default, whatever the pull
# request is aimed at - so a task on an integration branch would otherwise be
# reviewed as the whole integration branch. It is named for a default-branch
# task too, so a worktree whose origin/HEAD was never set up still has the right
# command. The plan is pointed at because it says why it asked and what to look
# at, and the `wt` clause is review_brief's: the spike's reviewers ran code to
# check a finding, and in a Rails worktree that means a database. One line, and
# quote-free by the same convention as dispatch_prompt.
security_brief() {                      # pr task_home base
  local basec=""
  [ -n "${3:-}" ] && basec=" The pull request is against $3, so the change under review is exactly \`git diff origin/$3...HEAD\`: where the diff shown to you differs from that, review what that command shows and nothing else."
  printf '%s' "You are running a security review of pull request #$1 from inside the worktree of the agent that wrote it, which is still working there.$basec The plan the change was built from is $2/plan.md, and it says why it asked for this review and what to focus on. Your only output is your final reply, the markdown report: pq posts it on the pull request and hands it to the author. Change nothing: no file edits, no commits, no checkouts, no pushes, and no gh. Write any scratch file as a new file inside a directory made with \`mktemp -d\`, never inside the worktree. This worktree has its own databases, ports and environment: run project commands through \`wt run <cmd>\`, and anything that runs in the test environment, such as specs, through \`wt test <cmd>\`. A bare \`bundle exec\` or \`bin/rails\` uses the shared databases of the whole machine instead."
}

# One `gh` call, right before launching: is this a STUCK pull request, and is it
# one commit big enough to want restructuring? Tabs and newlines in a title are
# squeezed so the TSV stays one line.
review_probe() {                        # repo pr -> title<TAB>state<TAB>draft|open<TAB>commits<TAB>changed
  local raw
  raw=$(cd "$1" 2>/dev/null && gh pr view "$2" --json title,state,isDraft,commits,additions,deletions 2>/dev/null) || return 1
  jq -er '[(.title | gsub("[\t\n]"; " ")), .state, (if .isDraft then "draft" else "open" end),
           (.commits | length | tostring), ((.additions + .deletions) | tostring)] | @tsv' <<<"$raw" 2>/dev/null
}

# How many inline review comments the pull request carries. Read once at launch
# and once at collection, because the difference is the only honest answer to
# "did the review post anything": the reviewer's JSON says what it was denied,
# not what it managed. Empty when gh cannot say.
review_comments() {                     # repo pr -> count, or nothing
  (cd "$1" 2>/dev/null && gh api "repos/{owner}/{repo}/pulls/$2/comments" --jq 'length' 2>/dev/null) | tr -dc '0-9'
}

# What a reviewer's ladder is keyed on in state.env: PQ_REVIEW for the code
# reviewer (whose ladder is the gate itself), PQ_SECURITY for the security one,
# each with its _PID, _AT, _TRIES, _RESULT and _RETRY_AT beside it. The STEM
# names its files: review.json, review.err, review.rc - or security.*.
reviewer_key() {                        # stem -> state.env key
  case "$1" in review) printf 'PQ_REVIEW' ;; security) printf 'PQ_SECURITY' ;; esac
}

reviewer_launch() {                     # task_dir stem cwd cmd...
  local d=$1 stem=$2 cwd=$3 key pid
  shift 3
  key=$(reviewer_key "$stem")
  rm -f "$d/$stem.rc" "$d/$stem.json" "$d/$stem.err" "$d/$stem.md" "$d/$stem".*.tmp
  # Job control puts the subshell in a process group of its own, as `shielded`
  # does - but nobody waits on this one. HUP and INT are ignored so the reviewer
  # survives the pq that launched it going away; TERM is not, because that is
  # how reviewer_kill stops it. Every result file is written to a .tmp and moved,
  # and the .rc last, so its presence means the rest is complete.
  #
  # The SUBSHELL's own three descriptors are detached too, not just the
  # reviewer's inside it. stdin, or a background group reading the terminal
  # would be stopped with SIGTTIN; stdout and stderr, because whatever launched
  # this tick may be reading them through a pipe - `out=$(pq tick)` - and a pipe
  # stays open until its last writer exits. Measured: a monitor capturing the
  # tick's output hung for the whole review, twenty minutes, and reported the
  # launch only when the reviewer finished.
  set -m
  (
    trap '' HUP INT
    rc=1
    if cd "$cwd" 2>/dev/null; then
      "$@" > "$d/$stem.json.tmp" 2> "$d/$stem.err.tmp"; rc=$?
    else
      : > "$d/$stem.json.tmp"
      printf 'no such directory: %s\n' "$cwd" > "$d/$stem.err.tmp"
    fi
    mv -f "$d/$stem.json.tmp" "$d/$stem.json" 2>/dev/null
    mv -f "$d/$stem.err.tmp"  "$d/$stem.err"  2>/dev/null
    printf '%s' "$rc" > "$d/$stem.rc.tmp" && mv -f "$d/$stem.rc.tmp" "$d/$stem.rc"
  ) < /dev/null > /dev/null 2>&1 &
  pid=$!
  set +m
  disown "$pid" 2>/dev/null || true
  st_set "$d" "${key}_PID" "$pid"
  st_set "$d" "${key}_AT" "$(epoch)"
  st_set "$d" "$key" running
}

reviewer_kill() {                       # task_dir stem
  local d=$1 stem=$2 pid; pid=$(st "$d" "$(reviewer_key "$stem")_PID")
  if [ -n "$pid" ] && review_alive "$pid"; then
    kill -TERM -- "-$pid" 2>/dev/null || pkill -TERM -g "$pid" 2>/dev/null || true
  fi
  rm -f "$d/$stem".*.tmp
  return 0
}

# Every reviewer the task still has running, which is what a settled pull
# request and `pq rm` both want - neither cares which one it was.
review_kill() {                         # task_dir
  [ "$(st "$1" PQ_REVIEW)" = running ]   && reviewer_kill "$1" review
  [ "$(st "$1" PQ_SECURITY)" = running ] && reviewer_kill "$1" security
  return 0
}

# What a finished reviewer amounts to. `denied` means the review could not post:
# a `gh` command was refused AND the pull request has no more inline comments
# than it had at launch - the one failure a retry cannot fix, since it will be
# refused the same way until PQ_REVIEW_TOOLS changes. A `gh` refusal with
# comments landing anyway is a reviewer that got its job done and was then
# stopped from, say, editing one of its own comments - worth a warning, still
# a review. The spike that verified the command saw exactly that: 25 denials
# (gem sources read outside the worktree, `ruby`, `bundle`, one `gh api -X
# PATCH`) and eleven comments posted.
review_collect() {                      # task_dir -> ok | failed | denied
  local d=$1 rc is_error gh_denied other before after
  rc=$(cat "$d/review.rc" 2>/dev/null)
  is_error=$(jq -r 'if type == "object" then ((.is_error // false) | tostring) else "malformed" end' \
               "$d/review.json" 2>/dev/null) || is_error=malformed
  gh_denied=$(jq -r '[.permission_denials[]? | select(.tool_name == "Bash"
                and ((.tool_input.command // "") | test("(^|[;&| ])gh( |$)")))] | length' \
                "$d/review.json" 2>/dev/null) || gh_denied=0
  other=$(jq -r '[.permission_denials[]?] | length' "$d/review.json" 2>/dev/null) || other=0
  if [ "$rc" = 0 ] && [ "$is_error" = false ]; then
    if [ "${gh_denied:-0}" != 0 ]; then
      before=$(st "$d" PQ_REVIEW_COMMENTS)
      after=$(review_comments "$(hdr "$d/plan.md" repo)" "$(st "$d" PQ_PR)")
      if [ -n "$before" ] && [ -n "$after" ] && [ "$after" -le "$before" ]; then
        printf 'denied'; return
      fi
    fi
    [ "${other:-0}" = 0 ] || warn "$(slug_of "$d"): the reviewer reached for things it was denied ($other denials, $gh_denied of them gh) - see $d/review.json"
    printf 'ok'; return
  fi
  printf 'failed'
}

# A try that did not produce a review: back to `pending` on a backoff while
# there are tries left, else the reviewer's finished state - `posted` for the
# code reviewer, `done` for the security one - with the failure as its result,
# which is what routes the follow-up to the self-review text. The tries count
# launches and probes alike, and the caller has already counted this one.
reviewer_try_failed() {                 # task_dir stem result why
  local d=$1 stem=$2 result=$3 why=$4 key noun final slug tries
  key=$(reviewer_key "$stem")
  case "$stem" in review) noun=review; final=posted ;; *) noun="security review"; final="done" ;; esac
  slug=$(slug_of "$d"); tries=$(st "$d" "${key}_TRIES"); tries=${tries:-0}
  st_set "$d" "${key}_RESULT" "$result"
  if [ "$tries" -lt "$PQ_REVIEW_MAX_TRIES" ]; then
    st_set "$d" "$key" pending
    st_set "$d" "${key}_RETRY_AT" "$(( $(epoch) + PQ_REVIEW_RETRY ))"
    warn "$slug: $noun attempt $tries failed - $why; retrying in $(( PQ_REVIEW_RETRY / 60 ))m"
  else
    st_set "$d" "$key" "$final"
    warn "$slug: $noun failed after $tries attempt(s) - $why; the implementer will be asked to self-review instead"
  fi
}

# What a finished security reviewer amounts to: `ok` when it exited cleanly with
# a report, `failed` otherwise. It never posts, so unlike review_collect there
# is no `denied` - a denial is only ever warned about.
security_collect() {                    # task_dir -> ok | failed
  local d=$1 rc is_error report denied
  rc=$(cat "$d/security.rc" 2>/dev/null)
  is_error=$(jq -r 'if type == "object" then ((.is_error // false) | tostring) else "malformed" end' \
               "$d/security.json" 2>/dev/null) || is_error=malformed
  report=$(jq -r 'if type == "object" then (.result // "" | tostring) else "" end' "$d/security.json" 2>/dev/null)
  denied=$(jq -r '[.permission_denials[]?] | length' "$d/security.json" 2>/dev/null) || denied=0
  if [ "$rc" = 0 ] && [ "$is_error" = false ] && [ -n "$(tr -d '[:space:]' <<<"$report")" ]; then
    [ "${denied:-0}" = 0 ] || warn "$(slug_of "$d"): the security reviewer reached for things it was denied ($denied denials) - see $d/security.json"
    printf 'ok'; return
  fi
  printf 'failed'
}

# The report goes on the pull request as one comment, so it is read beside the
# inline code review rather than by the implementer alone. pq posts it because
# the skill posts nothing, and one `gh` call pq makes is more certain than asking
# a model to make it. A comment that does not land is not a failed review: the
# report is on disk, and the follow-up asks the implementer to post it instead.
security_post() {                       # task_dir repo pr -> 0 posted
  local d=$1 repo=$2 pr=$3 body="$1/.security-comment.$$" rc
  # shellcheck disable=SC2016  # the backticks are markdown, not a substitution
  { printf '_An independent `/security-review` of this pull request, run by pq because its plan asked for one._\n\n'
    cat "$d/security.md"; } > "$body" 2>/dev/null || { rm -f "$body"; return 1; }
  (cd "$repo" 2>/dev/null && gh pr comment "$pr" --body-file "$body") >/dev/null 2>&1; rc=$?
  rm -f "$body"
  return "$rc"
}

# Stopped with the gate, and killed first if it is running.
security_skip() {                       # task_dir why
  case "$(st "$1" PQ_SECURITY)" in pending|running) ;; *) return 0 ;; esac
  [ "$(st "$1" PQ_SECURITY)" = running ] && reviewer_kill "$1" security
  st_set "$1" PQ_SECURITY skipped; st_set "$1" PQ_SECURITY_WHY "$2"
}

# The follow-up the implementer is sent. Quote-free by the same convention as
# dispatch_prompt. The restructure clause is added only when the probe found one
# commit over PQ_REVIEW_SPLIT_LINES changed lines: the commits are how the PR
# gets read, and one blob is the shape this whole change exists to stop.
#
# The security clause is added only for a task whose security reviewer ran to
# `done`, so a task that never asked for one gets, byte for byte, the prompt it
# always got. It sits between the code review's text and the restructure clause,
# and reads the same after either of the code review's two openings.
review_prompt() {                       # pr result split lines base [security_result security_posted report]
  local pr=$1 result=$2 split=${3:-} lines=${4:-} base=${5:-} splitc="" why text
  local sec=${6:-} sposted=${7:-} report=${8:-} secc="" swhy
  case "$sec" in
    "") ;;
    ok)
      if [ "$sposted" = 1 ]; then
        secc="The security review the plan asked for has run as well, and its report is posted on the pull request and saved in $report. "
      else
        secc="The security review the plan asked for has run as well, and its report is in $report - pq could not post it on the pull request, so post it there yourself with gh pr comment $pr --body-file $report. "
      fi
      secc="${secc}Resolve every finding it raises: fix it and push, or answer it in a comment on the pull request with why it is not exploitable. " ;;
    *)
      case "$sec" in
        timeout) swhy="the security reviewer ran out of time" ;;
        *)       swhy="the security reviewer exited with an error" ;;
      esac
      secc="The security review the plan asked for did not happen - $swhy. \
Review your own diff for the security risks the plan names, fix and push, and say in a comment on \
the pull request what you checked. " ;;
  esac
  [ "$split" = 1 ] && splitc="The pull request is a single commit of $lines changed lines. \
Before marking it ready, restructure the branch into small logical commits, each coherent \
on its own with a message saying why, and push with --force-with-lease. "
  local tail="Then, if the pull request is still a draft, mark it ready with gh pr ready $pr. \
If you opened it because you were stuck, do not mark it ready; answer what you can and stop. \
Never wait for input - there is nobody watching."
  case "$result" in
    ok)
      text="pq has finished an independent review of pull request #$pr and posted its findings \
as inline review comments. Read every one (gh api repos/{owner}/{repo}/pulls/$pr/comments) and \
resolve each: fix it and push, or reply on that thread with the reasoning for leaving it. \
Leave no comment unanswered. ${secc}${splitc}${tail}" ;;
    *)
      case "$result" in
        timeout) why="the reviewer ran out of time" ;;
        denied)  why="the reviewer was denied permission to post" ;;
        *)       why="the reviewer exited with an error" ;;
      esac
      text="pq could not get an independent review of pull request #$pr - $why. \
Review your own diff as a stranger would (git diff origin/${base:-HEAD}...HEAD) for bugs, \
missing tests and what the plan did not anticipate; fix and push. ${secc}${splitc}${tail}" ;;
  esac
  printf '%s' "$text"
}

# One task, one step. Every write is gated on `dry` at its own site, as reap_task
# does, because which `would ...` applies depends on state computed first.
#
# One step for the GATE, that is: the code reviewer's ladder never moves twice in
# one call. The security reviewer takes its own step in the same call - after the
# gate's while the gate is pending or running, so the two launch on the same
# tick, and before it at `posted`, so a security review that finishes last has
# its follow-up sent on the tick it finishes.
review_task() {                         # task_dir dry
  local d=$1 dry=$2 state slug repo branch pr num prstate draft pstate nowsec settled=0
  state=$(st "$d" PQ_REVIEW)
  case "$state" in pending|running|posted|prompted) ;; *) return 0 ;; esac
  slug=$(slug_of "$d"); repo=$(hdr "$d/plan.md" repo); branch=$(hdr "$d/plan.md" branch)
  nowsec=$(epoch)
  num=""; prstate=""; draft=""
  IFS=$'\t' read -r num prstate draft <<<"$(pr_get "$repo" "$branch")"
  pr=$(st "$d" PQ_PR); [ -n "$pr" ] || pr=${num:-}
  case "${prstate:-}" in MERGED|CLOSED) settled=1 ;; esac
  pstate=$(pane_state "$(st "$d" PQ_PANE)")

  # A settled row outranks everything in every state but `prompted`, which has
  # its own reading of a merge below: the verdict is in, reap is next in this
  # very tick, and a reviewer still running would be working in a workspace
  # about to be closed under it - either reviewer.
  if [ "$settled" = 1 ] && [ "$state" != prompted ]; then
    [ "$dry" = 1 ] && { msg "would skip $slug's review - #$pr has settled"; return 0; }
    review_kill "$d"
    st_set "$d" PQ_REVIEW skipped; st_set "$d" PQ_REVIEW_WHY settled
    security_skip "$d" settled
    msg "$slug: review skipped - #$pr has settled"
    return 0
  fi

  case "$state" in
    pending|running)
      review_step "$d" "$dry" "$pr" "$pstate"
      security_step "$d" "$dry" "$pr" "$pstate"
      ;;
    posted)
      security_step "$d" "$dry" "$pr" "$pstate"
      case "$pstate" in
        noagent|missing)
          # A security review still to finish is let finish: its report lands
          # on the pull request, which is where you will be resolving it now.
          case "$(st "$d" PQ_SECURITY)" in pending|running) return 0 ;; esac
          [ "$dry" = 1 ] && { msg "would mark $slug's review lapsed - its agent is gone"; return 0; }
          st_set "$d" PQ_REVIEW lapsed; st_set "$d" PQ_REVIEW_WHY noagent
          warn "$slug: review posted on #$pr, but its agent is gone - resolve the comments yourself and mark it ready"
          return 0 ;;
        idle|done|unknown) ;;
        *) return 0 ;;                  # working, blocked, or herdr silent
      esac
      [ -n "$(st "$d" PQ_BLOCKED)" ] && return 0
      # One follow-up, about both reviews - so not while the security reviewer
      # the plan asked for is yet to launch, or still running.
      case "$(st "$d" PQ_SECURITY)" in pending|running) return 0 ;; esac
      [ "$dry" = 1 ] && { msg "would prompt $slug to resolve the review of #$pr"; return 0; }
      local text result base code rc sec=""
      result=$(st "$d" PQ_REVIEW_RESULT); base=$(task_base "$d")
      [ "$(st "$d" PQ_SECURITY)" = "done" ] && sec=$(st "$d" PQ_SECURITY_RESULT)
      text=$(review_prompt "$pr" "${result:-failed}" "$(st "$d" PQ_REVIEW_SPLIT)" "$(st "$d" PQ_REVIEW_LINES)" "$base" \
               "$sec" "$(st "$d" PQ_SECURITY_POSTED)" "$(task_home "$d")/security.md")
      code=$(agent_prompt "$(st "$d" PQ_PANE)" "$text"); rc=$?
      case "$rc" in
        0)
          st_set "$d" PQ_REVIEW prompted; st_set "$d" PQ_REVIEW_PROMPTED "$(now)"; st_set "$d" PQ_REVIEW_WAIT ""
          # This tick's snapshot predates the prompt and still reads idle, so a
          # wrap-up clock started under the hold would release the slot moments
          # after the agent was handed more work.
          [ -z "$(st "$d" PQ_WRAPUP_SINCE)" ] || st_set "$d" PQ_WRAPUP_SINCE ""
          msg "$slug: asked to resolve the review of #$pr and mark it ready" ;;
        2)
          # The existing `permission` handling is not fought: the prompt goes on
          # the first tick after you answer the dialog.
          [ "$(st "$d" PQ_REVIEW_WAIT)" = blocked ] || { st_set "$d" PQ_REVIEW_WAIT blocked
            msg "$slug: the agent is on a dialog - the review follow-up waits for you to answer it"; } ;;
        *)
          [ "$(st "$d" PQ_REVIEW_WAIT)" = error ] || { st_set "$d" PQ_REVIEW_WAIT error
            warn "$slug: could not deliver the review follow-up ($code) - retrying each tick"; } ;;
      esac
      ;;
    prompted)
      case "${prstate:-}" in
        OPEN)
          if [ -z "${draft:-}" ]; then
            [ "$dry" = 1 ] && { msg "would close $slug's review gate - #$pr is no longer a draft"; return 0; }
            st_set "$d" PQ_REVIEW ready; st_set "$d" PQ_REVIEW_WAIT ""
            msg "$slug: #$pr marked ready - the review gate is done"
            return 0
          fi ;;
        MERGED)
          # Merged from the draft, or marked ready and merged between two ticks:
          # either way the work shipped, which is what ready meant.
          [ "$dry" = 1 ] && return 0
          st_set "$d" PQ_REVIEW ready; return 0 ;;
        CLOSED)
          [ "$dry" = 1 ] && return 0
          st_set "$d" PQ_REVIEW skipped; st_set "$d" PQ_REVIEW_WHY settled; return 0 ;;
        *) return 0 ;;                  # no row this tick - nothing to judge
      esac
      # Still a draft.
      case "$pstate" in
        noagent|missing)
          [ "$dry" = 1 ] && return 0
          st_set "$d" PQ_REVIEW lapsed; st_set "$d" PQ_REVIEW_WHY noagent
          warn "$slug: #$pr is still a draft and its agent is gone - look at it" ;;
        idle|done)
          # The ordinary wrap-up clock, read rather than kept twice: past the
          # grace, the slot is going anyway, and the draft is nobody's now.
          local since; since=$(epoch_of "$(st "$d" PQ_WRAPUP_SINCE)")
          if [ -n "$since" ] && [ $(( nowsec - since )) -ge "$PQ_WRAPUP_GRACE" ]; then
            [ "$dry" = 1 ] && return 0
            st_set "$d" PQ_REVIEW lapsed; st_set "$d" PQ_REVIEW_WHY idle
            warn "$slug: asked to mark #$pr ready, but it is still a draft and the agent has gone quiet - look at it"
          fi ;;
      esac
      ;;
  esac
  return 0
}

# The code reviewer's step while the gate is pending or running - the gate's
# own ladder, as it was before the security reviewer joined it.
review_step() {                         # task_dir dry pr pstate
  local d=$1 dry=$2 pr=$3 pstate=$4 state slug repo tries nowsec
  state=$(st "$d" PQ_REVIEW)
  slug=$(slug_of "$d"); repo=$(hdr "$d/plan.md" repo)
  nowsec=$(epoch)
  tries=$(st "$d" PQ_REVIEW_TRIES); tries=${tries:-0}
  case "$state" in
    pending)
      [ -n "$pr" ] || return 0
      # Not while the agent is still going or blocked; not behind a wall pq has
      # dismissed, which reads idle to herdr and only PQ_BLOCKED says otherwise;
      # not while herdr is silent; not inside a retry backoff.
      [ -n "$(st "$d" PQ_BLOCKED)" ] && return 0
      case "$pstate" in working|blocked|"") return 0 ;; esac
      local at; at=$(st "$d" PQ_REVIEW_RETRY_AT)
      [ -n "$at" ] && [ "$nowsec" -lt "$at" ] && return 0
      if [ "$PQ_REVIEW_MAX_TRIES" = 0 ]; then
        [ "$dry" = 1 ] && { msg "would send $slug straight to self-review (PQ_REVIEW_MAX_TRIES=0)"; return 0; }
        st_set "$d" PQ_REVIEW posted; st_set "$d" PQ_REVIEW_RESULT failed
        return 0
      fi
      [ "$dry" = 1 ] && { msg "would probe #$pr and launch a review of $slug"; return 0; }
      local probe title pstate2 ncommits changed
      if ! probe=$(review_probe "$repo" "$pr"); then
        st_set "$d" PQ_REVIEW_TRIES "$((tries + 1))"
        reviewer_try_failed "$d" review failed "could not read #$pr with gh"
        return 0
      fi
      IFS=$'\t' read -r title pstate2 _ ncommits changed <<<"$probe"
      if grep -qiE "$PQ_STUCK_RE" <<<"$title"; then
        st_set "$d" PQ_REVIEW skipped; st_set "$d" PQ_REVIEW_WHY stuck
        security_skip "$d" stuck
        msg "$slug: #$pr is a STUCK pull request - not reviewing it; it wants you"
        return 0
      fi
      case "$pstate2" in
        MERGED|CLOSED)
          st_set "$d" PQ_REVIEW skipped; st_set "$d" PQ_REVIEW_WHY settled
          security_skip "$d" settled
          msg "$slug: review skipped - #$pr has settled"
          return 0 ;;
      esac
      if [ "${ncommits:-0}" = 1 ] && [ "${changed:-0}" -gt "$PQ_REVIEW_SPLIT_LINES" ]; then
        st_set "$d" PQ_REVIEW_SPLIT 1; st_set "$d" PQ_REVIEW_LINES "$changed"
      fi
      local cwd; cwd=$(st "$d" PQ_WORKTREE)
      [ -n "$cwd" ] && [ -d "$cwd" ] || cwd=$repo
      st_set "$d" PQ_REVIEW_TRIES "$((tries + 1))"
      st_set "$d" PQ_REVIEW_COMMENTS "$(review_comments "$repo" "$pr")"
      reviewer_launch "$d" review "$cwd" review_cmd "$pr" "$(task_home "$d")"
      msg "$slug: reviewing #$pr with $PQ_REVIEWER_MODEL in the background"
      ;;
    running)
      local pid; pid=$(st "$d" PQ_REVIEW_PID)
      if [ -f "$d/review.rc" ]; then
        local result; result=$(review_collect "$d")
        case "$result" in
          ok)
            [ "$dry" = 1 ] && { msg "would record $slug's review as posted"; return 0; }
            st_set "$d" PQ_REVIEW posted; st_set "$d" PQ_REVIEW_RESULT ok
            msg "$slug: review of #$pr posted$(fmt_cost "$(jq -r '.total_cost_usd // empty' "$d/review.json" 2>/dev/null)" \
                                                        "$(jq -r '.duration_ms // empty' "$d/review.json" 2>/dev/null)")" ;;
          denied)
            [ "$dry" = 1 ] && { msg "would record $slug's review as denied"; return 0; }
            st_set "$d" PQ_REVIEW posted; st_set "$d" PQ_REVIEW_RESULT denied
            warn "$slug: the reviewer was denied permission to post through gh - check PQ_REVIEW_TOOLS; falling back to self-review" ;;
          *)
            [ "$dry" = 1 ] && { msg "would count $slug's failed review as a try"; return 0; }
            reviewer_try_failed "$d" review failed "the reviewer exited $(cat "$d/review.rc" 2>/dev/null) - see $d/review.err" ;;
        esac
        return 0
      fi
      if ! review_alive "$pid"; then
        [ "$dry" = 1 ] && { msg "would count $slug's vanished reviewer as a failed try"; return 0; }
        reviewer_try_failed "$d" review failed "the reviewer process is gone without leaving an exit code"
        return 0
      fi
      local since; since=$(st "$d" PQ_REVIEW_AT); since=${since:-$nowsec}
      if [ $(( nowsec - since )) -ge "$PQ_REVIEW_TIMEOUT" ]; then
        [ "$dry" = 1 ] && { msg "would kill $slug's reviewer - over PQ_REVIEW_TIMEOUT"; return 0; }
        reviewer_kill "$d" review
        reviewer_try_failed "$d" review timeout "ran past ${PQ_REVIEW_TIMEOUT}s"
      fi
      ;;
  esac
  return 0
}

# The security reviewer's step, beside the gate's (see the section's head for
# its ladder). No probe of its own: it launches only once the gate has probed
# and launched, which is everything it needs to know about the pull request.
security_step() {                       # task_dir dry pr pstate
  local d=$1 dry=$2 pr=$3 pstate=$4 sec slug nowsec tries
  sec=$(st "$d" PQ_SECURITY)
  case "$sec" in pending|running) ;; *) return 0 ;; esac
  slug=$(slug_of "$d"); nowsec=$(epoch)
  case "$sec" in
    pending)
      case "$(st "$d" PQ_REVIEW)" in running|posted) ;; *) return 0 ;; esac
      [ -n "$(st "$d" PQ_BLOCKED)" ] && return 0
      case "$pstate" in working|blocked|"") return 0 ;; esac
      local at; at=$(st "$d" PQ_SECURITY_RETRY_AT)
      [ -n "$at" ] && [ "$nowsec" -lt "$at" ] && return 0
      if [ "$PQ_REVIEW_MAX_TRIES" = 0 ]; then
        [ "$dry" = 1 ] && { msg "would send $slug straight to a security self-review (PQ_REVIEW_MAX_TRIES=0)"; return 0; }
        st_set "$d" PQ_SECURITY "done"; st_set "$d" PQ_SECURITY_RESULT failed
        return 0
      fi
      # The skill reads the change off the worktree's own HEAD, so unlike the
      # code reviewer - which reads the pull request through gh, and can fall
      # back to the main checkout - it has nowhere else it could run.
      local cwd; cwd=$(st "$d" PQ_WORKTREE)
      if [ -z "$cwd" ] || [ ! -d "$cwd" ]; then
        [ "$dry" = 1 ] && { msg "would give up $slug's security review - its worktree is gone"; return 0; }
        st_set "$d" PQ_SECURITY "done"; st_set "$d" PQ_SECURITY_RESULT failed
        warn "$slug: no worktree to run the security review in (${cwd:-none recorded}) - the implementer will be asked to self-review instead"
        return 0
      fi
      [ "$dry" = 1 ] && { msg "would launch a security review of $slug"; return 0; }
      tries=$(st "$d" PQ_SECURITY_TRIES); tries=${tries:-0}
      st_set "$d" PQ_SECURITY_TRIES "$((tries + 1))"
      reviewer_launch "$d" security "$cwd" security_cmd "$pr" "$(task_home "$d")" "$(task_base "$d")"
      msg "$slug: security-reviewing #$pr with $PQ_REVIEWER_MODEL in the background"
      ;;
    running)
      if [ -f "$d/security.rc" ]; then
        case "$(security_collect "$d")" in
          ok)
            [ "$dry" = 1 ] && { msg "would record $slug's security review as done"; return 0; }
            jq -j '.result' "$d/security.json" > "$d/security.md" 2>/dev/null
            st_set "$d" PQ_SECURITY "done"; st_set "$d" PQ_SECURITY_RESULT ok
            local cost; cost=$(fmt_cost "$(jq -r '.total_cost_usd // empty' "$d/security.json" 2>/dev/null)" \
                                        "$(jq -r '.duration_ms // empty' "$d/security.json" 2>/dev/null)")
            if security_post "$d" "$(hdr "$d/plan.md" repo)" "$pr"; then
              st_set "$d" PQ_SECURITY_POSTED 1
              msg "$slug: security review of #$pr posted$cost"
            else
              st_set "$d" PQ_SECURITY_POSTED ""
              warn "$slug: security review of #$pr finished$cost, but could not be posted on it - the implementer will be asked to"
            fi ;;
          *)
            [ "$dry" = 1 ] && { msg "would count $slug's failed security review as a try"; return 0; }
            local rc why; rc=$(cat "$d/security.rc" 2>/dev/null)
            if [ "$rc" = 0 ]; then why="the security reviewer finished without a report - see $d/security.json"
            else why="the security reviewer exited $rc - see $d/security.err"; fi
            reviewer_try_failed "$d" security failed "$why" ;;
        esac
        return 0
      fi
      local pid; pid=$(st "$d" PQ_SECURITY_PID)
      if ! review_alive "$pid"; then
        [ "$dry" = 1 ] && { msg "would count $slug's vanished security reviewer as a failed try"; return 0; }
        reviewer_try_failed "$d" security failed "the security reviewer process is gone without leaving an exit code"
        return 0
      fi
      local since; since=$(st "$d" PQ_SECURITY_AT); since=${since:-$nowsec}
      if [ $(( nowsec - since )) -ge "$PQ_REVIEW_TIMEOUT" ]; then
        [ "$dry" = 1 ] && { msg "would kill $slug's security reviewer - over PQ_REVIEW_TIMEOUT"; return 0; }
        reviewer_kill "$d" security
        reviewer_try_failed "$d" security timeout "ran past ${PQ_REVIEW_TIMEOUT}s"
      fi
      ;;
  esac
  return 0
}

# What `pq ls` says about the gate, or nothing when it has nothing to say.
# ASCII only, like every cell.
#
# A gate at `posted` that is waiting on the security reviewer says so: `reviewed`
# would read as about to move on, when the follow-up is held for the other review.
review_cell() {                         # task_dir
  local d=$1 sec; sec=$(st "$d" PQ_SECURITY)
  case "$(st "$d" PQ_REVIEW)" in
    pending)  printf 'review due' ;;
    running)  printf 'reviewing %s' "$(age_since "$(st "$d" PQ_REVIEW_AT)")" ;;
    posted)
      case "$sec" in
        pending) printf 'security review due'; return ;;
        running) printf 'security review %s' "$(age_since "$(st "$d" PQ_SECURITY_AT)")"; return ;;
      esac
      if [ "$(st "$d" PQ_REVIEW_RESULT)" != ok ]; then printf 'review failed'
      elif [ "$sec" = "done" ] && [ "$(st "$d" PQ_SECURITY_RESULT)" != ok ]; then printf 'security review failed'
      else printf 'reviewed'; fi ;;
    prompted) printf 'resolving' ;;
    lapsed)   printf 'review lapsed' ;;
  esac
}

# ── reap ────────────────────────────────────────────────────────────────────
# `pq` frees a slot the moment a pull request exists, in any state, and stops
# caring - everything the task was built on survives: the worktree, its database,
# its port, its redis index, its puma-dev entry, and the Herdr workspace holding
# the agent's pane. Reclaiming all of that used to be a human errand, `wt rm` by
# hand or `wt gc --settled` if you remembered it existed. This is the other end of
# dispatch: once a task's pull request has settled - merged into the base it was
# aimed at, or closed without merging - `pq` tears down what it built, the same
# `wt rm` you would have run yourself, driven unattended.
#
# `pq` still never touches a worktree it did not create, never merges or closes a
# pull request, and never force-pushes. Closing a pull request is your decision;
# acting on it is this. What is left alone is the task with NO verdict - no pull
# request at all, or one still open - because nobody has decided anything yet.

# The whole pass's precondition. `PIDX_OK` means Herdr answered the snapshot, so
# the agent check below is real rather than a blank. `HERDR_ENV` plus a live
# `HERDR_SOCKET_PATH` (mirroring wt's own `in_herdr`) mean `pq` is itself inside a
# Herdr pane, which `wt rm`'s `need_herdr` requires and which is where `pq run` is
# meant to live anyway. These are not the same condition - the server can be
# answering while `pq` runs from a plain terminal, and that combination would fail
# inside `wt rm` on every tick. A teardown deferred to the morning costs nothing,
# so skip rather than guess.
reap_ok() {
  [ "${PIDX_OK:-0}" = 1 ] || return 1
  [ "${HERDR_ENV:-}" = 1 ] || return 1
  [ -S "${HERDR_SOCKET_PATH:-/nonexistent}" ] || return 1
  return 0
}

# True while a done task still needs a `gh` answer - which is exactly "no verdict
# yet". This is what keeps `pr_targets running` from repeating a `gh` call forever
# once the answer is in: a merged-but-held task stops watching (the verdict is
# known; only local checks remain) and a closed one stops for good.
#
# `PQ_REAPED` deliberately does NOT appear here, though it used to. Reaping is a
# statement about the WORKTREE - there is nothing left to tear down - and it was
# being read as a statement about the VERDICT, which is a different fact. A task
# whose worktree vanished while its pull request was still open got stamped
# reaped, stopped being watched, and then its merge landed with nobody listening:
# no `PQ_MERGED` ever, so `archivable` never true, so it sat in `done/` forever.
# Measured: sup-7-centralize-video-output was reaped at 16:22:17 and its pull
# request merged at 16:31:26, nine minutes later.
#
# Dropping the clause costs nothing now that `reap_task` only ever stamps
# `PQ_REAPED` alongside a verdict: a settled task is already excluded by the two
# checks above, and the only rows this newly watches are precisely the ones the
# old rule stranded - which is what lets them heal on their own.
reap_watching() {                       # task_dir
  [ -z "$(st "$1" PQ_MERGED)" ] && [ -z "$(st "$1" PQ_CLOSED)" ]
}

# Tear one task down, once its PR has genuinely merged - 0 only when a teardown
# actually happened this pass, 2 when `--dry-run` would have done one (nothing
# is stamped either way), 1 for everything else. `tick_body` counts 0 as torn
# down and 2 as would-tear-down, the same split fill keeps between `started`
# and `would`.
#
# `dry` gates every write site individually rather than short-circuiting at the
# top: which of the three `--dry-run` messages applies depends on the hold
# reason, and that has to be computed before it can be printed.
reap_task() {                           # task_dir dry -> 0 torn down, 2 would (dry-run), 1 otherwise
  local d=$1 dry=$2 slug repo branch base wt settled=0 why="" reason="" explanation="" was

  slug=$(slug_of "$d")

  # 1. Settled - a verdict is on file AND the teardown it calls for has happened.
  #    Neither half is settled alone. `PQ_REAPED` says the worktree is gone, which
  #    is silent about whether the pull request ever merged - treating it as settled
  #    is what stranded the rows step 2 now lets back in. And a verdict alone leaves
  #    a worktree still to reclaim, which is why `PQ_CLOSED` is checked here with
  #    `PQ_REAPED` rather than on its own: closing a pull request is a decision that
  #    the work is finished, so it earns the same teardown a merge does.
  { [ -n "$(st "$d" PQ_REAPED)" ] \
      && { [ -n "$(st "$d" PQ_MERGED)" ] || [ -n "$(st "$d" PQ_CLOSED)" ]; }; } && return 1

  # 2. The worktree is already gone - a hand-run `wt rm`, or `wt gc`, got there
  #    first. Nothing left to invoke `wt` for, but the tick already paid for a
  #    verdict - reap_watching kept this task's branch in pr_targets running,
  #    so the row is already sitting in the cache pr_load_all loaded above.
  #    `PQ_REAPED` is stamped ONLY alongside a verdict. Stamping it regardless
  #    was the bug: an open pull request has no verdict yet, and marking the task
  #    reaped stopped it being watched, so a merge arriving minutes later was
  #    never recorded and the row could never archive. With no verdict we say so
  #    once and come back next tick, exactly as a task with a live worktree and
  #    an open pull request already does.
  wt=$(st "$d" PQ_WORKTREE)
  if [ -z "$wt" ] || [ ! -d "$wt" ]; then
    repo=$(hdr "$d/plan.md" repo); branch=$(hdr "$d/plan.md" branch)
    local verdict=""
    if [ -n "$repo" ] && [ -n "$branch" ]; then
      base=$(task_base "$d")
      if [ -n "$base" ] && merged_into "$repo" "$branch" "$base"; then verdict=merged
      elif pr_all_closed "$repo" "$branch"; then verdict=closed
      fi
    fi
    if [ "$dry" = 1 ]; then
      if [ -n "$verdict" ]; then
        msg "would stop watching $slug - its worktree is already gone ($verdict)"
      else
        msg "would keep watching $slug - its worktree is gone, but its pull request has not settled"
      fi
      return 1
    fi
    if [ -z "$verdict" ]; then
      # Once-only, on its own key: a task can legitimately sit in this state for
      # days, and saying it every tick would bury everything else in the log.
      [ -n "$(st "$d" PQ_WT_GONE)" ] || { st_set "$d" PQ_WT_GONE "$(now)"
        msg "$slug: worktree already gone - still watching for its verdict"; }
      return 1
    fi
    case "$verdict" in
      merged) st_set "$d" PQ_MERGED "$(now)" ;;
      closed) st_set "$d" PQ_CLOSED "$(now)" ;;
    esac
    st_set "$d" PQ_REAPED "$(now)"
    msg "$slug: worktree already gone - recorded as $verdict"
    return 1
  fi

  repo=$(hdr "$d/plan.md" repo); branch=$(hdr "$d/plan.md" branch)
  [ -d "$repo" ] || { warn "$slug: repo $repo is gone - fix that, then the next tick will retry"; return 1; }

  # 3. Resolve the verdict once, from the PR cache the tick already paid for
  #    (pr_targets running now covers every watched done task's branch too).
  #
  #    Two verdicts, one teardown. A merge means the work shipped; every pull
  #    request closed without merging means somebody decided it never will - and
  #    that decision is just as final, so the worktree, the agent and the dev
  #    environment are just as reclaimable. `settled` is what the rest of this
  #    function gates on, so neither verdict gets a second code path.
  #
  #    `pr_all_closed` needs a row and needs every row CLOSED, so a pull request
  #    reopened, or closed alongside a fresh one, is correctly not a verdict yet.
  if [ -n "$(st "$d" PQ_MERGED)" ] || [ -n "$(st "$d" PQ_CLOSED)" ]; then
    settled=1
  else
    base=$(task_base "$d")
    if [ -z "$base" ]; then
      # Resolved first, ahead of the predicates below: with no base
      # merged_into can never match and pr_all_closed will not fire on a
      # MERGED row, so without this the task would poll gh every tick forever.
      reason=nobase
    elif merged_into "$repo" "$branch" "$base"; then
      settled=1 why=merged
      [ "$dry" = 1 ] || st_set "$d" PQ_MERGED "$(now)"
    elif pr_all_closed "$repo" "$branch"; then
      settled=1 why=closed
      [ "$dry" = 1 ] || st_set "$d" PQ_CLOSED "$(now)"
    else
      return 1                          # still in review - no hold, just not yet
    fi
  fi

  # 4. Two holds, both only once there is a verdict (just now, or on an earlier pass).
  #    Invariant, not a check: the review gate (pass 1.22) runs before this one in
  #    the same tick and has already killed any reviewer still running against a
  #    settled pull request - so by the time `wt rm` closes the workspace below,
  #    nothing of pq's is working inside it. Reorder the passes and that breaks.
  if [ "$settled" = 1 ]; then
    # The guard that matters most: closing the Herdr workspace pq is itself
    # running in would kill this pane partway through the teardown. Guarded on
    # HERDR_WORKSPACE_ID being non-empty so two blank strings can never match.
    if [ -n "${HERDR_WORKSPACE_ID:-}" ] && [ "$(st "$d" PQ_WORKSPACE)" = "$HERDR_WORKSPACE_ID" ]; then
      reason=here
    else
      case "$(pane_state "$(st "$d" PQ_PANE)")" in
        working|blocked) reason=agent ;;
      esac
    fi
  fi

  # 5. One place writes PQ_REAP_HELD, for all three reasons - stamp and warn on
  #    the transition into it, clear it the moment the hold recovers.
  case "$reason" in
    agent)  explanation="the agent is still going" ;;
    here)   explanation="pq is running inside this task's own workspace" ;;
    nobase) explanation="could not resolve $repo's default branch" ;;
  esac
  was=$(st "$d" PQ_REAP_HELD)
  if [ "$dry" = 1 ]; then
    if [ -n "$reason" ]; then
      msg "would leave $slug alone - $explanation"
      return 1
    fi
    # 2, not 0: nothing actually happened (dry-run stamps nothing), but this is
    # distinct from "nothing to do" - it is what lets tick_body count a
    # would-be teardown into its summary, the same way fill tracks `would`
    # separately from `started`.
    msg "would tear down $slug ($branch)"
    return 2
  fi
  if [ -n "$reason" ]; then
    [ "$was" = "$reason" ] || { st_set "$d" PQ_REAP_HELD "$reason"
      warn "$slug: ${why:-settled}, but holding - $explanation"; }
    return 1
  fi
  [ -z "$was" ] || st_set "$d" PQ_REAP_HELD ""

  # 6. Tear it down - the same `wt rm` you would have run yourself. Shielded for
  #    the same reason `wt new` is: it drops a database, and a Ctrl-C mid-drop
  #    should not leave that half-done.
  if shielded wt_in "$repo" rm --yes "$branch"; then
    st_set "$d" PQ_REAPED "$(now)"
    msg "$slug: ${why:-settled} - tore down $branch"
    return 0
  fi
  warn "$slug: wt rm failed - run by hand: wt rm -y $branch"
  return 1
}

# ── archive ─────────────────────────────────────────────────────────────────
# `done/` never gets pruned on its own, so every task pq has ever finished
# still shows in it - and, once reap_task has torn a merged task's worktree
# down, still shows in `pq ls` too, for nothing pq or you can still decide.
# `archive_pass` (called from `tick_body`) files that settled history away to
# `archive/`, a fifth state nothing walks on the hot path.

# Terminal history - nothing pq or you can still decide, so it can leave done/.
# One rule, either verdict, and both halves are required:
#   PQ_MERGED|PQ_CLOSED + PQ_REAPED   the verdict is in and the worktree is gone
#
# The verdict alone is not enough, and `PQ_CLOSED` used to be allowed to stand on
# its own here because a closed pull request meant pq would never touch the
# worktree. Now that it earns a teardown, archiving on the verdict alone would
# file the task away in the same tick reap stamped it - archive/ is not walked on
# the hot path, so the worktree, its database and its port would be stranded where
# nothing would ever look for them again. `PQ_DONE_KEEP` hides that: it takes four
# archivable closed tasks before a single one actually moves.
#
# PQ_REAP_HELD needs no check: reap_task clears it before it can ever stamp
# PQ_REAPED, so a held task cannot satisfy the rule.
archivable() {                          # task_dir -> 0 when it can leave done/
  [ -n "$(st "$1" PQ_REAPED)" ] || return 1
  [ -n "$(st "$1" PQ_MERGED)" ] || [ -n "$(st "$1" PQ_CLOSED)" ]
}

# Files every archivable done/ task away, except the newest PQ_DONE_KEEP -
# kept behind so `pq ls` still answers "did last night's batch ship?" at a
# glance. Ordered by `stamp_of`, exactly as `queue_ordered` is, NOT by glob
# order - done/ still holds legacy directories whose width disagrees with the
# %014d prefix (see all_tasks' own caveat).
#
# Never reaches retitle's `die`: this runs inside tick_body's lock, so a
# destination collision - a hand-corrupted archive/ sharing this task's name -
# is worth one skipped row, not an aborted tick. next_stamp spanning archive
# (see all_tasks) is what keeps a FRESH task's destination from ever
# colliding; this guard is only for archive/ itself having been tampered with.
#
# Prints the count archived (or that would be, under --dry-run) so tick_body
# can fold it into its one-line summary.
archive_pass() {                        # dry -> count, via stdout; msg/warn as it goes
  local dry=$1 d cands total keep=$PQ_DONE_KEEP n_arch=0
  # Piped straight from the loop, same as queue_ordered - NOT built up in a
  # variable and fed to sort through <<<, which appends its own trailing
  # newline on top of the loop's and sorts that spurious blank line (numeric
  # key 0) to the very front, stealing a slot from head -n below.
  cands=$(
    for d in "$PQ_HOME/done"/*/; do
      [ -d "$d" ] || continue
      d=${d%/}
      archivable "$d" || continue
      printf '%s\t%s\n' "$(stamp_of "$d")" "$d"
    done | sort -s -n -k1,1 | cut -f2-
  )
  [ -n "$cands" ] || { printf 0; return; }

  total=$(grep -c . <<<"$cands")
  local to_archive=$(( total - keep ))
  if [ "$to_archive" -le 0 ]; then printf 0; return; fi

  local slug branch dst why moved
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    slug=$(slug_of "$d")
    dst="$PQ_HOME/archive/$(basename "$d")"
    if [ -e "$dst" ]; then
      warn "$slug: could not archive - archive/$(basename "$d") already exists"
      continue
    fi
    branch=$(hdr "$d/plan.md" branch)
    if [ -n "$(st "$d" PQ_CLOSED)" ]; then
      why="its PR closed without merging; worktree already torn down"
    else
      why="it shipped; worktree already torn down"
    fi
    if [ "$dry" = 1 ]; then
      msg "would archive $slug - $why"
    else
      moved=$(retitle "$d" archive)
      st_set "$moved" PQ_ARCHIVED "$(now)"
      msg "archived $slug - $why"
    fi
    n_arch=$((n_arch + 1))
  done <<<"$(head -n "$to_archive" <<<"$cands")"
  printf '%s' "$n_arch"
}

# ── tick ────────────────────────────────────────────────────────────────────
# One idempotent pass: free what has finished, finish what was interrupted, then
# fill whatever room that left. Reconcile runs BEFORE the cap is counted, so a task
# that shipped during the last interval hands its slot straight to the next one.
# One tick at a time. The per-task `mv` already stops the same plan being claimed
# twice, but two ticks running concurrently would each see the same free slots and
# between them overshoot the cap. mkdir is the atomic primitive; a lock whose owner
# is gone is stale and reclaimed.
#
# Taken and released around each tick rather than held for the life of the process,
# because `pq run` ticks in a loop - a lock released only at exit would make every
# tick after the first find the lock held, by itself, forever.
take_lock() {                           # -> 0 took it, 1 someone else has it
  local owner
  PQ_LOCK="$PQ_HOME/.tick.lock"
  if ! mkdir "$PQ_LOCK" 2>/dev/null; then
    owner=$(cat "$PQ_LOCK/pid" 2>/dev/null)
    if [ -n "$owner" ] && kill -0 "$owner" 2>/dev/null; then PQ_LOCK=""; return 1; fi
    warn "clearing a stale tick lock"
    rm -rf "$PQ_LOCK"; mkdir "$PQ_LOCK" 2>/dev/null || die "could not take the tick lock"
  fi
  printf '%s' "$$" > "$PQ_LOCK/pid"
  # The EXIT trap is the backstop for an abnormal exit; the normal path releases below.
  trap 'rm -rf "$PQ_LOCK"' EXIT
  return 0
}
release_lock() {
  [ -n "${PQ_LOCK:-}" ] && rm -rf "$PQ_LOCK"
  PQ_LOCK=""; trap - EXIT; return 0
}

cmd_tick() {
  local cap="" dry=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --cap)     cap=${2:-}; shift 2 ;;
      --dry-run) dry=1; shift ;;
      -*)        die "unknown option '$1' (usage: pq tick [--cap N] [--dry-run])" ;;
      *)         die "unexpected argument '$1'" ;;
    esac
  done
  # Re-read the cap every tick, so `pq cap 0` takes effect on the next pass of a
  # loop that is already running. An explicit --cap overrides for this tick only and
  # deliberately does not write the file.
  [ -n "$cap" ] || cap=$(cap_get)
  [[ "$cap" =~ ^[0-9]+$ ]] || die "--cap must be a number, got '$cap'"

  # A one-shot tick needs the handler too, not just the loop: dispatch shields its
  # slow child from SIGINT, so without a trap here a Ctrl-C would kill pq and leave
  # that `wt new` running orphaned, with nobody left to record what it produced.
  [ "$PQ_RUN" = 1 ] || trap on_interrupt INT TERM

  if ! take_lock; then
    msg "another tick is running (pid $(cat "$PQ_HOME/.tick.lock/pid" 2>/dev/null)) - nothing to do"
    return 0
  fi
  tick_body "$cap" "$dry"
  local rc=$?
  release_lock
  return $rc
}

tick_body() {                           # cap dry
  local cap=$1 dry=$2
  pidx_load
  # The tick is the converging path, so it is the one that may refresh a base's
  # remote-tracking ref - see base_fetch. Bounded and best-effort there; a
  # listing command never sets this and never reaches the network.
  PQ_FETCH_BASES=1

  # PR state for the whole tick, loaded ONCE: every RUNNING task's branch (for
  # reconcile below), plus every blocker of a task that has not started (for
  # the eligibility check that follows fill). `done` is deliberately excluded -
  # reconcile never looks at it, so a done task's own branch would otherwise be
  # a `gh` call repeated every tick, forever, for history that cannot change
  # state again. One combined cache means a dependency that merged during the
  # last interval is visible to the SAME lookup reconcile just paid for, not a
  # second round trip a tick later.
  pr_load_all "$(pr_targets running)"

  # 1. Reconcile. A pull request - in any state - means the work left the queue, so
  #    the slot is free whether it merged, is in review, or was opened as a draft
  #    because the agent got stuck. Judging what to do about it is yours.
  local d slug branch repo running=()
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    running+=("$d")
  done <<<"$(for x in "$PQ_HOME/running"/*/; do [ -d "$x" ] && printf '%s\n' "${x%/}"; done)"

  if [ "${#running[@]}" -gt 0 ]; then
    for d in "${running[@]}"; do
      slug=$(slug_of "$d"); branch=$(hdr "$d/plan.md" branch)
      # A directory with no plan.md is not a task pq made - the staging dance
      # rules that out - but something writing into a moved task's OLD path
      # recreates one (see task_link). Said once, with the fix, rather than
      # "dispatch was interrupted" every tick; active_slots does not count it.
      if [ ! -f "$d/plan.md" ]; then
        [ -n "$(st "$d" PQ_PHANTOM)" ] || { st_set "$d" PQ_PHANTOM "$(now)"
          warn "running/$(basename "$d") has no plan.md - not a task pq made (a stray write into a moved task's old path?) - remove it: rm -rf $d"; }
        continue
      fi
      local num prstate draft
      IFS=$'\t' read -r num prstate draft <<<"$(pr_get "$(hdr "$d/plan.md" repo)" "$branch")"
      if [ -n "${num:-}" ]; then
        local what="${draft:-$(tr '[:upper:]' '[:lower:]' <<<"${prstate:-}")}"
        if [ "$dry" = 1 ]; then
          msg "would finish $slug (#$num $what)"
        else
          st_set "$d" PQ_PR "$num"; st_set "$d" PQ_FINISHED "$(now)"
          # The review gate opens here, once, in the same cluster - see the
          # `review gate` section for what happens to it from the next pass on.
          # So does the security reviewer's ladder, for a plan that asked.
          st_set "$d" PQ_REVIEW pending
          [ "$(hdr "$d/plan.md" security)" = yes ] && st_set "$d" PQ_SECURITY pending
          retitle "$d" "done" >/dev/null
          msg "finished $slug - #$num $what"
        fi
        continue
      fi
      # Claimed but never launched: an interrupted tick. Pick it up where it stopped.
      if [ -z "$(st "$d" PQ_LAUNCHED)" ]; then
        if [ "$dry" = 1 ]; then msg "would resume the interrupted dispatch of $slug"
        else warn "$slug: dispatch was interrupted - resuming"; dispatch_task "$d" || true; fi
        continue
      fi
      # The wall check runs for every state but `missing`, deliberately including
      # `noagent`. Whether herdr currently has an agent bound to the pane is the
      # same kind of dependency the detection itself avoids - a walled session that
      # momentarily reads as `noagent` would otherwise be written off as exited and
      # never knocked on.
      local pstate; pstate=$(pane_state "$(st "$d" PQ_PANE)")
      [ "$dry" = 1 ] || [ "$pstate" = missing ] || check_stall "$d"
      case "$pstate" in
        missing) warn "$slug: its workspace is gone and no PR exists - look at it, then: pq rm $slug" ;;
        noagent) [ "$(st "$d" PQ_BLOCKED)" = quota ] \
                   || warn "$slug: the agent exited without opening a PR - look at the pane, or: pq rm $slug" ;;
      esac
    done
  fi

  # 1.2 The wall, for tasks that have already opened their pull request. An agent
  # does not stop when it opens one - it answers review, fixes CI, pushes again -
  # so `done/` is where an unattended agent spends most of the night, and it can
  # hit the wall there exactly as easily as in `running/`. For a long time nothing
  # knocked on those panes at all, which made the whole section useless for the
  # case it was written for: three agents wrapping up at midnight, all three
  # walled, none of them touched by morning.
  #
  # No new authority comes with this. check_stall only ever answers the wall; a
  # permission prompt in `done/` is recorded and left for you, the same as
  # anywhere else. Only reaped tasks are skipped, because their pane is gone: a
  # task whose PR closed is knocked on like any other, since its teardown is
  # waiting on that agent to stop and a walled agent never stops on its own.
  # It runs BEFORE reap and before active_slots
  # so the block it sets is visible to the teardown gate, to the slot arithmetic
  # and to the freeze below, all on the tick that set it.
  if [ "$dry" != 1 ]; then
    for d in "$PQ_HOME/done"/*/; do
      [ -d "$d" ] || continue
      d=${d%/}
      [ -n "$(st "$d" PQ_REAPED)" ] && continue
      [ "$(pane_state "$(st "$d" PQ_PANE)")" = missing ] && continue
      check_stall "$d"
    done
  fi

  # 1.22 The review gate, one step per task - see the `review gate` section.
  # After reconcile, so a task that finished this tick is examined this tick;
  # after check_stall, because a dismissed wall reads `idle` to herdr and only
  # PQ_BLOCKED says otherwise; before reap, so a settled PR stops its reviewer
  # before `wt rm` closes the workspace it runs in; before active_slots, so the
  # hold it puts on a slot is counted on the same tick. Reaped tasks have no pane
  # and no worktree left, and nothing here applies to them.
  local n_reviewing=0
  for d in "$PQ_HOME/done"/*/; do
    [ -d "$d" ] || continue
    d=${d%/}
    [ -n "$(st "$d" PQ_REAPED)" ] && continue
    review_task "$d" "$dry"
    review_inflight "$d" && n_reviewing=$((n_reviewing + 1))
  done

  # 1.25 Reap - tear down what merged, once the agent has stopped and pq is not
  # itself sitting in the workspace about to be closed. Runs after reconcile, so
  # a task that just moved from running/ to done/ this same tick is torn down on
  # the same pass, using the PR row `pr_targets running` already loaded for it
  # above - and before the blocker pass, though the two are independent (done
  # tasks vs. queued tasks, neither reads the other's cache).
  local n_torn=0 would_torn=0 reap_note="" rc
  if reap_ok; then
    for d in "$PQ_HOME/done"/*/; do
      [ -d "$d" ] || continue
      d=${d%/}
      reap_task "$d" "$dry"; rc=$?
      case "$rc" in
        0) n_torn=$((n_torn + 1)) ;;
        2) would_torn=$((would_torn + 1)) ;;
      esac
    done
  else
    # The gate can stay closed for a while - say so once something in done/ is
    # actually waiting on it, rather than every night it merely holds history.
    for d in "$PQ_HOME/done"/*/; do
      [ -d "$d" ] || continue
      d=${d%/}
      if reap_watching "$d" || { [ -n "$(st "$d" PQ_MERGED)" ] && [ -z "$(st "$d" PQ_REAPED)" ]; }; then
        reap_note=", teardown needs a herdr pane"; break
      fi
    done
  fi

  # 1.3 Archive - file settled done/ history away to archive/, right after reap
  # (which stamps the verdict this reads) and before the blocker pass. Needs
  # no herdr gate: archiving never touches a worktree, only a directory mv.
  local n_arch; n_arch=$(archive_pass "$dry")

  # 1.5 Blockers - runs for every task that has not started, so a chain
  # stalled on a stuck agent's draft is flagged before anything waits on it.
  # This runs AFTER reconcile and BEFORE fill, so a dependency that merged
  # during the interval that just ended unblocks its dependent on the same
  # tick that noticed, and it warms the per-task verdict fill reuses below
  # rather than recomputing it.
  local afterpass="$PQ_HOME/.after.$$"; : > "$afterpass"
  local v bgone
  for d in "$PQ_HOME/queue"/*/; do
    [ -d "$d" ] || continue
    d=${d%/}
    v=""
    [ -f "$d/after" ] && v=$(after_check "$d")
    # A base that no longer resolves OUTRANKS any blocker verdict: the task
    # cannot start either way, and this is the one of the two that needs you
    # rather than time. Run after after_check, never instead of it, so the
    # blocker bookkeeping (PQ_AFTER_DEAD and its clearing) stays consistent.
    bgone=$(base_check "$d")
    [ -n "$bgone" ] && v=$bgone
    [ -n "$v" ] && printf '%s\t%s\n' "$d" "$v" >> "$afterpass"
  done
  local waiting; waiting=$(awk -F'\t' '$2 !~ /^met/ { n++ } END { print n + 0 }' "$afterpass")

  # 2. Fill. A live agent is a slot, wherever its task now sits - every running/
  #    task (a task blocked on a permission prompt still holds one, the
  #    deliberate trade for running everything in auto mode) plus every done/
  #    task still wrapping up its pull request. See the `slots` section for why
  #    the second half is not optional.
  local n_run n_wrap active
  IFS=$'\t' read -r n_run n_wrap <<<"$(active_slots "$dry")"
  active=$(( n_run + n_wrap ))
  local free=$(( cap - active ))

  # ...and a wall stops fill outright, whatever the arithmetic says, because every
  # agent pq runs draws on the same window. See walled_slot.
  local walled_by walled_at
  IFS=$'\t' read -r walled_by walled_at <<<"$(walled_slot)"
  [ -n "$walled_by" ] && free=0

  # Build the queue ONCE, in stamp order, then walk it - skipping whatever
  # is not eligible - rather than re-globbing and taking the first entry every
  # pass, which only worked because a claimed task leaves queue/. --dry-run
  # reports every would-dispatch AND every would-skip with its reason, so a
  # queue that is entirely blocked reads differently from an empty one.
  local started=0 would=0 claimed verdict lbl n
  local ordered; ordered=$(queue_ordered)
  if [ -n "$ordered" ]; then
    while IFS= read -r d; do
      [ -n "$d" ] || continue
      slug=$(slug_of "$d")
      if [ "$free" -le 0 ]; then
        # Name the wall rather than the cap when the wall is what closed it: the two
        # want completely different things from you, and "cap reached" reads as
        # healthy.
        if [ "$dry" = 1 ]; then
          if [ -n "$walled_by" ]; then msg "would skip $slug - $(walled_note "$walled_at")"
          else msg "would skip $slug - cap reached"; fi
        fi
        continue
      fi
      verdict=$(awk -F'\t' -v d="$d" '$1 == d { print $2; exit }' "$afterpass")
      case "${verdict:-met}" in
        met) ;;
        waiting\ *)
          if [ "$dry" = 1 ]; then
            lbl=${verdict#waiting }; n=${lbl##* }; lbl=${lbl% *}
            msg "would skip $slug - waiting on $lbl ($n unmet)"
          fi
          continue ;;
        stalled\ *)
          [ "$dry" = 1 ] && msg "would skip $slug - blocker ${verdict#stalled } is stalled"
          continue ;;
        dead\ *)
          [ "$dry" = 1 ] && msg "would skip $slug - blocker ${verdict#dead } is dead"
          continue ;;
        basegone\ *)
          [ "$dry" = 1 ] && msg "would skip $slug - base origin/${verdict#basegone } is gone"
          continue ;;
      esac
      if [ "$dry" = 1 ]; then
        msg "would dispatch $slug ($(hdr "$d/plan.md" branch))"
        # A separate counter from $started: --dry-run changes nothing, and a
        # summary that says "N started" when nothing moved is the one line a
        # human actually reads before trusting the rest of it.
        would=$((would + 1)); free=$((free - 1))
        continue
      fi
      # Claim FIRST. `wt new` takes the better part of a minute, and until the task has
      # left queue/ a second tick would happily pick up the very same plan.
      claimed=$(retitle "$d" running) || continue
      st_set "$claimed" PQ_CLAIMED "$(now)"
      dispatch_task "$claimed" || warn "$slug: left in running/ half-dispatched - the next tick will retry it"
      started=$((started + 1)); free=$((free - 1))
    done <<<"$ordered"
  fi

  rm -f "$afterpass" "$PR_CACHE" "$PR_ANS"
  repo_base_reset

  # Only running/ is recounted - fill just moved tasks into it. The wrap-up half
  # is reused rather than recomputed: nothing after fill can change it, and a
  # second active_slots pass would re-walk done/ for the same answer.
  n_run=$(dir_count "$PQ_HOME/running")
  local queued; queued=$(dir_count "$PQ_HOME/queue")
  # Name the two halves separately. A cap of 3 reading "3 running" while three
  # more agents were still wrapping up in done/ is precisely what made six live
  # agents look like a healthy tick for as long as this bug lasted.
  #
  # The wall gets said out loud for the same reason: `pq run` suppresses a summary
  # identical to the last one, so a frozen queue would otherwise leave a log that
  # goes quiet at 2am and says nothing about why.
  summary "$n_run running$([ "$n_wrap" -gt 0 ] && printf ' + %s wrapping up' "$n_wrap") (cap $cap), $queued queued\
$([ -n "$walled_by" ] && printf ', %s - starting nothing' "$(walled_note "$walled_at")")\
$([ "$started" -gt 0 ] && printf ', %s started' "$started")\
$([ "$would" -gt 0 ] && printf ', %s would start' "$would")\
$([ "$waiting" -gt 0 ] && printf ', %s waiting on a merge' "$waiting")\
$([ "$n_reviewing" -gt 0 ] && printf ', %s reviewing' "$n_reviewing")\
$([ "$n_torn" -gt 0 ] && printf ', %s torn down' "$n_torn")\
$([ "$would_torn" -gt 0 ] && printf ', %s would tear down' "$would_torn")$reap_note\
$([ "$n_arch" -gt 0 ] && printf ', %s %s' "$n_arch" "$([ "$dry" = 1 ] && printf 'would archive' || printf 'archived')")"
}

# ── run ─────────────────────────────────────────────────────────────────────
# Tick, sleep, repeat - meant to sit in a Herdr space where it inherits the socket
# and you can watch it. Safe to stop and start whenever: the queue's state lives
# entirely in directories, so this process holds nothing that matters.
#
# Ctrl-C is a graceful stop. During the sleep - the overwhelmingly common case - it
# returns immediately. During a tick the work in flight is shielded from the signal
# (see `shielded`), so it genuinely runs to completion and the loop exits after it.
# A second interrupt means you would rather not wait, and it kills the shielded child
# too - otherwise "force" would leave a `wt new` running with nobody to record what
# it produced. Either way nothing is lost: a task caught mid-dispatch is left with no
# PQ_LAUNCHED, which the next reconcile recognises and resumes.
#
# Two `pq run` loops would not overshoot the cap - the tick lock serialises them -
# they would just tick twice as often. Harmless enough not to be worth a second lock.
PQ_STOP=0
on_interrupt() {
  printf '\n'
  if [ "$PQ_STOP" = 1 ]; then
    if [ -n "$SHIELDED_PID" ]; then
      msg "stopping now - abandoning the work in flight; the next tick will retry it"
      kill -TERM -"$SHIELDED_PID" 2>/dev/null || kill -TERM "$SHIELDED_PID" 2>/dev/null
    else
      msg "stopping now"
    fi
    release_lock; exit 130
  fi
  PQ_STOP=1
  if [ -n "$SHIELDED_PID" ]; then
    msg "finishing the work in flight, then stopping (Ctrl-C again to abandon it)"
  else
    msg "stopping after this tick (Ctrl-C again to stop now)"
  fi
}

# sleep in the background and `wait` on it, so the trap runs the moment a signal
# arrives rather than after the sleep has run its course. A bare `sleep` is only
# interruptible when the signal reaches it too, which is not true of `kill -INT`.
nap() {                                 # seconds
  local pid
  sleep "$1" & pid=$!
  wait "$pid" 2>/dev/null
  kill "$pid" 2>/dev/null
  return 0
}

cmd_run() {
  local interval=120 cap=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --interval) interval=${2:-}; shift 2 ;;
      --cap)      cap=${2:-}; shift 2 ;;
      -*)         die "unknown option '$1' (usage: pq run [--interval SECONDS] [--cap N])" ;;
      *)          die "unexpected argument '$1'" ;;
    esac
  done
  [[ "$interval" =~ ^[0-9]+$ ]] && [ "$interval" -ge 5 ] || die "--interval must be a number of seconds, at least 5"
  # --cap here SETS the cap rather than overriding for one pass, since this is the
  # long-running thing: what you pass at startup should be what `pq cap` reports.
  [ -n "$cap" ] && { [[ "$cap" =~ ^[0-9]+$ ]] || die "--cap must be a number"; cap_set "$cap"; }

  PQ_RUN=1
  trap on_interrupt INT TERM
  msg "running every ${interval}s at cap $(cap_get) - change it any time with 'pq cap N', Ctrl-C to stop"

  local last=""
  while :; do
    # Suppress a summary identical to the last one, so an idle night leaves a log of
    # what changed rather than hundreds of lines saying nothing happened.
    PQ_SUMMARY=""
    cmd_tick || true
    if [ -n "$PQ_SUMMARY" ] && [ "$PQ_SUMMARY" != "$last" ]; then
      printf 'pq: [%s] %s\n' "$(date '+%H:%M')" "$PQ_SUMMARY" >&2
      last=$PQ_SUMMARY
    fi
    [ "$PQ_STOP" = 1 ] && break
    nap "$interval"
    [ "$PQ_STOP" = 1 ] && break
  done
  release_lock
  # The same arithmetic the tick itself used, for the same reason cmd_cap uses
  # it: this is the line you read as you Ctrl-C, and "2 still running" while six
  # agents are live is how the cap came to be trusted when it should not have
  # been. slot_state, not slot_held - the loop is over, and nobody's clock should
  # start on the way out.
  local n_run n_wrap d
  n_run=$(dir_count "$PQ_HOME/running")
  n_wrap=0
  for d in "$PQ_HOME/done"/*/; do
    [ -d "$d" ] || continue
    [ -n "$(slot_state "${d%/}")" ] && n_wrap=$((n_wrap + 1))
  done
  msg "stopped - $n_run still running$([ "$n_wrap" -gt 0 ] && printf ' + %s wrapping up' "$n_wrap"), queue untouched"
}

# Wrapped so the script can be sourced without dispatching - `test/pq-after.sh`
# sources this file to reach the predicate directly. An `if` rather than a
# trailing `[ ... ] && main "$@"`: that form makes a sourced script return
# non-zero, which would kill any test running under `set -e`.
main() {
  case "${1:-}" in
    add)        shift; cmd_add "" "" "" "" "$@" ;;
    after)      shift; cmd_after "$@" ;;
    base)       shift; cmd_base "$@" ;;
    tick)       shift; cmd_tick "$@" ;;
    run)        shift; cmd_run "$@" ;;
    cap)        shift; cmd_cap "$@" ;;
    ls|list)    shift; cmd_ls "$@" ;;
    rm|remove)  shift; cmd_rm "$@" ;;
    evidence)   shift; cmd_evidence "$@" ;;
    *) die "usage: pq {add [--base B] [--urgent] [--after task|branch]... [--design PATH]... [--split | --split-dir DIR] | after <task> [<task|branch>... | --clear] | base <task> [<branch> | --clear] | ls [--all] [--json] | tick [--cap N] [--dry-run] | run [--interval S] [--cap N] | cap [N] | rm <task> | evidence [task]}" ;;
  esac
}
if [ "${BASH_SOURCE[0]}" = "$0" ]; then main "$@"; fi
