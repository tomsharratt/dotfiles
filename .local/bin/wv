#!/usr/bin/env bash
# wv - drive a booted simulator's or emulator's web view from the command line:
# evaluate JavaScript in it and print the result, or take a screenshot. Exists
# because there is otherwise no way to read a value (a layout measurement, a
# viewport size) back out of a WKWebView or Android WebView without a GUI
# inspector.
#
#   wv eval '<js>'      evaluate a JS expression in the booted device's web
#                       view, print the result
#   wv shot [path]      screenshot the booted device (default: a path it
#                       prints)
#
# wv NEVER RESOLVES A DEVICE ITSELF. It reads WT_IOS_UDID or ANDROID_SERIAL
# (plus DEVELOPER_DIR and the platform SDK on PATH) straight from the
# environment - exactly what the supercast-ios / supercast-android wt
# profiles' own wt_env exports - so the normal way to run this is
# `wt run wv eval '...'`, never `wv` on its own. Device selection belongs to
# the profile; driving whatever device it selected belongs here - the same
# split `wt` already makes between itself and its profiles. Exactly one of the
# two variables must be set: neither means there is nothing to drive, both
# means wv cannot tell which device you meant, and either way it fails naming
# both variables rather than silently guessing a platform.
#
# THE ONE NON-OBVIOUS FACT: Hotwire Native only sets isInspectable = true on
# its WKWebView under `#if DEBUG` (hotwire-native-ios's WebView.swift). A
# Release build's web view cannot be attached to at all - so an empty page
# list from either platform almost always means "wrong build", not "broken
# proxy". Check that before debugging the proxy.
#
# Both platforms end up speaking the same request/response JSON over a
# WebSocket - ios_webkit_debug_proxy deliberately mimics the same /json HTTP
# surface Chrome's own remote-debugging protocol uses - so that half is
# written once, in Node, and handed the resolved platform/port/expression
# through its environment (see write_eval_js) rather than as argv.
#
# Node is resolved LAST, after every argument and environment check, so
# test/wv-args.sh can exercise all of those with no device, no proxy, and no
# Node on PATH at all. Resolution order: $WV_NODE, then `node` on PATH, then
# asdf's shim - the order an unattended `pq` session (a thinner PATH than an
# interactive shell) needs. WV_NODE is the only environment variable this
# script adds; there is no platform-override variable or flag, because the
# two device variables above already carry that information.
set -uo pipefail

SELF=$(basename "$0")
msg() { printf 'wv: %s\n' "$*" >&2; }
die() { printf 'wv: %s\n' "$*" >&2; exit 1; }

usage() {
  printf 'usage: %s eval '"'"'<js>'"'"'      evaluate a JS expression in the web view, print the result\n' "$SELF" >&2
  printf '       %s shot [path]      screenshot the device (default: a path it prints)\n' "$SELF" >&2
}

# Used purely to prefer the right page when more than one is inspectable -
# see wv_app_host below for where the real value actually comes from. This
# is only the last-resort fallback for a worktree that hasn't been
# provisioned yet, so it need not track either profile's build config
# exactly (confirmed the two can disagree: supercast-ios.sh's own comment
# says "supercast.test", but supercast-android's current BASE_URL_SUFFIX is
# "supercast.com" - not this script's to reconcile).
WV_APP_HOST_DEFAULT="app.supercast.test"

# Both profiles' wt_provision already record "the backend the app actually
# talks to" as WT_URL in the worktree's state file, and `wt run` sources that
# state file under `set -a` before running wt_env - so WT_URL is usually
# already exported into this process by the time wv runs. Prefer it (it is
# the single source of truth the profiles themselves maintain); fall back to
# the literal above only for a worktree that has never been provisioned yet.
wv_app_host() {
  if [ -n "${WT_URL:-}" ]; then
    local host=${WT_URL#*://}
    host=${host%%/*}
    host=${host%%:*}
    [ -n "$host" ] && { printf '%s' "$host"; return 0; }
  fi
  printf '%s' "$WV_APP_HOST_DEFAULT"
}

# ── platform ─────────────────────────────────────────────────────────────────
# Which device to drive comes from whichever of these two the caller's profile
# exported via wt_env - never resolved here. Prints "ios" or "android" on
# stdout; on failure it has already called die (so the exit code, not the
# print, is what a caller must check).
wv_platform() {
  local ios=${WT_IOS_UDID:-} android=${ANDROID_SERIAL:-}
  if [ -n "$ios" ] && [ -n "$android" ]; then
    die "both WT_IOS_UDID and ANDROID_SERIAL are set - wv can't tell which device you mean; run it through 'wt run' from a single worktree, not two at once"
  fi
  if [ -z "$ios" ] && [ -z "$android" ]; then
    die "neither WT_IOS_UDID nor ANDROID_SERIAL is set - run wv through 'wt run' from an iOS or Android worktree (its profile exports one of them), not directly"
  fi
  if [ -n "$ios" ]; then printf 'ios'; else printf 'android'; fi
}

# ── interpreter ──────────────────────────────────────────────────────────────
# $WV_NODE, then node on PATH, then asdf's shim - see header. Prints the
# resolved path on stdout; on failure it has already called die.
resolve_node() {
  if [ -n "${WV_NODE:-}" ]; then
    [ -f "$WV_NODE" ] && [ -x "$WV_NODE" ] \
      || die "WV_NODE is set to '$WV_NODE' but that is not an executable file"
    printf '%s' "$WV_NODE"
    return 0
  fi
  if command -v node >/dev/null 2>&1; then
    command -v node
    return 0
  fi
  if [ -x "$HOME/.asdf/shims/node" ]; then
    printf '%s' "$HOME/.asdf/shims/node"
    return 0
  fi
  die "no node interpreter found (checked \$WV_NODE, PATH, and ~/.asdf/shims/node)"
}

# ── cleanup ──────────────────────────────────────────────────────────────────
# One trap for everything a run might have started. The iOS proxy is
# deliberately NOT torn down here - see its own section below for why; only
# the adb forward and the temp eval script are.
ANDROID_FWD_STARTED=0 ANDROID_FWD_PORT=""
WV_TMP_JS=""
wv_cleanup() {
  if [ "$ANDROID_FWD_STARTED" = 1 ] && [ -n "$ANDROID_FWD_PORT" ]; then
    adb -s "$ANDROID_SERIAL" forward --remove "tcp:$ANDROID_FWD_PORT" >/dev/null 2>&1
  fi
  [ -n "$WV_TMP_JS" ] && rm -f "$WV_TMP_JS"
}
trap wv_cleanup EXIT

# ── iOS: ios_webkit_debug_proxy ──────────────────────────────────────────────
IWDP_PORT=9221
# "null:9221,:9222-9322" is ios_webkit_debug_proxy's own default -c value
# (confirmed via --help) - kept explicit rather than omitted so the port this
# script waits on is never implicit. It has nothing to do with simulator
# support, though: that's a SEPARATE mechanism (see _iwdp_sim_socket below).
IWDP_SIM_SELECTOR="null:$IWDP_PORT,:$((IWDP_PORT + 1))-$((IWDP_PORT + 101))"

# The simulator's WebKit inspector listens on a per-boot UNIX socket that
# launchd creates on demand - NOT the fixed TCP default (-s localhost:27753)
# --help describes, which is for a bridge nothing here runs. Confirmed
# against a real booted simulator: `launchctl print`'s "sockets" section
# names the exact path via RWI_LISTEN_SOCKET, scoped to the specific
# simulator `simctl spawn` targets - which is what lets `wv eval` scope to
# $WT_IOS_UDID precisely, the same way `wv shot` already does.
_iwdp_sim_socket() {
  command -v xcrun >/dev/null 2>&1 || die "xcrun not found on PATH - run this via 'wt run' from an iOS worktree"
  xcrun simctl spawn "$WT_IOS_UDID" launchctl print user/foreground/com.apple.webinspectord 2>/dev/null \
    | awk -F' => ' '/RWI_LISTEN_SOCKET/ { print $2; exit }'
}

# The plan this shipped with called for stopping the proxy again if this
# invocation started it. Tried exactly that against a real booted simulator
# and it does not work: once a proxy that successfully attached disconnects,
# a freshly started one reconnecting to the SAME simulator fails
# unpredictably ("Unable to connect to SIMULATOR") - confirmed directly, not
# a timing fluke worth a longer wait: repeated trials with a growing cooldown
# between stop and restart (2s/3s/4s/5s) succeeded and failed in no
# consistent pattern. A proxy left running instead answers every query
# reliably, indefinitely.
#
# So this follows supercast-android.sh's own precedent for the shared
# emulator instead (started with `nohup ... & disown`, "detached so it
# survives this command returning"): start it if nothing is listening, then
# leave it running for reuse by the next invocation - on this one shared
# simulator, one lightweight idle proxy process is a better trade than an
# unreliable reconnect on every call. `nohup` here too, for the same reason:
# `disown` alone only stops THIS shell's job control from managing it - it
# does not block SIGHUP, so without nohup the proxy could still die when the
# terminal session that happened to start it closes, defeating the entire
# point of leaving it running for reuse.
#
# "Something is listening on the port" is not by itself proof that thing is
# still useful, though: the socket _iwdp_sim_socket resolves is per-boot, so
# a simulator rebooted (same or different UDID) since the running proxy
# attached leaves it bound to a now-dead socket, silently answering nothing
# useful - and a plain port check would never notice. IWDP_SOCK_FILE
# remembers which socket the running proxy was actually started against;
# a mismatch means it's stale, not merely idle, and gets replaced. This is a
# fresh proxy attaching to a NEW socket for the first time, not the
# kill-and-reconnect-to-the-SAME-socket pattern confirmed unreliable above.
IWDP_SOCK_FILE="${TMPDIR:-/tmp}/wv-iwdp.sock"

start_iwdp() {
  command -v ios_webkit_debug_proxy >/dev/null 2>&1 \
    || die "ios_webkit_debug_proxy not found on PATH - install it: brew install ios-webkit-debug-proxy"
  local sock; sock=$(_iwdp_sim_socket)
  [ -n "$sock" ] || die "could not find $WT_IOS_UDID's WebKit inspector socket - is it actually booted? (xcrun simctl spawn \"\$WT_IOS_UDID\" launchctl print user/foreground/com.apple.webinspectord)"
  if lsof -ti "tcp:$IWDP_PORT" >/dev/null 2>&1; then
    [ "$(cat "$IWDP_SOCK_FILE" 2>/dev/null)" = "$sock" ] && return 0
    local stale_pid; stale_pid=$(lsof -ti "tcp:$IWDP_PORT" 2>/dev/null | head -1)
    [ -n "$stale_pid" ] && kill "$stale_pid" 2>/dev/null
    local waited=0
    while lsof -ti "tcp:$IWDP_PORT" >/dev/null 2>&1; do
      [ "$waited" -ge 5 ] && break
      sleep 1; waited=$((waited + 1))
    done
  fi
  # -F: no DevTools frontend. This tool only ever talks the JSON/WebSocket
  # API directly, so the frontend HTML (whose default value is a URL on
  # appspot.com) is dead weight this shouldn't depend on being reachable.
  nohup ios_webkit_debug_proxy -c "$IWDP_SIM_SELECTOR" -s "unix:$sock" -F >/dev/null 2>&1 &
  disown 2>/dev/null || true
  printf '%s' "$sock" > "$IWDP_SOCK_FILE"
  local waited=0
  while ! lsof -ti "tcp:$IWDP_PORT" >/dev/null 2>&1; do
    [ "$waited" -ge 10 ] && die "ios_webkit_debug_proxy did not start listening on :$IWDP_PORT within 10s"
    sleep 1; waited=$((waited + 1))
  done
}

# ── Android: adb forward to the WebView devtools socket ─────────────────────
ANDROID_FWD_BASE_PORT=9339
# Guards the check-then-act port scan below: two concurrent `wv` invocations
# (a real, supported case on this one shared emulator, not hypothetical -
# see supercast-android.sh's own header) could otherwise both see the same
# port as free via lsof and both forward to it - adb forward on an
# already-mapped port REPLACES the mapping rather than erroring, so the
# loser's connection would be silently redirected to a different WebView's
# socket with no error at all.
ANDROID_FWD_LOCK_DIR="${TMPDIR:-/tmp}/wv-adb-forward.lock"

start_adb_forward() {
  command -v adb >/dev/null 2>&1 || die "adb not found on PATH - run this via 'wt run' from an Android worktree"
  local sock p waited=0
  # The devtools socket is an abstract unix socket, named webview_devtools_remote_<pid>;
  # /proc/net/unix prints its name with a leading '@' to mark it abstract, which
  # adb's own localabstract: forward target then wants stripped back off.
  #
  # Takes the FIRST matching socket. supercast-android's own wt_open force-stops
  # only its own package before installing, which narrows but doesn't guarantee
  # there is only ever one debuggable WebView process on the device - if that
  # ever becomes a real problem, the fix is the same "prefer the app's own
  # host, fail on genuine ambiguity" the page-selection step below already does,
  # extended to enumerate every matching socket rather than just the first.
  sock=$(adb -s "$ANDROID_SERIAL" shell cat /proc/net/unix 2>/dev/null \
    | tr -d '\r' | awk '/webview_devtools_remote/ { print $NF; exit }')
  [ -n "$sock" ] || die "no webview_devtools_remote socket found on $ANDROID_SERIAL - is the app running, and is its WebView debuggable?"
  sock=${sock#@}

  while ! mkdir "$ANDROID_FWD_LOCK_DIR" 2>/dev/null; do
    [ "$waited" -ge 10 ] && die "could not acquire the adb-forward lock ($ANDROID_FWD_LOCK_DIR) - remove it by hand if nothing is using it"
    sleep 1; waited=$((waited + 1))
  done
  for ((p = ANDROID_FWD_BASE_PORT; p < ANDROID_FWD_BASE_PORT + 200; p++)); do
    lsof -ti "tcp:$p" >/dev/null 2>&1 && continue
    ANDROID_FWD_PORT=$p
    break
  done
  if [ -z "$ANDROID_FWD_PORT" ]; then
    rmdir "$ANDROID_FWD_LOCK_DIR" 2>/dev/null || true
    die "no free local port found for adb forward"
  fi
  # adb forward prints the port back on success - confirmed empirically as a
  # real leak into wv's own output (a bare "9339" ahead of the actual eval
  # result) when not discarded.
  adb -s "$ANDROID_SERIAL" forward "tcp:$ANDROID_FWD_PORT" "localabstract:$sock" >/dev/null
  local rc=$?
  rmdir "$ANDROID_FWD_LOCK_DIR" 2>/dev/null || true
  [ "$rc" -eq 0 ] || die "adb forward to $sock failed"
  ANDROID_FWD_STARTED=1
}

# ── the shared protocol client ───────────────────────────────────────────────
# Both ios_webkit_debug_proxy and Android's WebView devtools socket serve the
# same /json HTTP listing (id, url, webSocketDebuggerUrl, ...) and the same
# Chrome DevTools Protocol JSON over that WebSocket, so this is written once
# and handed WV_PLATFORM/WV_HTTP_PORT/WV_APP_HOST/WV_EXPR through the
# environment rather than as argv.
write_eval_js() {
  cat <<'NODE_EOF'
const CONNECT_TIMEOUT_MS = 10000;
const EVAL_TIMEOUT_MS = 20000;

// Races a promise against a deadline instead of leaving a lost reply (a
// dropped connection, a target that never answers) to hang the script
// forever - fatal for a tool meant to run inside an unattended pq session
// with no one watching to Ctrl-C it.
function withTimeout(promise, ms, label) {
  return new Promise((resolve, reject) => {
    const t = setTimeout(() => reject(new Error(`timed out after ${ms}ms waiting for ${label}`)), ms);
    promise.then(
      (v) => { clearTimeout(t); resolve(v); },
      (e) => { clearTimeout(t); reject(e); }
    );
  });
}

async function fetchJson(url) {
  const res = await fetch(url);
  if (!res.ok) throw new Error(`GET ${url} failed (HTTP ${res.status})`);
  return res.json();
}

// The proxy's own TCP port accepting connections does not mean it has
// finished attaching to the device (or, one hop further in, that the device
// has finished listing its pages) - confirmed empirically: querying either
// step immediately after the port comes up can return an empty array for a
// moment before either registration completes, and the per-device port
// (found from the device list, then queried immediately) can briefly refuse
// connections outright before its own listener is up. Poll instead of
// trusting the first response - both an empty array AND a rejected fetch
// are treated as "not ready yet" - bounded so a genuinely empty result
// (nothing inspectable at all - a Release build) still fails in a few
// seconds rather than hanging.
async function fetchJsonNonEmpty(url, timeoutMs) {
  const deadline = Date.now() + timeoutMs;
  for (;;) {
    try {
      const body = await fetchJson(url);
      if (Array.isArray(body) && body.length > 0) return body;
      if (Date.now() >= deadline) return body;
    } catch (e) {
      if (Date.now() >= deadline) throw e;
    }
    await new Promise((resolve) => setTimeout(resolve, 300));
  }
}

async function main() {
  const platform = process.env.WV_PLATFORM;
  const port = process.env.WV_HTTP_PORT;
  const appHost = process.env.WV_APP_HOST;
  const expr = process.env.WV_EXPR;
  // WebKit's Runtime.evaluate names this emulateUserGesture; CDP (Android)
  // names the same thing userGesture - the two protocols were confirmed to
  // differ here rather than assumed to share a spelling.
  const gestureKey = platform === 'ios' ? 'emulateUserGesture' : 'userGesture';

  // ios_webkit_debug_proxy's own port (WV_HTTP_PORT) lists DEVICES, not
  // pages - confirmed empirically. Each device's own entry names a SECOND,
  // per-device port (dynamically assigned from the proxy's configured
  // range) whose /json actually lists that device's pages. Android's adb
  // forward instead points straight at one WebView's own socket, which
  // serves the page list directly - no such second hop.
  let pagesPort = port;
  if (platform === 'ios') {
    const devices = await fetchJsonNonEmpty(`http://127.0.0.1:${port}/json`, 5000);
    if (!Array.isArray(devices) || devices.length === 0) {
      throw new Error(`ios_webkit_debug_proxy on :${port} lists no devices at all`);
    }
    // "SIMULATOR" is the exact deviceId/deviceName the proxy reports for the
    // -s (simulator-webinspector) device, confirmed empirically - matched
    // explicitly so a real USB-attached device sharing the same proxy
    // process (the -c range does not exclude one) is never mistaken for it.
    // Falling back to devices[0] is only safe when there is nothing else TO
    // confuse it with; with more than one and no explicit match, this fails
    // the same way the page-selection step below does rather than guessing.
    let device = devices.find((d) => d.deviceId === 'SIMULATOR' || d.deviceName === 'SIMULATOR');
    if (!device) {
      if (devices.length > 1) {
        const lines = devices.map((d) => `  ${d.deviceId || d.deviceName}  ${d.url}`).join('\n');
        throw new Error(`no device reports as the simulator - which one?\n${lines}`);
      }
      device = devices[0];
    }
    const m = /:(\d+)\s*$/.exec(device.url || '');
    if (!m) throw new Error(`device entry has no usable port in its url: ${JSON.stringify(device)}`);
    pagesPort = m[1];
  }

  const pages = await fetchJsonNonEmpty(`http://127.0.0.1:${pagesPort}/json`, 5000);
  if (!Array.isArray(pages) || pages.length === 0) {
    throw new Error(
      'no inspectable pages found - a Release build is not inspectable at all ' +
      '(see this script\'s header); check the running build is Debug'
    );
  }

  // Prefer a page on the app's own host. Failing to match at all is failing
  // the preference, not just its tie-break - falling through to some
  // unrelated page (a system webview, a second debug app) would silently
  // return the wrong data, so this fails exactly the same way "more than one
  // still matches" does below, rather than guessing.
  const onHost = pages.filter((p) => {
    try { return new URL(p.url).hostname === appHost; } catch { return false; }
  });
  if (onHost.length === 0) {
    const lines = pages.map((p) => `  ${p.id}  ${p.url}`).join('\n');
    throw new Error(`no inspectable page matches host "${appHost}" - candidates:\n${lines}`);
  }

  // Android genuinely holds several WebViews open at once (one per
  // bottom-nav tab, confirmed against a real app: three tabs, four pages,
  // same host) - the host filter alone is not enough to disambiguate there.
  // Android's CDP reports a page's real state in its `description` field, a
  // JSON string carrying `empty` (no content ever rendered into it - a
  // background tab that hasn't been visited) and `visible`; prefer the one
  // page that is both, since that is the one the user is actually looking
  // at. iOS's `description` is always empty here, so this is a no-op there.
  let candidates = onHost;
  if (candidates.length > 1) {
    const rendered = candidates.filter((p) => {
      try {
        const d = JSON.parse(p.description || '');
        return d.empty === false && d.visible !== false;
      } catch { return false; }
    });
    if (rendered.length > 0) candidates = rendered;
  }
  if (candidates.length > 1) {
    const lines = candidates.map((p) => `  ${p.id}  ${p.url}`).join('\n');
    throw new Error(`more than one inspectable page matches - which one?\n${lines}`);
  }
  const page = candidates[0];
  if (!page.webSocketDebuggerUrl) throw new Error(`page ${page.id} has no webSocketDebuggerUrl`);

  const ws = new WebSocket(page.webSocketDebuggerUrl);
  try {
    await withTimeout(
      new Promise((resolve, reject) => {
        ws.addEventListener('open', () => resolve(), { once: true });
        ws.addEventListener('error', (e) => reject(new Error(e.message || 'websocket connection failed')), { once: true });
      }),
      CONNECT_TIMEOUT_MS,
      'the websocket to open'
    );

    let nextId = 1;
    let targetId = null;
    const pending = new Map();

    function settle(msg) {
      if (msg.id == null) return; // an event, not a reply
      const p = pending.get(msg.id);
      if (!p) return;
      pending.delete(msg.id);
      if (msg.error) p.reject(new Error(msg.error.message || JSON.stringify(msg.error)));
      else p.resolve(msg.result);
    }
    // A dropped connection after the open handshake (an app relaunch mid-eval,
    // a transient device hiccup) must fail whatever is still waiting rather
    // than rely on EVAL_TIMEOUT_MS alone to notice.
    function failAllPending(reason) {
      for (const p of pending.values()) p.reject(reason);
      pending.clear();
    }

    // Since iOS 12.2 the WebKit inspector wraps page traffic in the Target
    // domain (Target.targetCreated / Target.sendMessageToTarget /
    // Target.dispatchMessageFromTarget) - a bare Runtime.evaluate gets an
    // explicit "'Runtime' domain was not found" error when that wrapping is
    // in play, confirmed empirically. Handle both shapes rather than
    // assuming either: a page that never sends Target.targetCreated just
    // proceeds with targetId still null (Android's CDP, or a bare-shape
    // WebKit target). A page can report several targets (one per frame, plus
    // one aggregate "page" target) - whichever arrives FIRST is used
    // provisionally, but a "page" type, once seen, always wins over it: that
    // is the whole page's own context rather than one particular frame's.
    let sawTargetCreated = false;
    ws.addEventListener('message', (ev) => {
      let outer;
      try { outer = JSON.parse(ev.data); } catch { return; }
      if (outer.method === 'Target.targetCreated') {
        const info = outer.params?.targetInfo;
        if (info && (info.type === 'page' || !targetId)) targetId = info.targetId;
        sawTargetCreated = true;
        return;
      }
      if (outer.method === 'Target.dispatchMessageFromTarget') {
        let inner;
        try { inner = JSON.parse(outer.params.message); } catch { return; }
        settle(inner);
        return;
      }
      // A bare top-level reply is a real answer in two cases: the un-wrapped
      // (no Target domain, e.g. Android CDP) shape, where it is the ONLY
      // shape a reply ever takes; or a protocol-level error on the
      // Target.sendMessageToTarget call itself (a destroyed/unknown
      // targetId) once wrapping IS in play - that must still reach the
      // caller rather than silently running out EVAL_TIMEOUT_MS instead,
      // since ids match between the outer envelope and its inner payload by
      // construction (see rpc() below). A bare SUCCESS reply once wrapped
      // is never a real answer, though - it is only ever
      // Target.sendMessageToTarget's own empty delivery ack, which shares
      // that same id and would otherwise be mistaken for the inner reply.
      if (!targetId || outer.error) settle(outer);
    });
    ws.addEventListener('close', () => failAllPending(new Error('websocket closed before a reply arrived')));
    ws.addEventListener('error', (e) => failAllPending(new Error(e.message || 'websocket error')));

    function rpc(method, params) {
      return new Promise((resolve, reject) => {
        const id = nextId++;
        pending.set(id, { resolve, reject });
        const payload = { id, method, params };
        if (targetId) {
          // The outer envelope needs its OWN "id", not just the inner
          // message's - confirmed empirically ("'id' property was not
          // found" otherwise). Reusing the inner id is safe: the outer ack
          // is never treated as a reply (see the message handler above).
          ws.send(JSON.stringify({
            id,
            method: 'Target.sendMessageToTarget',
            params: { targetId, message: JSON.stringify(payload) },
          }));
        } else {
          ws.send(JSON.stringify(payload));
        }
      });
    }

    // Give a possible Target.targetCreated a moment to arrive before sending
    // anything, so the keyboard animation of the caller's own JS cannot race
    // this handshake either. Returns as soon as one arrives rather than
    // always waiting the full ceiling; Android (which never sends one at
    // all, so there is nothing to distinguish "no Target domain" from "not
    // arrived yet") always pays the full wait.
    const targetWaitStart = Date.now();
    while (!sawTargetCreated && Date.now() - targetWaitStart < 500) {
      await new Promise((resolve) => setTimeout(resolve, 25));
    }

    const result = await withTimeout(
      rpc('Runtime.evaluate', { expression: expr, returnByValue: true, [gestureKey]: true }),
      EVAL_TIMEOUT_MS,
      'Runtime.evaluate to reply'
    );

    // CDP (Android) reports a thrown exception via an exceptionDetails
    // object; WebKit instead reports it as result.wasThrown === true, with
    // no separate exceptionDetails at all - confirmed empirically, so both
    // are checked rather than assuming either shared shape. CDP's own
    // exceptionDetails.text is nearly always the generic literal "Uncaught" -
    // exceptionDetails.exception.description is where the real message and
    // location live, confirmed against a real ReferenceError, so it is tried
    // first rather than reported as just "Uncaught".
    if (result?.exceptionDetails || result?.wasThrown === true) {
      const desc = result?.exceptionDetails?.exception?.description
        || result?.exceptionDetails?.text
        || result?.result?.description
        || 'evaluation threw';
      throw new Error(desc);
    }
    const value = result?.result;
    if (value && Object.prototype.hasOwnProperty.call(value, 'value')) {
      console.log(typeof value.value === 'string' ? value.value : JSON.stringify(value.value));
    } else if (value?.description) {
      console.log(value.description);
    } else {
      console.log('undefined');
    }
  } finally {
    ws.close();
  }
}

// process.exitCode, never process.exit(): calling exit() can tear the
// process down before libuv finishes draining a large console.log to a pipe
// (empirically, anything over one pipe buffer's worth truncates silently) -
// letting the event loop drain naturally once `finally` above has closed the
// socket avoids that.
main().catch((e) => {
  console.error(`wv: ${e.message}`);
  process.exitCode = 1;
});
NODE_EOF
}

# ── commands ─────────────────────────────────────────────────────────────────
cmd_eval() {
  [ $# -le 1 ] || die "eval takes exactly one expression - quote it: wv eval 'a && b'"
  local expr=${1:-}
  [ -n "$expr" ] || die "eval needs a JS expression, e.g.: wv eval 'location.href'"
  local platform; platform=$(wv_platform) || exit 1
  local node; node=$(resolve_node) || exit 1
  local port
  case "$platform" in
    ios)     start_iwdp; port=$IWDP_PORT ;;
    android) start_adb_forward; port=$ANDROID_FWD_PORT ;;
  esac
  WV_TMP_JS=$(mktemp "${TMPDIR:-/tmp}/wv-eval.XXXXXX") \
    || die "could not create a temporary file for the eval script"
  write_eval_js > "$WV_TMP_JS"
  WV_PLATFORM="$platform" WV_HTTP_PORT="$port" WV_APP_HOST="$(wv_app_host)" WV_EXPR="$expr" \
    "$node" "$WV_TMP_JS"
}

cmd_shot() {
  [ $# -le 1 ] || die "usage: $SELF shot [path]"
  local path=${1:-}
  local platform; platform=$(wv_platform) || exit 1
  [ -n "$path" ] || path="${TMPDIR:-/tmp}/wv-shot-$(date +%Y%m%d%H%M%S).png"
  case "$platform" in
    ios)
      command -v xcrun >/dev/null 2>&1 || die "xcrun not found on PATH - run this via 'wt run' from an iOS worktree"
      xcrun simctl io "$WT_IOS_UDID" screenshot "$path" || die "simctl screenshot failed"
      ;;
    android)
      command -v adb >/dev/null 2>&1 || die "adb not found on PATH - run this via 'wt run' from an Android worktree"
      # The shell's own > redirect creates (or truncates) $path before adb
      # even runs, so writing straight to it would leave a misleading
      # 0-byte PNG behind on a failed screencap. Write to a temp file and
      # only move it into place once adb has actually succeeded.
      local tmp; tmp=$(mktemp "${TMPDIR:-/tmp}/wv-shot.XXXXXX") \
        || die "could not create a temporary file for the screenshot"
      if adb -s "$ANDROID_SERIAL" exec-out screencap -p > "$tmp"; then
        mv "$tmp" "$path"
      else
        rm -f "$tmp"
        die "adb screencap failed"
      fi
      ;;
  esac
  printf '%s\n' "$path"
}

case "${1:-}" in
  eval) shift; cmd_eval "$@" ;;
  shot) shift; cmd_shot "$@" ;;
  *)
    usage
    [ -n "${1:-}" ] && msg "unknown subcommand '$1'"
    exit 1
    ;;
esac
